<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <title>BGAV Hypercare Tool</title>
    <HTA:APPLICATION
        ID="BGAV_Hypercare"
        APPLICATIONNAME="BGAV Hypercare Tool"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="2.0"
        WINDOWSTATE="normal"
    />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 1.5rem;
        }
        .container { max-width: 600px; margin: 0 auto; }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .tab {
            flex: 1;
            padding: 0.75rem 1rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px 8px 0 0;
            color: #94a3b8;
            cursor: pointer;
            text-align: center;
            font-weight: 500;
            transition: all 0.2s;
        }
        .tab:hover { background: rgba(255,255,255,0.1); }
        .tab.active {
            background: rgba(30, 30, 50, 0.9);
            border-bottom-color: transparent;
            color: #f1f5f9;
        }

        .card {
            background: rgba(30, 30, 50, 0.9);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 0 0 16px 16px;
            padding: 1.5rem;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .header { text-align: center; margin-bottom: 1.5rem; }
        .logo {
            width: 50px; height: 50px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 0.75rem;
            font-size: 1.25rem;
        }
        .logo-export { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .logo-import { background: linear-gradient(135deg, #10b981, #059669); }
        h2 { font-size: 1.25rem; margin-bottom: 0.25rem; }
        .subtitle { color: #94a3b8; font-size: 0.8125rem; }

        label {
            display: block; margin-bottom: 0.375rem;
            font-weight: 500; color: #94a3b8; font-size: 0.8125rem;
        }
        select, input {
            width: 100%; padding: 0.625rem 0.875rem;
            background: #252542; border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px; color: #f1f5f9; font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }
        select:focus, input:focus { outline: none; border-color: #6366f1; }

        .btn {
            width: 100%; padding: 0.75rem; border: none; border-radius: 6px;
            font-size: 0.9375rem; font-weight: 600; cursor: pointer;
            transition: all 0.2s; margin-bottom: 0.5rem;
        }
        .btn-primary { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; }
        .btn-success { background: linear-gradient(135deg, #10b981, #059669); color: white; }
        .btn-secondary { background: #252542; color: #94a3b8; border: 1px solid rgba(255,255,255,0.1); }
        .btn:hover:not(:disabled) { transform: translateY(-1px); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .progress-container { display: none; margin: 1rem 0; }
        .progress-bar {
            height: 6px; background: #252542;
            border-radius: 3px; overflow: hidden; margin-bottom: 0.5rem;
        }
        .progress-fill {
            height: 100%; border-radius: 3px; width: 0%; transition: width 0.3s;
        }
        .progress-fill.export { background: linear-gradient(90deg, #6366f1, #818cf8); }
        .progress-fill.import { background: linear-gradient(90deg, #10b981, #34d399); }
        .progress-text { font-size: 0.8125rem; color: #94a3b8; text-align: center; }

        .status { padding: 0.75rem; border-radius: 6px; margin-top: 0.75rem; display: none; font-size: 0.875rem; }
        .status.success { background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #10b981; }
        .status.error { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ef4444; }

        .action-buttons { display: none; margin-top: 0.75rem; }
        .action-buttons .btn { margin-bottom: 0.375rem; }

        .info-box {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 6px; padding: 0.75rem; margin-top: 1rem;
            font-size: 0.75rem; color: #94a3b8;
        }
        .info-box strong { color: #818cf8; }

        .row { display: flex; gap: 0.75rem; }
        .row > * { flex: 1; }
    </style>
</head>
<body>
    <div class="container">
        <div class="tabs">
            <div class="tab active" onclick="switchTab('export')">&#128229; Outlook Export</div>
            <div class="tab" onclick="switchTab('import')">&#128200; Excel Import</div>
        </div>

        <div class="card">
            <!-- TAB 1: OUTLOOK EXPORT -->
            <div class="tab-content active" id="tabExport">
                <div class="header">
                    <div class="logo logo-export">&#9993;</div>
                    <h2>Emails aus Outlook exportieren</h2>
                    <p class="subtitle">Emails der letzten Tage als JSON speichern</p>
                </div>

                <label>Postfach</label>
                <select id="mailboxSelect" onchange="loadFolders()">
                    <option value="">-- Postfach wahlen --</option>
                </select>

                <label>Ordner</label>
                <select id="folderSelect" disabled>
                    <option value="">-- Erst Postfach wahlen --</option>
                </select>

                <label>Zeitraum (Tage)</label>
                <input type="number" id="daysInput" value="7" min="1" max="30">

                <label>Excel verbinden (Pflicht)</label>
                <div class="row">
                    <input type="text" id="exportExcelStatus" readonly placeholder="Tracking_Hypercare.xlsm öffnen, dann verbinden" style="flex:1">
                </div>
                <button class="btn btn-primary" onclick="detectExcelForExport()" style="margin-bottom:0.75rem;">
                    &#128269; Excel verbinden
                </button>

                <button class="btn btn-success" id="exportBtn" onclick="startExport()" disabled>
                    &#128229; Emails exportieren
                </button>

                <div class="progress-container" id="exportProgress">
                    <div class="progress-bar"><div class="progress-fill export" id="exportProgressFill"></div></div>
                    <div class="progress-text" id="exportProgressText">Exportiere...</div>
                </div>

                <div class="status success" id="exportSuccess">
                    <strong>&#10003; Export erfolgreich!</strong><br>
                    <span id="exportSuccessMsg"></span>
                </div>
                <div class="status error" id="exportError"><span id="exportErrorMsg"></span></div>

                <div class="action-buttons" id="exportActions">
                    <button class="btn btn-success" id="btnDirectImport" onclick="directImport()" style="display:none;">
                        &#128200; Direkt in Excel importieren
                    </button>
                    <button class="btn btn-success" onclick="openWebApp()">&#127760; Web-App öffnen (bearbeiten)</button>
                    <button class="btn btn-secondary" onclick="openDownloads()">&#128193; Downloads öffnen</button>
                </div>

                <div class="info-box">
                    <strong>Workflow:</strong> Excel verbinden → Export → Direkt importieren ODER Web-App → Import
                </div>
            </div>

            <!-- TAB 2: EXCEL IMPORT -->
            <div class="tab-content" id="tabImport">
                <div class="header">
                    <div class="logo logo-import">&#128200;</div>
                    <h2>In Excel importieren</h2>
                    <p class="subtitle">JSON in geoffnete Hypercare-Excel schreiben</p>
                </div>

                <label>JSON-Datei (bearbeitet aus Web-App)</label>
                <div class="row">
                    <input type="text" id="jsonPath" readonly placeholder="Keine Datei ausgewahlt" style="flex:3">
                    <button class="btn btn-secondary" onclick="selectJsonFile()" style="flex:1; margin-bottom:0.75rem;">Durchsuchen...</button>
                </div>

                <div class="status" id="jsonStatus" style="display:none; margin-bottom:0.75rem;"></div>

                <label>Excel-Ziel</label>
                <div class="row">
                    <input type="text" id="excelStatus" readonly placeholder="Suche geoffnete Hypercare-Excel..." style="flex:1">
                </div>
                <button class="btn btn-secondary" onclick="detectExcel()" style="margin-bottom:0.75rem;">
                    &#128269; Excel erkennen
                </button>

                <label>Tabellenblatt</label>
                <input type="text" id="sheetName" value="Übersicht">

                <button class="btn btn-success" id="importBtn" onclick="startImport()" disabled>
                    &#128200; In Excel importieren
                </button>

                <div class="progress-container" id="importProgress">
                    <div class="progress-bar"><div class="progress-fill import" id="importProgressFill"></div></div>
                    <div class="progress-text" id="importProgressText">Importiere...</div>
                </div>

                <div class="status success" id="importSuccess">
                    <strong>&#10003; Import erfolgreich!</strong><br>
                    <span id="importSuccessMsg"></span>
                </div>
                <div class="status error" id="importError"><span id="importErrorMsg"></span></div>

                <div class="info-box">
                    <strong>Hinweis:</strong> Offne zuerst die Tracking_Hypercare.xlsm in Excel, dann klicke "Excel erkennen"
                </div>
            </div>
        </div>
    </div>

    <script>
        var outlookApp = null;
        var namespace = null;
        var selectedStore = null;
        var jsonData = null;

        // Excel connection for duplicate checking during export
        var exportExcelApp = null;
        var exportWorkbook = null;
        var existingEmailKeys = {};  // Keys of emails already in Excel
        var existingReplies = {};    // Existing replies text per email key (for filtering new replies)
        var lastExportedEmails = null;  // Store for direct import

        // ============================================================================
        // INITIALIZATION
        // ============================================================================
        window.onload = function() {
            initOutlook();
        };

        function switchTab(tab) {
            var tabs = document.getElementsByClassName('tab');
            for (var i = 0; i < tabs.length; i++) {
                tabs[i].className = 'tab' + (i === (tab === 'export' ? 0 : 1) ? ' active' : '');
            }
            document.getElementById('tabExport').className = 'tab-content' + (tab === 'export' ? ' active' : '');
            document.getElementById('tabImport').className = 'tab-content' + (tab === 'import' ? ' active' : '');

            // If switching to import and Excel was already connected during export, reuse it
            if (tab === 'import' && exportWorkbook && !targetWorkbook) {
                try {
                    // Test if Excel connection is still valid
                    var testName = exportWorkbook.Name;
                    excelApp = exportExcelApp;
                    targetWorkbook = exportWorkbook;
                    document.getElementById('excelStatus').value = "OK: " + testName + " (vom Export übernommen)";
                    checkImportReady();
                } catch (e) {
                    // Excel connection lost - reset
                    exportWorkbook = null;
                    exportExcelApp = null;
                    document.getElementById('excelStatus').value = "Excel-Verbindung verloren - bitte neu verbinden";
                }
            }
        }

        // ============================================================================
        // OUTLOOK EXPORT
        // ============================================================================
        function initOutlook() {
            try {
                outlookApp = new ActiveXObject("Outlook.Application");
                namespace = outlookApp.GetNamespace("MAPI");
                loadMailboxes();
            } catch (e) {
                showExportError("Outlook nicht gefunden: " + e.message);
            }
        }

        function loadMailboxes() {
            var select = document.getElementById('mailboxSelect');
            select.innerHTML = '<option value="">-- Postfach wahlen --</option>';
            try {
                var stores = namespace.Stores;
                for (var i = 1; i <= stores.Count; i++) {
                    try {
                        var store = stores.Item(i);
                        var option = document.createElement('option');
                        option.value = i;
                        option.text = store.DisplayName;
                        select.appendChild(option);
                    } catch (e) {}
                }
            } catch (e) {}
        }

        function loadFolders() {
            var mailboxSelect = document.getElementById('mailboxSelect');
            var folderSelect = document.getElementById('folderSelect');
            var exportBtn = document.getElementById('exportBtn');

            if (!mailboxSelect.value) {
                folderSelect.innerHTML = '<option value="">-- Erst Postfach wahlen --</option>';
                folderSelect.disabled = true;
                exportBtn.disabled = true;
                return;
            }

            try {
                selectedStore = namespace.Stores.Item(parseInt(mailboxSelect.value));
                var rootFolder = selectedStore.GetRootFolder();
                folderSelect.innerHTML = '';

                try {
                    var inbox = selectedStore.GetDefaultFolder(6);
                    var option = document.createElement('option');
                    option.value = 'inbox';
                    option.text = 'Posteingang (' + inbox.Items.Count + ')';
                    folderSelect.appendChild(option);
                } catch (e) {}

                addSubfolders(rootFolder.Folders, folderSelect, '');
                folderSelect.disabled = false;
                checkExportReady();
            } catch (e) {
                showExportError("Fehler: " + e.message);
            }
        }

        function addSubfolders(folders, select, prefix) {
            for (var i = 1; i <= folders.Count; i++) {
                try {
                    var folder = folders.Item(i);
                    if (folder.DefaultItemType === 0) {
                        var option = document.createElement('option');
                        option.value = folder.EntryID;
                        option.text = prefix + folder.Name + ' (' + folder.Items.Count + ')';
                        select.appendChild(option);
                        if (folder.Folders.Count > 0) {
                            addSubfolders(folder.Folders, select, prefix + '  ');
                        }
                    }
                } catch (e) {}
            }
        }

        // ============================================================================
        // EXCEL CONNECTION FOR DUPLICATE CHECK
        // ============================================================================

        // Check if export can be started (folder selected AND Excel connected)
        function checkExportReady() {
            var folderSelected = document.getElementById('folderSelect').value !== '';
            var excelConnected = exportWorkbook !== null;
            var btn = document.getElementById('exportBtn');

            if (folderSelected && excelConnected) {
                btn.disabled = false;
                btn.innerHTML = '&#128229; Emails exportieren';
            } else if (folderSelected && !excelConnected) {
                btn.disabled = true;
                btn.innerHTML = '&#128229; Erst Excel verbinden!';
            } else {
                btn.disabled = true;
                btn.innerHTML = '&#128229; Emails exportieren';
            }
        }

        function detectExcelForExport() {
            document.getElementById('exportExcelStatus').value = "Suche Excel...";
            existingEmailKeys = {};
            existingReplies = {};

            try {
                // Try to connect to running Excel
                try {
                    exportExcelApp = GetObject("", "Excel.Application");
                } catch (e1) {
                    exportExcelApp = new ActiveXObject("Excel.Application");
                }
                exportExcelApp.Visible = true;

                // Find Hypercare workbook
                exportWorkbook = null;
                for (var i = 1; i <= exportExcelApp.Workbooks.Count; i++) {
                    try {
                        var wb = exportExcelApp.Workbooks(i);
                        var wbName = wb.Name.toLowerCase().replace(/[_\-\s]/g, '');
                        if (wbName.indexOf('hypercare') !== -1) {
                            exportWorkbook = wb;
                            break;
                        }
                    } catch (e) {}
                }

                if (!exportWorkbook) {
                    // Try SharePoint
                    document.getElementById('exportExcelStatus').value = "Offne SharePoint-Datei...";
                    var sharePointUrl = "https://barmeniagroup.sharepoint.com/sites/SAPUnity-WorkstreamICM/Freigegebene%20Dokumente/40%20Team%20Simulation,%20Kalibrierung,%20Verhandlung,%20Vertrag%20&%20EFM/Tracking_Hypercare.xlsm";
                    try {
                        exportWorkbook = exportExcelApp.Workbooks.Open(sharePointUrl);
                    } catch (e) {
                        document.getElementById('exportExcelStatus').value = "Excel nicht gefunden - Duplikate werden nicht gefiltert";
                        return;
                    }
                }

                // Read existing data from Excel
                document.getElementById('exportExcelStatus').value = "Lese bestehende Einträge...";
                var worksheet;
                try {
                    worksheet = exportWorkbook.Worksheets("Übersicht");
                } catch (e) {
                    worksheet = exportWorkbook.Worksheets(1);
                }

                var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                var count = 0;

                // Read ConversationID (col 21), date (col 2), subject (col 11), and replies (col 13) for duplicate detection
                for (var row = 2; row <= lastRow; row++) {
                    var conversationId = worksheet.Cells(row, 21).Value || '';
                    var datum = worksheet.Cells(row, 2).Value || '';
                    var betreff = worksheet.Cells(row, 11).Value || '';
                    var antworten = worksheet.Cells(row, 13).Value || '';  // Existing replies

                    // Primary key: ConversationID + Date (allows new replies in same conversation)
                    if (conversationId && datum) {
                        var dateStr = formatDateKey(datum);
                        var convKey = 'conv|' + conversationId + '|' + dateStr;
                        existingEmailKeys[convKey] = true;
                        if (antworten) existingReplies[convKey] = antworten;
                    }
                    // Fallback key: date + subject (for older entries without ConversationID)
                    if (datum || betreff) {
                        var key = createExportEmailKey(datum, betreff);
                        existingEmailKeys[key] = true;
                        if (antworten) existingReplies[key] = antworten;
                    }
                    if (conversationId || datum || betreff) count++;
                }

                document.getElementById('exportExcelStatus').value = "OK: " + exportWorkbook.Name + " (" + count + " Einträge)";
                checkExportReady();

            } catch (e) {
                document.getElementById('exportExcelStatus').value = "Fehler: " + e.message;
                existingEmailKeys = {};
                exportWorkbook = null;
                checkExportReady();
            }
        }

        function formatDateKey(datum) {
            try {
                var d;
                if (typeof datum === 'number') {
                    d = new Date((datum - 25569) * 86400 * 1000);
                } else {
                    d = new Date(datum);
                }
                if (!isNaN(d.getTime())) {
                    return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                }
            } catch (e) {}
            return String(datum).substring(0, 10);
        }

        function normalizeSubject(betreff) {
            var subjectStr = String(betreff || '').toLowerCase().trim();
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            return subjectStr.substring(0, 100);
        }

        function createExportEmailKey(datum, betreff) {
            var dateStr = '';
            if (datum) {
                try {
                    var d;
                    // Handle Excel serial number (days since 1899-12-30)
                    if (typeof datum === 'number') {
                        d = new Date((datum - 25569) * 86400 * 1000);
                    } else {
                        d = new Date(datum);
                    }
                    // Check if valid date
                    if (!isNaN(d.getTime())) {
                        dateStr = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                    } else {
                        dateStr = String(datum).substring(0, 10);
                    }
                } catch (e) {
                    dateStr = String(datum).substring(0, 10);
                }
            }
            // Normalize subject: lowercase, remove RE:/AW:/FW:/WG: prefixes
            var subjectStr = String(betreff || '').toLowerCase().trim();
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, ''); // Remove twice for RE: RE:
            subjectStr = subjectStr.substring(0, 100);
            return dateStr + '|' + subjectStr;
        }

        function startExport() {
            var folderId = document.getElementById('folderSelect').value;
            var days = parseInt(document.getElementById('daysInput').value) || 7;

            if (!folderId) { alert('Bitte Ordner auswahlen!'); return; }

            document.getElementById('exportProgress').style.display = 'block';
            document.getElementById('exportBtn').disabled = true;
            document.getElementById('exportSuccess').style.display = 'none';
            document.getElementById('exportError').style.display = 'none';
            document.getElementById('exportActions').style.display = 'none';

            setTimeout(function() { doExport(folderId, days); }, 100);
        }

        var sentItemsCache = [];

        // Export state for async processing
        var exportState = {
            items: null,
            emails: [],
            total: 0,
            current: 0,
            oldCount: 0,
            repliesFound: 0,
            duplicatesSkipped: 0,
            duplicatesWithReplies: 0,
            cutoffDate: null
        };

        function doExport(folderId, days) {
            try {
                // Phase 1: Get folder
                document.getElementById('exportProgressText').innerText = 'Phase 1/3: Ordner wird geladen...';
                document.getElementById('exportProgressFill').style.width = '5%';

                var folder = (folderId === 'inbox') ? selectedStore.GetDefaultFolder(6) : namespace.GetFolderFromID(folderId);
                exportState.items = folder.Items;
                try { exportState.items.Sort("[ReceivedTime]", true); } catch (e) {}

                exportState.cutoffDate = new Date();
                exportState.cutoffDate.setDate(exportState.cutoffDate.getDate() - days);
                exportState.emails = [];
                exportState.total = Math.min(exportState.items.Count, 500);
                exportState.current = 1;
                exportState.oldCount = 0;
                exportState.repliesFound = 0;
                exportState.duplicatesSkipped = 0;      // Duplicates from Excel
                exportState.batchDuplicates = 0;        // Duplicates within same export batch
                exportState.duplicatesWithReplies = 0;
                exportState.processedConvIds = {};  // Track ConversationIDs already processed in this export

                // Phase 2: Cache sent items (async - will start Phase 3 when done)
                document.getElementById('exportProgressText').innerText = 'Phase 2/3: Lade gesendete Emails...';
                document.getElementById('exportProgressFill').style.width = '10%';

                setTimeout(function() {
                    cacheSentItems(days);
                }, 50);

            } catch (e) {
                showExportError("Fehler: " + e.message);
            }
        }

        function processEmailBatch() {
            var batchSize = 5; // Process 5 emails per batch
            var processed = 0;

            while (processed < batchSize && exportState.current <= exportState.total) {
                var i = exportState.current;
                exportState.current++;
                processed++;

                try {
                    var item = exportState.items.Item(i);
                    if (item.Class !== 43) continue;
                    var receivedTime = new Date(item.ReceivedTime);
                    if (receivedTime < exportState.cutoffDate) {
                        exportState.oldCount++;
                        if (exportState.oldCount >= 20) {
                            exportState.current = exportState.total + 1; // Stop
                            break;
                        }
                        continue;
                    }

                    var emailData = extractEmail(item);

                    // Skip if we already processed this ConversationID in this export batch
                    // (handles forwarded emails appearing multiple times in folder)
                    if (emailData.conversationId && exportState.processedConvIds[emailData.conversationId]) {
                        exportState.batchDuplicates++;
                        continue;
                    }
                    if (emailData.conversationId) {
                        exportState.processedConvIds[emailData.conversationId] = true;
                    }

                    // Check for duplicates if Excel was connected
                    var hasExcelData = false;
                    for (var k in existingEmailKeys) { hasExcelData = true; break; }
                    var isDuplicate = false;
                    var existingReplyText = '';
                    var convKey = '';
                    var emailKey = '';
                    if (hasExcelData) {
                        var dateKey = formatDateKey(emailData.datum);
                        convKey = 'conv|' + (emailData.conversationId || '') + '|' + dateKey;
                        emailKey = createExportEmailKey(emailData.datum, emailData.betreff);
                        // Check ConversationID+Date first (allows new replies), then date+subject
                        if ((emailData.conversationId && existingEmailKeys[convKey]) || existingEmailKeys[emailKey]) {
                            isDuplicate = true;
                            // Get existing replies for comparison
                            existingReplyText = existingReplies[convKey] || existingReplies[emailKey] || '';
                        }
                    }

                    // Always check for replies (even for duplicates - there might be new ones)
                    var allReplies = findReplies(emailData);
                    exportState.repliesFound += allReplies.length;

                    if (isDuplicate) {
                        // Filter to only truly new replies (not already in Excel)
                        var newReplies = filterNewReplies(allReplies, existingReplyText);

                        if (newReplies.length > 0) {
                            // Has new replies - include for update
                            emailData.antworten = newReplies;  // Only new replies for import
                            emailData.alleAntworten = allReplies;  // All replies for web tool display
                            emailData.existingReplies = existingReplyText;  // Mark what already exists
                            emailData.isDuplicateWithNewReplies = true;
                            exportState.duplicatesWithReplies++;
                            exportState.emails.push(emailData);
                        } else {
                            exportState.duplicatesSkipped++;
                        }
                    } else {
                        // New email - include all replies
                        emailData.antworten = allReplies;
                        for (var r = 0; r < allReplies.length; r++) {
                            allReplies[r].isNew = true;  // Mark all as new for new emails
                        }
                        exportState.emails.push(emailData);
                    }
                } catch (e) {}
            }

            // Update UI
            var pct = 30 + Math.round((exportState.current / exportState.total) * 70);
            document.getElementById('exportProgressFill').style.width = pct + '%';
            var newCount = exportState.emails.length - exportState.duplicatesWithReplies;
            var statusText = 'Phase 3/3: Email ' + exportState.current + '/' + exportState.total +
                ' (' + newCount + ' neu';
            if (exportState.duplicatesWithReplies > 0) {
                statusText += ', ' + exportState.duplicatesWithReplies + ' Updates';
            }
            if (exportState.duplicatesSkipped > 0) {
                statusText += ', ' + exportState.duplicatesSkipped + ' in Excel';
            }
            if (exportState.batchDuplicates > 0) {
                statusText += ', ' + exportState.batchDuplicates + ' doppelt';
            }
            statusText += ', ' + exportState.repliesFound + ' Antworten)';
            document.getElementById('exportProgressText').innerText = statusText;

            // Continue or finish
            if (exportState.current <= exportState.total) {
                setTimeout(processEmailBatch, 10); // Small delay for UI update
            } else {
                finishExport();
            }
        }

        function finishExport() {
            if (exportState.emails.length === 0) {
                showExportError("Keine neuen Emails gefunden.");
                return;
            }
            saveExportFile(exportState.emails, exportState.repliesFound, exportState.duplicatesSkipped, exportState.duplicatesWithReplies, exportState.batchDuplicates);
        }

        // State for async sent items caching
        var sentCacheState = {
            folders: [],
            folderIdx: 0,
            itemIdx: 1,
            maxItems: 0,
            items: null,
            cutoffDate: null,
            days: 7
        };

        function cacheSentItems(days) {
            sentItemsCache = [];
            sentCacheState.days = days;
            sentCacheState.cutoffDate = new Date();
            sentCacheState.cutoffDate.setDate(sentCacheState.cutoffDate.getDate() - (days + 30));
            sentCacheState.folders = [];
            sentCacheState.folderIdx = 0;

            // Collect all sent folders
            try { sentCacheState.folders.push(selectedStore.GetDefaultFolder(5)); } catch (e) {}

            try {
                var defaultSent = namespace.GetDefaultFolder(5);
                var isDup = false;
                for (var f = 0; f < sentCacheState.folders.length; f++) {
                    try { if (sentCacheState.folders[f].EntryID === defaultSent.EntryID) isDup = true; } catch (e) {}
                }
                if (!isDup) sentCacheState.folders.push(defaultSent);
            } catch (e) {}

            try {
                for (var s = 1; s <= namespace.Stores.Count; s++) {
                    try {
                        var storeSent = namespace.Stores.Item(s).GetDefaultFolder(5);
                        var isDup = false;
                        for (var f = 0; f < sentCacheState.folders.length; f++) {
                            try { if (sentCacheState.folders[f].EntryID === storeSent.EntryID) isDup = true; } catch (e) {}
                        }
                        if (!isDup) sentCacheState.folders.push(storeSent);
                    } catch (e) {}
                }
            } catch (e) {}

            // Start first folder
            startNextSentFolder();
        }

        function startNextSentFolder() {
            if (sentCacheState.folderIdx >= sentCacheState.folders.length) {
                // All folders done - start Phase 3
                document.getElementById('exportProgressText').innerText =
                    'Phase 2/3 fertig: ' + sentItemsCache.length + ' gesendete Emails geladen';
                document.getElementById('exportProgressFill').style.width = '30%';
                setTimeout(processEmailBatch, 10);
                return;
            }

            try {
                sentCacheState.items = sentCacheState.folders[sentCacheState.folderIdx].Items;
                try { sentCacheState.items.Sort("[SentOn]", true); } catch (e) {}
                // Increased limit for group mailboxes with many sent items
                sentCacheState.maxItems = Math.min(sentCacheState.items.Count, 1000);
                sentCacheState.itemIdx = 1;
                setTimeout(processSentBatch, 10);
            } catch (e) {
                sentCacheState.folderIdx++;
                setTimeout(startNextSentFolder, 10);
            }
        }

        function processSentBatch() {
            var batchSize = 20;  // Increased batch size for faster processing
            var processed = 0;

            while (processed < batchSize && sentCacheState.itemIdx <= sentCacheState.maxItems) {
                var i = sentCacheState.itemIdx;
                sentCacheState.itemIdx++;
                processed++;

                try {
                    var item = sentCacheState.items.Item(i);
                    if (item.Class !== 43) continue;

                    var sentDate = new Date(item.SentOn);
                    if (sentDate < sentCacheState.cutoffDate) {
                        sentCacheState.itemIdx = sentCacheState.maxItems + 1;
                        break;
                    }

                    var body = '';
                    try { body = item.Body || ''; } catch (e) {}

                    var toRecipient = '';
                    try { toRecipient = item.To || ''; } catch (e) {}

                    var convId = '';
                    try { convId = item.ConversationID || ''; } catch (e) {}

                    sentItemsCache.push({
                        sentDate: sentDate,
                        conversationId: convId,
                        body: removeEmailQuotes(body),
                        to: toRecipient
                    });
                } catch (e) {}
            }

            // Update progress
            var totalFolders = sentCacheState.folders.length;
            var pct = 10 + Math.round(((sentCacheState.folderIdx * 1000 + sentCacheState.itemIdx) / (totalFolders * 1000)) * 20);
            document.getElementById('exportProgressFill').style.width = pct + '%';
            document.getElementById('exportProgressText').innerText =
                'Phase 2/3: Ordner ' + (sentCacheState.folderIdx + 1) + '/' + totalFolders +
                ' - Email ' + sentCacheState.itemIdx + '/' + sentCacheState.maxItems +
                ' (' + sentItemsCache.length + ' geladen)';

            // Continue or next folder
            if (sentCacheState.itemIdx <= sentCacheState.maxItems) {
                setTimeout(processSentBatch, 10);
            } else {
                sentCacheState.folderIdx++;
                setTimeout(startNextSentFolder, 10);
            }
        }

        function findReplies(originalEmail) {
            var replies = [];
            if (!sentItemsCache || sentItemsCache.length === 0) return replies;

            try {
                var originalConvId = originalEmail.conversationId || '';
                var originalDate = new Date(originalEmail.datum);

                // No ConversationID = can't match reliably
                if (!originalConvId) return replies;

                for (var i = 0; i < sentItemsCache.length; i++) {
                    var cached = sentItemsCache[i];

                    // Match by ConversationID (Outlook's built-in thread tracking)
                    if (cached.conversationId && cached.conversationId === originalConvId) {
                        // Reply must be after original email
                        if (cached.sentDate <= originalDate) continue;

                        if (cached.body && cached.body.trim() !== '') {
                            replies.push({
                                datum: formatDate(cached.sentDate),
                                an: cached.to || '',
                                text: cached.body.trim()
                            });
                        }
                    }
                }
            } catch (e) {}

            return replies;
        }

        // Filter replies to only include ones that are not already in Excel
        function filterNewReplies(allReplies, existingReplyText) {
            if (!allReplies || allReplies.length === 0) return [];
            if (!existingReplyText) {
                // No existing replies - all are new
                for (var i = 0; i < allReplies.length; i++) {
                    allReplies[i].isNew = true;
                }
                return allReplies;
            }

            var newReplies = [];
            var existingLower = existingReplyText.toLowerCase();

            for (var j = 0; j < allReplies.length; j++) {
                var reply = allReplies[j];
                var replyText = (reply.text || '').trim();

                // Skip empty replies
                if (!replyText) continue;

                // Check if this reply is already in Excel
                // Use first 80 chars for matching (handles minor formatting differences)
                var checkText = replyText.substring(0, 80).toLowerCase().trim();
                if (checkText.length < 10) checkText = replyText.toLowerCase().trim();

                if (existingLower.indexOf(checkText) === -1) {
                    // Not found in existing - this is new
                    reply.isNew = true;
                    newReplies.push(reply);
                } else {
                    reply.isNew = false;
                }
            }

            return newReplies;
        }

        function removeEmailQuotes(text) {
            if (!text) return '';

            // Find where quoted content starts and cut it off
            // Multiple patterns for German and English Outlook
            var patterns = [
                // German Outlook patterns (including UTF-8 mojibake versions)
                /_{5,}\s*\r?\n\s*Von:/i,
                /\r?\n\s*Von:\s+.+\r?\n\s*Gesendet:/im,
                /\r?\n\s*Von:\s+.+\r?\n\s*An:/im,
                /-{3,}\s*Urspr[uü]ngliche\s+Nachricht/i,
                /-{3,}\s*UrsprÃ¼ngliche\s+Nachricht/i,  // UTF-8 mojibake
                /-{3,}\s*Original\s*Message/i,
                /-{3,}\s*Weitergeleitete\s+Nachricht/i,
                /-{3,}\s*Weitergeleite\s+Nachricht/i,
                // English Outlook patterns
                /_{5,}\s*\r?\n\s*From:/i,
                /\r?\n\s*From:\s+.+\r?\n\s*Sent:/im,
                /\r?\n\s*From:\s+.+\r?\n\s*To:/im,
                // Quote headers
                /\r?\n\s*Am\s+\d.+\s+schrieb\s+.+:/im,
                /\r?\n\s*On\s+.+\s+wrote:/im,
                /\r?\n\s*>+\s*Von:/im,
                /\r?\n\s*>+\s*From:/im,
                // Line of underscores/dashes followed by email header
                /\r?\n_{10,}\r?\n/,
                /\r?\n-{10,}\r?\n/
            ];

            for (var i = 0; i < patterns.length; i++) {
                var match = text.search(patterns[i]);
                if (match > 0) {
                    text = text.substring(0, match);
                    break;
                }
            }

            // Remove trailing signature markers
            text = text.replace(/\r?\n--\s*\r?\n[\s\S]*$/, '');

            // Additional cleanup: Remove any remaining quote markers and everything after
            // This catches cases where the pattern didn't match exactly
            var quoteMarkers = [
                /-{3,}\s*Urspr/i,           // -----Ursprüngliche Nachricht
                /-{3,}\s*UrsprÃ/i,          // Mojibake version
                /-{3,}\s*Original/i,         // -----Original Message
                /-{3,}\s*Weitergeleit/i,     // -----Weitergeleitete Nachricht
                /_{5,}\s*Von:/i,             // _____Von:
                /_{5,}\s*From:/i             // _____From:
            ];
            for (var j = 0; j < quoteMarkers.length; j++) {
                var pos = text.search(quoteMarkers[j]);
                if (pos > 0) {
                    text = text.substring(0, pos);
                    break;
                }
            }

            // Trim and limit length
            text = text.trim();
            if (text.length > 10000) text = text.substring(0, 10000) + '...';
            return text;
        }

        function extractEmail(item) {
            var senderEmail = '';
            try {
                senderEmail = item.SenderEmailAddress || '';
                if ((!senderEmail || senderEmail.indexOf('@') === -1) && item.SenderEmailType === 'EX') {
                    try { var exUser = item.Sender.GetExchangeUser(); if (exUser) senderEmail = exUser.PrimarySmtpAddress || senderEmail; } catch (e) {}
                }
            } catch (e) {}

            var body = '';
            try { body = item.Body || ''; if (body.length > 50000) body = body.substring(0, 50000) + '...'; } catch (e) {}

            var attachments = [];
            try { for (var a = 1; a <= item.Attachments.Count; a++) { attachments.push(item.Attachments.Item(a).FileName); } } catch (e) {}

            var convId = '';
            try { convId = item.ConversationID || ''; } catch (e) {}

            return {
                datum: formatDate(item.ReceivedTime),
                von_email: senderEmail,
                von_name: item.SenderName || 'Unbekannt',
                betreff: item.Subject || '(Kein Betreff)',
                text: body,
                anhaenge: attachments,
                conversationId: convId,
                antworten: []
            };
        }

        function formatDate(date) {
            var d = new Date(date);
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        }

        function pad(n) { return n < 10 ? '0' + n : n; }

        function saveExportFile(emails, totalReplies, duplicatesSkipped, duplicatesWithReplies, batchDuplicates) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var shellApp = new ActiveXObject("Shell.Application");
                var fso = new ActiveXObject("Scripting.FileSystemObject");

                var downloads;
                try { downloads = shellApp.NameSpace("shell:Downloads").Self.Path; }
                catch (e) { downloads = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }

                var filename = 'hypercare_emails_' + new Date().toISOString().slice(0, 10) + '.json';
                var filepath = downloads + '\\' + filename;

                // Use FSO with Unicode encoding
                var file = fso.CreateTextFile(filepath, true, true); // true = overwrite, true = unicode
                file.Write(JSON.stringify(emails, null, 2));
                file.Close();

                document.getElementById('exportProgress').style.display = 'none';
                document.getElementById('exportSuccess').style.display = 'block';
                var newCount = emails.length - (duplicatesWithReplies || 0);
                var msg = '<strong>' + newCount + ' neue Emails</strong> exportiert<br>';
                if (duplicatesWithReplies > 0) {
                    msg += '<strong>' + duplicatesWithReplies + ' Updates</strong> (mit neuen Antworten)<br>';
                }
                if (duplicatesSkipped > 0) {
                    msg += duplicatesSkipped + ' bereits in Excel<br>';
                }
                if (batchDuplicates > 0) {
                    msg += batchDuplicates + ' doppelt im Ordner (gleiche Konversation)<br>';
                }
                msg += (totalReplies || 0) + ' Antworten gefunden<br>';
                msg += 'Datei: <strong>' + filename + '</strong>';
                document.getElementById('exportSuccessMsg').innerHTML = msg;
                document.getElementById('exportActions').style.display = 'block';
                document.getElementById('exportBtn').disabled = false;

                // Store emails and show direct import button if Excel was connected
                lastExportedEmails = emails;
                if (exportWorkbook) {
                    document.getElementById('btnDirectImport').style.display = 'block';
                }
            } catch (e) {
                showExportError("Speichern fehlgeschlagen: " + e.message);
            }
        }

        // Direct import without web app (uses lastExportedEmails and exportWorkbook)
        function directImport() {
            if (!lastExportedEmails || lastExportedEmails.length === 0) {
                alert('Keine Emails zum Importieren!');
                return;
            }
            if (!exportWorkbook) {
                alert('Excel nicht verbunden!');
                return;
            }

            document.getElementById('exportActions').style.display = 'none';
            document.getElementById('exportProgress').style.display = 'block';
            document.getElementById('exportProgressText').innerText = 'Importiere direkt in Excel...';
            document.getElementById('exportProgressFill').style.width = '10%';

            setTimeout(function() {
                try {
                    var worksheet;
                    try {
                        worksheet = exportWorkbook.Worksheets("Übersicht");
                    } catch (e) {
                        worksheet = exportWorkbook.Worksheets(1);
                    }

                    var existingData = readExistingData(worksheet);
                    var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                    if (lastRow === 1 && !worksheet.Cells(1, 1).Value) lastRow = 0;
                    var nextRow = lastRow + 1;

                    var newCount = 0, updateCount = 0, skipCount = 0;

                    for (var i = 0; i < lastExportedEmails.length; i++) {
                        var email = lastExportedEmails[i];
                        var pct = 10 + Math.round((i / lastExportedEmails.length) * 85);
                        document.getElementById('exportProgressFill').style.width = pct + '%';

                        var emailKey = createEmailKey(email.datum, email.betreff);
                        var existingRow = existingData[emailKey];

                        if (existingRow) {
                            if (email.antworten && email.antworten.length > 0) {
                                var currentReplies = worksheet.Cells(existingRow, 13).Value || '';
                                var newRepliesText = formatReplies(email.antworten);
                                if (newRepliesText && currentReplies.indexOf(newRepliesText.substring(0, 50)) === -1) {
                                    // New replies go on TOP (newest first)
                                    var combinedReplies = currentReplies ? newRepliesText + '\n\n' + currentReplies : newRepliesText;
                                    worksheet.Cells(existingRow, 13).Value = combinedReplies;
                                    updateCount++;
                                } else {
                                    skipCount++;
                                }
                            } else {
                                skipCount++;
                            }
                        } else {
                            writeEmailRow(worksheet, nextRow, email);
                            existingData[emailKey] = nextRow;
                            nextRow++;
                            newCount++;
                        }
                    }

                    exportWorkbook.Save();
                    document.getElementById('exportProgressFill').style.width = '100%';

                    document.getElementById('exportProgress').style.display = 'none';
                    document.getElementById('exportSuccess').style.display = 'block';
                    document.getElementById('exportSuccessMsg').innerHTML =
                        '<strong>Direkt-Import erfolgreich!</strong><br>' +
                        '<strong>' + newCount + '</strong> neue Vorgänge<br>' +
                        '<strong>' + updateCount + '</strong> Antworten aktualisiert<br>' +
                        skipCount + ' übersprungen';
                    document.getElementById('exportActions').style.display = 'block';
                    document.getElementById('btnDirectImport').style.display = 'none';

                } catch (e) {
                    document.getElementById('exportProgress').style.display = 'none';
                    showExportError('Import fehlgeschlagen: ' + e.message);
                }
            }, 100);
        }

        function updateExportProgress(current, total, found) {
            document.getElementById('exportProgressFill').style.width = Math.round((current / total) * 100) + '%';
            document.getElementById('exportProgressText').innerText = 'Durchsuche ' + current + '/' + total + ' (' + found + ' gefunden)';
        }

        function showExportError(msg) {
            document.getElementById('exportProgress').style.display = 'none';
            document.getElementById('exportError').style.display = 'block';
            document.getElementById('exportErrorMsg').innerText = msg;
            document.getElementById('exportBtn').disabled = false;
        }

        function openWebApp() {
            var shell = new ActiveXObject("WScript.Shell");
            shell.Run('https://emailimport.pages.dev/');
        }

        function openDownloads() {
            var shell = new ActiveXObject("WScript.Shell");
            var shellApp = new ActiveXObject("Shell.Application");
            var downloads;
            try { downloads = shellApp.NameSpace("shell:Downloads").Self.Path; }
            catch (e) { downloads = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }
            shell.Run('explorer.exe "' + downloads + '"');
        }

        // ============================================================================
        // EXCEL IMPORT
        // ============================================================================
        var excelApp = null;
        var targetWorkbook = null;

        function selectJsonFile() {
            try {
                // Use Excel's FileDialog for file selection
                var tempExcel = null;
                try {
                    tempExcel = GetObject("", "Excel.Application");
                } catch (e) {
                    tempExcel = new ActiveXObject("Excel.Application");
                }

                var fd = tempExcel.FileDialog(3); // msoFileDialogFilePicker = 3
                fd.Title = "JSON-Datei auswahlen";
                fd.Filters.Clear();
                fd.Filters.Add("JSON Dateien", "*.json");
                fd.AllowMultiSelect = false;

                // Set initial folder to Downloads
                try {
                    var shellApp = new ActiveXObject("Shell.Application");
                    var downloads = shellApp.NameSpace("shell:Downloads").Self.Path;
                    fd.InitialFileName = downloads + "\\";
                } catch (e) {}

                if (fd.Show() === -1) {
                    var selectedPath = fd.SelectedItems.Item(1);
                    loadJsonFile(selectedPath);
                }
            } catch (e) {
                alert("Fehler beim Dateidialog: " + e.message + "\n\nBitte Pfad manuell eingeben.");
                var path = prompt("Pfad zur JSON-Datei:", "");
                if (path) loadJsonFile(path);
            }
        }

        function loadJsonFile(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) { alert("Datei nicht gefunden!"); return; }

                var content = '';
                var loaded = false;

                // Method 1: Try system default encoding (works for most UTF-8 files)
                if (!loaded) {
                    try {
                        var file = fso.OpenTextFile(path, 1, false, -2); // -2 = TristateUseDefault
                        content = file.ReadAll();
                        file.Close();
                        if (content.indexOf('[') >= 0 || content.indexOf('{') >= 0) loaded = true;
                    } catch (e) {}
                }

                // Method 2: Try ASCII
                if (!loaded) {
                    try {
                        var file = fso.OpenTextFile(path, 1, false, 0); // 0 = ASCII
                        content = file.ReadAll();
                        file.Close();
                        if (content.indexOf('[') >= 0 || content.indexOf('{') >= 0) loaded = true;
                    } catch (e) {}
                }

                // Method 3: Try Unicode (UTF-16) for files from this HTA
                if (!loaded) {
                    try {
                        var file = fso.OpenTextFile(path, 1, false, -1); // -1 = TristateTrue (Unicode)
                        content = file.ReadAll();
                        file.Close();
                        loaded = true;
                    } catch (e) {}
                }

                if (!loaded || !content) {
                    throw new Error("Datei konnte nicht gelesen werden");
                }

                // Remove BOM if present
                while (content.length > 0 && (content.charCodeAt(0) === 0xFEFF || content.charCodeAt(0) === 65279 ||
                       content.charCodeAt(0) === 0xFFFE || content.charCodeAt(0) === 0xEF)) {
                    content = content.substring(1);
                }

                // Find start of JSON
                var jsonStart = content.indexOf('[');
                if (jsonStart === -1) jsonStart = content.indexOf('{');
                if (jsonStart > 0) content = content.substring(jsonStart);

                jsonData = JSON.parse(content);

                var filename = path.substring(path.lastIndexOf("\\") + 1);
                document.getElementById('jsonPath').value = filename;

                var statusEl = document.getElementById('jsonStatus');
                statusEl.style.display = 'block';
                statusEl.className = 'status success';
                statusEl.innerHTML = '<strong>' + jsonData.length + ' Datensatze</strong> geladen';

                checkImportReady();
            } catch (e) {
                var statusEl = document.getElementById('jsonStatus');
                statusEl.style.display = 'block';
                statusEl.className = 'status error';
                statusEl.innerText = 'Fehler: ' + e.message;
            }
        }

        function detectExcel() {
            document.getElementById('excelStatus').value = "Suche Excel...";

            try {
                // Method 1: GetObject with empty string (preferred - connects to running Excel)
                try {
                    excelApp = GetObject("", "Excel.Application");
                } catch (e1) {
                    // Method 2: Create new ActiveXObject
                    excelApp = new ActiveXObject("Excel.Application");
                }

                excelApp.Visible = true;

                // Find Hypercare/Tracking workbook in open workbooks
                targetWorkbook = null;
                var allWorkbooks = [];

                for (var i = 1; i <= excelApp.Workbooks.Count; i++) {
                    try {
                        var wb = excelApp.Workbooks(i);
                        allWorkbooks.push(wb.Name);
                        var wbName = wb.Name.toLowerCase().replace(/[_\-\s]/g, '');
                        if (wbName.indexOf('hypercare') !== -1) {
                            targetWorkbook = wb;
                            break;
                        }
                    } catch (e) {}
                }

                // If not found, try to open from SharePoint
                if (!targetWorkbook) {
                    document.getElementById('excelStatus').value = "Offne SharePoint-Datei...";
                    var sharePointUrl = "https://barmeniagroup.sharepoint.com/sites/SAPUnity-WorkstreamICM/Freigegebene%20Dokumente/40%20Team%20Simulation,%20Kalibrierung,%20Verhandlung,%20Vertrag%20&%20EFM/Tracking_Hypercare.xlsm";
                    try {
                        targetWorkbook = excelApp.Workbooks.Open(sharePointUrl);
                    } catch (e) {
                        document.getElementById('excelStatus').value = "SharePoint-Datei konnte nicht geoffnet werden - bitte manuell offnen";
                        return;
                    }
                }

                if (targetWorkbook) {
                    document.getElementById('excelStatus').value = "OK: " + targetWorkbook.Name;
                    checkImportReady();
                } else {
                    document.getElementById('excelStatus').value = "Hypercare-Datei nicht gefunden";
                }
            } catch (e) {
                document.getElementById('excelStatus').value = "Fehler: " + e.message;
            }
        }

        function checkImportReady() {
            var ready = jsonData && jsonData.length > 0 && targetWorkbook;
            document.getElementById('importBtn').disabled = !ready;
        }

        function startImport() {
            var sheetName = document.getElementById('sheetName').value || "Übersicht";

            if (!jsonData || jsonData.length === 0) { alert("Keine JSON-Daten geladen!"); return; }
            if (!targetWorkbook) { alert("Keine Excel-Datei erkannt! Klicke 'Excel erkennen'."); return; }

            document.getElementById('importProgress').style.display = 'block';
            document.getElementById('importBtn').disabled = true;
            document.getElementById('importSuccess').style.display = 'none';
            document.getElementById('importError').style.display = 'none';

            setTimeout(function() { doImport(sheetName); }, 100);
        }

        function doImport(sheetName) {
            try {
                var worksheet;
                try {
                    worksheet = targetWorkbook.Worksheets(sheetName);
                } catch (e) {
                    // Sheet not found - list available sheets for user
                    var availableSheets = [];
                    for (var s = 1; s <= targetWorkbook.Worksheets.Count; s++) {
                        try { availableSheets.push(targetWorkbook.Worksheets(s).Name); } catch (ex) {}
                    }
                    throw new Error('Tabellenblatt "' + sheetName + '" nicht gefunden!\n\nVerfügbare Blätter: ' + availableSheets.join(', '));
                }

                // Read existing data for duplicate check
                document.getElementById('importProgressText').innerText = 'Lese bestehende Daten...';
                var existingData = readExistingData(worksheet);

                var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                if (lastRow === 1 && !worksheet.Cells(1, 1).Value) lastRow = 0;
                var nextRow = lastRow + 1;

                var total = jsonData.length;
                var newCount = 0;
                var skipCount = 0;
                var updateCount = 0;

                for (var i = 0; i < total; i++) {
                    var email = jsonData[i];
                    if (i % 3 === 0) {
                        updateImportProgress(i, total);
                        document.getElementById('importProgressText').innerText =
                            'Verarbeite ' + (i+1) + '/' + total + ' (Neu: ' + newCount + ', Aktualisiert: ' + updateCount + ', Übersprungen: ' + skipCount + ')';
                    }

                    // Create unique key from date + subject
                    var emailKey = createEmailKey(email.datum, email.betreff);
                    var existingRow = existingData[emailKey];

                    if (existingRow) {
                        // Email exists - check if we have new replies to add
                        if (email.antworten && email.antworten.length > 0) {
                            var currentReplies = worksheet.Cells(existingRow, 13).Value || '';  // Antwort = col 13
                            var newRepliesText = formatReplies(email.antworten);

                            // Only update if we have new content
                            if (newRepliesText && currentReplies.indexOf(newRepliesText.substring(0, 50)) === -1) {
                                // New replies go on TOP (newest first)
                                var combinedReplies = currentReplies ? newRepliesText + '\n\n' + currentReplies : newRepliesText;
                                worksheet.Cells(existingRow, 13).Value = combinedReplies;  // Antwort = col 13
                                updateCount++;
                            } else {
                                skipCount++;
                            }
                        } else {
                            skipCount++;
                        }
                    } else {
                        // New email - add to Excel
                        writeEmailRow(worksheet, nextRow, email);
                        // Add to existing data cache to prevent duplicates within same import
                        existingData[emailKey] = nextRow;
                        nextRow++;
                        newCount++;
                    }
                }

                updateImportProgress(total, total);
                targetWorkbook.Save();

                document.getElementById('importProgress').style.display = 'none';
                document.getElementById('importSuccess').style.display = 'block';
                document.getElementById('importSuccessMsg').innerHTML =
                    '<strong>' + newCount + '</strong> neue Vorgange importiert<br>' +
                    '<strong>' + updateCount + '</strong> Antworten aktualisiert<br>' +
                    '<strong>' + skipCount + '</strong> Duplikate ubersprungen';
                document.getElementById('importBtn').disabled = false;

            } catch (e) {
                document.getElementById('importProgress').style.display = 'none';
                document.getElementById('importError').style.display = 'block';
                document.getElementById('importErrorMsg').innerText = e.message;
                document.getElementById('importBtn').disabled = false;
            }
        }

        function updateImportProgress(current, total) {
            document.getElementById('importProgressFill').style.width = Math.round((current / total) * 100) + '%';
            document.getElementById('importProgressText').innerText = 'Importiere ' + current + '/' + total + '...';
        }

        // Read existing data from Excel for duplicate checking
        function readExistingData(worksheet) {
            var data = {};
            try {
                var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                if (lastRow <= 1) return data;

                // Read date (col 2) and subject (col 11) to create unique keys
                for (var row = 2; row <= lastRow; row++) {
                    var datum = worksheet.Cells(row, 2).Value || '';
                    var betreff = worksheet.Cells(row, 11).Value || '';  // Betreff = col 11

                    if (datum || betreff) {
                        var key = createEmailKey(datum, betreff);
                        data[key] = row;
                    }
                }
            } catch (e) {}
            return data;
        }

        // Create unique key from date and subject
        function createEmailKey(datum, betreff) {
            var dateStr = '';
            if (datum) {
                try {
                    var d = new Date(datum);
                    dateStr = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                } catch (e) {
                    dateStr = String(datum).substring(0, 10);
                }
            }
            var subjectStr = String(betreff || '').toLowerCase().trim().substring(0, 100);
            return dateStr + '|' + subjectStr;
        }

        // Format replies array to text (newest first, timestamps prominent)
        function formatReplies(antworten) {
            if (!antworten || antworten.length === 0) return '';

            // Sort by date descending (newest first)
            var sorted = [];
            for (var i = 0; i < antworten.length; i++) {
                sorted.push(antworten[i]);
            }
            sorted.sort(function(a, b) {
                var dateA = new Date(a.datum || 0);
                var dateB = new Date(b.datum || 0);
                return dateB - dateA;  // Descending
            });

            var text = '';
            for (var r = 0; r < sorted.length; r++) {
                var reply = sorted[r];
                // Prominent timestamp format
                text += '=== ' + (reply.datum || '') + ' ===\n' + (reply.text || '') + '\n\n';
            }
            return text.trim();
        }

        // Write a single email row to Excel
        // Columns: ID, Datum, Kanal, BD-Nummer, Agentur, Absender, Kategorie, Status, In Bearbeitung von,
        //          Cluster, Betreff, Anfrage, Antwort, Diagnose, Workaround, Nächste Schritte,
        //          Lösung, JIRA, Kommunikation, Kommentar, ConversationID (21 columns)
        function writeEmailRow(worksheet, row, email) {
            // Copy formatting from row above (if exists and row > 2)
            if (row > 2) {
                try {
                    var sourceRange = worksheet.Range(worksheet.Cells(row - 1, 1), worksheet.Cells(row - 1, 21));
                    var targetRange = worksheet.Range(worksheet.Cells(row, 1), worksheet.Cells(row, 21));
                    sourceRange.Copy();
                    targetRange.PasteSpecial(-4122); // xlPasteFormats = -4122
                    try { worksheet.Application.CutCopyMode = false; } catch(e) {}
                } catch (e) {
                    // Formatting copy failed, continue without it
                }
            }

            var repliesText = formatReplies(email.antworten);
            var pd = email.provisionData || {};

            // Absender: Bei Provisionsreklamation den Vermittlernamen nehmen
            var absender = email.von_name || email.von_email || '';
            if (pd.vorname_vermittler || pd.nachname_vermittler) {
                absender = ((pd.vorname_vermittler || '') + ' ' + (pd.nachname_vermittler || '')).trim();
            }
            absender = fixEncoding(absender);  // Fix encoding for names

            // Agentur mit Encoding-Fix
            var agentur = fixEncoding(email.agentur || '');

            // Anfrage/Zusammenfassung: User-edited content has priority
            var anfrage = '';
            if (email.anfrage && email.anfrage.trim()) {
                // User edited the summary in web app - use that
                anfrage = fixEncoding(email.anfrage);
            } else if (pd.nachricht) {
                // Provisionsreklamation: use nachricht field
                anfrage = fixEncoding(pd.nachricht);
            } else {
                // Fallback to original email text
                anfrage = fixEncoding(email.text || '');
            }

            // BD-Nummer: Aus provisionData oder email
            var bdNummer = pd.vermittlernummer_vermittler || email.vermittlernr || '';

            // Betreff mit Encoding-Fix
            var betreff = fixEncoding(email.betreff || '');

            // Apply fixEncoding to all text fields
            var kategorie = fixEncoding(email.kategorie || '');
            var status = fixEncoding(email.status || 'Neu');
            var clusters = fixEncoding((email.clusters || []).join(', '));
            var kommentar = fixEncoding(email.kommentar || '');
            var bearbeiter = '';
            try {
                bearbeiter = fixEncoding(String(email.bearbeiter || ''));
            } catch (e) {
                bearbeiter = '';
            }

            // Combine user's manual answer with automatic replies
            var antwortText = '';
            var userAntwort = fixEncoding(email.antwort || '');
            if (userAntwort && repliesText) {
                antwortText = userAntwort + '\n\n--- Gefundene Antworten ---\n\n' + repliesText;
            } else {
                antwortText = userAntwort || repliesText || '';
            }

            worksheet.Cells(row, 1).Value = 'HC-' + (row - 1);           // ID
            worksheet.Cells(row, 2).Value = email.datum || '';           // Datum
            worksheet.Cells(row, 3).Value = 'Email';                     // Kanal
            worksheet.Cells(row, 4).Value = bdNummer;                    // BD-Nummer
            worksheet.Cells(row, 5).Value = agentur;                     // Agentur
            worksheet.Cells(row, 6).Value = absender;                    // Absender
            worksheet.Cells(row, 7).Value = kategorie;                   // Kategorie
            worksheet.Cells(row, 8).Value = status;                      // Status
            worksheet.Cells(row, 9).Value = bearbeiter;                  // In Bearbeitung von
            worksheet.Cells(row, 10).Value = clusters;                   // Cluster
            worksheet.Cells(row, 11).Value = betreff;                    // Betreff
            worksheet.Cells(row, 12).Value = anfrage;                    // Anfrage
            worksheet.Cells(row, 13).Value = fixEncoding(antwortText);   // Antwort
            worksheet.Cells(row, 14).Value = '';                         // Diagnose
            worksheet.Cells(row, 15).Value = '';                         // Workaround
            worksheet.Cells(row, 16).Value = '';                         // Nächste Schritte
            worksheet.Cells(row, 17).Value = '';                         // Lösung
            worksheet.Cells(row, 18).Value = '';                         // JIRA
            worksheet.Cells(row, 19).Value = '';                         // Kommunikation
            worksheet.Cells(row, 20).Value = kommentar;                  // Kommentar
            worksheet.Cells(row, 21).Value = email.conversationId || ''; // ConversationID für Duplikatsprüfung
        }

        // Fix UTF-8 encoding issues (Ã¼ -> ü, ÃŸ -> ß, etc.)
        function fixEncoding(text) {
            if (!text) return '';
            // Use string split/join for reliable replacement in JScript
            var result = String(text);
            var replacements = [
                [String.fromCharCode(195, 164), String.fromCharCode(228)],  // Ã¤ -> ä
                [String.fromCharCode(195, 132), String.fromCharCode(196)],  // Ã„ -> Ä
                [String.fromCharCode(195, 182), String.fromCharCode(246)],  // Ã¶ -> ö
                [String.fromCharCode(195, 150), String.fromCharCode(214)],  // Ã– -> Ö
                [String.fromCharCode(195, 188), String.fromCharCode(252)],  // Ã¼ -> ü
                [String.fromCharCode(195, 156), String.fromCharCode(220)],  // Ãœ -> Ü
                [String.fromCharCode(195, 159), String.fromCharCode(223)],  // ÃŸ -> ß
                [String.fromCharCode(195, 169), String.fromCharCode(233)],  // Ã© -> é
                [String.fromCharCode(195, 168), String.fromCharCode(232)],  // Ã¨ -> è
                [String.fromCharCode(226, 130, 172), String.fromCharCode(8364)],  // € symbol
                [String.fromCharCode(226, 128, 158), String.fromCharCode(8222)],  // „
                [String.fromCharCode(226, 128, 156), String.fromCharCode(8220)],  // "
                [String.fromCharCode(226, 128, 152), String.fromCharCode(8216)],  // '
                [String.fromCharCode(226, 128, 153), String.fromCharCode(8217)],  // '
                [String.fromCharCode(226, 128, 147), String.fromCharCode(8211)],  // –
                [String.fromCharCode(226, 128, 148), String.fromCharCode(8212)],  // —
                [String.fromCharCode(226, 128, 166), String.fromCharCode(8230)]   // …
            ];
            for (var i = 0; i < replacements.length; i++) {
                result = result.split(replacements[i][0]).join(replacements[i][1]);
            }
            return result;
        }

        // JSON polyfill
        if (!window.JSON) {
            window.JSON = {
                stringify: function(obj, rep, space) {
                    var t = typeof obj;
                    if (t !== 'object' || obj === null) {
                        if (t === 'string') obj = '"' + obj.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r') + '"';
                        return String(obj);
                    }
                    var n, v, json = [], arr = (obj && obj.constructor === Array);
                    for (n in obj) {
                        v = obj[n]; t = typeof v;
                        if (t === 'string') v = '"' + v.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r') + '"';
                        else if (t === 'object' && v !== null) v = JSON.stringify(v);
                        else if (t === 'undefined') continue;
                        json.push((arr ? '' : '"' + n + '":') + String(v));
                    }
                    return (arr ? '[' : '{') + String(json) + (arr ? ']' : '}');
                },
                parse: function(text) { return eval('(' + text + ')'); }
            };
        }
    </script>
</body>
</html>
