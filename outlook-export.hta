<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <title>BGAV Hypercare Tool</title>
    <HTA:APPLICATION
        ID="BGAV_Hypercare"
        APPLICATIONNAME="BGAV Hypercare Tool"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="2.0"
        WINDOWSTATE="normal"
    />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 1.5rem;
        }
        .container { max-width: 600px; margin: 0 auto; }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .tab {
            flex: 1;
            padding: 0.75rem 1rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px 8px 0 0;
            color: #94a3b8;
            cursor: pointer;
            text-align: center;
            font-weight: 500;
            transition: all 0.2s;
        }
        .tab:hover { background: rgba(255,255,255,0.1); }
        .tab.active {
            background: rgba(30, 30, 50, 0.9);
            border-bottom-color: transparent;
            color: #f1f5f9;
        }

        .card {
            background: rgba(30, 30, 50, 0.9);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 0 0 16px 16px;
            padding: 1.5rem;
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .header { text-align: center; margin-bottom: 1.5rem; }
        .logo {
            width: 50px; height: 50px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 0.75rem;
            font-size: 1.25rem;
        }
        .logo-export { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .logo-import { background: linear-gradient(135deg, #10b981, #059669); }
        h2 { font-size: 1.25rem; margin-bottom: 0.25rem; }
        .subtitle { color: #94a3b8; font-size: 0.8125rem; }

        label {
            display: block; margin-bottom: 0.375rem;
            font-weight: 500; color: #94a3b8; font-size: 0.8125rem;
        }
        select, input {
            width: 100%; padding: 0.625rem 0.875rem;
            background: #252542; border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px; color: #f1f5f9; font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }
        select:focus, input:focus { outline: none; border-color: #6366f1; }

        .btn {
            width: 100%; padding: 0.75rem; border: none; border-radius: 6px;
            font-size: 0.9375rem; font-weight: 600; cursor: pointer;
            transition: all 0.2s; margin-bottom: 0.5rem;
        }
        .btn-primary { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; }
        .btn-success { background: linear-gradient(135deg, #10b981, #059669); color: white; }
        .btn-secondary { background: #252542; color: #94a3b8; border: 1px solid rgba(255,255,255,0.1); }
        .btn:hover:not(:disabled):not(.btn-inactive-step) { transform: translateY(-1px); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        /* Active step button - pulsing highlight */
        .btn-active-step {
            animation: btnPulse 2s ease-in-out infinite;
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.5);
            position: relative;
        }
        .btn-active-step::before {
            content: '►';
            position: absolute;
            left: 0.75rem;
            animation: arrowBounce 1s ease-in-out infinite;
        }
        @keyframes btnPulse {
            0%, 100% { box-shadow: 0 0 10px rgba(99, 102, 241, 0.4); }
            50% { box-shadow: 0 0 25px rgba(99, 102, 241, 0.7); }
        }
        @keyframes arrowBounce {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(5px); }
        }

        /* Inactive step button - grayed out */
        .btn-inactive-step {
            opacity: 0.35 !important;
            cursor: not-allowed !important;
            transform: none !important;
            filter: grayscale(100%);
        }

        /* Active select - pulsing border */
        .select-active-step {
            animation: selectPulse 2s ease-in-out infinite;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
        }
        @keyframes selectPulse {
            0%, 100% { box-shadow: 0 0 8px rgba(99, 102, 241, 0.3); border-color: #6366f1; }
            50% { box-shadow: 0 0 20px rgba(99, 102, 241, 0.6); border-color: #818cf8; }
        }

        /* Inactive select */
        .select-inactive-step {
            opacity: 0.35 !important;
        }

        .progress-container { display: none; margin: 1rem 0; }
        .progress-bar {
            height: 6px; background: #252542;
            border-radius: 3px; overflow: hidden; margin-bottom: 0.5rem;
        }
        .progress-fill {
            height: 100%; border-radius: 3px; width: 0%; transition: width 0.3s;
        }
        .progress-fill.export { background: linear-gradient(90deg, #6366f1, #818cf8); }
        .progress-fill.import { background: linear-gradient(90deg, #10b981, #34d399); }
        .progress-text { font-size: 0.8125rem; color: #94a3b8; text-align: center; }

        .status { padding: 0.75rem; border-radius: 6px; margin-top: 0.75rem; display: none; font-size: 0.875rem; }
        .status.success { background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #10b981; }
        .status.error { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ef4444; }

        .action-buttons { display: none; margin-top: 0.75rem; }
        .action-buttons .btn { margin-bottom: 0.375rem; }

        .info-box {
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 6px; padding: 0.75rem; margin-top: 1rem;
            font-size: 0.75rem; color: #94a3b8;
        }
        .info-box strong { color: #818cf8; }

        .row { display: flex; gap: 0.75rem; }
        .row > * { flex: 1; }

        /* Step Indicator Styles */
        .step-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        .step-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
            opacity: 0.4;
            transition: all 0.3s ease;
            position: relative;
        }
        .step-circle.step-1 { background: #FFB5BA; } /* Pastel Pink */
        .step-circle.step-2 { background: #FFDAB3; } /* Pastel Orange */
        .step-circle.step-3 { background: #B5EAD7; } /* Pastel Green */
        .step-circle.step-4 { background: #C7CEEA; } /* Pastel Blue */
        .step-circle.step-5 { background: #E2B6CF; } /* Pastel Purple */

        .step-circle.active {
            opacity: 1;
            transform: scale(1.15);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
            animation: stepPulse 1.5s ease-in-out infinite;
        }
        .step-circle.completed {
            opacity: 0.8;
            transform: scale(1);
        }
        .step-circle.completed::after {
            content: '\2713';
            position: absolute;
            bottom: -4px;
            right: -4px;
            width: 20px;
            height: 20px;
            background: #10b981;
            border-radius: 50%;
            font-size: 0.75rem;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .step-arrow {
            color: #4a5568;
            font-size: 1.25rem;
            opacity: 0.5;
        }
        .step-label {
            font-size: 0.65rem;
            color: #94a3b8;
            text-align: center;
            margin-top: 0.25rem;
            max-width: 60px;
            line-height: 1.1;
        }
        .step-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @keyframes stepPulse {
            0%, 100% {
                box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
                transform: scale(1.15);
            }
            50% {
                box-shadow: 0 0 25px rgba(255, 255, 255, 0.5);
                transform: scale(1.2);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="tabs">
            <div class="tab active" onclick="switchTab('export')">&#128229; Outlook Export</div>
            <div class="tab" onclick="switchTab('import')">&#128200; Excel Import</div>
        </div>

        <div class="card">
            <!-- TAB 1: OUTLOOK EXPORT -->
            <div class="tab-content active" id="tabExport">
                <div class="header">
                    <div class="logo logo-export">&#9993;</div>
                    <h2>Emails aus Outlook exportieren</h2>
                    <p class="subtitle">Emails der letzten Tage als JSON speichern</p>
                </div>

                <!-- Step Indicator -->
                <div class="step-indicator" id="stepIndicator">
                    <div class="step-wrapper">
                        <div class="step-circle step-1 active" id="step1">1</div>
                        <div class="step-label">Excel verbinden</div>
                    </div>
                    <span class="step-arrow">&#10140;</span>
                    <div class="step-wrapper">
                        <div class="step-circle step-2" id="step2">2</div>
                        <div class="step-label">Postfach auswählen</div>
                    </div>
                    <span class="step-arrow">&#10140;</span>
                    <div class="step-wrapper">
                        <div class="step-circle step-3" id="step3">3</div>
                        <div class="step-label">Emails exportieren</div>
                    </div>
                    <span class="step-arrow">&#10140;</span>
                    <div class="step-wrapper">
                        <div class="step-circle step-4" id="step4">4</div>
                        <div class="step-label">Web-App</div>
                    </div>
                    <span class="step-arrow">&#10140;</span>
                    <div class="step-wrapper">
                        <div class="step-circle step-5" id="step5">5</div>
                        <div class="step-label">Excel Import</div>
                    </div>
                </div>

                <label>Postfach</label>
                <select id="mailboxSelect" onchange="loadFolders()">
                    <option value="">-- Postfach wahlen --</option>
                </select>

                <label>Ordner</label>
                <select id="folderSelect" disabled>
                    <option value="">-- Erst Postfach wahlen --</option>
                </select>

                <label>Zeitraum (Tage)</label>
                <input type="number" id="daysInput" value="7" min="1" max="30">

                <label>Excel verbinden (Pflicht)</label>
                <div class="row">
                    <input type="text" id="exportExcelStatus" readonly placeholder="Tracking_Hypercare.xlsm öffnen, dann verbinden" style="flex:1">
                </div>
                <button class="btn btn-primary" id="btnExcelConnect" onclick="detectExcelForExport()" style="margin-bottom:0.75rem;">
                    &#128269; Excel verbinden
                </button>

                <label>Emails exportieren</label>
                <button class="btn btn-success" id="exportBtn" onclick="startExport()" disabled>
                    &#128229; Emails exportieren
                </button>

                <div class="progress-container" id="exportProgress">
                    <div class="progress-bar"><div class="progress-fill export" id="exportProgressFill"></div></div>
                    <div class="progress-text" id="exportProgressText">Exportiere...</div>
                </div>

                <div class="status success" id="exportSuccess">
                    <strong>&#10003; Export erfolgreich!</strong><br>
                    <span id="exportSuccessMsg"></span>
                </div>
                <div class="status error" id="exportError"><span id="exportErrorMsg"></span></div>

                <div class="action-buttons" id="exportActions">
                    <button class="btn btn-success" id="btnWebApp" onclick="openWebApp()">&#127760; Web-App öffnen (bearbeiten)</button>
                    <button class="btn btn-secondary" onclick="openDownloads()">&#128193; Downloads öffnen</button>
                </div>

                <div class="info-box">
                    <strong>Workflow:</strong> Siehe Schritte oben - die Kreise zeigen den aktuellen Schritt
                </div>
            </div>

            <!-- TAB 2: EXCEL IMPORT -->
            <div class="tab-content" id="tabImport">
                <div class="header">
                    <div class="logo logo-import">&#128200;</div>
                    <h2>In Excel importieren</h2>
                    <p class="subtitle">Bearbeitete JSON in Hypercare-Excel schreiben</p>
                </div>

                <label>JSON-Datei (wird automatisch geladen)</label>
                <div class="row">
                    <input type="text" id="jsonPath" readonly placeholder="Lade hypercare_bearbeitet_heute.json..." style="flex:3">
                    <button class="btn btn-secondary" onclick="selectJsonFile()" style="flex:1; margin-bottom:0.75rem;">Andere...</button>
                </div>

                <div class="status" id="jsonStatus" style="display:none; margin-bottom:0.75rem;"></div>

                <label>Excel-Ziel (vom Export übernommen)</label>
                <div class="row">
                    <input type="text" id="excelStatus" readonly placeholder="Wird vom Export übernommen..." style="flex:1">
                </div>
                <button class="btn btn-secondary" onclick="detectExcel()" style="margin-bottom:0.75rem;">
                    &#128269; Andere Excel
                </button>

                <label>Tabellenblatt</label>
                <input type="text" id="sheetName" value="Übersicht">

                <button class="btn btn-success" id="btnImport" onclick="startImport()" disabled>
                    &#128200; In Excel importieren
                </button>

                <div class="progress-container" id="importProgress">
                    <div class="progress-bar"><div class="progress-fill import" id="importProgressFill"></div></div>
                    <div class="progress-text" id="importProgressText">Importiere...</div>
                </div>

                <div class="status success" id="importSuccess">
                    <strong>&#10003; Import erfolgreich!</strong><br>
                    <span id="importSuccessMsg"></span>
                </div>
                <div class="status error" id="importError"><span id="importErrorMsg"></span></div>

                <div class="info-box">
                    <strong>Hinweis:</strong> Offne zuerst die Tracking_Hypercare.xlsm in Excel, dann klicke "Excel erkennen"
                </div>
            </div>
        </div>
    </div>

    <script>
        var outlookApp = null;
        var namespace = null;
        var selectedStore = null;
        var jsonData = null;

        // Excel connection for duplicate checking during export
        var exportExcelApp = null;
        var exportWorkbook = null;
        var existingEmailKeys = {};  // Keys of emails already in Excel
        var existingReplies = {};    // Existing replies text per email key (for filtering new replies)
        var existingEmailIds = {};   // EmailIDs (EntryIDs) already in Excel - for precise duplicate detection
        var existingReplyIds = {};   // ReplyIDs per email key - comma-separated EntryIDs of already imported replies
        var existingAnfragen = {};   // Original request text per conversation (to avoid duplicating)
        var existingDates = {};      // Original request date per conversation
        var existingSubjects = {};   // Original subject per conversation
        var existingExcelRows = {};  // ConversationID → row number mapping (for auto-erledigt)
        var foundInInbox = {};       // Track which ConversationIDs were found in Inbox
        var lastExportedEmails = null;  // Store for direct import

        // Step tracking
        var currentStep = 1;
        var completedSteps = {};

        // Update step indicator UI and button states
        function updateStepIndicator(stepNumber, markCompleted) {
            // Mark the specified step as completed if requested
            if (markCompleted && stepNumber > 0 && stepNumber <= 5) {
                completedSteps[stepNumber] = true;
            }

            // Update all step circles
            for (var i = 1; i <= 5; i++) {
                var stepEl = document.getElementById('step' + i);
                if (stepEl) {
                    // Remove all state classes
                    stepEl.className = 'step-circle step-' + i;

                    if (completedSteps[i]) {
                        stepEl.className += ' completed';
                    }
                    if (i === currentStep && !completedSteps[i]) {
                        stepEl.className += ' active';
                    }
                }
            }

            // Update button/select states based on current step
            updateButtonStates();
        }

        // Update button states based on current step
        function updateButtonStates() {
            // Step 1: Excel verbinden
            var btnExcel = document.getElementById('btnExcelConnect');
            // Step 2: Postfach auswählen
            var selectMailbox = document.getElementById('mailboxSelect');
            var selectFolder = document.getElementById('folderSelect');
            // Step 3: Emails exportieren
            var btnExport = document.getElementById('exportBtn');
            // Step 4: Web-App öffnen
            var btnWebApp = document.getElementById('btnWebApp');
            // Step 5: In Excel importieren
            var btnImport = document.getElementById('btnImport');

            // Remove all step classes first
            var allElements = [btnExcel, selectMailbox, selectFolder, btnExport, btnWebApp, btnImport];
            for (var i = 0; i < allElements.length; i++) {
                if (allElements[i]) {
                    allElements[i].className = allElements[i].className
                        .replace(/\s*btn-active-step/g, '')
                        .replace(/\s*btn-inactive-step/g, '')
                        .replace(/\s*select-active-step/g, '')
                        .replace(/\s*select-inactive-step/g, '');
                }
            }

            // Step 1: Excel verbinden
            if (currentStep === 1 && !completedSteps[1]) {
                if (btnExcel) btnExcel.className += ' btn-active-step';
                if (selectMailbox) selectMailbox.className += ' select-inactive-step';
                if (btnExport) btnExport.className += ' btn-inactive-step';
            } else if (completedSteps[1]) {
                // Step 1 completed - gray out the button (already connected)
                if (btnExcel) btnExcel.className += ' btn-inactive-step';
            } else {
                if (btnExcel) btnExcel.className += ' btn-inactive-step';
            }

            // Step 2: Postfach/Ordner auswählen
            if (currentStep === 2 && !completedSteps[2]) {
                if (selectMailbox) selectMailbox.className += ' select-active-step';
                if (selectFolder) selectFolder.className += ' select-active-step';
                if (btnExport) btnExport.className += ' btn-inactive-step';
            } else if (completedSteps[2]) {
                // Step 2 completed - gray out selects
                if (selectMailbox) selectMailbox.className += ' select-inactive-step';
                if (selectFolder) selectFolder.className += ' select-inactive-step';
            } else {
                if (selectMailbox) selectMailbox.className += ' select-inactive-step';
                if (selectFolder) selectFolder.className += ' select-inactive-step';
            }

            // Step 3: Emails exportieren
            if (currentStep === 3 && !completedSteps[3]) {
                if (btnExport) btnExport.className += ' btn-active-step';
            } else if (completedSteps[3]) {
                // Step 3 completed - gray out export button
                if (btnExport) btnExport.className += ' btn-inactive-step';
            } else {
                if (btnExport) btnExport.className += ' btn-inactive-step';
            }

            // Step 4: Web-App öffnen
            if (currentStep === 4 && !completedSteps[4]) {
                if (btnWebApp) btnWebApp.className += ' btn-active-step';
            } else if (completedSteps[4]) {
                // Step 4 completed - gray out web app button
                if (btnWebApp) btnWebApp.className += ' btn-inactive-step';
            }

            // Step 5: In Excel importieren
            if (currentStep === 5 && !completedSteps[5]) {
                if (btnImport) btnImport.className += ' btn-active-step';
            } else if (completedSteps[5]) {
                // Step 5 completed - gray out import button
                if (btnImport) btnImport.className += ' btn-inactive-step';
            } else {
                if (btnImport) btnImport.className += ' btn-inactive-step';
            }
        }

        // Advance to next step
        function advanceToStep(stepNumber) {
            if (stepNumber > currentStep) {
                currentStep = stepNumber;
                updateStepIndicator(0, false);
            }
        }

        // Complete a step and advance to next
        function completeStep(stepNumber) {
            completedSteps[stepNumber] = true;
            if (stepNumber >= currentStep && stepNumber < 5) {
                currentStep = stepNumber + 1;
            }
            updateStepIndicator(stepNumber, true);
        }

        // ============================================================================
        // INITIALIZATION
        // ============================================================================
        window.onload = function() {
            initOutlook();
            // Initialize button states
            updateButtonStates();
        };

        function switchTab(tab) {
            var tabs = document.getElementsByClassName('tab');
            for (var i = 0; i < tabs.length; i++) {
                tabs[i].className = 'tab' + (i === (tab === 'export' ? 0 : 1) ? ' active' : '');
            }
            document.getElementById('tabExport').className = 'tab-content' + (tab === 'export' ? ' active' : '');
            document.getElementById('tabImport').className = 'tab-content' + (tab === 'import' ? ' active' : '');

            // When switching to import tab, advance to step 5 if step 4 is completed
            if (tab === 'import' && completedSteps[4]) {
                currentStep = 5;
                updateStepIndicator(0, false);
            }

            // If switching to import and Excel was already connected during export, reuse it
            if (tab === 'import' && exportWorkbook && !targetWorkbook) {
                try {
                    // Test if Excel connection is still valid
                    var testName = exportWorkbook.Name;
                    excelApp = exportExcelApp;
                    targetWorkbook = exportWorkbook;
                    document.getElementById('excelStatus').value = "OK: " + testName + " (vom Export übernommen)";
                    checkImportReady();
                } catch (e) {
                    // Excel connection lost - reset
                    exportWorkbook = null;
                    exportExcelApp = null;
                    document.getElementById('excelStatus').value = "Excel-Verbindung verloren - bitte neu verbinden";
                }
            }

            // Auto-load today's JSON file when switching to import tab
            if (tab === 'import' && !jsonData) {
                autoLoadTodayJson();
            }
        }

        // Auto-load today's bearbeitet JSON file
        function autoLoadTodayJson() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var shellApp = new ActiveXObject("Shell.Application");
                var fso = new ActiveXObject("Scripting.FileSystemObject");

                var downloads;
                try { downloads = shellApp.NameSpace("shell:Downloads").Self.Path; }
                catch (e) { downloads = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }

                // Build today's filename
                var today = new Date();
                var dateStr = today.getFullYear() + '-' +
                    (today.getMonth() + 1 < 10 ? '0' : '') + (today.getMonth() + 1) + '-' +
                    (today.getDate() < 10 ? '0' : '') + today.getDate();
                var expectedFile = downloads + '\\hypercare_bearbeitet_' + dateStr + '.json';

                if (fso.FileExists(expectedFile)) {
                    loadJsonFile(expectedFile);
                }
            } catch (e) {
                // Silently fail - user can manually browse
            }
        }

        // ============================================================================
        // OUTLOOK EXPORT
        // ============================================================================
        function initOutlook() {
            try {
                outlookApp = new ActiveXObject("Outlook.Application");
                namespace = outlookApp.GetNamespace("MAPI");
                loadMailboxes();
            } catch (e) {
                showExportError("Outlook nicht gefunden: " + e.message);
            }
        }

        function loadMailboxes() {
            var select = document.getElementById('mailboxSelect');
            select.innerHTML = '<option value="">-- Postfach wahlen --</option>';
            try {
                var stores = namespace.Stores;
                for (var i = 1; i <= stores.Count; i++) {
                    try {
                        var store = stores.Item(i);
                        var option = document.createElement('option');
                        option.value = i;
                        option.text = store.DisplayName;
                        select.appendChild(option);
                    } catch (e) {}
                }
            } catch (e) {}
        }

        function loadFolders() {
            var mailboxSelect = document.getElementById('mailboxSelect');
            var folderSelect = document.getElementById('folderSelect');
            var exportBtn = document.getElementById('exportBtn');

            if (!mailboxSelect.value) {
                folderSelect.innerHTML = '<option value="">-- Erst Postfach wahlen --</option>';
                folderSelect.disabled = true;
                exportBtn.disabled = true;
                return;
            }

            try {
                selectedStore = namespace.Stores.Item(parseInt(mailboxSelect.value));
                var rootFolder = selectedStore.GetRootFolder();
                folderSelect.innerHTML = '';

                try {
                    var inbox = selectedStore.GetDefaultFolder(6);
                    var option = document.createElement('option');
                    option.value = 'inbox';
                    option.text = 'Posteingang (' + inbox.Items.Count + ')';
                    folderSelect.appendChild(option);
                } catch (e) {}

                addSubfolders(rootFolder.Folders, folderSelect, '');
                folderSelect.disabled = false;
                checkExportReady();

                // Step 2 completed - Mailbox selected
                completeStep(2);
            } catch (e) {
                showExportError("Fehler: " + e.message);
            }
        }

        function addSubfolders(folders, select, prefix) {
            for (var i = 1; i <= folders.Count; i++) {
                try {
                    var folder = folders.Item(i);
                    if (folder.DefaultItemType === 0) {
                        var option = document.createElement('option');
                        option.value = folder.EntryID;
                        option.text = prefix + folder.Name + ' (' + folder.Items.Count + ')';
                        select.appendChild(option);
                        if (folder.Folders.Count > 0) {
                            addSubfolders(folder.Folders, select, prefix + '  ');
                        }
                    }
                } catch (e) {}
            }
        }

        // ============================================================================
        // EXCEL CONNECTION FOR DUPLICATE CHECK
        // ============================================================================

        // Check if export can be started (folder selected AND Excel connected)
        function checkExportReady() {
            var folderSelected = document.getElementById('folderSelect').value !== '';
            var excelConnected = exportWorkbook !== null;
            var btn = document.getElementById('exportBtn');

            if (folderSelected && excelConnected) {
                btn.disabled = false;
                btn.innerHTML = '&#128229; Emails exportieren';
            } else if (folderSelected && !excelConnected) {
                btn.disabled = true;
                btn.innerHTML = '&#128229; Erst Excel verbinden!';
            } else {
                btn.disabled = true;
                btn.innerHTML = '&#128229; Emails exportieren';
            }
        }

        function detectExcelForExport() {
            document.getElementById('exportExcelStatus').value = "Suche Excel...";
            existingEmailKeys = {};
            existingReplies = {};
            existingEmailIds = {};
            existingReplyIds = {};
            existingAnfragen = {};
            existingDates = {};
            existingSubjects = {};
            existingExcelRows = {};
            foundInInbox = {};

            try {
                // Try to connect to running Excel
                try {
                    exportExcelApp = GetObject("", "Excel.Application");
                } catch (e1) {
                    exportExcelApp = new ActiveXObject("Excel.Application");
                }
                exportExcelApp.Visible = true;

                // Find Hypercare workbook
                exportWorkbook = null;
                for (var i = 1; i <= exportExcelApp.Workbooks.Count; i++) {
                    try {
                        var wb = exportExcelApp.Workbooks(i);
                        var wbName = wb.Name.toLowerCase().replace(/[_\-\s]/g, '');
                        if (wbName.indexOf('hypercare') !== -1) {
                            exportWorkbook = wb;
                            break;
                        }
                    } catch (e) {}
                }

                if (!exportWorkbook) {
                    // Try SharePoint
                    document.getElementById('exportExcelStatus').value = "Offne SharePoint-Datei...";
                    var sharePointUrl = "https://barmeniagroup.sharepoint.com/sites/SAPUnity-WorkstreamICM/Freigegebene%20Dokumente/40%20Team%20Simulation,%20Kalibrierung,%20Verhandlung,%20Vertrag%20&%20EFM/Tracking_Hypercare.xlsm";
                    try {
                        exportWorkbook = exportExcelApp.Workbooks.Open(sharePointUrl);
                    } catch (e) {
                        document.getElementById('exportExcelStatus').value = "Excel nicht gefunden - Duplikate werden nicht gefiltert";
                        return;
                    }
                }

                // Read existing data from Excel
                document.getElementById('exportExcelStatus').value = "Lese bestehende Einträge...";
                var worksheet;
                try {
                    worksheet = exportWorkbook.Worksheets("Übersicht");
                } catch (e) {
                    worksheet = exportWorkbook.Worksheets(1);
                }

                var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                var count = 0;

                // Read ConversationID (col 22), date (col 2), subject (col 12), replies (col 14),
                // emailId (col 23), replyIds (col 24), status (col 9) for duplicate detection
                for (var row = 2; row <= lastRow; row++) {
                    var conversationId = worksheet.Cells(row, 22).Value || '';
                    var datum = worksheet.Cells(row, 2).Value || '';
                    var betreff = worksheet.Cells(row, 12).Value || '';
                    var antworten = worksheet.Cells(row, 14).Value || '';  // Existing replies
                    var emailId = worksheet.Cells(row, 23).Value || '';    // Email's unique EntryID
                    var replyIds = worksheet.Cells(row, 24).Value || '';   // Comma-separated reply EntryIDs
                    var anfrage = worksheet.Cells(row, 13).Value || '';    // Original request text
                    var status = worksheet.Cells(row, 9).Value || '';      // Current status

                    // Primary key: ConversationID ONLY (new emails in same conversation are replies!)
                    if (conversationId) {
                        var convKey = 'conv|' + conversationId;
                        existingEmailKeys[convKey] = true;
                        if (antworten) existingReplies[convKey] = antworten;
                        if (replyIds) existingReplyIds[convKey] = replyIds;
                        if (anfrage) existingAnfragen[convKey] = anfrage;  // Track original request
                        if (datum) existingDates[convKey] = datum;  // Track original date
                        if (betreff) existingSubjects[convKey] = betreff;  // Track original subject
                        // Track row for auto-erledigt (only if not already erledigt)
                        if (status.toLowerCase() !== 'erledigt') {
                            existingExcelRows[conversationId] = row;
                        }
                    }
                    // Fallback key: date + subject (for older entries without ConversationID)
                    if (datum || betreff) {
                        var key = createExportEmailKey(datum, betreff);
                        existingEmailKeys[key] = true;
                        if (antworten) existingReplies[key] = antworten;
                        if (replyIds) existingReplyIds[key] = replyIds;
                        if (anfrage) existingAnfragen[key] = anfrage;  // Also track for fallback
                        if (datum) existingDates[key] = datum;  // Also track for fallback
                        if (betreff) existingSubjects[key] = betreff;  // Also track for fallback
                    }
                    // Track emailId for precise duplicate detection
                    if (emailId) {
                        existingEmailIds[emailId] = true;
                    }
                    if (conversationId || datum || betreff) count++;
                }

                document.getElementById('exportExcelStatus').value = "OK: " + exportWorkbook.Name + " (" + count + " Einträge)";
                checkExportReady();

                // Step 1 completed - Excel connected
                completeStep(1);

            } catch (e) {
                document.getElementById('exportExcelStatus').value = "Fehler: " + e.message;
                existingEmailKeys = {};
                existingEmailIds = {};
                existingReplyIds = {};
                existingAnfragen = {};
                existingDates = {};
                existingSubjects = {};
                existingExcelRows = {};
                foundInInbox = {};
                exportWorkbook = null;
                checkExportReady();
            }
        }

        function formatDateKey(datum) {
            try {
                var d;
                if (typeof datum === 'number') {
                    d = new Date((datum - 25569) * 86400 * 1000);
                } else {
                    d = new Date(datum);
                }
                if (!isNaN(d.getTime())) {
                    return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                }
            } catch (e) {}
            return String(datum).substring(0, 10);
        }

        function normalizeSubject(betreff) {
            var subjectStr = String(betreff || '').toLowerCase().trim();
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            return subjectStr.substring(0, 100);
        }

        function createExportEmailKey(datum, betreff) {
            var dateStr = '';
            if (datum) {
                try {
                    var d;
                    // Handle Excel serial number (days since 1899-12-30)
                    if (typeof datum === 'number') {
                        d = new Date((datum - 25569) * 86400 * 1000);
                    } else {
                        d = new Date(datum);
                    }
                    // Check if valid date
                    if (!isNaN(d.getTime())) {
                        dateStr = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                    } else {
                        dateStr = String(datum).substring(0, 10);
                    }
                } catch (e) {
                    dateStr = String(datum).substring(0, 10);
                }
            }
            // Normalize subject: lowercase, remove RE:/AW:/FW:/WG: prefixes
            var subjectStr = String(betreff || '').toLowerCase().trim();
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, '');
            subjectStr = subjectStr.replace(/^(re|aw|fw|wg|fwd|antwort|antw):\s*/gi, ''); // Remove twice for RE: RE:
            subjectStr = subjectStr.substring(0, 100);
            return dateStr + '|' + subjectStr;
        }

        function startExport() {
            var folderId = document.getElementById('folderSelect').value;
            var days = parseInt(document.getElementById('daysInput').value) || 7;

            if (!folderId) { alert('Bitte Ordner auswahlen!'); return; }

            document.getElementById('exportProgress').style.display = 'block';
            document.getElementById('exportBtn').disabled = true;
            document.getElementById('exportSuccess').style.display = 'none';
            document.getElementById('exportError').style.display = 'none';
            document.getElementById('exportActions').style.display = 'none';

            setTimeout(function() { doExport(folderId, days); }, 100);
        }

        var sentItemsCache = [];
        var sentItemsByConvId = {};  // Lookup map for O(1) access by ConversationID

        // Export state for async processing
        var exportState = {
            items: null,
            emails: [],
            total: 0,
            current: 0,
            oldCount: 0,
            repliesFound: 0,
            duplicatesSkipped: 0,
            duplicatesWithReplies: 0,
            cutoffDate: null
        };

        // Format date for Outlook Restrict() filter (mm/dd/yyyy format)
        function formatDateForRestrict(date) {
            var d = new Date(date);
            var month = d.getMonth() + 1;
            var day = d.getDate();
            var year = d.getFullYear();
            return month + '/' + day + '/' + year;
        }

        function doExport(folderId, days) {
            try {
                // Phase 1: Get folder
                document.getElementById('exportProgressText').innerText = 'Phase 1/3: Ordner wird geladen...';
                document.getElementById('exportProgressFill').style.width = '5%';

                var folder = (folderId === 'inbox') ? selectedStore.GetDefaultFolder(6) : namespace.GetFolderFromID(folderId);

                // Calculate cutoff date
                exportState.cutoffDate = new Date();
                exportState.cutoffDate.setDate(exportState.cutoffDate.getDate() - days);

                // Use Restrict() to filter emails at the Outlook server level (MUCH faster)
                var dateFilter = "[ReceivedTime] >= '" + formatDateForRestrict(exportState.cutoffDate) + "'";
                try {
                    exportState.items = folder.Items.Restrict(dateFilter);
                } catch (restrictErr) {
                    // Fallback to all items if Restrict fails
                    exportState.items = folder.Items;
                }
                try { exportState.items.Sort("[ReceivedTime]", true); } catch (e) {}

                exportState.emails = [];
                exportState.total = Math.min(exportState.items.Count, 500);
                exportState.current = 1;
                exportState.oldCount = 0;
                exportState.repliesFound = 0;
                exportState.duplicatesSkipped = 0;      // Duplicates from Excel
                exportState.batchDuplicates = 0;        // Duplicates within same export batch
                exportState.duplicatesWithReplies = 0;
                exportState.processedConvIds = {};  // Track ConversationIDs already processed in this export

                // Phase 2: Cache sent items (async - will start Phase 3 when done)
                document.getElementById('exportProgressText').innerText = 'Phase 2/3: Lade gesendete Emails...';
                document.getElementById('exportProgressFill').style.width = '10%';

                setTimeout(function() {
                    cacheSentItems(days);
                }, 50);

            } catch (e) {
                showExportError("Fehler: " + e.message);
            }
        }

        function processEmailBatch() {
            var batchSize = 20; // Process 20 emails per batch (faster with lookup map)
            var processed = 0;

            while (processed < batchSize && exportState.current <= exportState.total) {
                var i = exportState.current;
                exportState.current++;
                processed++;

                try {
                    var item = exportState.items.Item(i);
                    if (item.Class !== 43) continue;
                    var receivedTime = new Date(item.ReceivedTime);
                    if (receivedTime < exportState.cutoffDate) {
                        exportState.oldCount++;
                        if (exportState.oldCount >= 20) {
                            exportState.current = exportState.total + 1; // Stop
                            break;
                        }
                        continue;
                    }

                    var emailData = extractEmail(item);

                    // Filter out emails with specific subjects that are not relevant
                    var subjectLower = (emailData.betreff || '').toLowerCase();
                    if (subjectLower.indexOf('online-abschluss vermittlerzuordnung ändern') !== -1) {
                        continue;  // Skip this email
                    }

                    // Skip if we already processed this ConversationID in this export batch
                    // (handles forwarded emails appearing multiple times in folder)
                    if (emailData.conversationId && exportState.processedConvIds[emailData.conversationId]) {
                        exportState.batchDuplicates++;
                        continue;
                    }
                    if (emailData.conversationId) {
                        exportState.processedConvIds[emailData.conversationId] = true;
                        // Mark as found in Inbox (for auto-erledigt feature)
                        foundInInbox[emailData.conversationId] = true;
                    }

                    // Check for duplicates if Excel was connected
                    var hasExcelData = false;
                    for (var k in existingEmailKeys) { hasExcelData = true; break; }
                    var isDuplicate = false;
                    var isConversationContinuation = false;  // New email in existing conversation
                    var existingReplyText = '';
                    var existingReplyIdList = '';
                    var convKey = '';
                    var emailKey = '';
                    if (hasExcelData) {
                        // Primary: Check ConversationID ONLY (any new email in same conversation = reply!)
                        convKey = 'conv|' + (emailData.conversationId || '');
                        emailKey = createExportEmailKey(emailData.datum, emailData.betreff);

                        if (emailData.conversationId && existingEmailKeys[convKey]) {
                            // Check if this exact email is already imported (by EntryID)
                            if (emailData.emailId && existingEmailIds[emailData.emailId]) {
                                isDuplicate = true;  // Exact same email
                            } else {
                                // Same conversation, but NEW email = this is a continuation/reply!
                                isConversationContinuation = true;
                            }
                            existingReplyText = existingReplies[convKey] || '';
                            existingReplyIdList = existingReplyIds[convKey] || '';
                        } else if (existingEmailKeys[emailKey]) {
                            isDuplicate = true;  // Fallback: date+subject match
                            existingReplyText = existingReplies[emailKey] || '';
                            existingReplyIdList = existingReplyIds[emailKey] || '';
                        }
                    }

                    // Always check for replies from sent items
                    var allReplies = findReplies(emailData);
                    exportState.repliesFound += allReplies.length;

                    if (isDuplicate) {
                        // Exact duplicate - check for new sent replies only
                        var newReplies = filterNewReplies(allReplies, existingReplyText, existingReplyIdList);

                        if (newReplies.length > 0) {
                            emailData.antworten = newReplies;
                            emailData.alleAntworten = allReplies;
                            emailData.existingReplies = existingReplyText;
                            emailData.existingReplyIds = existingReplyIdList;
                            emailData.isDuplicateWithNewReplies = true;
                            exportState.duplicatesWithReplies++;
                            exportState.emails.push(emailData);
                        } else {
                            exportState.duplicatesSkipped++;
                        }
                    } else if (isConversationContinuation) {
                        // NEW incoming email in EXISTING conversation = treat as new reply!
                        // Save original text for date extraction BEFORE modifying
                        var originalRawText = emailData.text;

                        // The email's text becomes a new reply, not a new Anfrage
                        var incomingReply = {
                            datum: emailData.datum,
                            an: '',  // Incoming email, no "An"
                            text: removeEmailQuotes(emailData.text),
                            replyId: emailData.emailId,
                            isNew: true,
                            isIncoming: true  // Mark as incoming (not from sent items)
                        };

                        // Combine with any sent replies
                        var allNewReplies = [incomingReply];
                        var filteredSentReplies = filterNewReplies(allReplies, existingReplyText, existingReplyIdList);
                        for (var sr = 0; sr < filteredSentReplies.length; sr++) {
                            allNewReplies.push(filteredSentReplies[sr]);
                        }

                        // IMPORTANT: Use original request text from Excel, not the new email's text!
                        var originalAnfrage = existingAnfragen[convKey] || existingAnfragen[emailKey] || '';
                        if (originalAnfrage) {
                            emailData.text = originalAnfrage;  // Keep the original request
                        } else {
                            // Fallback: at least remove email quotes from the new email
                            emailData.text = removeEmailQuotes(originalRawText);
                        }

                        // IMPORTANT: Use original request DATE - priority:
                        // 1. From Excel (if already saved)
                        // 2. From Outlook Conversation API (conversationStartDate)
                        // 3. From quoted email headers (fallback)
                        var originalDate = existingDates[convKey] || existingDates[emailKey] || '';
                        if (originalDate) {
                            emailData.datum = originalDate;  // Keep the original date from Excel
                        } else if (emailData.conversationStartDate) {
                            emailData.datum = emailData.conversationStartDate;  // Use Outlook's conversation start date
                        } else {
                            // Fallback: try to extract from quoted email headers (use ORIGINAL raw text!)
                            var quotedDate = extractOldestDateFromQuotes(originalRawText);
                            if (quotedDate) {
                                emailData.datum = quotedDate.getFullYear() + '-' +
                                    pad(quotedDate.getMonth() + 1) + '-' +
                                    pad(quotedDate.getDate()) + 'T' +
                                    pad(quotedDate.getHours()) + ':' +
                                    pad(quotedDate.getMinutes()) + ':' +
                                    pad(quotedDate.getSeconds());
                            }
                        }

                        // IMPORTANT: Use original SUBJECT - priority:
                        // 1. From Excel (if already saved)
                        // 2. From Outlook Conversation API (originalSubject)
                        // 3. Strip prefixes from current subject (fallback)
                        var originalSubject = existingSubjects[convKey] || existingSubjects[emailKey] || '';
                        if (originalSubject) {
                            emailData.betreff = originalSubject;  // Keep the original subject from Excel
                        } else if (emailData.originalSubject) {
                            emailData.betreff = emailData.originalSubject;  // Use Outlook's conversation original subject
                        } else {
                            // Fallback: strip AW:/RE:/etc. prefixes
                            emailData.betreff = stripSubjectPrefixes(emailData.betreff);
                        }

                        emailData.antworten = allNewReplies;
                        emailData.alleAntworten = allReplies;
                        emailData.existingReplies = existingReplyText;
                        emailData.existingReplyIds = existingReplyIdList;
                        emailData.isDuplicateWithNewReplies = true;
                        emailData.isConversationContinuation = true;  // Flag for import
                        exportState.duplicatesWithReplies++;
                        exportState.emails.push(emailData);
                    } else {
                        // Completely new email - check if a sent item started this conversation
                        var inboxDate = new Date(emailData.datum);
                        var oldestSentItem = null;
                        var oldestSentDate = null;

                        // Find the oldest sent item in this conversation
                        for (var si = 0; si < allReplies.length; si++) {
                            var replyDate = new Date(allReplies[si].datum);
                            if (!oldestSentDate || replyDate < oldestSentDate) {
                                oldestSentDate = replyDate;
                                oldestSentItem = allReplies[si];
                            }
                        }

                        // If a sent item is older than the inbox email, it's the actual "Anfrage"
                        if (oldestSentItem && oldestSentDate < inboxDate) {
                            // The sent item is the Anfrage, inbox email becomes a reply
                            var inboxAsReply = {
                                datum: emailData.datum,
                                an: '',  // Incoming email
                                text: removeEmailQuotes(emailData.text),
                                replyId: emailData.emailId,
                                isNew: true,
                                isIncoming: true
                            };

                            // Build replies: all sent items except the oldest (which is Anfrage)
                            var repliesWithoutOldest = [];
                            for (var ri = 0; ri < allReplies.length; ri++) {
                                if (allReplies[ri] !== oldestSentItem) {
                                    allReplies[ri].isNew = true;
                                    repliesWithoutOldest.push(allReplies[ri]);
                                }
                            }
                            // Add the inbox email as a reply
                            repliesWithoutOldest.push(inboxAsReply);

                            // Use the oldest sent item as the Anfrage
                            emailData.text = oldestSentItem.text;
                            emailData.datum = oldestSentItem.datum;
                            emailData.antworten = repliesWithoutOldest;

                            // Use recipient name as "von" since we initiated the conversation
                            if (oldestSentItem.to) {
                                emailData.von_name = 'An: ' + oldestSentItem.to;
                                emailData.von_email = '';
                            }
                        } else {
                            // Inbox email is the oldest - normal case
                            emailData.antworten = allReplies;
                            for (var r = 0; r < allReplies.length; r++) {
                                allReplies[r].isNew = true;
                            }
                        }

                        // Use conversation start date if available, otherwise try quoted headers
                        if (emailData.conversationStartDate) {
                            // Only override if we haven't already set it from sent item
                            var convStartDate = new Date(emailData.conversationStartDate);
                            var currentDate = new Date(emailData.datum);
                            if (convStartDate < currentDate) {
                                emailData.datum = emailData.conversationStartDate;
                            }
                        } else if (!oldestSentItem || oldestSentDate >= inboxDate) {
                            var quotedDate = extractOldestDateFromQuotes(emailData.text);
                            if (quotedDate) {
                                emailData.datum = quotedDate.getFullYear() + '-' +
                                    pad(quotedDate.getMonth() + 1) + '-' +
                                    pad(quotedDate.getDate()) + 'T' +
                                    pad(quotedDate.getHours()) + ':' +
                                    pad(quotedDate.getMinutes()) + ':' +
                                    pad(quotedDate.getSeconds());
                            }
                        }

                        // Use original subject if available, otherwise strip prefixes
                        if (emailData.originalSubject) {
                            emailData.betreff = emailData.originalSubject;
                        } else {
                            // Strip AW:/RE:/etc. prefixes
                            emailData.betreff = stripSubjectPrefixes(emailData.betreff);
                        }

                        exportState.emails.push(emailData);
                    }
                } catch (e) {}
            }

            // Update UI
            var pct = 30 + Math.round((exportState.current / exportState.total) * 70);
            document.getElementById('exportProgressFill').style.width = pct + '%';
            var newCount = exportState.emails.length - exportState.duplicatesWithReplies;
            var statusText = 'Phase 3/3: Email ' + exportState.current + '/' + exportState.total +
                ' (' + newCount + ' neu';
            if (exportState.duplicatesWithReplies > 0) {
                statusText += ', ' + exportState.duplicatesWithReplies + ' Updates';
            }
            if (exportState.duplicatesSkipped > 0) {
                statusText += ', ' + exportState.duplicatesSkipped + ' in Excel';
            }
            if (exportState.batchDuplicates > 0) {
                statusText += ', ' + exportState.batchDuplicates + ' doppelt';
            }
            statusText += ', ' + exportState.repliesFound + ' Antworten)';
            document.getElementById('exportProgressText').innerText = statusText;

            // Continue or finish
            if (exportState.current <= exportState.total) {
                setTimeout(processEmailBatch, 10); // Small delay for UI update
            } else {
                finishExport();
            }
        }

        function finishExport() {
            if (exportState.emails.length === 0) {
                showExportError("Keine neuen Emails gefunden.");
                return;
            }
            saveExportFile(exportState.emails, exportState.repliesFound, exportState.duplicatesSkipped, exportState.duplicatesWithReplies, exportState.batchDuplicates);
        }

        // State for async sent items caching
        var sentCacheState = {
            folders: [],
            folderIdx: 0,
            itemIdx: 1,
            maxItems: 0,
            items: null,
            cutoffDate: null,
            days: 7
        };

        function cacheSentItems(days) {
            sentItemsCache = [];
            sentItemsByConvId = {};  // Clear lookup map
            sentCacheState.days = days;
            // Use same cutoff date as inbox - replies can't exist before the emails
            sentCacheState.cutoffDate = exportState.cutoffDate;
            sentCacheState.folders = [];
            sentCacheState.folderIdx = 0;

            // Only search sent folder of selected mailbox (faster)
            try { sentCacheState.folders.push(selectedStore.GetDefaultFolder(5)); } catch (e) {}

            // Start first folder
            startNextSentFolder();
        }

        function startNextSentFolder() {
            if (sentCacheState.folderIdx >= sentCacheState.folders.length) {
                // All folders done - start Phase 3
                document.getElementById('exportProgressText').innerText =
                    'Phase 2/3 fertig: ' + sentItemsCache.length + ' gesendete Emails aus ' + sentCacheState.folders.length + ' Ordnern geladen';
                document.getElementById('exportProgressFill').style.width = '30%';
                setTimeout(processEmailBatch, 10);
                return;
            }

            try {
                var folder = sentCacheState.folders[sentCacheState.folderIdx];

                // Use Restrict() to filter sent items by date at the Outlook server level (MUCH faster)
                var dateFilter = "[SentOn] >= '" + formatDateForRestrict(sentCacheState.cutoffDate) + "'";
                try {
                    sentCacheState.items = folder.Items.Restrict(dateFilter);
                } catch (restrictErr) {
                    // Fallback to all items if Restrict fails
                    sentCacheState.items = folder.Items;
                }
                try { sentCacheState.items.Sort("[SentOn]", true); } catch (e) {}
                // No artificial limit - date filter already restricts to relevant timeframe
                sentCacheState.maxItems = sentCacheState.items.Count;
                sentCacheState.itemIdx = 1;
                setTimeout(processSentBatch, 10);
            } catch (e) {
                sentCacheState.folderIdx++;
                setTimeout(startNextSentFolder, 10);
            }
        }

        function processSentBatch() {
            var batchSize = 50;  // Large batch size for faster sent items loading
            var processed = 0;

            while (processed < batchSize && sentCacheState.itemIdx <= sentCacheState.maxItems) {
                var i = sentCacheState.itemIdx;
                sentCacheState.itemIdx++;
                processed++;

                try {
                    var item = sentCacheState.items.Item(i);
                    if (item.Class !== 43) continue;

                    var sentDate = new Date(item.SentOn);
                    if (sentDate < sentCacheState.cutoffDate) {
                        sentCacheState.itemIdx = sentCacheState.maxItems + 1;
                        break;
                    }

                    var body = '';
                    try { body = item.Body || ''; } catch (e) {}

                    var toRecipient = '';
                    try { toRecipient = item.To || ''; } catch (e) {}

                    var convId = '';
                    try { convId = item.ConversationID || ''; } catch (e) {}

                    var entryId = '';
                    try { entryId = item.EntryID || ''; } catch (e) {}

                    var sentItem = {
                        sentDate: sentDate,
                        conversationId: convId,
                        entryId: entryId,  // Unique ID for reply duplicate detection
                        body: removeEmailQuotes(body),
                        to: toRecipient
                    };
                    sentItemsCache.push(sentItem);

                    // Add to lookup map for fast access
                    if (convId) {
                        if (!sentItemsByConvId[convId]) {
                            sentItemsByConvId[convId] = [];
                        }
                        sentItemsByConvId[convId].push(sentItem);
                    }
                } catch (e) {}
            }

            // Update progress
            var totalFolders = sentCacheState.folders.length;
            var pct = 10 + Math.round(((sentCacheState.folderIdx * 1000 + sentCacheState.itemIdx) / (totalFolders * 1000)) * 20);
            document.getElementById('exportProgressFill').style.width = pct + '%';
            var folderName = '';
            try { folderName = sentCacheState.folders[sentCacheState.folderIdx].Name; } catch (e) { folderName = 'Ordner ' + (sentCacheState.folderIdx + 1); }
            document.getElementById('exportProgressText').innerText =
                'Phase 2/3: ' + folderName + ' (' + (sentCacheState.folderIdx + 1) + '/' + totalFolders + ')' +
                ' - Email ' + sentCacheState.itemIdx + '/' + sentCacheState.maxItems +
                ' (' + sentItemsCache.length + ' geladen)';

            // Continue or next folder
            if (sentCacheState.itemIdx <= sentCacheState.maxItems) {
                setTimeout(processSentBatch, 10);
            } else {
                sentCacheState.folderIdx++;
                setTimeout(startNextSentFolder, 10);
            }
        }

        function findReplies(originalEmail) {
            var replies = [];

            try {
                var originalConvId = originalEmail.conversationId || '';

                // No ConversationID = can't match reliably
                if (!originalConvId) return replies;

                // Use lookup map for O(1) access instead of iterating entire cache
                var matchingItems = sentItemsByConvId[originalConvId];
                if (!matchingItems || matchingItems.length === 0) return replies;

                for (var i = 0; i < matchingItems.length; i++) {
                    var cached = matchingItems[i];
                    if (cached.body && cached.body.trim() !== '') {
                        replies.push({
                            datum: formatDate(cached.sentDate),
                            an: cached.to || '',
                            text: cached.body.trim(),
                            replyId: cached.entryId || ''  // Unique ID for this reply
                        });
                    }
                }
            } catch (e) {}

            return replies;
        }

        // Filter replies to only include ones that are not already in Excel
        // Uses ReplyID (EntryID) for precise matching, falls back to text matching if no IDs available
        function filterNewReplies(allReplies, existingReplyText, existingReplyIdList) {
            if (!allReplies || allReplies.length === 0) return [];

            // Parse existing reply IDs into a lookup set
            var existingIdSet = {};
            if (existingReplyIdList) {
                var idParts = String(existingReplyIdList).split(',');
                for (var p = 0; p < idParts.length; p++) {
                    var id = idParts[p].trim();
                    if (id) existingIdSet[id] = true;
                }
            }

            // If no existing data at all - all are new
            if (!existingReplyText && !existingReplyIdList) {
                for (var i = 0; i < allReplies.length; i++) {
                    allReplies[i].isNew = true;
                }
                return allReplies;
            }

            var newReplies = [];
            // Normalize text for fallback matching
            var existingNormalized = existingReplyText ? fixEncoding(existingReplyText).toLowerCase() : '';

            for (var j = 0; j < allReplies.length; j++) {
                var reply = allReplies[j];
                var replyText = (reply.text || '').trim();

                // Skip empty replies
                if (!replyText) continue;

                // Primary check: Use ReplyID if available (precise matching)
                if (reply.replyId && existingIdSet[reply.replyId]) {
                    // Already in Excel by ID
                    reply.isNew = false;
                    continue;
                }

                // Fallback check: Text matching (for older data without IDs)
                if (existingNormalized) {
                    var normalizedReply = fixEncoding(replyText);
                    var checkText = normalizedReply.substring(0, 80).toLowerCase().trim();
                    if (checkText.length < 10) checkText = normalizedReply.toLowerCase().trim();

                    if (existingNormalized.indexOf(checkText) !== -1) {
                        // Found in existing by text
                        reply.isNew = false;
                        continue;
                    }
                }

                // Not found - this is new
                reply.isNew = true;
                newReplies.push(reply);
            }

            return newReplies;
        }

        // Get the conversation start date from Outlook using GetConversation API
        function getConversationStartDate(item) {
            try {
                var conv = item.GetConversation();
                if (conv) {
                    var rootItems = conv.GetRootItems();
                    if (rootItems && rootItems.Count > 0) {
                        var oldestDate = null;
                        for (var i = 1; i <= rootItems.Count; i++) {
                            var rootItem = rootItems.Item(i);
                            try {
                                var itemDate = rootItem.ReceivedTime || rootItem.SentOn;
                                if (itemDate) {
                                    var d = new Date(itemDate);
                                    if (!isNaN(d.getTime())) {
                                        if (!oldestDate || d < oldestDate) {
                                            oldestDate = d;
                                        }
                                    }
                                }
                            } catch (e) {}
                        }
                        return oldestDate;
                    }
                }
            } catch (e) {}
            return null;
        }

        // Get the original subject from conversation root item
        function getConversationOriginalSubject(item) {
            try {
                var conv = item.GetConversation();
                if (conv) {
                    var rootItems = conv.GetRootItems();
                    if (rootItems && rootItems.Count > 0) {
                        // Find the oldest root item and get its subject
                        var oldestDate = null;
                        var originalSubject = null;
                        for (var i = 1; i <= rootItems.Count; i++) {
                            var rootItem = rootItems.Item(i);
                            try {
                                var itemDate = rootItem.ReceivedTime || rootItem.SentOn;
                                var itemSubject = rootItem.Subject;
                                if (itemDate) {
                                    var d = new Date(itemDate);
                                    if (!isNaN(d.getTime())) {
                                        if (!oldestDate || d < oldestDate) {
                                            oldestDate = d;
                                            originalSubject = itemSubject;
                                        }
                                    }
                                }
                            } catch (e) {}
                        }
                        return originalSubject;
                    }
                }
            } catch (e) {}
            return null;
        }

        // Strip reply prefixes (AW:, RE:, Antwort:, WG:, FW:, Fwd:) from subject
        function stripSubjectPrefixes(subject) {
            if (!subject) return subject;
            var s = String(subject).trim();
            // Remove common reply/forward prefixes repeatedly (handles "AW: AW: RE: ...")
            var changed = true;
            while (changed) {
                changed = false;
                var patterns = [/^AW:\s*/i, /^RE:\s*/i, /^Antwort:\s*/i, /^WG:\s*/i, /^FW:\s*/i, /^Fwd:\s*/i];
                for (var i = 0; i < patterns.length; i++) {
                    if (patterns[i].test(s)) {
                        s = s.replace(patterns[i], '');
                        changed = true;
                    }
                }
            }
            return s.trim();
        }

        // Extract the oldest date from quoted email headers in the text
        // Looks for patterns like "Gesendet: Montag, 1. Dezember 2025 12:50"
        function extractOldestDateFromQuotes(text) {
            if (!text) return null;

            var oldestDate = null;

            // German months mapping
            var germanMonths = {
                'januar': 0, 'februar': 1, 'märz': 2, 'maerz': 2, 'april': 3,
                'mai': 4, 'juni': 5, 'juli': 6, 'august': 7, 'september': 8,
                'oktober': 9, 'november': 10, 'dezember': 11
            };

            // Pattern: "Gesendet: Wochentag, DD. Monat YYYY HH:MM"
            // Example: "Gesendet: Montag, 1. Dezember 2025 12:50"
            var pattern = /Gesendet:\s*\w+,\s*(\d{1,2})\.\s*(\w+)\s+(\d{4})\s+(\d{1,2}):(\d{2})/gi;
            var match;

            while ((match = pattern.exec(text)) !== null) {
                var day = parseInt(match[1], 10);
                var monthName = match[2].toLowerCase();
                var year = parseInt(match[3], 10);
                var hour = parseInt(match[4], 10);
                var minute = parseInt(match[5], 10);

                var month = germanMonths[monthName];
                if (month === undefined) continue;

                var date = new Date(year, month, day, hour, minute, 0);
                if (!isNaN(date.getTime())) {
                    if (!oldestDate || date < oldestDate) {
                        oldestDate = date;
                    }
                }
            }

            // Also try English pattern: "Sent: Day, Month DD, YYYY HH:MM"
            var englishMonths = {
                'january': 0, 'february': 1, 'march': 2, 'april': 3,
                'may': 4, 'june': 5, 'july': 6, 'august': 7, 'september': 8,
                'october': 9, 'november': 10, 'december': 11
            };

            var englishPattern = /Sent:\s*\w+,\s*(\w+)\s+(\d{1,2}),\s*(\d{4})\s+(\d{1,2}):(\d{2})/gi;
            while ((match = englishPattern.exec(text)) !== null) {
                var monthName = match[1].toLowerCase();
                var day = parseInt(match[2], 10);
                var year = parseInt(match[3], 10);
                var hour = parseInt(match[4], 10);
                var minute = parseInt(match[5], 10);

                var month = englishMonths[monthName];
                if (month === undefined) continue;

                var date = new Date(year, month, day, hour, minute, 0);
                if (!isNaN(date.getTime())) {
                    if (!oldestDate || date < oldestDate) {
                        oldestDate = date;
                    }
                }
            }

            return oldestDate;
        }

        // Remove problematic Unicode characters (emojis, etc.) that JScript can't handle
        function sanitizeText(text) {
            if (!text) return '';
            var result = '';
            for (var i = 0; i < text.length; i++) {
                var code = text.charCodeAt(i);
                // Skip surrogate pairs (emojis, etc.) which are 0xD800-0xDFFF
                if (code >= 0xD800 && code <= 0xDFFF) {
                    continue;
                }
                // Skip control characters except newline, carriage return, tab
                if (code < 32 && code !== 9 && code !== 10 && code !== 13) {
                    continue;
                }
                // Skip other problematic ranges
                if (code >= 0xFFFE) {
                    continue;
                }
                // Skip private use area
                if (code >= 0xE000 && code <= 0xF8FF) {
                    continue;
                }
                // Skip variation selectors and other modifiers that can cause issues
                if (code >= 0xFE00 && code <= 0xFE0F) {
                    continue;
                }
                result += text.charAt(i);
            }
            return result;
        }

        function removeEmailQuotes(text) {
            if (!text) return '';

            // Find where quoted content starts and cut it off
            // Multiple patterns for German and English Outlook
            var patterns = [
                // German Outlook patterns (including UTF-8 mojibake versions)
                /_{5,}\s*\r?\n\s*Von:/i,
                /\r?\n\s*Von:\s+.+\r?\n\s*Gesendet:/im,
                /\r?\n\s*Von:\s+.+\r?\n\s*An:/im,
                /-{3,}\s*Urspr[uü]ngliche\s+Nachricht/i,
                /-{3,}\s*UrsprÃ¼ngliche\s+Nachricht/i,  // UTF-8 mojibake
                /-{3,}\s*Original\s*Message/i,
                /-{3,}\s*Weitergeleitete\s+Nachricht/i,
                /-{3,}\s*Weitergeleite\s+Nachricht/i,
                // English Outlook patterns
                /_{5,}\s*\r?\n\s*From:/i,
                /\r?\n\s*From:\s+.+\r?\n\s*Sent:/im,
                /\r?\n\s*From:\s+.+\r?\n\s*To:/im,
                // Quote headers
                /\r?\n\s*Am\s+\d.+\s+schrieb\s+.+:/im,
                /\r?\n\s*On\s+.+\s+wrote:/im,
                /\r?\n\s*>+\s*Von:/im,
                /\r?\n\s*>+\s*From:/im,
                // Line of underscores/dashes followed by email header
                /\r?\n_{10,}\r?\n/,
                /\r?\n-{10,}\r?\n/
            ];

            for (var i = 0; i < patterns.length; i++) {
                var match = text.search(patterns[i]);
                if (match > 0) {
                    text = text.substring(0, match);
                    break;
                }
            }

            // Remove trailing signature markers
            text = text.replace(/\r?\n--\s*\r?\n[\s\S]*$/, '');

            // Additional cleanup: Remove any remaining quote markers and everything after
            // This catches cases where the pattern didn't match exactly
            var quoteMarkers = [
                /-{3,}\s*Urspr/i,           // -----Ursprüngliche Nachricht
                /-{3,}\s*UrsprÃ/i,          // Mojibake version
                /-{3,}\s*Original/i,         // -----Original Message
                /-{3,}\s*Weitergeleit/i,     // -----Weitergeleitete Nachricht
                /_{5,}\s*Von:/i,             // _____Von:
                /_{5,}\s*From:/i             // _____From:
            ];
            for (var j = 0; j < quoteMarkers.length; j++) {
                var pos = text.search(quoteMarkers[j]);
                if (pos > 0) {
                    text = text.substring(0, pos);
                    break;
                }
            }

            // Trim and limit length
            text = text.trim();
            if (text.length > 10000) text = text.substring(0, 10000) + '...';
            return text;
        }

        function extractEmail(item) {
            var senderEmail = '';
            try {
                senderEmail = item.SenderEmailAddress || '';
                if ((!senderEmail || senderEmail.indexOf('@') === -1) && item.SenderEmailType === 'EX') {
                    try { var exUser = item.Sender.GetExchangeUser(); if (exUser) senderEmail = exUser.PrimarySmtpAddress || senderEmail; } catch (e) {}
                }
            } catch (e) {}

            var body = '';
            try { body = item.Body || ''; if (body.length > 50000) body = body.substring(0, 50000) + '...'; } catch (e) {}

            var htmlBody = '';
            try {
                htmlBody = item.HTMLBody || '';
                if (htmlBody.length > 500000) htmlBody = '';
            } catch (e) {
                htmlBody = '';
            }

            var attachments = [];
            try { for (var a = 1; a <= item.Attachments.Count; a++) { attachments.push(item.Attachments.Item(a).FileName); } } catch (e) {}

            var convId = '';
            try { convId = item.ConversationID || ''; } catch (e) {}

            var entryId = '';
            try { entryId = item.EntryID || ''; } catch (e) {}

            // Try to get the conversation start date (when the first email was sent/received)
            var convStartDate = null;
            try {
                convStartDate = getConversationStartDate(item);
            } catch (e) {}

            // Try to get the original subject from conversation root
            var convOriginalSubject = null;
            try {
                convOriginalSubject = getConversationOriginalSubject(item);
            } catch (e) {}

            // Get Outlook category (used as Bearbeiter)
            var category = '';
            try {
                var cats = item.Categories || '';
                if (cats) {
                    // Categories can be comma-separated, take the first one
                    category = cats.split(',')[0].trim();
                }
            } catch (e) {}

            return {
                datum: formatDate(item.ReceivedTime),
                conversationStartDate: convStartDate ? formatDate(convStartDate) : null,
                originalSubject: convOriginalSubject,
                von_email: senderEmail,
                von_name: item.SenderName || 'Unbekannt',
                betreff: item.Subject || '(Kein Betreff)',
                text: body,
                htmlBody: htmlBody,  // HTML version for tables/formatting
                anhaenge: attachments,
                conversationId: convId,
                emailId: entryId,  // Unique ID for duplicate detection
                outlookKategorie: category,  // Outlook category → Bearbeiter
                antworten: []
            };
        }

        function formatDate(date) {
            var d = new Date(date);
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        }

        function pad(n) { return n < 10 ? '0' + n : n; }

        function saveExportFile(emails, totalReplies, duplicatesSkipped, duplicatesWithReplies, batchDuplicates) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var shellApp = new ActiveXObject("Shell.Application");
                var fso = new ActiveXObject("Scripting.FileSystemObject");

                var downloads;
                try { downloads = shellApp.NameSpace("shell:Downloads").Self.Path; }
                catch (e) { downloads = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }

                var filename = 'hypercare_emails_' + new Date().toISOString().slice(0, 10) + '.json';
                var filepath = downloads + '\\' + filename;

                // Use FSO with Unicode encoding
                var file = fso.CreateTextFile(filepath, true, true); // true = overwrite, true = unicode
                file.Write(JSON.stringify(emails, null, 2));
                file.Close();

                document.getElementById('exportProgress').style.display = 'none';
                document.getElementById('exportSuccess').style.display = 'block';
                var newCount = emails.length - (duplicatesWithReplies || 0);
                var msg = '<strong>' + newCount + ' neue Emails</strong> exportiert<br>';
                if (duplicatesWithReplies > 0) {
                    msg += '<strong>' + duplicatesWithReplies + ' Updates</strong> (mit neuen Antworten)<br>';
                }
                if (duplicatesSkipped > 0) {
                    msg += duplicatesSkipped + ' bereits in Excel<br>';
                }
                if (batchDuplicates > 0) {
                    msg += batchDuplicates + ' doppelt im Ordner (gleiche Konversation)<br>';
                }
                msg += (totalReplies || 0) + ' Antworten gefunden<br>';
                msg += 'Datei: <strong>' + filename + '</strong>';
                document.getElementById('exportSuccessMsg').innerHTML = msg;
                document.getElementById('exportActions').style.display = 'block';
                document.getElementById('exportBtn').disabled = false;

                // Store emails for reference
                lastExportedEmails = emails;

                // Step 3 completed - Export done
                completeStep(3);
            } catch (e) {
                showExportError("Speichern fehlgeschlagen: " + e.message);
            }
        }

        function updateExportProgress(current, total, found) {
            document.getElementById('exportProgressFill').style.width = Math.round((current / total) * 100) + '%';
            document.getElementById('exportProgressText').innerText = 'Durchsuche ' + current + '/' + total + ' (' + found + ' gefunden)';
        }

        function showExportError(msg) {
            document.getElementById('exportProgress').style.display = 'none';
            document.getElementById('exportError').style.display = 'block';
            document.getElementById('exportErrorMsg').innerText = msg;
            document.getElementById('exportBtn').disabled = false;
        }

        function openWebApp() {
            var shell = new ActiveXObject("WScript.Shell");
            var fso = new ActiveXObject("Scripting.FileSystemObject");

            // Try to open local index.html first
            var scriptPath = document.location.pathname.replace(/^\//, '').replace(/\//g, '\\');
            var scriptDir = fso.GetParentFolderName(scriptPath);
            var localIndex = scriptDir + '\\index.html';

            if (fso.FileExists(localIndex)) {
                shell.Run('"' + localIndex + '"');
            } else {
                // Fallback to hosted version
                shell.Run('https://emailimport.pages.dev/');
            }

            // Step 4 completed - Web App opened
            completeStep(4);
        }

        function openDownloads() {
            var shell = new ActiveXObject("WScript.Shell");
            var shellApp = new ActiveXObject("Shell.Application");
            var downloads;
            try { downloads = shellApp.NameSpace("shell:Downloads").Self.Path; }
            catch (e) { downloads = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }
            shell.Run('explorer.exe "' + downloads + '"');
        }

        // ============================================================================
        // EXCEL IMPORT
        // ============================================================================
        var excelApp = null;
        var targetWorkbook = null;

        function selectJsonFile() {
            try {
                // Use Excel's FileDialog for file selection
                var tempExcel = null;
                try {
                    tempExcel = GetObject("", "Excel.Application");
                } catch (e) {
                    tempExcel = new ActiveXObject("Excel.Application");
                }

                var fd = tempExcel.FileDialog(3); // msoFileDialogFilePicker = 3
                fd.Title = "JSON-Datei auswahlen";
                fd.Filters.Clear();
                fd.Filters.Add("JSON Dateien", "*.json");
                fd.AllowMultiSelect = false;

                // Set initial folder to Downloads
                try {
                    var shellApp = new ActiveXObject("Shell.Application");
                    var downloads = shellApp.NameSpace("shell:Downloads").Self.Path;
                    fd.InitialFileName = downloads + "\\";
                } catch (e) {}

                if (fd.Show() === -1) {
                    var selectedPath = fd.SelectedItems.Item(1);
                    loadJsonFile(selectedPath);
                }
            } catch (e) {
                alert("Fehler beim Dateidialog: " + e.message + "\n\nBitte Pfad manuell eingeben.");
                var path = prompt("Pfad zur JSON-Datei:", "");
                if (path) loadJsonFile(path);
            }
        }

        function loadJsonFile(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) { alert("Datei nicht gefunden!"); return; }

                var content = '';
                var loaded = false;

                // Method 1: Use ADODB.Stream for proper UTF-8 reading (from web app)
                if (!loaded) {
                    try {
                        var stream = new ActiveXObject("ADODB.Stream");
                        stream.CharSet = "utf-8";
                        stream.Open();
                        stream.LoadFromFile(path);
                        content = stream.ReadText();
                        stream.Close();
                        if (content.indexOf('[') >= 0 || content.indexOf('{') >= 0) loaded = true;
                    } catch (e) {}
                }

                // Method 2: Try Unicode (UTF-16) for files from this HTA
                if (!loaded) {
                    try {
                        var file = fso.OpenTextFile(path, 1, false, -1); // -1 = TristateTrue (Unicode)
                        content = file.ReadAll();
                        file.Close();
                        if (content.indexOf('[') >= 0 || content.indexOf('{') >= 0) loaded = true;
                    } catch (e) {}
                }

                // Method 3: Try system default encoding
                if (!loaded) {
                    try {
                        var file = fso.OpenTextFile(path, 1, false, -2); // -2 = TristateUseDefault
                        content = file.ReadAll();
                        file.Close();
                        if (content.indexOf('[') >= 0 || content.indexOf('{') >= 0) loaded = true;
                    } catch (e) {}
                }

                if (!loaded || !content) {
                    throw new Error("Datei konnte nicht gelesen werden");
                }

                // Remove BOM if present
                while (content.length > 0 && (content.charCodeAt(0) === 0xFEFF || content.charCodeAt(0) === 65279 ||
                       content.charCodeAt(0) === 0xFFFE || content.charCodeAt(0) === 0xEF)) {
                    content = content.substring(1);
                }

                // Find start of JSON
                var jsonStart = content.indexOf('[');
                if (jsonStart === -1) jsonStart = content.indexOf('{');
                if (jsonStart > 0) content = content.substring(jsonStart);

                // Try to parse JSON with detailed error handling
                try {
                    jsonData = JSON.parse(content);
                } catch (parseError) {
                    // Find the problematic position
                    var errorMsg = parseError.message || String(parseError);
                    var errorDetails = 'JSON Parse Fehler: ' + errorMsg + '\n\n';

                    // Try to find problematic line/character
                    var lines = content.split('\n');
                    var charCount = 0;
                    var problemLine = -1;
                    var problemChar = -1;

                    // Look for common issues
                    for (var i = 0; i < lines.length && i < 100; i++) {
                        var line = lines[i];
                        // Check for unescaped control characters
                        if (line.match(/[\x00-\x1f]/)) {
                            problemLine = i + 1;
                            errorDetails += 'Zeile ' + problemLine + ' enthält ungültige Steuerzeichen\n';
                            errorDetails += 'Inhalt: ' + line.substring(0, 100) + '\n\n';
                            break;
                        }
                    }

                    // Show first 500 chars of content for debugging
                    errorDetails += '=== JSON Anfang (erste 500 Zeichen) ===\n';
                    errorDetails += content.substring(0, 500) + '\n\n';

                    // Show around position if available in error message
                    var posMatch = errorMsg.match(/position\s*(\d+)/i) || errorMsg.match(/at\s*(\d+)/i);
                    if (posMatch) {
                        var pos = parseInt(posMatch[1]);
                        errorDetails += '=== Um Position ' + pos + ' ===\n';
                        errorDetails += content.substring(Math.max(0, pos - 50), pos + 50) + '\n';
                    }

                    // Create copyable error display
                    var statusEl = document.getElementById('jsonStatus');
                    statusEl.style.display = 'block';
                    statusEl.className = 'status error';
                    statusEl.innerHTML = '<strong>JSON Fehler:</strong> ' + errorMsg +
                        '<br><br><textarea readonly style="width:100%;height:150px;font-size:11px;background:#1a1a2e;color:#ef4444;border:1px solid #ef4444;padding:8px;" onclick="this.select()">' +
                        errorDetails.replace(/</g, '&lt;').replace(/>/g, '&gt;') +
                        '</textarea><br><small>Klicken zum Kopieren</small>';
                    return;
                }

                var filename = path.substring(path.lastIndexOf("\\") + 1);
                document.getElementById('jsonPath').value = filename;

                var statusEl = document.getElementById('jsonStatus');
                statusEl.style.display = 'block';
                statusEl.className = 'status success';
                statusEl.innerHTML = '<strong>' + jsonData.length + ' Datensatze</strong> geladen';

                checkImportReady();
            } catch (e) {
                var statusEl = document.getElementById('jsonStatus');
                statusEl.style.display = 'block';
                statusEl.className = 'status error';
                statusEl.innerHTML = '<strong>Fehler:</strong> ' + e.message +
                    '<br><br><textarea readonly style="width:100%;height:80px;font-size:11px;background:#1a1a2e;color:#ef4444;border:1px solid #ef4444;padding:8px;" onclick="this.select()">' +
                    'Fehler: ' + e.message + '\nStack: ' + (e.stack || 'nicht verfügbar') +
                    '</textarea>';
            }
        }

        function detectExcel() {
            document.getElementById('excelStatus').value = "Suche Excel...";

            try {
                // Method 1: GetObject with empty string (preferred - connects to running Excel)
                try {
                    excelApp = GetObject("", "Excel.Application");
                } catch (e1) {
                    // Method 2: Create new ActiveXObject
                    excelApp = new ActiveXObject("Excel.Application");
                }

                excelApp.Visible = true;

                // Find Hypercare/Tracking workbook in open workbooks
                targetWorkbook = null;
                var allWorkbooks = [];

                for (var i = 1; i <= excelApp.Workbooks.Count; i++) {
                    try {
                        var wb = excelApp.Workbooks(i);
                        allWorkbooks.push(wb.Name);
                        var wbName = wb.Name.toLowerCase().replace(/[_\-\s]/g, '');
                        if (wbName.indexOf('hypercare') !== -1) {
                            targetWorkbook = wb;
                            break;
                        }
                    } catch (e) {}
                }

                // If not found, try to open from SharePoint
                if (!targetWorkbook) {
                    document.getElementById('excelStatus').value = "Offne SharePoint-Datei...";
                    var sharePointUrl = "https://barmeniagroup.sharepoint.com/sites/SAPUnity-WorkstreamICM/Freigegebene%20Dokumente/40%20Team%20Simulation,%20Kalibrierung,%20Verhandlung,%20Vertrag%20&%20EFM/Tracking_Hypercare.xlsm";
                    try {
                        targetWorkbook = excelApp.Workbooks.Open(sharePointUrl);
                    } catch (e) {
                        document.getElementById('excelStatus').value = "SharePoint-Datei konnte nicht geoffnet werden - bitte manuell offnen";
                        return;
                    }
                }

                if (targetWorkbook) {
                    document.getElementById('excelStatus').value = "OK: " + targetWorkbook.Name;
                    checkImportReady();
                } else {
                    document.getElementById('excelStatus').value = "Hypercare-Datei nicht gefunden";
                }
            } catch (e) {
                document.getElementById('excelStatus').value = "Fehler: " + e.message;
            }
        }

        function checkImportReady() {
            var ready = jsonData && jsonData.length > 0 && targetWorkbook;
            document.getElementById('btnImport').disabled = !ready;
        }

        function startImport() {
            var sheetName = document.getElementById('sheetName').value || "Übersicht";

            if (!jsonData || jsonData.length === 0) { alert("Keine JSON-Daten geladen!"); return; }
            if (!targetWorkbook) { alert("Keine Excel-Datei erkannt! Klicke 'Excel erkennen'."); return; }

            document.getElementById('importProgress').style.display = 'block';
            document.getElementById('btnImport').disabled = true;
            document.getElementById('importSuccess').style.display = 'none';
            document.getElementById('importError').style.display = 'none';

            setTimeout(function() { doImport(sheetName); }, 100);
        }

        function doImport(sheetName) {
            var currentEmailIndex = -1;
            var currentEmailBetreff = '';
            var currentStep = '';

            try {
                currentStep = 'Worksheet öffnen';
                var worksheet;
                try {
                    worksheet = targetWorkbook.Worksheets(sheetName);
                } catch (e) {
                    // Sheet not found - list available sheets for user
                    var availableSheets = [];
                    for (var s = 1; s <= targetWorkbook.Worksheets.Count; s++) {
                        try { availableSheets.push(targetWorkbook.Worksheets(s).Name); } catch (ex) {}
                    }
                    throw new Error('Tabellenblatt "' + sheetName + '" nicht gefunden!\n\nVerfügbare Blätter: ' + availableSheets.join(', '));
                }

                // Check if worksheet has a ListObject (table) named "Übersicht"
                currentStep = 'Excel-Tabelle suchen';
                var listObject = null;
                var tableLastRow = 0;
                try {
                    // Try to find table by name first
                    try {
                        listObject = worksheet.ListObjects("Übersicht");
                    } catch (e1) {
                        // If not found by name, try first table
                        if (worksheet.ListObjects.Count > 0) {
                            listObject = worksheet.ListObjects(1);
                        }
                    }

                    if (listObject) {
                        // Get the last row of the table's data body
                        var dataBodyRange = listObject.DataBodyRange;
                        if (dataBodyRange) {
                            tableLastRow = dataBodyRange.Row + dataBodyRange.Rows.Count - 1;
                        } else {
                            // Table has no data yet, start after header
                            tableLastRow = listObject.HeaderRowRange.Row;
                        }
                    }
                } catch (e) {
                    // No table found, will write to cells directly
                    listObject = null;
                }

                // Read existing data for duplicate check
                currentStep = 'Bestehende Daten lesen';
                document.getElementById('importProgressText').innerText = 'Lese bestehende Daten...';
                var existingData = readExistingData(worksheet);

                currentStep = 'Letzte Zeile finden';
                var lastRow;
                if (listObject && tableLastRow > 0) {
                    // Use table's last row
                    lastRow = tableLastRow;
                } else {
                    // Fallback to worksheet's last row
                    lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                    if (lastRow === 1 && !worksheet.Cells(1, 1).Value) lastRow = 0;
                }
                var nextRow = lastRow + 1;

                var total = jsonData.length;
                var newCount = 0;
                var skipCount = 0;
                var updateCount = 0;

                for (var i = 0; i < total; i++) {
                    currentEmailIndex = i;
                    currentStep = 'Email ' + (i+1) + ' laden';
                    var email = jsonData[i];
                    currentEmailBetreff = email.betreff || '(kein Betreff)';

                    if (i % 3 === 0) {
                        updateImportProgress(i, total);
                        document.getElementById('importProgressText').innerText =
                            'Verarbeite ' + (i+1) + '/' + total + ' (Neu: ' + newCount + ', Aktualisiert: ' + updateCount + ', Übersprungen: ' + skipCount + ')';
                    }

                    // Create unique key from date + subject
                    currentStep = 'Email ' + (i+1) + ' Key erstellen';
                    var emailKey = createEmailKey(email.datum, email.betreff);
                    var existingRow = existingData[emailKey];

                    if (existingRow) {
                        // Email exists - check if we have new replies to add
                        currentStep = 'Email ' + (i+1) + ' Antworten prüfen';
                        if (email.antworten && email.antworten.length > 0) {
                            var currentReplies = worksheet.Cells(existingRow, 13).Value || '';  // Antwort = col 13

                            currentStep = 'Email ' + (i+1) + ' Antworten formatieren';
                            var newRepliesText = formatReplies(email.antworten);

                            // Normalize both for comparison (handle encoding differences)
                            var normalizedCurrent = fixEncoding(currentReplies).toLowerCase();
                            var normalizedNew = fixEncoding(newRepliesText).toLowerCase();

                            // Only update if we have new content
                            if (newRepliesText && normalizedCurrent.indexOf(normalizedNew.substring(0, 50)) === -1) {
                                // New replies go on TOP (newest first)
                                currentStep = 'Email ' + (i+1) + ' Antworten schreiben';
                                var combinedReplies = currentReplies ? newRepliesText + '\n\n' + currentReplies : newRepliesText;
                                // Sanitize to remove emojis and problematic Unicode
                                combinedReplies = sanitizeText(combinedReplies);
                                worksheet.Cells(existingRow, 13).Value = combinedReplies;  // Antwort = col 13

                                // Bold timestamps in reply cell
                                currentStep = 'Email ' + (i+1) + ' Timestamps fetten';
                                boldTimestamps(worksheet.Cells(existingRow, 13));

                                // Also update ReplyIDs (col 23) - append new reply IDs
                                currentStep = 'Email ' + (i+1) + ' ReplyIDs aktualisieren';
                                try {
                                    var currentReplyIds = worksheet.Cells(existingRow, 23).Value || '';
                                    var newReplyIds = [];
                                    for (var nr = 0; nr < email.antworten.length; nr++) {
                                        if (email.antworten[nr].replyId) {
                                            newReplyIds.push(email.antworten[nr].replyId);
                                        }
                                    }
                                    if (newReplyIds.length > 0) {
                                        var combinedIds = currentReplyIds ? currentReplyIds + ',' + newReplyIds.join(',') : newReplyIds.join(',');
                                        worksheet.Cells(existingRow, 23).Value = combinedIds;
                                    }
                                } catch (replyIdErr) {
                                    // Non-critical, continue
                                }

                                updateCount++;
                            } else {
                                skipCount++;
                            }
                        } else {
                            skipCount++;
                        }
                    } else {
                        // New email - add to Excel
                        currentStep = 'Email ' + (i+1) + ' schreiben (Zeile ' + nextRow + ')';
                        try {
                            // If there's a table, add a new row to extend it
                            var actualRow = nextRow;
                            if (listObject) {
                                try {
                                    var newListRow = listObject.ListRows.Add();
                                    // Get the actual row number from the new ListRow
                                    actualRow = newListRow.Range.Row;
                                } catch (addErr) {
                                    // Table might be at max size or other issue, use nextRow
                                }
                            }
                            writeEmailRow(worksheet, actualRow, email);
                            // Add to existing data cache to prevent duplicates within same import
                            existingData[emailKey] = actualRow;
                            nextRow = actualRow + 1;
                            newCount++;
                        } catch (writeErr) {
                            // Log error but continue with next email
                            currentStep = 'Email ' + (i+1) + ' FEHLER - übersprungen';
                            // Write minimal error row so we know there was an issue
                            try {
                                var errorRow = nextRow;
                                if (listObject) {
                                    try {
                                        var errListRow = listObject.ListRows.Add();
                                        errorRow = errListRow.Range.Row;
                                    } catch (e3) {}
                                }
                                worksheet.Cells(errorRow, 1).Value = 'HC-' + (errorRow - 1);
                                worksheet.Cells(errorRow, 2).Value = email.datum || '';
                                worksheet.Cells(errorRow, 11).Value = email.betreff || '';
                                worksheet.Cells(errorRow, 12).Value = '[FEHLER beim Import: ' + writeErr.message + ']';
                                existingData[emailKey] = errorRow;
                                nextRow = errorRow + 1;
                                skipCount++;  // Count as skipped
                            } catch (e2) {
                                // Even minimal write failed - just skip
                                skipCount++;
                            }
                        }
                    }
                }

                // Auto-Erledigt: Mark entries as "Erledigt" if they were in Excel but not found in Inbox
                currentStep = 'Auto-Erledigt prüfen';
                var erledigtCount = 0;
                try {
                    for (var convId in existingExcelRows) {
                        if (existingExcelRows.hasOwnProperty(convId) && !foundInInbox[convId]) {
                            // This conversation was in Excel but not found in Inbox → mark as Erledigt
                            var erledigtRow = existingExcelRows[convId];
                            try {
                                worksheet.Cells(erledigtRow, 9).Value = 'Erledigt';  // Status = col 9
                                erledigtCount++;
                            } catch (erlErr) {
                                // Non-critical, continue
                            }
                        }
                    }
                } catch (autoErr) {
                    // Non-critical, continue with save
                }

                currentStep = 'Speichern';
                updateImportProgress(total, total);
                targetWorkbook.Save();

                document.getElementById('importProgress').style.display = 'none';
                document.getElementById('importSuccess').style.display = 'block';
                var successMsg = '<strong>' + newCount + '</strong> neue Vorgange importiert<br>' +
                    '<strong>' + updateCount + '</strong> Antworten aktualisiert<br>' +
                    '<strong>' + skipCount + '</strong> Duplikate ubersprungen';
                if (erledigtCount > 0) {
                    successMsg += '<br><strong>' + erledigtCount + '</strong> Vorgange auf Erledigt gesetzt';
                }
                document.getElementById('importSuccessMsg').innerHTML = successMsg;
                document.getElementById('btnImport').disabled = false;

                // Step 5 completed - Import done
                completeStep(5);

            } catch (e) {
                document.getElementById('importProgress').style.display = 'none';
                document.getElementById('importError').style.display = 'block';

                // Detailed error message with context
                var errorDetails = 'Fehler bei: ' + currentStep + '\n';
                if (_writeRowCurrentField) {
                    errorDetails += 'Letztes Feld: ' + _writeRowCurrentField + '\n';
                }
                errorDetails += 'Email-Index: ' + (currentEmailIndex + 1) + ' von ' + (jsonData ? jsonData.length : 0) + '\n';
                errorDetails += 'Betreff: ' + currentEmailBetreff + '\n\n';
                errorDetails += 'Fehlermeldung: ' + e.message + '\n';
                if (e.number) errorDetails += 'Fehlernummer: ' + e.number + '\n';

                // Try to get email data for debugging
                if (currentEmailIndex >= 0 && jsonData && jsonData[currentEmailIndex]) {
                    var debugEmail = jsonData[currentEmailIndex];
                    errorDetails += '\n=== Email-Daten ===\n';
                    errorDetails += 'Datum: ' + (debugEmail.datum || '') + '\n';
                    errorDetails += 'Von: ' + (debugEmail.von_name || debugEmail.von_email || '') + '\n';
                    errorDetails += 'Betreff: ' + (debugEmail.betreff || '') + '\n';
                    errorDetails += 'Kategorie: ' + (debugEmail.kategorie || '') + '\n';
                    errorDetails += 'Clusters: ' + ((debugEmail.clusters || []).join(', ')) + '\n';
                    errorDetails += 'Text-Länge: ' + (debugEmail.text ? debugEmail.text.length : 0) + ' Zeichen\n';
                    errorDetails += 'Antworten: ' + (debugEmail.antworten ? debugEmail.antworten.length : 0) + '\n';

                    // Show first 200 chars of text to check for problematic characters
                    if (debugEmail.text) {
                        errorDetails += '\n=== Text-Anfang (200 Zeichen) ===\n';
                        errorDetails += debugEmail.text.substring(0, 200) + '\n';
                    }
                }

                document.getElementById('importErrorMsg').innerHTML =
                    '<textarea readonly style="width:100%;height:250px;font-size:11px;background:#1a1a2e;color:#ef4444;border:1px solid #ef4444;padding:8px;font-family:monospace;" onclick="this.select()">' +
                    errorDetails.replace(/</g, '&lt;').replace(/>/g, '&gt;') +
                    '</textarea><br><small>Klicken zum Kopieren</small>';
                document.getElementById('btnImport').disabled = false;
            }
        }

        function updateImportProgress(current, total) {
            document.getElementById('importProgressFill').style.width = Math.round((current / total) * 100) + '%';
            document.getElementById('importProgressText').innerText = 'Importiere ' + current + '/' + total + '...';
        }

        // Read existing data from Excel for duplicate checking
        function readExistingData(worksheet) {
            var data = {};
            try {
                var lastRow = worksheet.Cells(worksheet.Rows.Count, 1).End(-4162).Row;
                if (lastRow <= 1) return data;

                // Read date (col 2) and subject (col 12) to create unique keys
                for (var row = 2; row <= lastRow; row++) {
                    var datum = worksheet.Cells(row, 2).Value || '';
                    var betreff = worksheet.Cells(row, 12).Value || '';  // Betreff = col 12

                    if (datum || betreff) {
                        var key = createEmailKey(datum, betreff);
                        data[key] = row;
                    }
                }
            } catch (e) {}
            return data;
        }

        // Create unique key from date and subject
        function createEmailKey(datum, betreff) {
            var dateStr = '';
            if (datum) {
                try {
                    var d = new Date(datum);
                    dateStr = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
                } catch (e) {
                    dateStr = String(datum).substring(0, 10);
                }
            }
            var subjectStr = String(betreff || '').toLowerCase().trim().substring(0, 100);
            return dateStr + '|' + subjectStr;
        }

        // Format replies array to text (newest first, timestamps prominent)
        function formatReplies(antworten) {
            if (!antworten) return '';

            try {
                // Check if it's actually an array-like object
                var len = 0;
                try { len = antworten.length || 0; } catch (e) { return ''; }
                if (len === 0) return '';

                // Don't sort - just process in order (sorting can cause issues with eval-parsed objects)
                var text = '';
                for (var r = 0; r < len && r < 20; r++) {  // Max 20 replies
                    try {
                        var reply = antworten[r];
                        if (!reply) continue;

                        // Safely extract datum and sanitize
                        var replyDatum = '';
                        try {
                            if (reply.datum !== undefined && reply.datum !== null) {
                                replyDatum = sanitizeText('' + reply.datum);
                            }
                        } catch (e) { replyDatum = ''; }

                        // Safely extract text, fix encoding, and sanitize
                        var replyText = '';
                        try {
                            if (reply.text !== undefined && reply.text !== null) {
                                replyText = '' + reply.text;
                                // Apply encoding fix and sanitize (remove emojis)
                                replyText = fixEncoding(replyText);
                                replyText = sanitizeText(replyText);
                            }
                        } catch (e) { replyText = '[Fehler]'; }

                        // Limit each reply to 2000 chars
                        if (replyText.length > 2000) {
                            replyText = replyText.substring(0, 2000) + '...';
                        }

                        // Format: show direction (incoming vs outgoing) - sanitize recipient name
                        var direction = '';
                        if (reply.isIncoming) {
                            direction = '[Eingehend]';
                        } else if (reply.an) {
                            direction = '[An: ' + sanitizeText('' + reply.an) + ']';
                        }

                        text += '=== ' + replyDatum + ' ' + direction + ' ===\n' + replyText + '\n\n';
                    } catch (replyErr) {
                        text += '=== [Fehler beim Lesen dieser Antwort] ===\n\n';
                    }
                }
                return sanitizeText(text.trim());
            } catch (e) {
                return '[Fehler: ' + (e.message || e) + ']';
            }
        }

        // Global for tracking current field being written (for error debugging)
        var _writeRowCurrentField = '';

        // Bold timestamp patterns (=== 2025-12-04T12:34:56 ===) in a cell
        function boldTimestamps(cell) {
            try {
                var text = cell.Value || '';
                if (!text || typeof text !== 'string') return;

                // Find all "=== ... ===" patterns and make them bold
                var pattern = /===[^=]+===/g;
                var match;
                var regex = new RegExp('===[^=]+===', 'g');

                // Get all matches with their positions
                var lastIndex = 0;
                while ((match = regex.exec(text)) !== null) {
                    var start = match.index + 1;  // Excel Characters is 1-based
                    var length = match[0].length;
                    try {
                        cell.Characters(start, length).Font.Bold = true;
                    } catch (e) {
                        // Non-critical, continue
                    }
                }
            } catch (e) {
                // Non-critical formatting error, ignore
            }
        }

        // Write a single email row to Excel
        // Columns: ID, Datum, Kanal, BD-Nummer, Agentur, Absender, Kategorie, Status, In Bearbeitung von,
        //          Cluster, Betreff, Anfrage, Antwort, Diagnose, Workaround, Nächste Schritte,
        //          Lösung, JIRA, Kommunikation, Kommentar, ConversationID (21 columns)
        function writeEmailRow(worksheet, row, email) {
            _writeRowCurrentField = 'Start';

            // Copy formatting from row above (if exists and row > 2)
            if (row > 2) {
                try {
                    _writeRowCurrentField = 'Format kopieren';
                    var sourceRange = worksheet.Range(worksheet.Cells(row - 1, 1), worksheet.Cells(row - 1, 24));
                    var targetRange = worksheet.Range(worksheet.Cells(row, 1), worksheet.Cells(row, 24));
                    sourceRange.Copy();
                    targetRange.PasteSpecial(-4122); // xlPasteFormats = -4122
                    try { worksheet.Application.CutCopyMode = false; } catch(e) {}
                } catch (e) {
                    // Formatting copy failed, continue without it
                }
            }

            _writeRowCurrentField = 'Antworten formatieren';
            var repliesText = '';
            try {
                repliesText = formatReplies(email.antworten);
                // Limit replies to 15000 chars to leave room for user answer
                if (repliesText.length > 15000) {
                    repliesText = repliesText.substring(0, 15000) + '\n\n[... weitere Antworten gekürzt ...]';
                }
            } catch (repliesErr) {
                repliesText = '[Fehler: ' + repliesErr.message + ']';
            }
            _writeRowCurrentField = 'Antworten formatiert (' + repliesText.length + ' Zeichen)';

            _writeRowCurrentField = 'provisionData lesen';
            var pd = email.provisionData || {};

            // Absender: Bei Provisionsreklamation den Vermittlernamen nehmen
            _writeRowCurrentField = 'Absender erstellen';
            var absender = email.von_name || email.von_email || '';
            if (pd.vorname_vermittler || pd.nachname_vermittler) {
                absender = ((pd.vorname_vermittler || '') + ' ' + (pd.nachname_vermittler || '')).trim();
            }
            absender = fixEncoding(absender);  // Fix encoding for names

            // Agentur mit Encoding-Fix
            _writeRowCurrentField = 'Agentur erstellen';
            var agentur = fixEncoding(email.agentur || '');

            // Anfrage/Zusammenfassung: User-edited content has priority
            _writeRowCurrentField = 'Anfrage erstellen';
            var anfrage = '';
            if (email.anfrage && email.anfrage.trim()) {
                // User edited the summary in web app - use that
                anfrage = fixEncoding(email.anfrage);
            } else if (pd.nachricht) {
                // Provisionsreklamation: use nachricht field
                anfrage = fixEncoding(pd.nachricht);
            } else {
                // Fallback to original email text
                anfrage = fixEncoding(email.text || '');
            }

            // BD-Nummer: Aus provisionData oder email
            _writeRowCurrentField = 'BD-Nummer erstellen';
            var bdNummer = pd.vermittlernummer_vermittler || email.vermittlernr || '';

            // Betreff mit Encoding-Fix
            _writeRowCurrentField = 'Betreff erstellen';
            var betreff = fixEncoding(email.betreff || '');

            // Apply fixEncoding to all text fields
            _writeRowCurrentField = 'Kategorie erstellen';
            var kategorie = fixEncoding(email.kategorie || '');

            _writeRowCurrentField = 'Status erstellen';
            var status = fixEncoding(email.status || 'Neu');

            _writeRowCurrentField = 'Clusters erstellen';
            var clusters = fixEncoding((email.clusters || []).join(', '));

            _writeRowCurrentField = 'Kommentar erstellen';
            var kommentar = fixEncoding(email.kommentar || '');

            // Bearbeiter - from email.bearbeiter OR Outlook category
            _writeRowCurrentField = 'Bearbeiter erstellen';
            var bearbeiter = '';
            if (email.bearbeiter) {
                bearbeiter = '' + email.bearbeiter;
            } else if (email.outlookKategorie) {
                // Use Outlook category as Bearbeiter
                bearbeiter = '' + email.outlookKategorie;
            }

            // Combine user's manual answer with automatic replies
            _writeRowCurrentField = 'Antwort-Text erstellen';
            var antwortText = '';
            var userAntwort = '';
            try {
                // Safely get user answer
                if (email.antwort) {
                    userAntwort = String(email.antwort);
                    userAntwort = fixEncoding(userAntwort);
                }
            } catch (e) {
                userAntwort = '[Fehler beim Lesen der Benutzerantwort]';
            }

            if (userAntwort && repliesText) {
                antwortText = userAntwort + '\n\n--- Gefundene Antworten ---\n\n' + repliesText;
            } else {
                antwortText = userAntwort || repliesText || '';
            }

            // Write each cell with error tracking
            _writeRowCurrentField = 'Spalte 1 (ID)';
            worksheet.Cells(row, 1).Value = 'HC-' + (row - 1);           // ID

            _writeRowCurrentField = 'Spalte 2 (Datum)';
            // Format date as German date (DD.MM.YYYY HH:MM)
            try {
                var datumValue = email.datum || '';
                if (datumValue) {
                    var d = new Date(datumValue);
                    if (!isNaN(d.getTime())) {
                        // Format as ISO-like string that Excel recognizes: YYYY-MM-DD HH:MM:SS
                        var excelDateStr = d.getFullYear() + '-' +
                            pad(d.getMonth() + 1) + '-' +
                            pad(d.getDate()) + ' ' +
                            pad(d.getHours()) + ':' +
                            pad(d.getMinutes()) + ':' +
                            pad(d.getSeconds());
                        worksheet.Cells(row, 2).Value = excelDateStr;
                        worksheet.Cells(row, 2).NumberFormat = 'DD.MM.YYYY HH:MM';
                    } else {
                        worksheet.Cells(row, 2).Value = datumValue;
                    }
                } else {
                    worksheet.Cells(row, 2).Value = '';
                }
            } catch (dateErr) {
                worksheet.Cells(row, 2).Value = email.datum || '';
            }

            // Spalte 3: Datum neuste Antwort
            _writeRowCurrentField = 'Spalte 3 (Datum neuste Antwort)';
            try {
                var latestReplyDate = '';
                if (email.antworten && email.antworten.length > 0) {
                    // Find the newest reply date
                    var newestDate = null;
                    for (var rd = 0; rd < email.antworten.length; rd++) {
                        var replyDatum = email.antworten[rd].datum;
                        if (replyDatum) {
                            var replyD = new Date(replyDatum);
                            if (!isNaN(replyD.getTime())) {
                                if (!newestDate || replyD > newestDate) {
                                    newestDate = replyD;
                                }
                            }
                        }
                    }
                    if (newestDate) {
                        var replyDateStr = newestDate.getFullYear() + '-' +
                            pad(newestDate.getMonth() + 1) + '-' +
                            pad(newestDate.getDate()) + ' ' +
                            pad(newestDate.getHours()) + ':' +
                            pad(newestDate.getMinutes()) + ':' +
                            pad(newestDate.getSeconds());
                        worksheet.Cells(row, 3).Value = replyDateStr;
                        worksheet.Cells(row, 3).NumberFormat = 'DD.MM.YYYY HH:MM';
                    } else {
                        worksheet.Cells(row, 3).Value = '';
                    }
                } else {
                    worksheet.Cells(row, 3).Value = '';
                }
            } catch (replyDateErr) {
                worksheet.Cells(row, 3).Value = '';
            }

            _writeRowCurrentField = 'Spalte 4 (Kanal)';
            worksheet.Cells(row, 4).Value = 'Email';                     // Kanal

            // BD-Nummer als Text speichern (führende Nullen erhalten)
            _writeRowCurrentField = 'Spalte 5 (BD-Nummer Format)';
            worksheet.Cells(row, 5).NumberFormat = '@';

            _writeRowCurrentField = 'Spalte 5 (BD-Nummer Wert)';
            worksheet.Cells(row, 5).Value = bdNummer;                    // BD-Nummer

            _writeRowCurrentField = 'Spalte 6 (Agentur)';
            worksheet.Cells(row, 6).Value = agentur;                     // Agentur

            _writeRowCurrentField = 'Spalte 7 (Absender)';
            worksheet.Cells(row, 7).Value = absender;                    // Absender

            _writeRowCurrentField = 'Spalte 8 (Kategorie)';
            worksheet.Cells(row, 8).Value = kategorie;                   // Kategorie

            _writeRowCurrentField = 'Spalte 9 (Status)';
            worksheet.Cells(row, 9).Value = status;                      // Status

            _writeRowCurrentField = 'Spalte 10 (Bearbeiter)';
            worksheet.Cells(row, 10).Value = bearbeiter;                 // In Bearbeitung von

            _writeRowCurrentField = 'Spalte 11 (Cluster)';
            worksheet.Cells(row, 11).Value = clusters;                   // Cluster

            _writeRowCurrentField = 'Spalte 12 (Betreff)';
            worksheet.Cells(row, 12).Value = betreff;                    // Betreff

            _writeRowCurrentField = 'Spalte 13 (Anfrage)';
            worksheet.Cells(row, 13).Value = sanitizeForExcel(anfrage);  // Anfrage

            _writeRowCurrentField = 'Spalte 14 (Antwort) - Vorbereiten';
            var safeAntwort = '';
            try {
                _writeRowCurrentField = 'Spalte 14 (Antwort) - fixEncoding';
                safeAntwort = fixEncoding(antwortText);
                _writeRowCurrentField = 'Spalte 14 (Antwort) - sanitize';
                safeAntwort = sanitizeForExcel(safeAntwort);

                // Set cell format to text first
                _writeRowCurrentField = 'Spalte 14 (Antwort) - Format';
                worksheet.Cells(row, 14).NumberFormat = '@';

                _writeRowCurrentField = 'Spalte 14 (Antwort) - schreiben (' + safeAntwort.length + ' Zeichen)';

                // Try writing - if fails, try progressively simpler text
                try {
                    worksheet.Cells(row, 14).Value = safeAntwort;
                } catch (writeErr1) {
                    // First fallback: remove only control characters, keep umlauts
                    _writeRowCurrentField = 'Spalte 14 (Antwort) - Fallback (ohne Steuerzeichen)';
                    var cleanText = '';
                    var maxLen = Math.min(safeAntwort.length, 10000);
                    for (var c = 0; c < maxLen; c++) {
                        var code = safeAntwort.charCodeAt(c);
                        // Keep printable ASCII (32-126), extended Latin (128-255), newline, CR, tab
                        if ((code >= 32 && code <= 255) || code === 10 || code === 13 || code === 9) {
                            cleanText += safeAntwort.charAt(c);
                        }
                        // Skip control chars 0-8, 11-12, 14-31 and chars > 255
                    }
                    try {
                        worksheet.Cells(row, 14).Value = cleanText;
                    } catch (writeErr2) {
                        // Second fallback: shorter text
                        try {
                            worksheet.Cells(row, 14).Value = cleanText.substring(0, 2000);
                        } catch (writeErr3) {
                            // Third fallback: just a message
                            try {
                                worksheet.Cells(row, 14).Value = '[Antwort konnte nicht geschrieben werden - ' + (email.antworten ? email.antworten.length : 0) + ' Antworten]';
                            } catch (e3) {
                                // Skip
                            }
                        }
                    }
                }
            } catch (antwortErr) {
                // Error in preparation - write error message
                _writeRowCurrentField = 'Spalte 14 (Antwort) - Fehler';
                try {
                    worksheet.Cells(row, 14).Value = '[FEHLER: ' + antwortErr.message + ']';
                } catch (e2) {
                    // Can't even write error - skip
                }
            }

            // Bold the timestamps in reply cell (=== 2025-12-04T12:34:56 ===)
            _writeRowCurrentField = 'Spalte 14 (Antwort) - Timestamps fetten';
            boldTimestamps(worksheet.Cells(row, 14));

            _writeRowCurrentField = 'Spalte 15-20 (Leere Felder)';
            worksheet.Cells(row, 15).Value = '';                         // Diagnose
            worksheet.Cells(row, 16).Value = '';                         // Workaround
            worksheet.Cells(row, 17).Value = '';                         // Nächste Schritte
            worksheet.Cells(row, 18).Value = '';                         // Lösung
            worksheet.Cells(row, 19).Value = '';                         // JIRA
            worksheet.Cells(row, 20).Value = '';                         // Kommunikation

            _writeRowCurrentField = 'Spalte 21 (Kommentar)';
            worksheet.Cells(row, 21).Value = kommentar;                  // Kommentar

            _writeRowCurrentField = 'Spalte 22 (ConversationID)';
            worksheet.Cells(row, 22).Value = email.conversationId || ''; // ConversationID für Duplikatsprüfung

            _writeRowCurrentField = 'Spalte 23 (EmailID)';
            worksheet.Cells(row, 23).Value = email.emailId || '';        // Unique EntryID for precise duplicate detection

            // Collect all reply IDs (new ones being added)
            _writeRowCurrentField = 'Spalte 24 (ReplyIDs)';
            var replyIdList = '';
            try {
                var replyIds = [];
                if (email.antworten && email.antworten.length > 0) {
                    for (var ri = 0; ri < email.antworten.length; ri++) {
                        if (email.antworten[ri].replyId) {
                            replyIds.push(email.antworten[ri].replyId);
                        }
                    }
                }
                replyIdList = replyIds.join(',');
            } catch (e) {}
            worksheet.Cells(row, 24).Value = replyIdList;                // Comma-separated reply EntryIDs

            _writeRowCurrentField = 'Fertig';
        }

        // Fix UTF-8 encoding issues (mojibake: Ã¼ -> ü, ÃŸ -> ß, etc.)
        function fixEncoding(text) {
            if (!text) return '';
            var result = String(text);

            // Method 1: Direct string replacements (most reliable for common patterns)
            // German umlauts and ß
            result = result.split('Ã¤').join('ä');
            result = result.split('Ã„').join('Ä');
            result = result.split('Ã¶').join('ö');
            result = result.split('Ã–').join('Ö');
            result = result.split('Ã¼').join('ü');
            result = result.split('Ãœ').join('Ü');
            result = result.split('ÃŸ').join('ß');
            result = result.split('Ã\u009F').join('ß');  // Alternative encoding

            // Other common characters
            result = result.split('Ã©').join('é');
            result = result.split('Ã¨').join('è');
            result = result.split('Ã ').join('à');
            result = result.split('Ã¡').join('á');
            result = result.split('Ã¢').join('â');
            result = result.split('Ã£').join('ã');
            result = result.split('Ã§').join('ç');
            result = result.split('Ã±').join('ñ');

            // Smart quotes and special punctuation (â€ sequences)
            result = result.split('â€œ').join('"');
            result = result.split('â€').join('"');
            result = result.split('â€˜').join("'");
            result = result.split('â€™').join("'");
            result = result.split('â€"').join('–');
            result = result.split('â€"').join('—');
            result = result.split('â€¦').join('...');
            result = result.split('â€ž').join('„');
            result = result.split('"ž').join('„');  // Alternative pattern for „
            result = result.split('"œ').join('"');  // Alternative pattern for "
            result = result.split("'").join("'");   // Curly apostrophe
            result = result.split('Â´').join("'");  // Acute accent as apostrophe

            // Section symbol and other
            result = result.split('Â§').join('§');
            result = result.split('Â°').join('°');
            result = result.split('Â®').join('®');
            result = result.split('Â©').join('©');
            result = result.split('Â»').join('»');
            result = result.split('Â«').join('«');
            result = result.split('Â´').join("'");
            result = result.split('Â ').join(' ');  // Non-breaking space issue

            // Euro symbol
            result = result.split('â‚¬').join('€');

            // Method 2: fromCharCode for any remaining patterns
            var replacements = [
                [String.fromCharCode(195, 164), String.fromCharCode(228)],  // ä
                [String.fromCharCode(195, 132), String.fromCharCode(196)],  // Ä
                [String.fromCharCode(195, 182), String.fromCharCode(246)],  // ö
                [String.fromCharCode(195, 150), String.fromCharCode(214)],  // Ö
                [String.fromCharCode(195, 188), String.fromCharCode(252)],  // ü
                [String.fromCharCode(195, 156), String.fromCharCode(220)],  // Ü
                [String.fromCharCode(195, 159), String.fromCharCode(223)],  // ß
                [String.fromCharCode(195, 169), String.fromCharCode(233)],  // é
                [String.fromCharCode(195, 168), String.fromCharCode(232)]   // è
            ];
            for (var i = 0; i < replacements.length; i++) {
                result = result.split(replacements[i][0]).join(replacements[i][1]);
            }

            return result;
        }

        // Sanitize text for safe Excel writing - removes problematic characters
        function sanitizeForExcel(text) {
            if (!text) return '';
            var result = String(text);

            // Remove null characters
            result = result.split(String.fromCharCode(0)).join('');

            // Remove control characters and problematic Unicode (emojis, etc.)
            var cleaned = '';
            for (var i = 0; i < result.length; i++) {
                var code = result.charCodeAt(i);
                // Skip surrogate pairs (emojis) - 0xD800-0xDFFF
                if (code >= 0xD800 && code <= 0xDFFF) {
                    continue;
                }
                // Skip other problematic Unicode ranges
                if (code >= 0xFFFE) {
                    continue;
                }
                // Allow printable ASCII (32+), extended chars (128+), newline (10), carriage return (13), tab (9)
                if (code >= 32 || code === 10 || code === 13 || code === 9) {
                    cleaned += result.charAt(i);
                }
                // Skip control characters 0-8, 11-12, 14-31
            }
            result = cleaned;

            // Limit length to prevent Excel issues (32767 is Excel cell limit)
            if (result.length > 30000) {
                result = result.substring(0, 30000) + '\n\n[... gekürzt ...]';
            }

            return result;
        }

        // JSON polyfill
        if (!window.JSON) {
            window.JSON = {
                stringify: function(obj, rep, space) {
                    function escapeStr(s) {
                        return s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r').replace(/\t/g, '\\t');
                    }
                    var t = typeof obj;
                    if (t !== 'object' || obj === null) {
                        if (t === 'string') obj = '"' + escapeStr(obj) + '"';
                        return String(obj);
                    }
                    var n, v, json = [], arr = (obj && obj.constructor === Array);
                    for (n in obj) {
                        v = obj[n]; t = typeof v;
                        if (t === 'string') v = '"' + escapeStr(v) + '"';
                        else if (t === 'object' && v !== null) v = JSON.stringify(v);
                        else if (t === 'undefined') continue;
                        json.push((arr ? '' : '"' + n + '":') + String(v));
                    }
                    return (arr ? '[' : '{') + String(json) + (arr ? ']' : '}');
                },
                parse: function(text) {
                    // Escape characters that are valid in JSON but cause syntax errors in eval()
                    // U+2028 (Line Separator) and U+2029 (Paragraph Separator)
                    text = text.split('\u2028').join('\\u2028');
                    text = text.split('\u2029').join('\\u2029');
                    return eval('(' + text + ')');
                }
            };
        }
    </script>
</body>
</html>
