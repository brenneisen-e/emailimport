<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <title>Outlook-Regeln visualisieren</title>
    <HTA:APPLICATION
        ID="Outlook_Regeln_Visualisierung"
        APPLICATIONNAME="Outlook-Regeln visualisieren"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="yes"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="1.2"
        WINDOWSTATE="normal"
    />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 1.5rem;
        }
        .container { max-width: 880px; margin: 0 auto; }
        .card {
            background: rgba(30, 41, 59, 0.85);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }
        .header { text-align: center; margin-bottom: 1.25rem; }
        .logo { width: 40px; height: 40px; margin: 0 auto 6px; display: block; }
        h2 { color: #f1f5f9; margin-bottom: 0.25rem; }
        .subtitle { color: #94a3b8; font-size: 13px; }
        .ver { color: #64748b; font-size: 11px; margin-top: 4px; }

        .section {
            background: rgba(0,0,0,0.22);
            border: 1px solid rgba(148,163,184,0.15);
            border-radius: 12px;
            padding: 1rem 1.1rem;
            margin-bottom: 1rem;
        }
        .section-title {
            font-size: 13px; font-weight: 600; color: #e2e8f0;
            margin-bottom: 0.75rem;
        }
        .section-title .tag {
            display: inline-block; font-size: 10px; font-weight: 600;
            color: #94a3b8; border: 1px solid #475569; border-radius: 6px;
            padding: 1px 7px; margin-left: 8px; vertical-align: 1px;
        }

        .hint { font-size: 11px; color: #94a3b8; margin-top: 0.5rem; line-height: 1.5; }

        .quick { margin-bottom: 0.7rem; }
        .quick button {
            padding: 5px 11px; margin-right: 6px; margin-bottom: 4px;
            border: 1px solid #475569; border-radius: 7px;
            background: transparent; color: #cbd5e1;
            font-size: 11.5px; cursor: pointer;
        }
        .quick button:hover { border-color: #ef4444; color: #fff; }

        .store-list {
            max-height: 220px; overflow-y: auto;
            border: 1px solid #475569; border-radius: 8px;
            background: #1e293b; padding: 0.5rem 0.6rem;
        }
        .store-row {
            display: block; color: #e2e8f0; font-size: 12.5px;
            padding: 4px 2px; cursor: pointer; line-height: 1.5;
        }
        .store-row:hover { color: #fff; }
        .store-row input { margin-right: 8px; vertical-align: -1px; }
        .badge {
            display: inline-block; font-size: 10px; font-weight: 600;
            border-radius: 5px; padding: 1px 6px; margin-left: 7px;
            vertical-align: 1px;
        }
        .badge-self { color: #93c5fd; border: 1px solid #3b82f6; }
        .badge-extra { color: #6ee7b7; border: 1px solid #10b981; }
        .badge-file { color: #fcd34d; border: 1px solid #f59e0b; }

        .chk { display: block; color: #cbd5e1; font-size: 12.5px; margin-bottom: 0.35rem; cursor: pointer; }
        .chk input { margin-right: 7px; }

        .btn {
            padding: 12px 22px; border: none; border-radius: 8px;
            cursor: pointer; font-size: 14px; font-weight: 600;
            transition: all 0.2s; width: 100%;
        }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-primary { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); color: white; }
        .btn-primary:hover:not(:disabled) { background: linear-gradient(135deg, #f87171 0%, #dc2626 100%); }

        .progress-container { display: none; margin: 1rem 0 0.25rem; }
        .progress-bar { height: 8px; background: #374151; border-radius: 4px; overflow: hidden; }
        .progress-fill {
            height: 100%; background: linear-gradient(90deg, #ef4444, #f97316);
            width: 0%; transition: width 0.3s;
        }
        .progress-text { font-size: 12px; color: #94a3b8; margin-top: 0.5rem; text-align: center; }

        .log {
            display: none; margin-top: 0.9rem; padding: 0.6rem 0.75rem;
            max-height: 170px; overflow-y: auto;
            background: rgba(0,0,0,0.35); border: 1px solid rgba(148,163,184,0.15);
            border-radius: 8px; font-size: 11.5px; line-height: 1.6;
            font-family: Consolas, 'Courier New', monospace;
        }
        .log div { white-space: pre-wrap; }
        .log .t-info { color: #cbd5e1; }
        .log .t-ok { color: #6ee7b7; }
        .log .t-err { color: #fca5a5; }
        .log .t-head { color: #f1f5f9; font-weight: 600; margin-top: 3px; }
        .log .t-muted { color: #94a3b8; }

        .status { display: none; padding: 0.85rem 1rem; border-radius: 8px; margin: 0.85rem 0 0; font-size: 13px; line-height: 1.5; }
        .status.success { background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; }
        .status.error { background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; }
        .status.info { background: rgba(59, 130, 246, 0.15); border: 1px solid #3b82f6; color: #93c5fd; }

        .foot { text-align: center; color: #64748b; font-size: 11px; margin-top: 1rem; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="header">
                <svg class="logo" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="8" y="2" width="8" height="4" rx="1"/>
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <path d="M12 11h4M12 16h4M8 11h.01M8 16h.01"/>
                </svg>
                <h2>Outlook-Regeln visualisieren</h2>
                <div class="subtitle">Alle Regeln ausgew&auml;hlter (Gruppen-)Postf&auml;cher auslesen und die Logik als Excel-Mappe darstellen</div>
                <div class="ver">v1.2</div>
            </div>

            <!-- Postfaecher -->
            <div class="section">
                <div class="section-title">Postf&auml;cher ausw&auml;hlen <span class="tag">Mehrfachauswahl</span></div>
                <div class="quick">
                    <button onclick="selectAllStores(true)">Alle</button>
                    <button onclick="selectAllStores(false)">Keine</button>
                    <button onclick="selectGroupStores()">Nur Gruppenpostf&auml;cher</button>
                    <button onclick="takeFromOutlook()">Aus Outlook-Auswahl &uuml;bernehmen</button>
                    <button onclick="reconnectOutlook()">Postf&auml;cher neu laden</button>
                </div>
                <div class="store-list" id="storeList">
                    <div class="store-row">Outlook wird verbunden &hellip;</div>
                </div>
                <div class="hint">
                    &bdquo;Gruppenpostf&auml;cher&ldquo; = alle Postf&auml;cher im Outlook-Profil ausser dem eigenen.
                    &bdquo;Aus Outlook-Auswahl &uuml;bernehmen&ldquo; kreuzt das Postfach an, in dem gerade ein Ordner
                    oder eine Mail markiert ist &ndash; f&uuml;r mehrere Postf&auml;cher einfach mehrere H&auml;kchen setzen.
                    <br><b>Wichtig:</b> Regeln eines Gruppenpostfachs sind nur lesbar, wenn das Postfach als
                    vollwertiges Postfach im Profil h&auml;ngt (Konto/weiteres Postfach), nicht bei
                    &bdquo;Ordner eines anderen Benutzers &ouml;ffnen&ldquo;.
                </div>
            </div>

            <!-- Optionen -->
            <div class="section">
                <div class="section-title">Optionen</div>
                <label class="chk">
                    <input type="checkbox" id="chkDisabled" checked>
                    Deaktivierte Regeln mit ausgeben (im Excel als &bdquo;inaktiv&ldquo; markiert)
                </label>
                <label class="chk">
                    <input type="checkbox" id="chkLocal" checked>
                    Nur-lokale Regeln (Client-Regeln) mit ausgeben
                </label>
                <label class="chk">
                    <input type="checkbox" id="chkSend">
                    Auch Regeln f&uuml;r ausgehende Mails (Senden-Regeln) einbeziehen
                </label>
                <label class="chk">
                    <input type="checkbox" id="chkChecks" checked>
                    Blatt &bdquo;Pr&uuml;fhinweise&ldquo; erzeugen (Konflikte, toter Code, Datenabfluss)
                </label>
                <div class="hint">
                    <b>Neu in v1.2:</b> Die Werte von Bedingungen wie &bdquo;Betreff enth&auml;lt&ldquo;, &bdquo;Absenderadresse enth&auml;lt&ldquo;
                    oder &bdquo;Text enth&auml;lt&ldquo; werden jetzt gelesen. Bis v1.1 brach das Lesen dort ab (&bdquo;Zeichenfolge erwartet&ldquo;),
                    und die Regel erschien ohne Bedingung. Bleibt eine Bedingung trotzdem unlesbar, steht das in der Spalte
                    &bdquo;Bedingung lesbar&ldquo; und im Blatt &bdquo;Diagnose&ldquo;.
                </div>
            </div>

            <button class="btn btn-primary" id="btnStart" onclick="startRead()" disabled>Regeln auslesen &amp; Excel erstellen</button>

            <div class="progress-container" id="progressContainer">
                <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
                <div class="progress-text" id="progressText"></div>
            </div>

            <div class="log" id="log"></div>
            <div class="status" id="status"></div>

            <div class="foot">Ben&ouml;tigt Outlook (MAPI) und Excel &middot; l&auml;uft vollst&auml;ndig lokal, keine Daten verlassen den Arbeitsplatz</div>
        </div>
    </div>

<script language="VBScript">
' Hilfe fuer JScript (v1.2): Outlook liefert die Werte einer Bedingung (z. B. TextRuleCondition.Text,
' AddressRuleCondition.Address) als typisiertes String-Array. JScripts VBArray kann das nicht lesen,
' VBScript schon. Rueckgabe: Werte durch Chr(1) getrennt; Chr(2) + Hinweis, wenn nichts lesbar war.
Function VbsListe(v)
    Dim s, i, x, ok
    VbsListe = ""
    On Error Resume Next
    If IsArray(v) Then
        Err.Clear
        s = Join(v, Chr(1))
        If Err.Number = 0 Then
            VbsListe = s
            Exit Function
        End If
        Err.Clear
        s = ""
        ok = True
        For Each x In v
            s = s & CStr(x) & Chr(1)
            If Err.Number <> 0 Then ok = False
        Next
        If ok And Err.Number = 0 Then
            VbsListe = s
            Exit Function
        End If
        Err.Clear
        s = ""
        ok = True
        For i = LBound(v) To UBound(v)
            s = s & CStr(v(i)) & Chr(1)
            If Err.Number <> 0 Then ok = False
        Next
        If ok And Err.Number = 0 Then
            VbsListe = s
            Exit Function
        End If
        VbsListe = Chr(2) & "VarType " & VarType(v)
    Else
        Err.Clear
        s = CStr(v)
        If Err.Number = 0 Then
            VbsListe = s
        Else
            VbsListe = Chr(2) & "VarType " & VarType(v)
        End If
    End If
End Function
</script>
<script language="JScript">
/* =====================================================================
   Outlook-Regeln visualisieren  (HTA / JScript / COM-Automation)
   ---------------------------------------------------------------------
   1) Outlook wird per COM gestartet/verbunden, alle Stores des Profils
      werden als Mehrfachauswahl angeboten (Gruppenpostfaecher inklusive).
   2) Fuer jedes angekreuzte Postfach wird Store.GetRules() gelesen und
      jede Regel in Bedingungen / Ausnahmen / Aktionen zerlegt.
   3) Excel-Mappe mit 6 Blaettern:
        Uebersicht     - eine Zeile pro Regel + Logik in Kurzform
        Regel-Logik    - WENN / UND / AUSSER WENN / DANN je Regel, farbig
        Elemente       - flache Liste aller Bedingungen/Ausnahmen/Aktionen
        Zielordner     - wohin die Regeln Mails schreiben (Mengengeruest)
        Pruefhinweise  - Konflikte, tote Regeln, Datenabfluss, Doppelungen
        Diagnose       - was das Outlook-Objektmodell je Regel liefert

   v1.1: Bedingungen/Ausnahmen haben je Regel einen von drei Zustaenden
        a = Bedingung(en) gelesen
        b = keine Bedingung sichtbar (Objektmodell liefert keine aktive
            Bedingung, kein Fehler) - typisch fuer Regeln aus Outlook im
            Web, deren Bedingung Outlook nicht abbilden kann
        c = Bedingung nicht lesbar (Fehler beim Zugriff)
        b und c werden nicht mehr als "jede eingehende Mail" dargestellt.
        "teilweise" = a, aber ein weiterer Eintrag war nicht lesbar oder
        Outlook meldet eine Bedingung unbekannten Typs (OlRuleConditionType 0).
        Ausnahmen und Aktionen werden genauso gelesen (readRuleBlock).

   JScript + ActiveXObject wie in ergo-mail-statistik.hta. Das Auslesen
   laeuft in kleinen Bloecken pro setTimeout-Tick, damit die HTA nicht
   haengt und der Fortschritt sichtbar bleibt.
   ===================================================================== */

var outlookApp = null;
var outlookNS = null;

var STORES = [];              // { idx, name, storeId, isDefault, isFile }
var readState = null;         // Zustand des laufenden Auslesens
var CHUNK_RULES = 5;          // Regeln pro setTimeout-Tick

/* Outlook-Konstanten */
var OL_RULE_RECEIVE = 0;      // olRuleReceive
var OL_RULE_SEND    = 1;      // olRuleSend

/* ---------------- Bedingungen: benannte Eigenschaften der RuleConditions ----------------
   Reihenfolge = Anzeigereihenfolge im Excel. Nicht vorhandene Eigenschaften
   werfen beim Zugriff und werden uebersprungen (try/catch). */
var COND_DEFS = [
    { prop: 'From',                  label: 'Absender ist' },
    { prop: 'SenderAddress',         label: 'Absenderadresse enthält' },
    { prop: 'SenderInAddressList',   label: 'Absender steht in Adressbuch' },
    { prop: 'SentTo',                label: 'Gesendet an' },
    { prop: 'NotTo',                 label: 'NICHT gesendet an' },
    { prop: 'ToMe',                  label: 'Direkt an mich adressiert' },
    { prop: 'OnlyToMe',              label: 'Nur an mich adressiert' },
    { prop: 'ToOrCc',                label: 'Ich stehe in An oder Cc' },
    { prop: 'CC',                    label: 'Ich stehe in Cc' },
    { prop: 'RecipientAddress',      label: 'Empfängeradresse enthält' },
    { prop: 'Subject',               label: 'Betreff enthält' },
    { prop: 'Body',                  label: 'Mailtext enthält' },
    { prop: 'BodyOrSubject',         label: 'Betreff oder Mailtext enthält' },
    { prop: 'MessageHeader',         label: 'Nachrichtenkopf enthält' },
    { prop: 'Category',              label: 'Kategorie zugewiesen' },
    { prop: 'AnyCategory',           label: 'Irgendeine Kategorie zugewiesen' },
    { prop: 'HasAttachment',         label: 'Hat Anhang' },
    { prop: 'Importance',            label: 'Priorität ist' },
    { prop: 'Sensitivity',           label: 'Vertraulichkeit ist' },
    { prop: 'FormName',              label: 'Formular / Nachrichtenklasse' },
    { prop: 'Account',               label: 'Über Konto empfangen' },
    { prop: 'MeetingInviteOrUpdate', label: 'Ist Besprechungsanfrage / -aktualisierung' },
    { prop: 'FromRssFeed',           label: 'Aus RSS-Feed' },
    { prop: 'FromAnyRSSFeed',        label: 'Aus irgendeinem RSS-Feed' },
    { prop: 'OnLocalMachine',        label: 'Nur auf diesem Computer' },
    { prop: 'OnOtherMachine',        label: 'Nur auf einem anderen Computer' }
];

/* ---------------- Aktionen: benannte Eigenschaften der RuleActions ---------------- */
var ACTION_DEFS = [
    { prop: 'MoveToFolder',        label: 'In Ordner verschieben',            move: true },
    { prop: 'CopyToFolder',        label: 'In Ordner kopieren',               move: true },
    { prop: 'Forward',             label: 'Weiterleiten an',                  out: true },
    { prop: 'ForwardAsAttachment', label: 'Als Anhang weiterleiten an',       out: true },
    { prop: 'Redirect',            label: 'Umleiten an',                      out: true },
    { prop: 'CC',                  label: 'Kopie senden an (Cc)',             out: true },
    { prop: 'Delete',              label: 'Löschen (Gelöschte Elemente)' },
    { prop: 'DeletePermanently',   label: 'Endgültig löschen',      hard: true },
    { prop: 'AssignToCategory',    label: 'Kategorie zuweisen' },
    { prop: 'ClearCategories',     label: 'Kategorien entfernen' },
    { prop: 'MarkAsTask',          label: 'Zur Nachverfolgung markieren' },
    { prop: 'Importance',          label: 'Priorität setzen' },
    { prop: 'Sensitivity',         label: 'Vertraulichkeit setzen' },
    { prop: 'DesktopAlert',        label: 'Desktopbenachrichtigung anzeigen' },
    { prop: 'NewItemAlert',        label: 'Hinweisfenster anzeigen' },
    { prop: 'PlaySound',           label: 'Sound abspielen' },
    { prop: 'NotifyDelivery',      label: 'Übermittlungsbestätigung anfordern' },
    { prop: 'NotifyRead',          label: 'Lesebestätigung anfordern' },
    { prop: 'Stop',                label: 'Keine weiteren Regeln anwenden',   stop: true }
];

var IMPORTANCE_TEXT  = ['Niedrig', 'Normal', 'Hoch'];
var SENSITIVITY_TEXT = ['Normal', 'Persönlich', 'Privat', 'Vertraulich'];

/* ---------------- Typ-Tabellen (Microsoft Learn) ----------------
   OlRuleConditionType bzw. OlRuleActionType -> deutsches Label. Genutzt fuer
   Eintraege, die nur ueber den Index (Item(k)) gefunden werden, und fuer das
   Blatt "Diagnose". Labels der benannten Eigenschaften (COND_DEFS /
   ACTION_DEFS) sind hier gleich lautend uebernommen. */
var COND_TYPE_LABELS = {
    0:  'Unbekannte Bedingung (für Outlook nicht lesbar)',
    1:  'Absender ist',
    2:  'Betreff enthält',
    3:  'Über Konto empfangen',
    4:  'Nur an mich adressiert',
    5:  'Direkt an mich adressiert',
    6:  'Priorität ist',
    7:  'Vertraulichkeit ist',
    8:  'Zur Nachverfolgung gekennzeichnet',
    9:  'Ich stehe in Cc',
    10: 'Ich stehe in An oder Cc',
    11: 'NICHT gesendet an',
    12: 'Gesendet an',
    13: 'Mailtext enthält',
    14: 'Betreff oder Mailtext enthält',
    15: 'Nachrichtenkopf enthält',
    16: 'Empfängeradresse enthält',
    17: 'Absenderadresse enthält',
    18: 'Kategorie zugewiesen',
    19: 'Ist eine Abwesenheitsnotiz (automatische Antwort)',
    20: 'Hat Anhang',
    21: 'Größe im Bereich (Werte nicht lesbar)',
    22: 'Empfangen im Zeitraum (Werte nicht lesbar)',
    23: 'Formular / Nachrichtenklasse',
    24: 'Eigenschaft hat bestimmten Wert (Werte nicht lesbar)',
    25: 'Absender steht in Adressbuch',
    26: 'Ist Besprechungsanfrage / -aktualisierung',
    27: 'Nur auf diesem Computer',
    28: 'Nur auf einem anderen Computer',
    29: 'Irgendeine Kategorie zugewiesen',
    30: 'Aus RSS-Feed',
    31: 'Aus irgendeinem RSS-Feed'
};

/* Bedingungstypen, deren Werte Outlook nicht herausgibt. Zwei solche
   Bedingungen sehen gleich aus, koennen aber Verschiedenes pruefen - sie
   zaehlen deshalb nie als "gleiche Bedingung" (Doppelungen, toter Code). */
var COND_TYPES_OPAQUE = { 0: true, 8: true, 21: true, 22: true, 24: true };

var ACTION_TYPE_LABELS = {
    0:  'Unbekannte Aktion (für Outlook nicht lesbar)',
    1:  'In Ordner verschieben',
    2:  'Kategorie zuweisen',
    3:  'Löschen (Gelöschte Elemente)',
    4:  'Endgültig löschen',
    5:  'In Ordner kopieren',
    6:  'Weiterleiten an',
    7:  'Als Anhang weiterleiten an',
    8:  'Umleiten an',
    9:  'Vom Server mit bestimmter Nachricht antworten',
    10: 'Mit Vorlage antworten',
    11: 'Zur Nachverfolgung in Tagen kennzeichnen',
    12: 'Mit farbiger Kennzeichnung markieren',
    13: 'Kennzeichnung entfernen',
    14: 'Priorität setzen',
    15: 'Vertraulichkeit setzen',
    16: 'Drucken',
    17: 'Sound abspielen',
    18: 'Anwendung starten',
    19: 'Als gelesen markieren',
    20: 'Skript ausführen',
    21: 'Keine weiteren Regeln anwenden',
    22: 'Benutzerdefinierte Aktion',
    23: 'Hinweisfenster anzeigen',
    24: 'Desktopbenachrichtigung anzeigen',
    25: 'Lesebestätigung anfordern',
    26: 'Übermittlungsbestätigung anfordern',
    27: 'Kopie senden an (Cc)',
    28: 'Übermittlung verzögern',
    30: 'Kategorien entfernen',
    41: 'Zur Nachverfolgung markieren'
};

/* Zustaende der Bedingungen einer Regel (v1.1) */
var COND_READ    = 'a';       // Bedingung(en) gelesen
var COND_NONE    = 'b';       // keine Bedingung sichtbar (kein Fehler)
var COND_ERROR   = 'c';       // Bedingung nicht lesbar (Fehler beim Zugriff)

var OWA_HINT = 'in Outlook im Web unter Einstellungen › E-Mail › Regeln nachsehen';

/* ---------------- Init ---------------- */
window.onload = function () {
    try { window.resizeTo(920, 980); } catch (e) {}
    connectOutlook();
};

function connectOutlook() {
    try {
        outlookApp = new ActiveXObject("Outlook.Application");
        outlookNS = outlookApp.GetNamespace("MAPI");
        loadStores();
    } catch (e) {
        document.getElementById('storeList').innerHTML =
            '<div class="store-row">&ndash; keine Verbindung &ndash;</div>';
        showError("Outlook konnte nicht verbunden werden. Bitte Outlook &ouml;ffnen und &bdquo;Postf&auml;cher neu laden&ldquo; klicken. (" + esc(e.message) + ")");
    }
}

function reconnectOutlook() {
    hideStatus();
    connectOutlook();
}

/* ---------------- UI-Helfer ---------------- */
function esc(s) {
    return String(s === null || typeof s === 'undefined' ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function trim(s) { return String(s === null || typeof s === 'undefined' ? '' : s).replace(/^\s+|\s+$/g, ''); }
function pad(n) { return n < 10 ? '0' + n : '' + n; }

function showStatus(cls, html) {
    var el = document.getElementById('status');
    el.className = 'status ' + cls;
    el.style.display = 'block';
    el.innerHTML = html;
}
function showError(html)   { showStatus('error', html); }
function showInfo(html)    { showStatus('info', html); }
function showSuccess(html) { showStatus('success', html); }
function hideStatus() { document.getElementById('status').style.display = 'none'; }

function showProgress(text) {
    document.getElementById('progressContainer').style.display = 'block';
    setProgress(0, text);
}
function setProgress(pct, text) {
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressText').innerHTML = text;
}
function hideProgress() {
    document.getElementById('progressContainer').style.display = 'none';
}

/* Log: echte Umlaute im String-Literal, Escaping macht log() selbst. */
function log(msg, type) {
    var box = document.getElementById('log');
    box.style.display = 'block';
    var d = new Date();
    var line = document.createElement('div');
    line.className = 't-' + (type || 'info');
    line.innerHTML = '<span class="t-muted">' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + '</span>  ' + esc(msg);
    box.appendChild(line);
    box.scrollTop = box.scrollHeight;
}
function clearLog() {
    var box = document.getElementById('log');
    box.innerHTML = '';
    box.style.display = 'none';
}

/* ---------------- Postfaecher laden ---------------- */
function loadStores() {
    STORES = [];
    var listEl = document.getElementById('storeList');
    listEl.innerHTML = '';

    var defaultId = '';
    try { defaultId = String(outlookNS.DefaultStore.StoreID); } catch (e) {}

    try {
        var stores = outlookNS.Stores;
        for (var i = 1; i <= stores.Count; i++) {
            try {
                var store = stores.Item(i);
                var name = '';
                try { name = String(store.DisplayName); } catch (eN) { name = 'Postfach ' + i; }
                var sid = '';
                try { sid = String(store.StoreID); } catch (eS) {}
                var isFile = false;
                try { isFile = !!store.IsDataFileStore; } catch (eF) {}
                STORES.push({
                    idx: i,
                    name: name,
                    storeId: sid,
                    isDefault: (sid !== '' && sid === defaultId),
                    isFile: isFile
                });
            } catch (eItem) {}
        }
    } catch (e) {
        listEl.innerHTML = '<div class="store-row">&ndash; Fehler &ndash;</div>';
        showError("Postf&auml;cher konnten nicht geladen werden: " + esc(e.message));
        return;
    }

    if (STORES.length === 0) {
        listEl.innerHTML = '<div class="store-row">&ndash; keine Postf&auml;cher im Profil &ndash;</div>';
        updateStartButton();
        return;
    }

    for (var k = 0; k < STORES.length; k++) {
        var s = STORES[k];
        var lbl = document.createElement('label');
        lbl.className = 'store-row';
        var badge = s.isFile
            ? '<span class="badge badge-file">Datendatei</span>'
            : (s.isDefault
                ? '<span class="badge badge-self">eigenes Postfach</span>'
                : '<span class="badge badge-extra">weiteres Postfach</span>');
        lbl.innerHTML = '<input type="checkbox" id="st' + k + '" onclick="updateStartButton()"> ' +
                        esc(s.name) + badge;
        listEl.appendChild(lbl);
    }

    log('Outlook verbunden – ' + STORES.length + ' Postfach/Postfächer im Profil gefunden.', 'ok');
    selectGroupStores();
    updateStartButton();
}

function setChecked(k, val) {
    var el = document.getElementById('st' + k);
    if (el) el.checked = !!val;
}
function isChecked(k) {
    var el = document.getElementById('st' + k);
    return el ? !!el.checked : false;
}

function selectAllStores(val) {
    for (var k = 0; k < STORES.length; k++) setChecked(k, val);
    updateStartButton();
}

/* Gruppenpostfach-Heuristik: alles ausser dem eigenen Standard-Postfach
   und ausser lokalen Datendateien (PST). */
function selectGroupStores() {
    var any = false;
    for (var k = 0; k < STORES.length; k++) {
        var take = (!STORES[k].isDefault && !STORES[k].isFile);
        setChecked(k, take);
        if (take) any = true;
    }
    if (!any) {
        /* Kein weiteres Postfach im Profil: eigenes vorauswaehlen. */
        for (var j = 0; j < STORES.length; j++) {
            if (!STORES[j].isFile) { setChecked(j, true); break; }
        }
    }
    updateStartButton();
}

/* Postfach der aktuellen Outlook-Auswahl (Ordner bzw. markierte Mails) ankreuzen. */
function takeFromOutlook() {
    hideStatus();
    var found = {};
    var count = 0;
    try {
        var exp = outlookApp.ActiveExplorer();
        if (exp) {
            try {
                var sid = String(exp.CurrentFolder.Store.StoreID);
                if (!found[sid]) { found[sid] = true; count++; }
            } catch (e1) {}
            try {
                var sel = exp.Selection;
                for (var i = 1; i <= sel.Count; i++) {
                    try {
                        var parent = sel.Item(i).Parent;
                        var sid2 = String(parent.Store.StoreID);
                        if (!found[sid2]) { found[sid2] = true; count++; }
                    } catch (e2) {}
                }
            } catch (e3) {}
        }
    } catch (e) {}

    if (count === 0) {
        showInfo("In Outlook ist gerade keine Auswahl erkennbar. Bitte in Outlook einen Ordner des Gruppenpostfachs anklicken (oder eine Mail markieren) und erneut &bdquo;Aus Outlook-Auswahl &uuml;bernehmen&ldquo; dr&uuml;cken &ndash; oder die H&auml;kchen direkt in der Liste setzen.");
        return;
    }

    var hits = 0;
    for (var k = 0; k < STORES.length; k++) {
        var take = !!found[STORES[k].storeId];
        setChecked(k, take);
        if (take) hits++;
    }
    updateStartButton();

    if (hits === 0) {
        showInfo("Das Postfach der Outlook-Auswahl ist in der Liste nicht wiederzufinden. Bitte die H&auml;kchen direkt in der Liste setzen.");
    } else {
        log('Aus Outlook übernommen: ' + hits + ' Postfach/Postfächer angekreuzt.', 'ok');
    }
}

function selectedStores() {
    var out = [];
    for (var k = 0; k < STORES.length; k++) {
        if (isChecked(k)) out.push(STORES[k]);
    }
    return out;
}

function updateStartButton() {
    document.getElementById('btnStart').disabled = (selectedStores().length === 0);
}

/* ---------------- COM-Lesehilfen ---------------- */
/* Eigenschaft lesen, ohne bei nicht vorhandenen Properties abzubrechen. */
function tryGet(obj, prop) {
    try {
        var v = obj[prop];
        return (typeof v === 'undefined') ? null : v;
    } catch (e) { return null; }
}

/* SAFEARRAY (VBArray) oder Einzelwert in ein JS-Array aus Strings wandeln. */
function toList(v) {
    if (v === null || typeof v === 'undefined') return [];
    var out = [];
    var i, s;
    /* 1) Variant-Array (VT_ARRAY|VT_VARIANT) */
    try {
        var arr = new VBArray(v).toArray();
        for (i = 0; i < arr.length; i++) {
            s = safeStr(arr[i]);
            if (s !== '') out.push(s);
        }
        return out;
    } catch (e) {}
    /* 2) Typisiertes Array (VT_ARRAY|VT_BSTR, so liefert Outlook die Werte von
          "Betreff enthaelt", "Absenderadresse enthaelt" usw.) ueber VBScript,
          falls die HTA VBScript ausfuehrt (im IE11-Modus nicht – dann Schritt 3).
          Bis v1.1 brach das Lesen hier mit "Zeichenfolge erwartet" ab. */
    try {
        var j = VbsListe(v);
        if (typeof j === 'string') {
            if (j.charAt(0) === '\x02') {
                out.push('(Werte nicht lesbar, ' + j.substring(1) + ')');
                return out;
            }
            var teile = j.split('\x01');
            for (i = 0; i < teile.length; i++) {
                s = trim(teile[i]);
                if (s !== '') out.push(s);
            }
            return out;
        }
    } catch (e2) {}
    /* 3) Ueber Excel: WorksheetFunction.Transpose wandelt jedes 1D-Array in ein
          Variant-Array, das VBArray lesen kann. Noetig, weil die HTA im IE11-Modus
          laeuft und VBScript dort nicht ausgefuehrt wird. Excel braucht das Tool
          ohnehin; die Hilfsinstanz wird in finishRead wieder beendet. */
    try {
        var xl = xlHilfe();
        if (xl) {
            var tr = xl.WorksheetFunction.Transpose(v);
            var flach = null;
            try { flach = new VBArray(tr).toArray(); } catch (eT) { flach = [tr]; }
            for (i = 0; i < flach.length; i++) {
                s = safeStr(flach[i]);
                if (s !== '') out.push(s);
            }
            if (out.length > 0) return out;
        }
    } catch (e4) {}
    /* 4) JavaScript-Array */
    try {
        if (typeof v === 'object' && typeof v.length === 'number') {
            for (i = 0; i < v.length; i++) {
                s = safeStr(v[i]);
                if (s !== '') out.push(s);
            }
            return out;
        }
    } catch (e3) {}
    /* 5) Einzelwert */
    s = safeStr(v);
    if (s !== '') out.push(s);
    return out;
}

/* Unsichtbare Excel-Hilfsinstanz fuer toList (einmal je Lauf, wird in finishRead beendet). */
var XL_HILFE = null, XL_HILFE_FEHLT = false;
function xlHilfe() {
    if (XL_HILFE) return XL_HILFE;
    if (XL_HILFE_FEHLT) return null;
    try {
        XL_HILFE = new ActiveXObject("Excel.Application");
        try { XL_HILFE.Visible = false; XL_HILFE.DisplayAlerts = false; } catch (e1) {}
    } catch (e) {
        XL_HILFE = null;
        XL_HILFE_FEHLT = true;
    }
    return XL_HILFE;
}
function xlHilfeBeenden() {
    if (!XL_HILFE) return;
    try { XL_HILFE.Quit(); } catch (e) {}
    XL_HILFE = null;
}

/* Wert als Text, ohne Ausnahme: nicht wandelbare COM-Werte ergeben einen Hinweis. */
function safeStr(x) {
    try { return trim(x); } catch (e) {}
    var t = '';
    try { t = typeof x; } catch (e2) {}
    return '(Wert nicht lesbar' + (t !== '' ? ', Typ ' + t : '') + ')';
}

/* Recipients-Collection als Namensliste. */
function recipientList(recs) {
    var out = [];
    if (!recs) return out;
    try {
        for (var i = 1; i <= recs.Count; i++) {
            try {
                var r = recs.Item(i);
                var name = '';
                try { name = trim(r.Name); } catch (e1) {}
                var addr = '';
                try { addr = trim(r.Address); } catch (e2) {}
                if (name === '' && addr === '') continue;
                if (name === '') { out.push(addr); }
                else if (addr !== '' && addr.indexOf('@') !== -1 && addr.toLowerCase() !== name.toLowerCase()) {
                    out.push(name + ' <' + addr + '>');
                } else {
                    out.push(name);
                }
            } catch (eR) {}
        }
    } catch (e) {}
    return out;
}

function quoteList(list) {
    var out = [];
    for (var i = 0; i < list.length; i++) out.push('"' + list[i] + '"');
    return out.join(', ');
}

/* Details einer Bedingung / Aktion lesen. Es wird generisch nach allen
   Eigenschaften gefragt, die die Outlook-Subtypen anbieten koennen. */
function describeRuleItem(obj) {
    var parts = [];
    /* v1.2: jeder Teil einzeln abgesichert - ein nicht lesbarer Wert verdirbt
       nicht mehr die ganze Bedingung (bis v1.1 fiel dann der ganze Block weg). */
    var schritte = [
        function () { var t = toList(tryGet(obj, 'Text')); if (t.length > 0) parts.push(quoteList(t)); },
        function () { var a = toList(tryGet(obj, 'Address')); if (a.length > 0) parts.push(quoteList(a)); },
        function () { var f = toList(tryGet(obj, 'FormName')); if (f.length > 0) parts.push(quoteList(f)); },
        function () { var c = toList(tryGet(obj, 'Categories')); if (c.length > 0) parts.push(c.join(', ')); },
        function () { var r = recipientList(tryGet(obj, 'Recipients')); if (r.length > 0) parts.push(r.join('; ')); },
        function () {
            var folder = tryGet(obj, 'Folder');
            if (folder) { var fp = folderPath(folder); if (fp !== '') parts.push(fp); }
        },
        function () { var acc = tryGet(obj, 'Account'); if (acc) parts.push(safeStr(acc.DisplayName)); },
        function () { var al = tryGet(obj, 'AddressList'); if (al) parts.push(safeStr(al.Name)); },
        function () {
            var imp = tryGet(obj, 'Importance');
            if (typeof imp === 'number' && imp >= 0 && imp <= 2) parts.push(IMPORTANCE_TEXT[imp]);
        },
        function () {
            var sens = tryGet(obj, 'Sensitivity');
            if (typeof sens === 'number' && sens >= 0 && sens <= 3) parts.push(SENSITIVITY_TEXT[sens]);
        },
        function () { var ft = tryGet(obj, 'FlagTo'); if (ft !== null && safeStr(ft) !== '') parts.push(safeStr(ft)); },
        function () { var mi = tryGet(obj, 'MarkInterval'); if (typeof mi === 'number') parts.push('Frist-Code ' + mi); },
        function () { var fi = tryGet(obj, 'FilePath'); if (fi !== null && safeStr(fi) !== '') parts.push(safeStr(fi)); }
    ];
    for (var i = 0; i < schritte.length; i++) {
        try { schritte[i](); } catch (e) { parts.push('(Wert nicht lesbar: ' + errText(e) + ')'); }
    }
    return parts.join(' | ');
}

/* Ordnerpfad eines Ordner-Objekts, robust gegen geloeschte Ordner. */
function folderPath(folder) {
    try {
        var p = trim(folder.FolderPath);
        if (p !== '') return p;
    } catch (e) {}
    try {
        var n = trim(folder.Name);
        if (n !== '') return n;
    } catch (e2) {}
    return '(Ordner nicht verfügbar)';
}

/* Typ-Kennung einer Bedingung/Aktion (fuer die Vollstaendigkeits-Pruefung). */
function itemType(obj) {
    var t = tryGet(obj, 'ConditionType');
    if (typeof t === 'number') return 'C' + t;
    t = tryGet(obj, 'ActionType');
    if (typeof t === 'number') return 'A' + t;
    return '?';
}

/* Deutsches Label zu einer Typ-Kennung ('C19' / 'A20'), '' wenn unbekannt. */
function typeLabel(key) {
    var s = String(key);
    var n = parseInt(s.substring(1), 10);
    if (isNaN(n)) return '';
    var tbl = null;
    if (s.charAt(0) === 'C') tbl = COND_TYPE_LABELS;
    else if (s.charAt(0) === 'A') tbl = ACTION_TYPE_LABELS;
    if (!tbl || !tbl.hasOwnProperty(n)) return '';
    return tbl[n];
}

/* Kennung + Label fuer das Blatt "Diagnose", z. B. "C19 Ist eine Abwesenheitsnotiz ..." */
function typeWithLabel(key) {
    var l = typeLabel(key);
    return l !== '' ? (key + ' ' + l) : String(key);
}

/* Werte der Bedingung fuer Outlook nicht lesbar? (nur Index-Nachlese) */
function isOpaqueType(key) {
    var s = String(key);
    if (s.charAt(0) !== 'C') return true;          // Typ unbekannt: nicht vergleichbar
    var n = parseInt(s.substring(1), 10);
    if (isNaN(n) || !COND_TYPE_LABELS.hasOwnProperty(n)) return true;
    return COND_TYPES_OPAQUE[n] === true;
}

/* Fehlermeldung eines COM-/Script-Fehlers als Text, mit HRESULT falls vorhanden. */
function errText(e) {
    var msg = '';
    try { msg = trim(e && e.message ? e.message : (e && e.description ? e.description : '')); } catch (x) {}
    var code = '';
    try {
        if (e && typeof e.number === 'number' && e.number !== 0) {
            var n = e.number < 0 ? e.number + 4294967296 : e.number;
            code = '0x' + n.toString(16).toUpperCase();
        }
    } catch (x2) {}
    if (msg === '' && code === '') {
        try { msg = trim(e); } catch (x3) {}
        if (msg === '' || msg === '[object Error]' || msg === 'Error') msg = 'unbekannter Fehler';
    }
    if (code === '') return msg;
    if (msg === '') return 'Fehler ' + code;
    return msg + ' (' + code + ')';
}

/* Leeres Diagnose-Objekt fuer einen Bedingungs-/Ausnahmen-/Aktionen-Container. */
function newDiag() {
    return {
        count: -1,          // Anzahl Eintraege laut Outlook (Count), -1 = nicht lesbar
        active: [],         // Typ-Kennungen aktiver Eintraege (Enabled = true)
        inactive: [],       // Typ-Kennungen inaktiver Eintraege
        errors: [],         // Fehlertexte beim Lesen
        countFailed: false, // Count nicht lesbar -> Nachlese ueber den Index unmoeglich
        itemFailed: 0,      // Anzahl Item(k), die beim Lesen geworfen haben
        propsFailed: false  // keine einzige benannte Eigenschaft lesbar
    };
}

/* Alle aktiven Eintraege eines RuleConditions-/RuleActions-Containers lesen.
   Erst die benannten Eigenschaften (mit deutschem Label), danach ueber den
   Index alles, was nicht ueber einen Namen erfasst wurde. Optional fuellt
   diag (siehe newDiag) die Diagnose: Count, aktive/inaktive Typen, Fehler. */
function collectRuleItems(container, defs, diag) {
    var out = [];
    var seen = {};
    if (!diag) diag = newDiag();
    if (!container) return out;

    var propFailed = 0, firstPropErr = '';
    for (var i = 0; i < defs.length; i++) {
        var def = defs[i];
        var obj = null;
        try {
            obj = container[def.prop];
        } catch (eP) {
            propFailed++;
            if (firstPropErr === '') firstPropErr = errText(eP);
            continue;
        }
        if (!obj) continue;
        var enabled = tryGet(obj, 'Enabled');
        if (enabled !== true) continue;
        var t = itemType(obj);
        seen[t] = true;
        var det = '', detFehler = false;
        try { det = describeRuleItem(obj); } catch (eD) { det = '(Werte nicht lesbar: ' + errText(eD) + ')'; detFehler = true; }
        if (det.indexOf('nicht lesbar') !== -1) detFehler = true;
        if (detFehler) diag.errors.push(def.label + ': Werte nicht vollständig lesbar');
        out.push({
            label: def.label,
            detail: det,
            def: def,
            type: t,
            opaque: detFehler
        });
    }
    /* Keine einzige benannte Eigenschaft lesbar: Zugriff gestoert */
    if (defs.length > 0 && propFailed === defs.length) {
        diag.propsFailed = true;
        diag.errors.push('benannte Eigenschaften nicht lesbar: ' + firstPropErr);
    }

    /* Nachlese ueber den Index: Eintraege ohne benannte Eigenschaft (z. B.
       "Ist eine Abwesenheitsnotiz", "Skript ausfuehren"). Dabei werden fuer
       die Diagnose ALLE Eintraege mit Typ und Enabled erfasst. */
    var cnt = null;
    try {
        cnt = container.Count;
    } catch (eC) {
        diag.countFailed = true;
        diag.errors.push('Anzahl der Einträge nicht lesbar: ' + errText(eC));
    }
    if (typeof cnt === 'number') diag.count = cnt;
    else if (!diag.countFailed) {
        diag.countFailed = true;
        diag.errors.push('Anzahl der Einträge nicht lesbar');
    }

    var itemFailed = 0, firstItemErr = '';
    for (var k = 1; typeof cnt === 'number' && k <= cnt; k++) {
        try {
            var it = container.Item(k);
            var key = itemType(it);
            if (tryGet(it, 'Enabled') !== true) {
                diag.inactive.push(key);
                continue;
            }
            diag.active.push(key);
            if (seen[key]) continue;
            seen[key] = true;
            var lbl = typeLabel(key);
            var det2 = '', det2Fehler = false;
            try { det2 = describeRuleItem(it); } catch (eD2) { det2 = '(Werte nicht lesbar: ' + errText(eD2) + ')'; det2Fehler = true; }
            if (det2.indexOf('nicht lesbar') !== -1) det2Fehler = true;
            out.push({
                label: lbl !== '' ? lbl : 'Sonstiges (Typ ' + key + ')',
                detail: det2,
                def: {},
                type: key,
                opaque: det2Fehler || isOpaqueType(key)
            });
        } catch (eIt) {
            itemFailed++;
            if (firstItemErr === '') firstItemErr = errText(eIt);
        }
    }
    if (itemFailed > 0) {
        diag.itemFailed = itemFailed;
        diag.errors.push(itemFailed + ' von ' + cnt + ' Einträgen nicht lesbar: ' + firstItemErr);
    }

    return out;
}

/* Bedingungen, Ausnahmen oder Aktionen einer Regel lesen und den Zustand
   bestimmen: COND_READ (a), COND_NONE (b) oder COND_ERROR (c). Der Zugriff
   auf rule.Conditions / rule.Exceptions / rule.Actions hat ein eigenes try,
   damit ein Fehler nicht mehr still als "keine Bedingung" erscheint.

   Fehler werden in zwei Stufen gewertet:
     schwer  - Container nicht lesbar, Count nicht lesbar, alle Item(k)
               werfen oder gar nichts lesbar: der Inhalt ist unbekannt.
     einzeln - nur einzelne Item(k) werfen, der Rest ist lesbar.
   strict = true (Bedingungen, Aktionen): jeder Fehler zaehlt. Eine Regel
   ohne Bedingung bzw. ohne Aktion ist unplausibel, ein nicht lesbarer
   Eintrag ist dann sehr wahrscheinlich genau die fehlende Bedingung/Aktion.
   strict = false (Ausnahmen): nur schwere Fehler zaehlen. Ohne Ausnahme ist
   der Normalfall; ein einzelner nicht lesbarer Eintrag aendert die Ausgabe
   einer sonst lesbaren Regel nicht und steht nur im Blatt "Diagnose".

   Ergebnis:
     state   - a / b / c
     partial - a, aber ein zaehlender Fehler: weitere Eintraege koennen fehlen
     soft    - Fehler aufgetreten, die nach obiger Regel nicht zaehlen
     error   - alle Fehlertexte (fuer Diagnose und Hinweise) */
function readRuleBlock(rule, prop, defs, strict) {
    var res = { items: [], state: COND_NONE, partial: false, soft: false, error: '', diag: newDiag() };
    var d = res.diag;
    var container = null;
    var hard = false;
    try {
        container = rule[prop];
    } catch (e) {
        d.errors.push('Zugriff fehlgeschlagen: ' + errText(e));
        hard = true;
    }
    if (!hard && !container) {
        d.errors.push('Outlook liefert kein Objekt');
        hard = true;
    }
    if (container) {
        try {
            res.items = collectRuleItems(container, defs, d);
        } catch (e2) {
            d.errors.push('Lesefehler: ' + errText(e2));
            hard = true;
        }
    }
    /* Ueber den Index nicht vollstaendig nachlesbar = schwerer Fehler */
    if (d.countFailed) hard = true;
    if (d.count > 0 && d.itemFailed >= d.count) hard = true;
    if (d.propsFailed && d.count <= 0) hard = true;

    var counts = hard || (strict && d.itemFailed > 0);
    if (res.items.length > 0) {
        res.state = COND_READ;
        res.partial = counts;
    } else {
        res.state = counts ? COND_ERROR : COND_NONE;
    }
    res.soft = (d.errors.length > 0 && !counts);
    res.error = d.errors.join('; ');
    return res;
}

/* ---------------- Regeln auslesen (in Bloecken) ---------------- */
function startRead() {
    hideStatus();
    clearLog();

    var stores = selectedStores();
    if (stores.length === 0) {
        showError("Bitte mindestens ein Postfach ankreuzen.");
        return;
    }

    document.getElementById('btnStart').disabled = true;
    showProgress("Regeln werden gelesen &hellip;");

    readState = {
        stores: stores,
        sIdx: 0,
        rules: null,
        rIdx: 1,
        ruleCount: 0,
        storeName: '',
        rows: [],                 // ein Eintrag pro Regel
        storeStats: [],           // { name, rules, read, error }
        skipped: 0,
        uidSeq: 0,                // laufende Nummer je Regel (readRule)
        includeDisabled: document.getElementById('chkDisabled').checked,
        includeLocal: document.getElementById('chkLocal').checked,
        includeSend: document.getElementById('chkSend').checked,
        withChecks: document.getElementById('chkChecks').checked
    };

    log('Auslesen gestartet für ' + stores.length + ' Postfach/Postfächer.', 'head');
    window.setTimeout(readTick, 60);
}

function readTick() {
    var st = readState;
    if (!st) return;

    try {
        /* Naechstes Postfach oeffnen */
        if (st.rules === null) {
            if (st.sIdx >= st.stores.length) { finishRead(); return; }
            var s = st.stores[st.sIdx];
            st.storeName = s.name;
            setProgress(storePct(st), "Postfach: " + esc(s.name));

            var rules = null;
            var errMsg = '';
            try {
                var store = outlookNS.Stores.Item(s.idx);
                rules = store.GetRules();
            } catch (eG) {
                errMsg = eG.message ? String(eG.message) : 'unbekannter Fehler';
            }

            if (rules === null) {
                st.storeStats.push({ name: s.name, rules: 0, read: 0, error: errMsg });
                log('Postfach "' + s.name + '": Regeln nicht lesbar – ' + errMsg, 'err');
                st.sIdx++;
                window.setTimeout(readTick, 10);
                return;
            }

            st.rules = rules;
            try { st.ruleCount = rules.Count; } catch (eC) { st.ruleCount = 0; }
            st.rIdx = 1;
            st.storeStats.push({ name: s.name, rules: st.ruleCount, read: 0, error: '' });
            log('Postfach "' + s.name + '": ' + st.ruleCount + ' Regel(n) gefunden.', 'ok');
        }

        var stat = st.storeStats[st.storeStats.length - 1];
        var end = Math.min(st.rIdx + CHUNK_RULES - 1, st.ruleCount);

        for (var r = st.rIdx; r <= end; r++) {
            try {
                var rec = readRule(st.rules.Item(r), st.storeName, st);
                if (rec) {
                    st.rows.push(rec);
                    stat.read++;
                    if (rec.condState === COND_ERROR) {
                        log('Regel "' + rec.name + '": Bedingung nicht lesbar – ' + rec.condError, 'err');
                    } else if (rec.condPartial) {
                        log('Regel "' + rec.name + '": Bedingung nur teilweise lesbar – ' + rec.condError, 'err');
                    }
                    if (rec.excState === COND_ERROR) {
                        log('Regel "' + rec.name + '": Ausnahmen nicht lesbar – ' + rec.excError, 'err');
                    } else if (rec.excPartial) {
                        log('Regel "' + rec.name + '": Ausnahmen nur teilweise lesbar – ' + rec.excError, 'err');
                    }
                    if (rec.actState === COND_ERROR) {
                        log('Regel "' + rec.name + '": Aktionen nicht lesbar – ' + rec.actError, 'err');
                    } else if (rec.actPartial) {
                        log('Regel "' + rec.name + '": Aktionen nur teilweise lesbar – ' + rec.actError, 'err');
                    }
                }
            } catch (eR) {
                st.skipped++;
            }
        }

        st.rIdx = end + 1;
        setProgress(storePct(st),
            "Postfach " + esc(st.storeName) + ": " +
            Math.min(st.rIdx - 1, st.ruleCount) + " / " + st.ruleCount + " Regeln gelesen");

        if (st.rIdx > st.ruleCount) {
            st.sIdx++;
            st.rules = null;
        }

        window.setTimeout(readTick, 10);
    } catch (e) {
        hideProgress();
        document.getElementById('btnStart').disabled = false;
        readState = null;
        xlHilfeBeenden();
        showError("Fehler beim Auslesen der Regeln: " + esc(e.message));
    }
}

function storePct(st) {
    var per = 100 / st.stores.length;
    var inner = st.ruleCount > 0 ? Math.min(1, (st.rIdx - 1) / st.ruleCount) : 0;
    return Math.round(st.sIdx * per + inner * per);
}

/* Eine Outlook-Regel in ein flaches Objekt uebersetzen. */
function readRule(rule, mailbox, st) {
    var name = '';
    try { name = trim(rule.Name); } catch (e) {}
    if (name === '') name = '(ohne Namen)';

    var enabled = true;
    try { enabled = !!rule.Enabled; } catch (e) {}
    var order = 0;
    try { order = rule.ExecutionOrder; } catch (e) {}
    var isLocal = false;
    try { isLocal = !!rule.IsLocalRule; } catch (e) {}
    var ruleType = OL_RULE_RECEIVE;
    try { ruleType = rule.RuleType; } catch (e) {}

    /* Filter aus den Optionen */
    if (!enabled && !st.includeDisabled) return null;
    if (isLocal && !st.includeLocal) return null;
    if (ruleType === OL_RULE_SEND && !st.includeSend) return null;

    var condBlock = readRuleBlock(rule, 'Conditions', COND_DEFS, true);
    var excBlock  = readRuleBlock(rule, 'Exceptions', COND_DEFS, false);
    var actBlock  = readRuleBlock(rule, 'Actions', ACTION_DEFS, true);
    var conditions = condBlock.items, exceptions = excBlock.items, actions = actBlock.items;
    /* Bei Ausnahmen ist "keine sichtbar" (b) der Normalfall: Regel ohne Ausnahme. */

    /* Aktive Bedingung unbekannten Typs (OlRuleConditionType 0 bzw. Typ nicht
       lesbar): die Regel hat eine Bedingung, deren Inhalt Outlook nicht kennt. */
    var condUnknown = false;
    for (var u = 0; u < conditions.length; u++) {
        if (conditions[u].type === 'C0' || conditions[u].type === '?') condUnknown = true;
    }

    /* Laufende Nummer: macht nicht vergleichbare Bedingungen eindeutig */
    st.uidSeq = (st.uidSeq || 0) + 1;

    /* Kennzahlen fuer Uebersicht und Pruefhinweise */
    var stop = false, targets = [], outbound = [], hardDelete = false;
    var realActions = 0;
    for (var i = 0; i < actions.length; i++) {
        var a = actions[i];
        var d = a.def || {};
        if (d.stop) { stop = true; continue; }
        realActions++;
        if (d.move && a.detail !== '') targets.push(a.detail);
        if (d.out) outbound.push(a.label + (a.detail !== '' ? ' ' + a.detail : ''));
        if (d.hard) hardDelete = true;
    }

    return {
        uid: st.uidSeq,
        mailbox: mailbox,
        name: name,
        enabled: enabled,
        order: order,
        isLocal: isLocal,
        ruleType: ruleType,
        conditions: conditions,
        exceptions: exceptions,
        actions: actions,
        condState: condBlock.state,
        condPartial: condBlock.partial,
        condUnknown: condUnknown,
        condError: condBlock.error,
        condDiag: condBlock.diag,
        excState: excBlock.state,
        excPartial: excBlock.partial,
        excSoft: excBlock.soft,
        excError: excBlock.error,
        excDiag: excBlock.diag,
        actState: actBlock.state,
        actPartial: actBlock.partial,
        actError: actBlock.error,
        actDiag: actBlock.diag,
        stop: stop,
        realActions: realActions,
        targets: targets,
        outbound: outbound,
        hardDelete: hardDelete
    };
}

/* ---------------- Textbausteine ---------------- */
function itemText(it) {
    return it.detail !== '' ? (it.label + ' ' + it.detail) : it.label;
}
function itemTexts(list, sep) {
    var out = [];
    for (var i = 0; i < list.length; i++) out.push(itemText(list[i]));
    return out.join(sep);
}

/* Zustand der Bedingungen (a/b/c). Regeln mit gelesener Bedingung sind
   immer COND_READ, auch wenn ein Datensatz kein condState traegt. */
function condStateOf(rec) {
    if (rec.conditions.length > 0) return COND_READ;
    return rec.condState === COND_ERROR ? COND_ERROR : COND_NONE;
}
/* Bedingung gelesen (a), aber unvollstaendig: ein weiterer Eintrag war nicht
   lesbar (condPartial) oder Outlook meldet eine Bedingung unbekannten Typs. */
function condIncomplete(rec) {
    return condStateOf(rec) === COND_READ && (rec.condPartial === true || rec.condUnknown === true);
}
/* Bedingung gelesen und vollstaendig (a ohne Einschraenkung) */
function condComplete(rec) {
    return condStateOf(rec) === COND_READ && !condIncomplete(rec);
}
/* Spalte "Bedingung lesbar" in der Uebersicht */
function condStateShort(rec) {
    var s = condStateOf(rec);
    if (s === COND_READ) return condIncomplete(rec) ? 'teilweise' : 'Ja';
    if (s === COND_ERROR) return 'Fehler';
    return 'keine sichtbar';
}
/* Spalte "Zustand" im Blatt Diagnose */
function condStateLong(rec) {
    var state = condStateOf(rec);
    if (state === COND_READ) {
        if (rec.condPartial) return 'a – teilweise gelesen (weitere Bedingung nicht lesbar)';
        if (rec.condUnknown) return 'a – gelesen, aber Bedingung unbekannten Typs';
        return 'a – Bedingung(en) gelesen';
    }
    if (state === COND_ERROR) return 'c – Bedingung nicht lesbar';
    return 'b – keine Bedingung sichtbar';
}

/* Wo die echte Regel nachzusehen ist. Senden-Regeln gibt es in Outlook im
   Web nicht - dort auf die Regelverwaltung von Outlook verweisen. */
var OUTLOOK_HINT = 'in Outlook unter Datei › Regeln und Benachrichtigungen verwalten nachsehen';
function whereToCheck(rec) {
    return rec.ruleType === OL_RULE_SEND ? OUTLOOK_HINT : OWA_HINT;
}

/* Logik in einer Zeile: WENN ... DANN ... AUSSER WENN ... */
function logicText(rec) {
    var state = condStateOf(rec);
    var s;
    if (state === COND_READ) {
        s = 'WENN ' + itemTexts(rec.conditions, ' UND ');
        if (rec.condPartial) s += ' UND ? (weitere Bedingung nicht lesbar: ' + rec.condError + ')';
    } else if (state === COND_ERROR) {
        s = 'WENN Bedingung nicht lesbar (' + rec.condError + ')';
    } else if (rec.ruleType === OL_RULE_SEND) {
        s = 'WENN keine Bedingung sichtbar (gilt für alle gesendeten Mails oder für Outlook nicht lesbar – in Outlook prüfen)';
    } else {
        s = 'WENN keine Bedingung sichtbar (gilt für alle Mails oder in Outlook im Web angelegt – dort prüfen)';
    }
    if (rec.actions.length > 0) {
        s += '  DANN ' + itemTexts(rec.actions, ' + ');
        if (rec.actPartial) s += ' + ? (weitere Aktion nicht lesbar: ' + rec.actError + ')';
    } else if (rec.actState === COND_ERROR) {
        s += '  DANN ? (Aktionen nicht lesbar: ' + rec.actError + ')';
    } else {
        s += '  DANN keine Aktion';
    }
    if (rec.exceptions.length > 0) {
        s += '  AUSSER WENN ' + itemTexts(rec.exceptions, ' ODER ');
        if (rec.excPartial) s += ' ODER ? (weitere Ausnahme nicht lesbar: ' + rec.excError + ')';
    } else if (rec.excState === COND_ERROR) {
        s += '  AUSSER WENN ? (Ausnahmen nicht lesbar: ' + rec.excError + ')';
    }
    if (s.length > 900) s = s.substring(0, 897) + '...';
    return s;
}

/* Vergleichsschluessel einer Bedingung. Bedingungen, deren Werte Outlook
   nicht herausgibt (opaque), bekommen die Regelnummer angehaengt und sind
   damit nie "gleich" mit der Bedingung einer anderen Regel. */
function condKey(rec, it) {
    var k = itemText(it);
    if (it.opaque) k += ' #' + rec.uid;
    return k;
}

/* Signatur der Bedingungen - fuer Doppelungs- und Konfliktpruefung. */
function condSignature(rec) {
    var parts = [];
    for (var i = 0; i < rec.conditions.length; i++) parts.push(condKey(rec, rec.conditions[i]));
    parts.sort();
    return parts.join(' && ');
}
function condSet(rec) {
    var set = {};
    for (var i = 0; i < rec.conditions.length; i++) set[condKey(rec, rec.conditions[i])] = true;
    return set;
}

/* Zusammenfassung fuer Protokoll und Statusmeldung */
function condSummary(rows) {
    var res = { none: 0, error: 0, partial: 0, exc: 0, act: 0 };
    for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var s = condStateOf(r);
        if (s === COND_NONE) res.none++;
        else if (s === COND_ERROR) res.error++;
        else if (condIncomplete(r)) res.partial++;
        /* Ausnahmen/Aktionen mit irgendeinem Lesefehler (auch einzelne Eintraege) */
        if (r.excState === COND_ERROR || r.excPartial || r.excSoft) res.exc++;
        if (r.actState === COND_ERROR || r.actPartial) res.act++;
    }
    return res;
}
function isSubset(small, big) {
    var any = false;
    for (var k in small) {
        if (!small.hasOwnProperty(k)) continue;
        any = true;
        if (!big[k]) return false;
    }
    return any;
}

function ruleTypeText(t) { return t === OL_RULE_SEND ? 'Senden' : 'Empfangen'; }
function jaNein(b) { return b ? 'Ja' : 'Nein'; }
function fmtNow() {
    var d = new Date();
    return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + '.' + d.getFullYear() +
           ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
}

/* ---------------- Abschluss ---------------- */
function finishRead() {
    var st = readState;
    readState = null;
    xlHilfeBeenden();

    setProgress(100, "Regeln gelesen &ndash; Excel wird erstellt &hellip;");
    log('Insgesamt ' + st.rows.length + ' Regel(n) übernommen. Excel-Mappe wird aufgebaut …', 'head');

    /* Kurzer Tick, damit der Fortschritt gerendert wird, bevor Excel-COM blockiert */
    window.setTimeout(function () {
        try {
            if (st.rows.length === 0) {
                hideProgress();
                showError("Es wurden keine Regeln gefunden, die zu den gew&auml;hlten Optionen passen. " +
                          "H&auml;ufigster Grund: Das Gruppenpostfach h&auml;ngt nicht als vollwertiges Postfach im Profil, " +
                          "oder es gibt dort tats&auml;chlich keine Regeln.");
                document.getElementById('btnStart').disabled = false;
                return;
            }

            buildExcel(st);
            hideProgress();

            var sheets = st.withChecks ? 6 : 5;
            var msg = "<b>Fertig!</b><br>" + st.rows.length + " Regel(n) aus " + st.storeStats.length +
                      " Postfach/Postf&auml;chern ausgelesen. Die Excel-Mappe ist ge&ouml;ffnet (" + sheets +
                      " Bl&auml;tter). Bitte manuell speichern.";
            var sum = condSummary(st.rows);
            if (sum.none + sum.error + sum.partial > 0) {
                msg += "<br><i>" + sum.none + " Regel(n) ohne sichtbare Bedingung, " + sum.error + " nicht lesbar" +
                       (sum.partial > 0 ? ", " + sum.partial + " nur teilweise lesbar" : "") +
                       " &ndash; Bedingungen aus Outlook im Web kann Outlook oft nicht lesen. Bitte in Outlook im Web unter " +
                       "Einstellungen &rsaquo; E-Mail &rsaquo; Regeln pr&uuml;fen (Details im Blatt &bdquo;Diagnose&ldquo;).</i>";
            }
            var errs = 0;
            for (var i = 0; i < st.storeStats.length; i++) if (st.storeStats[i].error !== '') errs++;
            if (errs > 0) {
                msg += "<br><i>" + errs + " Postfach/Postf&auml;cher lieferten keine Regeln &ndash; Details im Log und im Blatt &bdquo;&Uuml;bersicht&ldquo;.</i>";
            }
            if (st.skipped > 0) {
                msg += "<br><i>" + st.skipped + " Regel(n) konnten nicht gelesen werden und wurden &uuml;bersprungen.</i>";
            }
            showSuccess(msg);
            log('Excel-Mappe erstellt.', 'ok');
        } catch (e) {
            hideProgress();
            showError("Excel-Export fehlgeschlagen: " + esc(e.message));
            log('Excel-Export fehlgeschlagen: ' + e.message, 'err');
        }
        if (st.rows.length > 0) logCondSummary(st.rows);
        document.getElementById('btnStart').disabled = false;
    }, 60);
}

/* Zusammenfassung am Ende des Protokolls: Regeln ohne sichtbare / lesbare Bedingung */
function logCondSummary(rows) {
    var sum = condSummary(rows);
    var line = 'Bedingungen: ' + sum.none + ' Regel(n) ohne sichtbare Bedingung, ' +
               sum.error + ' nicht lesbar' +
               (sum.partial > 0 ? ', ' + sum.partial + ' nur teilweise lesbar' : '') + '.';
    if (sum.none + sum.error + sum.partial === 0) {
        log(line + ' Alle Bedingungen gelesen.', 'ok');
    } else {
        log(line, 'head');
        if (sum.none > 0) {
            log(sum.none + ' Regel(n) ohne sichtbare Bedingung: Entweder greifen sie wirklich bei allen Mails, oder die ' +
                'Bedingung wurde in Outlook im Web angelegt (z. B. Nachrichtentyp „automatische Antwort“) und ist für ' +
                'Outlook nicht lesbar.', 'info');
        }
        if (sum.error > 0) {
            log(sum.error + ' Regel(n) nicht lesbar: Outlook meldete beim Lesen der Bedingung einen Fehler – ' +
                'welche Bedingung gilt, ist unbekannt.', 'info');
        }
        if (sum.partial > 0) {
            log(sum.partial + ' Regel(n) nur teilweise lesbar: Mindestens eine Bedingung ist unbekannt oder ' +
                'konnte nicht gelesen werden.', 'info');
        }
        log('Bitte ' + OWA_HINT + '. Details im Blatt „Diagnose“.', 'info');
    }
    if (sum.exc > 0) {
        log('Ausnahmen: bei ' + sum.exc + ' Regel(n) nicht vollständig lesbar – Details im Blatt „Diagnose“.', 'info');
    }
    if (sum.act > 0) {
        log('Aktionen: bei ' + sum.act + ' Regel(n) nicht vollständig lesbar – Details im Blatt „Diagnose“.', 'info');
    }
}

/* ---------------- Excel-Ausgabe ---------------- */
/* Excel Interior.Color erwartet R + G*256 + B*65536 */
function rgb(r, g, b) { return r + g * 256 + b * 65536; }

var C_HEAD    = [185, 28, 28];    // Kopfzeile: Rot
var C_RULE    = [30, 41, 59];     // Regelkopf: dunkelblau
var C_COND    = [219, 234, 254];  // Bedingung: hellblau
var C_EXCEPT  = [254, 243, 199];  // Ausnahme: amber
var C_ACTION  = [209, 250, 229];  // Aktion: gruen
var C_GREY    = [243, 244, 246];  // neutral grau
var C_SUM     = [229, 231, 235];  // Summenzeile

function fillRange(sheet, r1, c1, r2, c2, col) {
    try {
        sheet.Range(sheet.Cells(r1, c1), sheet.Cells(r2, c2)).Interior.Color = rgb(col[0], col[1], col[2]);
    } catch (e) {}
}
function styleHeaderRow(sheet, rowNr, colCount) {
    try {
        var hr = sheet.Range(sheet.Cells(rowNr, 1), sheet.Cells(rowNr, colCount));
        hr.Font.Bold = true;
        hr.Interior.Color = rgb(C_HEAD[0], C_HEAD[1], C_HEAD[2]);
        hr.Font.Color = rgb(255, 255, 255);
    } catch (e) {}
}
function freezeBelow(sheet, excel, rowNr) {
    try {
        sheet.Activate();
        sheet.Range("A1").Select();
        excel.ActiveWindow.FreezePanes = false;
        sheet.Cells(rowNr + 1, 1).Select();
        excel.ActiveWindow.FreezePanes = true;
    } catch (e) {}
}
function writeRow(sheet, rowNr, values) {
    for (var i = 0; i < values.length; i++) {
        try { sheet.Cells(rowNr, i + 1).Value = values[i]; } catch (e) {}
    }
}

function buildExcel(st) {
    var rows = st.rows;

    var excel = new ActiveXObject("Excel.Application");
    excel.Visible = true;
    excel.DisplayAlerts = false;
    try { excel.ScreenUpdating = false; } catch (e) {}

    var wb = excel.Workbooks.Add();

    /* Worksheets.Add() legt VOR dem aktiven Blatt an -> in umgekehrter
       Reihenfolge anlegen. Zielreihenfolge:
       Übersicht | Regel-Logik | Elemente | Zielordner | Prüfhinweise | Diagnose */
    var shDiag = null, shChecks = null, shFolders = null, shFlat = null, shLogic = null, shOverview = null;

    shDiag = wb.ActiveSheet;
    try { shDiag.Name = "Diagnose"; } catch (e) {}
    if (st.withChecks) {
        shChecks = wb.Worksheets.Add();
        try { shChecks.Name = "Prüfhinweise"; } catch (e) {}
    }
    shFolders = wb.Worksheets.Add();
    try { shFolders.Name = "Zielordner"; } catch (e) {}
    shFlat = wb.Worksheets.Add();
    try { shFlat.Name = "Elemente"; } catch (e) {}
    shLogic = wb.Worksheets.Add();
    try { shLogic.Name = "Regel-Logik"; } catch (e) {}
    shOverview = wb.Worksheets.Add();
    try { shOverview.Name = "Übersicht"; } catch (e) {}

    try {
        buildOverview(shOverview, excel, st);
        buildLogic(shLogic, excel, st);
        buildFlat(shFlat, excel, st);
        buildFolders(shFolders, excel, st);
        if (shChecks) buildChecks(shChecks, excel, st);
        buildDiag(shDiag, excel, st);
    } finally {
        try { excel.ScreenUpdating = true; } catch (e) {}
        excel.DisplayAlerts = true;
    }

    try { shOverview.Activate(); shOverview.Range("A1").Select(); } catch (e) {}
}

/* ---------- Blatt 1: Übersicht ---------- */
function buildOverview(sh, excel, st) {
    var rows = st.rows;

    sh.Cells(1, 1).Value = "Outlook-Regeln – Übersicht";
    try { sh.Cells(1, 1).Font.Bold = true; sh.Cells(1, 1).Font.Size = 14; } catch (e) {}
    sh.Cells(2, 1).Value = "Erstellt am:";
    sh.Cells(2, 2).Value = fmtNow();
    sh.Cells(3, 1).Value = "Postfächer:";
    var names = [], errLines = [];
    for (var i = 0; i < st.storeStats.length; i++) {
        var s = st.storeStats[i];
        names.push(s.name + " (" + s.rules + " Regeln)");
        if (s.error !== '') errLines.push(s.name + ": " + s.error);
    }
    sh.Cells(3, 2).Value = names.join("  |  ");
    sh.Cells(4, 1).Value = "Regeln ausgegeben:";
    sh.Cells(4, 2).Value = rows.length;
    sh.Cells(5, 1).Value = "Optionen:";
    sh.Cells(5, 2).Value =
        (st.includeDisabled ? "inkl. deaktivierte" : "nur aktive") + ", " +
        (st.includeLocal ? "inkl. Nur-lokale" : "ohne Nur-lokale") + ", " +
        (st.includeSend ? "inkl. Senden-Regeln" : "nur Empfangen-Regeln");
    var metaRow = 6;
    if (errLines.length > 0) {
        sh.Cells(metaRow, 1).Value = "Nicht lesbar:";
        sh.Cells(metaRow, 2).Value = errLines.join("  |  ");
        metaRow++;
    }
    for (var m = 2; m < metaRow; m++) { try { sh.Cells(m, 1).Font.Bold = true; } catch (e) {} }

    var headRow = metaRow + 1;
    /* Spalten: A Nr | B Postfach | C Reihenfolge | D Regelname | E Aktiv | F Regeltyp |
       G Gültigkeit | H Bedingungen | I Bedingung lesbar | J Ausnahmen | K Aktionen |
       L Stopp danach | M Zielordner | N Logik */
    var headers = ["Nr", "Postfach", "Reihenfolge", "Regelname", "Aktiv", "Regeltyp", "Gültigkeit",
                   "Bedingungen", "Bedingung lesbar", "Ausnahmen", "Aktionen", "Stopp danach", "Zielordner",
                   "Logik (WENN / DANN / AUSSER WENN)"];
    writeRow(sh, headRow, headers);
    styleHeaderRow(sh, headRow, headers.length);

    /* Sortierung: Postfach, dann Ausführungsreihenfolge */
    var sorted = rows.slice(0);
    sorted.sort(function (a, b) {
        if (a.mailbox < b.mailbox) return -1;
        if (a.mailbox > b.mailbox) return 1;
        return a.order - b.order;
    });

    var row = headRow + 1;
    for (var r = 0; r < sorted.length; r++) {
        var rec = sorted[r];
        writeRow(sh, row, [
            r + 1,
            rec.mailbox,
            rec.order,
            rec.name,
            jaNein(rec.enabled),
            ruleTypeText(rec.ruleType),
            rec.isLocal ? "Nur auf diesem Client" : "Server (immer)",
            rec.conditions.length,
            condStateShort(rec),
            rec.exceptions.length,
            rec.realActions,
            jaNein(rec.stop),
            rec.targets.join(" | "),
            logicText(rec)
        ]);
        if (!rec.enabled) {
            fillRange(sh, row, 1, row, headers.length, C_GREY);
            try { sh.Range(sh.Cells(row, 1), sh.Cells(row, headers.length)).Font.Italic = true; } catch (e) {}
        }
        /* Spalte I "Bedingung lesbar": teilweise / keine sichtbar / Fehler hervorheben */
        if (!condComplete(rec)) fillRange(sh, row, 9, row, 9, C_EXCEPT);
        row++;
    }

    try { sh.Range(sh.Cells(headRow, 1), sh.Cells(row - 1, headers.length)).AutoFilter(); } catch (e) {}
    try {
        sh.Columns("A:L").AutoFit();
        sh.Columns("D:D").ColumnWidth = 34;
        sh.Columns("M:M").ColumnWidth = 32;
        sh.Columns("N:N").ColumnWidth = 90;
        sh.Cells(3, 2).ColumnWidth = 30;
    } catch (e) {}
    freezeBelow(sh, excel, headRow);
}

/* ---------- Blatt 2: Regel-Logik (Blockdarstellung) ---------- */
function buildLogic(sh, excel, st) {
    var rows = st.rows.slice(0);
    rows.sort(function (a, b) {
        if (a.mailbox < b.mailbox) return -1;
        if (a.mailbox > b.mailbox) return 1;
        return a.order - b.order;
    });

    sh.Cells(1, 1).Value = "Regel-Logik im Detail";
    try { sh.Cells(1, 1).Font.Bold = true; sh.Cells(1, 1).Font.Size = 14; } catch (e) {}
    sh.Cells(2, 1).Value = "Legende:";
    sh.Cells(2, 2).Value = "Bedingungen sind UND-verknüpft (alle müssen zutreffen). " +
                           "Jede einzelne Ausnahme verhindert die Regel. " +
                           "Aktionen laufen von oben nach unten; \"Keine weiteren Regeln anwenden\" beendet die Kette. " +
                           "\"Keine Bedingung sichtbar\" / \"Bedingung nicht lesbar\" / \"weitere Bedingung nicht lesbar\": " +
                           "Outlook liefert die Bedingung nicht oder nicht vollständig (oft in Outlook im Web angelegt) – " +
                           "dort prüfen, Details im Blatt \"Diagnose\". Gelbe Bezeichnung in WENN-/UND-/DANN-Zeilen = nicht (vollständig) lesbar.";
    try { sh.Cells(2, 1).Font.Bold = true; } catch (e) {}

    var headRow = 4;
    writeRow(sh, headRow, ["Postfach", "Nr", "Block", "Bezeichnung", "Details"]);
    styleHeaderRow(sh, headRow, 5);

    var row = headRow + 1;
    var lastMailbox = null;

    for (var r = 0; r < rows.length; r++) {
        var rec = rows[r];

        /* Trennzeile je Postfach */
        if (rec.mailbox !== lastMailbox) {
            if (lastMailbox !== null) row++;
            sh.Cells(row, 1).Value = "POSTFACH: " + rec.mailbox;
            try {
                var mr = sh.Range(sh.Cells(row, 1), sh.Cells(row, 5));
                mr.Font.Bold = true;
                mr.Interior.Color = rgb(C_HEAD[0], C_HEAD[1], C_HEAD[2]);
                mr.Font.Color = rgb(255, 255, 255);
            } catch (e) {}
            lastMailbox = rec.mailbox;
            row++;
        }

        /* Regelkopf */
        var head = "Regel #" + rec.order + ": " + rec.name;
        if (!rec.enabled) head += "   [INAKTIV]";
        if (rec.isLocal) head += "   [nur auf diesem Client]";
        if (rec.ruleType === OL_RULE_SEND) head += "   [Senden-Regel]";
        sh.Cells(row, 1).Value = rec.mailbox;
        sh.Cells(row, 2).Value = rec.order;
        sh.Cells(row, 3).Value = "REGEL";
        sh.Cells(row, 4).Value = head;
        sh.Cells(row, 5).Value = logicText(rec);
        try {
            var hr = sh.Range(sh.Cells(row, 1), sh.Cells(row, 5));
            hr.Font.Bold = true;
            hr.Interior.Color = rgb(C_RULE[0], C_RULE[1], C_RULE[2]);
            hr.Font.Color = rgb(255, 255, 255);
        } catch (e) {}
        row++;

        /* WENN / UND. Nicht (vollstaendig) lesbare Bedingungen: Bezeichnung
           gelb markiert wie Spalte "Bedingung lesbar" in der Uebersicht. */
        var where = whereToCheck(rec);
        if (rec.conditions.length === 0) {
            sh.Cells(row, 3).Value = "WENN";
            if (condStateOf(rec) === COND_ERROR) {
                sh.Cells(row, 4).Value = "Bedingung nicht lesbar";
                sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.condError +
                                         " – die Regel-Logik ist unvollständig, bitte " + where;
            } else if (rec.ruleType === OL_RULE_SEND) {
                sh.Cells(row, 4).Value = "keine Bedingung sichtbar";
                sh.Cells(row, 5).Value = "Outlook zeigt keine Bedingung – entweder greift die Senden-Regel bei ALLEN ausgehenden Mails, " +
                                         "oder Outlook kann ihre Bedingung nicht lesen (bitte " + where + ")";
            } else {
                sh.Cells(row, 4).Value = "keine Bedingung sichtbar";
                sh.Cells(row, 5).Value = "Outlook zeigt keine Bedingung – entweder greift die Regel bei ALLEN Mails, " +
                                         "oder die Bedingung wurde in Outlook im Web angelegt und ist für Outlook nicht lesbar (dort prüfen)";
            }
            fillRange(sh, row, 3, row, 5, C_COND);
            fillRange(sh, row, 4, row, 4, C_EXCEPT);
            row++;
        } else {
            for (var c = 0; c < rec.conditions.length; c++) {
                var cIt = rec.conditions[c];
                sh.Cells(row, 3).Value = (c === 0) ? "WENN" : "UND";
                sh.Cells(row, 4).Value = cIt.label;
                sh.Cells(row, 5).Value = cIt.detail;
                fillRange(sh, row, 3, row, 5, C_COND);
                if (cIt.type === 'C0' || cIt.type === '?') fillRange(sh, row, 4, row, 4, C_EXCEPT);
                row++;
            }
            if (rec.condPartial) {
                sh.Cells(row, 3).Value = "UND";
                sh.Cells(row, 4).Value = "weitere Bedingung nicht lesbar";
                sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.condError +
                                         " – die Regel-Logik ist unvollständig, bitte " + where;
                fillRange(sh, row, 3, row, 5, C_COND);
                fillRange(sh, row, 4, row, 4, C_EXCEPT);
                row++;
            }
        }

        /* AUSSER WENN */
        for (var x = 0; x < rec.exceptions.length; x++) {
            sh.Cells(row, 3).Value = (x === 0) ? "AUSSER WENN" : "ODER";
            sh.Cells(row, 4).Value = rec.exceptions[x].label;
            sh.Cells(row, 5).Value = rec.exceptions[x].detail;
            fillRange(sh, row, 3, row, 5, C_EXCEPT);
            row++;
        }
        if (rec.exceptions.length > 0 && rec.excPartial) {
            sh.Cells(row, 3).Value = "ODER";
            sh.Cells(row, 4).Value = "weitere Ausnahme nicht lesbar";
            sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.excError + " – bitte " + where;
            fillRange(sh, row, 3, row, 5, C_EXCEPT);
            row++;
        }
        if (rec.exceptions.length === 0 && rec.excState === COND_ERROR) {
            sh.Cells(row, 3).Value = "AUSSER WENN";
            sh.Cells(row, 4).Value = "Ausnahmen nicht lesbar";
            sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.excError + " – bitte " + where;
            fillRange(sh, row, 3, row, 5, C_EXCEPT);
            row++;
        }

        /* DANN */
        if (rec.actions.length === 0) {
            sh.Cells(row, 3).Value = "DANN";
            if (rec.actState === COND_ERROR) {
                sh.Cells(row, 4).Value = "Aktionen nicht lesbar";
                sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.actError +
                                         " – was die Regel tut, ist offen, bitte " + where;
                fillRange(sh, row, 3, row, 5, C_ACTION);
                fillRange(sh, row, 4, row, 4, C_EXCEPT);
            } else {
                sh.Cells(row, 4).Value = "keine Aktion";
                sh.Cells(row, 5).Value = "Regel ohne Aktion – sie tut nichts";
                fillRange(sh, row, 3, row, 5, C_ACTION);
            }
            row++;
        } else {
            for (var a = 0; a < rec.actions.length; a++) {
                sh.Cells(row, 3).Value = (a === 0) ? "DANN" : "UND DANN";
                sh.Cells(row, 4).Value = rec.actions[a].label;
                sh.Cells(row, 5).Value = rec.actions[a].detail;
                fillRange(sh, row, 3, row, 5, C_ACTION);
                row++;
            }
            if (rec.actPartial) {
                sh.Cells(row, 3).Value = "UND DANN";
                sh.Cells(row, 4).Value = "weitere Aktion nicht lesbar";
                sh.Cells(row, 5).Value = "Fehler beim Lesen: " + rec.actError + " – bitte " + where;
                fillRange(sh, row, 3, row, 5, C_ACTION);
                fillRange(sh, row, 4, row, 4, C_EXCEPT);
                row++;
            }
        }

        row++;   /* Leerzeile zwischen Regeln */
    }

    try {
        sh.Columns("A:A").ColumnWidth = 26;
        sh.Columns("B:B").ColumnWidth = 6;
        sh.Columns("C:C").ColumnWidth = 14;
        sh.Columns("D:D").ColumnWidth = 42;
        sh.Columns("E:E").ColumnWidth = 80;
    } catch (e) {}
    freezeBelow(sh, excel, headRow);
}

/* ---------- Blatt 3: Elemente (flach, filterbar) ---------- */
function buildFlat(sh, excel, st) {
    var headers = ["Postfach", "Reihenfolge", "Regelname", "Aktiv", "Art", "Bezeichnung", "Details"];
    writeRow(sh, 1, headers);
    styleHeaderRow(sh, 1, headers.length);

    var rows = st.rows;
    var row = 2;
    for (var r = 0; r < rows.length; r++) {
        var rec = rows[r];
        var where = whereToCheck(rec);
        row = flatBlock(sh, row, rec, "Bedingung", rec.conditions, C_COND);
        /* Zustaende b / c / teilweise als eigene Zeile, damit ein Filter auf
           Art = Bedingung auch diese Regeln zeigt */
        if (rec.conditions.length === 0 && condStateOf(rec) === COND_ERROR) {
            row = flatNote(sh, row, rec, "Bedingung", "Bedingung nicht lesbar", "Fehler beim Lesen: " + rec.condError, C_COND);
        } else if (rec.conditions.length === 0) {
            row = flatNote(sh, row, rec, "Bedingung", "keine Bedingung sichtbar",
                           "Outlook liefert keine aktive Bedingung – " + where, C_COND);
        } else if (rec.condPartial) {
            row = flatNote(sh, row, rec, "Bedingung", "weitere Bedingung nicht lesbar", "Fehler beim Lesen: " + rec.condError, C_COND);
        }
        row = flatBlock(sh, row, rec, "Ausnahme", rec.exceptions, C_EXCEPT);
        if (rec.exceptions.length === 0 && rec.excState === COND_ERROR) {
            row = flatNote(sh, row, rec, "Ausnahme", "Ausnahmen nicht lesbar", "Fehler beim Lesen: " + rec.excError, C_EXCEPT);
        } else if (rec.exceptions.length > 0 && rec.excPartial) {
            row = flatNote(sh, row, rec, "Ausnahme", "weitere Ausnahme nicht lesbar", "Fehler beim Lesen: " + rec.excError, C_EXCEPT);
        }
        row = flatBlock(sh, row, rec, "Aktion", rec.actions, C_ACTION);
        if (rec.actions.length === 0 && rec.actState === COND_ERROR) {
            row = flatNote(sh, row, rec, "Aktion", "Aktionen nicht lesbar", "Fehler beim Lesen: " + rec.actError, C_ACTION);
        } else if (rec.actions.length > 0 && rec.actPartial) {
            row = flatNote(sh, row, rec, "Aktion", "weitere Aktion nicht lesbar", "Fehler beim Lesen: " + rec.actError, C_ACTION);
        }
    }
    if (row === 2) {
        sh.Cells(2, 1).Value = "Keine Bedingungen/Aktionen gefunden.";
    }

    try { sh.Range(sh.Cells(1, 1), sh.Cells(row - 1, headers.length)).AutoFilter(); } catch (e) {}
    try {
        sh.Columns("A:E").AutoFit();
        sh.Columns("C:C").ColumnWidth = 34;
        sh.Columns("F:F").ColumnWidth = 42;
        sh.Columns("G:G").ColumnWidth = 70;
    } catch (e) {}
    freezeBelow(sh, excel, 1);
}

function flatBlock(sh, row, rec, art, list, col) {
    for (var i = 0; i < list.length; i++) {
        writeRow(sh, row, [
            rec.mailbox, rec.order, rec.name, jaNein(rec.enabled),
            art, list[i].label, list[i].detail
        ]);
        fillRange(sh, row, 5, row, 5, col);
        if (list[i].type === 'C0' || list[i].type === '?') fillRange(sh, row, 6, row, 6, C_EXCEPT);
        row++;
    }
    return row;
}

/* Zeile fuer einen nicht (vollstaendig) lesbaren Block, Bezeichnung gelb */
function flatNote(sh, row, rec, art, label, detail, col) {
    writeRow(sh, row, [
        rec.mailbox, rec.order, rec.name, jaNein(rec.enabled),
        art, label, detail
    ]);
    fillRange(sh, row, 5, row, 5, col);
    fillRange(sh, row, 6, row, 6, C_EXCEPT);
    return row + 1;
}

/* ---------- Blatt 4: Zielordner (Mengengerüst) ---------- */
function buildFolders(sh, excel, st) {
    sh.Cells(1, 1).Value = "Wohin schreiben die Regeln?";
    try { sh.Cells(1, 1).Font.Bold = true; sh.Cells(1, 1).Font.Size = 14; } catch (e) {}
    sh.Cells(2, 1).Value = "Grundlage: Aktionen \"In Ordner verschieben\" und \"In Ordner kopieren\".";

    var headRow = 4;
    var headers = ["Postfach", "Zielordner", "Anzahl Regeln", "davon aktiv", "Regeln"];
    writeRow(sh, headRow, headers);
    styleHeaderRow(sh, headRow, headers.length);

    /* Aggregation Postfach + Zielordner */
    var map = {}, order = [];
    for (var r = 0; r < st.rows.length; r++) {
        var rec = st.rows[r];
        for (var t = 0; t < rec.targets.length; t++) {
            var key = rec.mailbox + '' + rec.targets[t];
            if (!map[key]) {
                map[key] = { mailbox: rec.mailbox, folder: rec.targets[t], count: 0, active: 0, names: [] };
                order.push(key);
            }
            map[key].count++;
            if (rec.enabled) map[key].active++;
            map[key].names.push(rec.name + (rec.enabled ? '' : ' [inaktiv]'));
        }
    }

    order.sort(function (a, b) {
        var x = map[a], y = map[b];
        if (x.mailbox < y.mailbox) return -1;
        if (x.mailbox > y.mailbox) return 1;
        if (y.count !== x.count) return y.count - x.count;
        return x.folder < y.folder ? -1 : 1;
    });

    var row = headRow + 1;
    var total = 0;
    for (var i = 0; i < order.length; i++) {
        var e = map[order[i]];
        var names = e.names.join(', ');
        if (names.length > 500) names = names.substring(0, 497) + '...';
        writeRow(sh, row, [e.mailbox, e.folder, e.count, e.active, names]);
        total += e.count;
        row++;
    }

    if (order.length === 0) {
        sh.Cells(row, 1).Value = "Keine Regel verschiebt oder kopiert Mails in einen Ordner.";
        row++;
    } else {
        writeRow(sh, row, ["Summe", "", total, "", ""]);
        try {
            var sr = sh.Range(sh.Cells(row, 1), sh.Cells(row, headers.length));
            sr.Font.Bold = true;
            sr.Interior.Color = rgb(C_SUM[0], C_SUM[1], C_SUM[2]);
        } catch (e) {}
        row++;
    }

    try { sh.Range(sh.Cells(headRow, 1), sh.Cells(row - 2, headers.length)).AutoFilter(); } catch (e) {}
    try {
        sh.Columns("A:A").ColumnWidth = 26;
        sh.Columns("B:B").ColumnWidth = 60;
        sh.Columns("C:D").AutoFit();
        sh.Columns("E:E").ColumnWidth = 70;
    } catch (e) {}
    freezeBelow(sh, excel, headRow);
}

/* ---------- Blatt 5: Prüfhinweise ---------- */
function buildChecks(sh, excel, st) {
    sh.Cells(1, 1).Value = "Prüfhinweise zur Regel-Logik";
    try { sh.Cells(1, 1).Font.Bold = true; sh.Cells(1, 1).Font.Size = 14; } catch (e) {}
    sh.Cells(2, 1).Value = "Automatisch erkannte Auffälligkeiten. Kein Ersatz für die fachliche Prüfung – bitte einzeln bewerten.";

    var headRow = 4;
    var headers = ["Kategorie", "Postfach", "Regel", "Hinweis"];
    writeRow(sh, headRow, headers);
    styleHeaderRow(sh, headRow, headers.length);

    var notes = [];
    function note(cat, mailbox, rule, text) {
        notes.push({ cat: cat, mailbox: mailbox, rule: rule, text: text });
    }

    var rows = st.rows;

    /* Anzahl aktiver Regeln, die im selben Postfach NACH rec laufen. Nur
       Regeln desselben Typs: "Keine weiteren Regeln anwenden" einer
       Empfangen-Regel haelt keine Senden-Regel an und umgekehrt. */
    function laterActiveCount(rec) {
        var n = 0;
        for (var j = 0; j < rows.length; j++) {
            var o = rows[j];
            if (o === rec || o.mailbox !== rec.mailbox || !o.enabled) continue;
            if (o.ruleType !== rec.ruleType) continue;
            if (o.order > rec.order) n++;
        }
        return n;
    }

    /* Satz zu "Keine weiteren Regeln anwenden" bei einer Regel ohne sichtbare
       Bedingung: Einzahl/Mehrzahl und Ausnahmen beruecksichtigen. */
    function stopSentence(rec, n) {
        var who = (n === 1)
            ? "greift die danach laufende aktive Regel dieses Postfachs nie"
            : "greift keine der " + n + " danach laufenden aktiven Regeln dieses Postfachs";
        var exc = "";
        if (rec.exceptions.length > 0) exc = " – außer bei Mails, auf die eine ihrer Ausnahmen zutrifft";
        else if (rec.excState === COND_ERROR || rec.excPartial) exc = " – außer womöglich bei Mails, auf die eine nicht lesbare Ausnahme zutrifft";
        return " Die Regel beendet außerdem die Regelkette („Keine weiteren Regeln anwenden“): Falls sie wirklich keine Bedingung hat, " +
               who + exc + ". Das wäre unplausibel und spricht für eine nicht lesbare Bedingung.";
    }

    /* Einzelregel-Prüfungen */
    for (var i = 0; i < rows.length; i++) {
        var rec = rows[i];
        var cState = condStateOf(rec);
        if (!rec.enabled) {
            note("Inaktiv", rec.mailbox, rec.name,
                 "Regel ist deaktiviert und greift derzeit nicht.");
        }
        if (rec.isLocal) {
            note("Nur-lokale Regel", rec.mailbox, rec.name,
                 "Client-Regel: läuft nur, wenn genau dieses Outlook geöffnet ist. Für ein Gruppenpostfach mit mehreren Bearbeitern meist unerwünscht – serverseitige Regel bevorzugen.");
        }
        var where = whereToCheck(rec);
        var stopsOthers = (rec.enabled && rec.stop) ? laterActiveCount(rec) : 0;
        /* Ohne sichtbare Bedingung ist offen, ob die Regel wirklich alle Mails
           trifft - deshalb kein "Sehr breit" mehr, sondern ein Prüfauftrag. */
        if (cState === COND_NONE) {
            var txtNone;
            if (rec.ruleType === OL_RULE_SEND) {
                txtNone = "Outlook zeigt keine Bedingung. Entweder greift die Senden-Regel bei allen ausgehenden Mails, oder Outlook kann ihre Bedingung nicht lesen – " + where + ".";
            } else {
                txtNone = "Outlook zeigt keine Bedingung. Entweder greift die Regel bei allen Mails, oder die Bedingung wurde in Outlook im Web angelegt (z. B. Nachrichtentyp automatische Antwort) und ist für Outlook nicht lesbar – " + where + ".";
            }
            if (stopsOthers > 0) txtNone += stopSentence(rec, stopsOthers);
            note("Keine Bedingung sichtbar", rec.mailbox, rec.name, txtNone);
        } else if (cState === COND_ERROR) {
            var txtErr = "Outlook konnte die Bedingung nicht lesen (" + rec.condError + "). Die Regel-Logik ist deshalb unvollständig – " + where + ".";
            if (stopsOthers > 0) {
                txtErr += " Die Regel beendet die Regelkette („Keine weiteren Regeln anwenden“); welche späteren Regeln sie verdeckt, lässt sich ohne lesbare Bedingung nicht prüfen.";
            }
            note("Bedingung nicht lesbar", rec.mailbox, rec.name, txtErr);
        } else if (condIncomplete(rec)) {
            /* Bedingung gelesen, aber unvollstaendig (Lesefehler oder unbekannter Typ) */
            var txtPart = "";
            if (rec.condUnknown) {
                txtPart = "Outlook meldet eine Bedingung unbekannten Typs (OlRuleConditionType 0); ihr Inhalt ist für Outlook nicht lesbar" +
                          (rec.ruleType === OL_RULE_SEND ? "" : ", typisch für Bedingungen aus Outlook im Web") + ".";
            }
            if (rec.condPartial) {
                txtPart += (txtPart !== "" ? " " : "") +
                           "Outlook konnte nur einen Teil der Bedingungen lesen (teilweise: " + rec.condError + "). " +
                           "Gelesen: " + itemTexts(rec.conditions, " UND ") + ". Weitere Bedingungen können fehlen.";
            }
            txtPart += " Bitte " + where + ".";
            if (stopsOthers > 0) {
                txtPart += " Die Regel beendet die Regelkette („Keine weiteren Regeln anwenden“); welche späteren Regeln sie verdeckt, lässt sich ohne vollständig lesbare Bedingung nicht sicher prüfen.";
            }
            note("Bedingung nicht lesbar", rec.mailbox, rec.name, txtPart);
        }
        /* Ausnahmen: nur schwere Lesefehler (excState c bzw. excPartial) als
           Hinweis; einzelne nicht lesbare Eintraege stehen nur in "Diagnose". */
        if (rec.exceptions.length === 0 && rec.excState === COND_ERROR) {
            note("Ausnahmen nicht lesbar", rec.mailbox, rec.name,
                 "Outlook konnte die Ausnahmen nicht lesen (" + rec.excError + "). Möglicherweise fehlen Ausnahmen in der Darstellung – " + where + ".");
        } else if (rec.exceptions.length > 0 && rec.excPartial) {
            note("Ausnahmen nicht lesbar", rec.mailbox, rec.name,
                 "Outlook konnte nur einen Teil der Ausnahmen lesen (teilweise: " + rec.excError + "). Weitere Ausnahmen können fehlen – " + where + ".");
        }
        /* Aktionen nicht (vollstaendig) lesbar: dann ist auch "Ohne Wirkung" nicht sicher */
        var actUnreadable = (rec.actState === COND_ERROR || rec.actPartial === true);
        if (rec.actions.length === 0 && rec.actState === COND_ERROR) {
            note("Aktionen nicht lesbar", rec.mailbox, rec.name,
                 "Outlook konnte die Aktionen nicht lesen (" + rec.actError + "). Was die Regel tut, ist deshalb offen – " + where + ".");
        } else if (rec.actPartial) {
            note("Aktionen nicht lesbar", rec.mailbox, rec.name,
                 "Outlook konnte nur einen Teil der Aktionen lesen (teilweise: " + rec.actError + "). Weitere Aktionen können fehlen – " + where + ".");
        }
        if (rec.realActions === 0 && !actUnreadable) {
            note("Ohne Wirkung", rec.mailbox, rec.name,
                 "Regel hat keine Aktion" + (rec.stop ? " ausser \"keine weiteren Regeln anwenden\"" : "") + " – sie bewirkt nichts.");
        }
        if (rec.outbound.length > 0) {
            note("Datenabfluss prüfen", rec.mailbox, rec.name,
                 "Regel leitet Mails weiter oder um: " + rec.outbound.join(" | ") + ". Empfänger und Ziel-Domäne prüfen.");
        }
        if (rec.hardDelete) {
            note("Endgültiges Löschen", rec.mailbox, rec.name,
                 "Regel löscht Mails endgültig (nicht in \"Gelöschte Elemente\"). Nicht wiederherstellbar.");
        }
        if (rec.targets.length > 1) {
            note("Mehrfachziel", rec.mailbox, rec.name,
                 "Regel schreibt in mehrere Ordner: " + rec.targets.join(" | ") + ".");
        }
        for (var t = 0; t < rec.targets.length; t++) {
            if (rec.targets[t].indexOf("nicht verf") !== -1) {
                note("Zielordner fehlt", rec.mailbox, rec.name,
                     "Ein Zielordner der Regel ist nicht lesbar (umbenannt oder gelöscht?).");
            }
        }
    }

    /* Doppelungen: gleiche Bedingungs-Signatur im selben Postfach.
       Nur Regeln mit vollstaendig gelesener Bedingung (a, nicht teilweise):
       eine nicht lesbare weitere Bedingung koennte die Regeln unterscheiden.
       Nicht lesbare Bedingungswerte sind ueber condKey ohnehin nie gleich. */
    var sigMap = {};
    for (var s = 0; s < rows.length; s++) {
        var r2 = rows[s];
        if (condStateOf(r2) !== COND_READ || r2.condPartial) continue;
        var key = r2.mailbox + '' + condSignature(r2);
        if (!sigMap[key]) sigMap[key] = [];
        sigMap[key].push(r2);
    }
    for (var k in sigMap) {
        if (!sigMap.hasOwnProperty(k)) continue;
        var group = sigMap[k];
        if (group.length < 2) continue;
        var namesArr = [];
        for (var g = 0; g < group.length; g++) namesArr.push("#" + group[g].order + " " + group[g].name);
        note("Doppelte Bedingung", group[0].mailbox, namesArr.join(" / "),
             group.length + " Regeln haben genau dieselben Bedingungen. Reihenfolge und Aktionen prüfen – vermutlich zusammenfassbar.");
    }

    /* Toter Code: fruehere Regel mit "Stopp" und Teilmenge der Bedingungen.
       Nur Regeln mit GELESENER Bedingung (a) werden verglichen. Eine Regel
       ohne sichtbare (b) oder ohne lesbare (c) Bedingung wird hier bewusst
       nicht gewertet - dafuer gibt es die vorsichtig formulierten Hinweise
       "Keine Bedingung sichtbar" / "Bedingung nicht lesbar" oben. (isSubset
       liefert fuer eine leere Menge ohnehin false.)
       Sicherer Blocker ist die fruehe Regel nur, wenn ihre Bedingungen und
       Ausnahmen vollstaendig gelesen sind. Fehlt dort etwas (weitere Bedingung
       oder Ausnahmen nicht lesbar), koennte sie seltener greifen als gelesen -
       dann nur der vorsichtige Hinweis "Evtl. nie erreicht". Die spaete Regel
       darf teilweise gelesen sein: eine nicht lesbare weitere Bedingung macht
       sie nur enger, sie bleibt verdeckt. Stopp wirkt nur auf Regeln desselben
       Typs (Empfangen/Senden). */
    for (var a = 0; a < rows.length; a++) {
        var early = rows[a];
        if (!early.enabled || !early.stop) continue;
        if (condStateOf(early) !== COND_READ) continue;
        var earlyExcOpen = (early.excState === COND_ERROR || early.excPartial === true);
        var earlyUnsure = (early.condPartial === true || earlyExcOpen);
        var setEarly = condSet(early);
        for (var b = 0; b < rows.length; b++) {
            var later = rows[b];
            if (later === early) continue;
            if (later.mailbox !== early.mailbox) continue;
            if (later.ruleType !== early.ruleType) continue;
            if (!later.enabled) continue;
            if (later.order <= early.order) continue;
            if (condStateOf(later) !== COND_READ) continue;
            if (!isSubset(setEarly, condSet(later))) continue;
            if (!earlyUnsure) {
                note("Wird nie erreicht", later.mailbox, later.name,
                     "Die früher laufende Regel #" + early.order + " (\"" + early.name + "\") hat dieselben oder weniger Bedingungen und beendet die Regelkette (\"keine weiteren Regeln anwenden\"). Sobald sie greift, läuft diese Regel nicht mehr.");
            } else {
                var why;
                if (early.condPartial && earlyExcOpen) why = "sind aber eine weitere Bedingung und die Ausnahmen nicht (vollständig) lesbar";
                else if (early.condPartial) why = "ist aber eine weitere Bedingung nicht lesbar";
                else why = "sind aber die Ausnahmen nicht (vollständig) lesbar";
                note("Evtl. nie erreicht", later.mailbox, later.name,
                     "Die früher laufende Regel #" + early.order + " (\"" + early.name + "\") hat nach dem, was Outlook lesen kann, dieselben oder weniger Bedingungen und beendet die Regelkette (\"keine weiteren Regeln anwenden\"). " +
                     "Bei Regel #" + early.order + " " + why + " – ob diese Regel erreicht wird, ist offen. Bitte " + whereToCheck(early) + ".");
            }
        }
    }

    /* Postfaecher ohne lesbare Regeln */
    for (var p = 0; p < st.storeStats.length; p++) {
        var stat = st.storeStats[p];
        if (stat.error !== '') {
            note("Nicht lesbar", stat.name, "-",
                 "Regeln konnten nicht gelesen werden: " + stat.error +
                 " Häufigster Grund: Das Postfach hängt nicht als vollwertiges Postfach im Profil.");
        } else if (stat.rules === 0) {
            note("Keine Regeln", stat.name, "-", "In diesem Postfach ist keine Regel definiert.");
        }
    }

    var CAT_COLOR = {
        "Nur-lokale Regel": C_EXCEPT,
        "Datenabfluss prüfen": C_EXCEPT,
        "Endgültiges Löschen": C_EXCEPT,
        "Wird nie erreicht": C_EXCEPT,
        "Evtl. nie erreicht": C_EXCEPT,
        "Nicht lesbar": C_EXCEPT,
        "Keine Bedingung sichtbar": C_EXCEPT,
        "Bedingung nicht lesbar": C_EXCEPT,
        "Ausnahmen nicht lesbar": C_EXCEPT,
        "Aktionen nicht lesbar": C_EXCEPT
    };

    var row = headRow + 1;
    for (var n = 0; n < notes.length; n++) {
        var nt = notes[n];
        writeRow(sh, row, [nt.cat, nt.mailbox, nt.rule, nt.text]);
        var col = CAT_COLOR[nt.cat];
        if (col) fillRange(sh, row, 1, row, 1, col);
        row++;
    }
    if (notes.length === 0) {
        sh.Cells(row, 1).Value = "Keine Auffälligkeiten gefunden.";
        row++;
    }

    try { sh.Range(sh.Cells(headRow, 1), sh.Cells(row - 1, headers.length)).AutoFilter(); } catch (e) {}
    try {
        sh.Columns("A:A").ColumnWidth = 26;
        sh.Columns("B:B").ColumnWidth = 26;
        sh.Columns("C:C").ColumnWidth = 40;
        sh.Columns("D:D").ColumnWidth = 95;
    } catch (e) {}
    freezeBelow(sh, excel, headRow);
}

/* ---------- Blatt 6: Diagnose ---------- */
/* Typ-Kennungen als Text: aktive mit Label, inaktive nur als Kennung. */
function diagTypes(list, withLabel) {
    var out = [];
    for (var i = 0; i < list.length; i++) out.push(withLabel ? typeWithLabel(list[i]) : String(list[i]));
    return out.join(withLabel ? ' | ' : ', ');
}
function diagCount(d) {
    return (d && d.count >= 0) ? d.count : 'nicht lesbar';
}

function buildDiag(sh, excel, st) {
    sh.Cells(1, 1).Value = "Diagnose: Bedingungen und Ausnahmen laut Outlook";
    try { sh.Cells(1, 1).Font.Bold = true; sh.Cells(1, 1).Font.Size = 14; } catch (e) {}
    sh.Cells(2, 1).Value = "Zustand a = Bedingung(en) gelesen (\"teilweise\": ein weiterer Eintrag nicht lesbar oder Bedingung unbekannten Typs), " +
                           "b = keine Bedingung sichtbar (Outlook liefert keine aktive Bedingung, kein Fehler), " +
                           "c = Bedingung nicht lesbar (Fehler beim Zugriff). Bei b, c und teilweise: " + OWA_HINT + ". " +
                           "Typ-Kennung C<Zahl> = OlRuleConditionType. Der Fehlertext nennt auch Lesefehler bei Ausnahmen und Aktionen.";

    var headRow = 4;
    var headers = ["Postfach", "Reihenfolge", "Regelname", "Aktiv", "Nur lokal", "Zustand",
                   "Bedingungen: Anzahl laut Outlook", "Bedingungen: aktive Typen", "Bedingungen: inaktive Typen",
                   "Ausnahmen: Anzahl laut Outlook", "Ausnahmen: aktive Typen", "Ausnahmen: inaktive Typen",
                   "Fehlertext"];
    writeRow(sh, headRow, headers);
    styleHeaderRow(sh, headRow, headers.length);

    var rows = st.rows.slice(0);
    rows.sort(function (a, b) {
        if (a.mailbox < b.mailbox) return -1;
        if (a.mailbox > b.mailbox) return 1;
        return a.order - b.order;
    });

    var row = headRow + 1;
    for (var r = 0; r < rows.length; r++) {
        var rec = rows[r];
        var cd = rec.condDiag || newDiag();
        var xd = rec.excDiag || newDiag();
        var errs = [];
        if (rec.condError) errs.push('Bedingungen: ' + rec.condError);
        if (rec.excError) errs.push('Ausnahmen: ' + rec.excError);
        if (rec.actError) errs.push('Aktionen: ' + rec.actError);
        writeRow(sh, row, [
            rec.mailbox,
            rec.order,
            rec.name,
            jaNein(rec.enabled),
            jaNein(rec.isLocal),
            condStateLong(rec),
            diagCount(cd),
            diagTypes(cd.active, true),
            diagTypes(cd.inactive, false),
            diagCount(xd),
            diagTypes(xd.active, true),
            diagTypes(xd.inactive, false),
            errs.join(' | ')
        ]);
        if (!condComplete(rec)) fillRange(sh, row, 6, row, 6, C_EXCEPT);
        if (errs.length > 0) fillRange(sh, row, headers.length, row, headers.length, C_EXCEPT);
        if (!rec.enabled) {
            try { sh.Range(sh.Cells(row, 1), sh.Cells(row, headers.length)).Font.Italic = true; } catch (e) {}
        }
        row++;
    }
    if (rows.length === 0) {
        sh.Cells(row, 1).Value = "Keine Regeln ausgegeben.";
        row++;
    }

    try { sh.Range(sh.Cells(headRow, 1), sh.Cells(row - 1, headers.length)).AutoFilter(); } catch (e) {}
    try {
        sh.Columns("A:A").ColumnWidth = 26;
        sh.Columns("B:B").ColumnWidth = 12;
        sh.Columns("C:C").ColumnWidth = 34;
        sh.Columns("D:E").ColumnWidth = 10;
        sh.Columns("F:F").ColumnWidth = 30;
        sh.Columns("G:G").ColumnWidth = 14;
        sh.Columns("H:H").ColumnWidth = 50;
        sh.Columns("I:I").ColumnWidth = 30;
        sh.Columns("J:J").ColumnWidth = 14;
        sh.Columns("K:K").ColumnWidth = 40;
        sh.Columns("L:L").ColumnWidth = 30;
        sh.Columns("M:M").ColumnWidth = 60;
        sh.Range(sh.Cells(headRow, 1), sh.Cells(headRow, headers.length)).WrapText = true;
    } catch (e) {}
    freezeBelow(sh, excel, headRow);
}
</script>
</body>
</html>
