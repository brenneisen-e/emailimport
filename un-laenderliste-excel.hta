<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <title>UN-Länderliste nach Excel</title>
    <HTA:APPLICATION
        ID="UN_Laenderliste_Excel"
        APPLICATIONNAME="UN-Länderliste nach Excel"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="1.2"
        WINDOWSTATE="normal"
    />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #f1f5f9;
            padding: 22px;
        }
        .card {
            max-width: 560px;
            margin: 0 auto;
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 16px;
            padding: 26px;
            box-shadow: 0 8px 28px rgba(0,0,0,0.35);
        }
        .header { text-align: center; margin-bottom: 18px; }
        .logo { font-size: 42px; line-height: 1; margin-bottom: 8px; }
        h1 { font-size: 20px; font-weight: 650; margin-bottom: 4px; }
        .subtitle { color: #94a3b8; font-size: 13px; }
        .ver { color: #64748b; font-size: 11px; margin-top: 6px; }

        .info {
            background: rgba(99, 102, 241, 0.12);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13px;
            color: #c7d2fe;
            margin-bottom: 18px;
            line-height: 1.5;
        }

        button.action {
            width: 100%;
            padding: 14px 18px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
        }
        button.action:hover { filter: brightness(1.08); }
        button.action:disabled {
            background: #475569;
            box-shadow: none;
            cursor: default;
            filter: none;
        }

        #status {
            margin-top: 18px;
            padding: 12px 14px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.5;
            min-height: 20px;
            display: none;
        }
        #status.show { display: block; }
        #status.info    { background: rgba(148,163,184,0.12); border: 1px solid rgba(148,163,184,0.3);  color: #cbd5e1; }
        #status.success { background: rgba(34,197,94,0.12);   border: 1px solid rgba(34,197,94,0.35);   color: #bbf7d0; }
        #status.error   { background: rgba(239,68,68,0.12);   border: 1px solid rgba(239,68,68,0.35);   color: #fecaca; }

        .foot { text-align: center; color: #64748b; font-size: 11px; margin-top: 18px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="header">
            <div class="logo">🌍</div>
            <h1>UN-Länderliste nach Excel</h1>
            <div class="subtitle">Alle 193 Mitgliedstaaten der Vereinten Nationen &ndash; direkt in Excel</div>
            <div class="ver">v1.2</div>
        </div>

        <div class="info">
            Ein Klick erzeugt eine neue Excel-Arbeitsmappe mit allen aktuell
            193&nbsp;UN-Mitgliedstaaten &ndash; alphabetisch sortiert, mit
            formatierter &Uuml;berschrift, Autofilter und eingefrorener Kopfzeile.
        </div>

        <button class="action" id="btnCreate" onclick="createExcelList()">Excel-Liste erstellen</button>

        <div id="status"></div>

        <div class="foot">Ben&ouml;tigt Microsoft Excel &middot; l&auml;uft vollst&auml;ndig lokal</div>
    </div>

<script language="JScript">
/* =====================================================================
   UN-Länderliste nach Excel  (HTA / JScript / COM-Automation)
   ---------------------------------------------------------------------
   Erstellt beim Klick auf "Excel-Liste erstellen" eine neue
   Excel-Arbeitsmappe und schreibt alle 193 aktuellen UN-Mitgliedstaaten
   alphabetisch sortiert in Spalte A. Ueberschrift wird formatiert,
   Spaltenbreite angepasst, Autofilter aktiviert, Kopfzeile eingefroren.

   JScript + ActiveXObject("Excel.Application") -- identisches, bewaehrtes
   COM-Muster wie in den uebrigen Modulen (ergo-email-batch.hta u.a.).
   Keine externen Abhaengigkeiten, keine Netzwerkzugriffe.
   ===================================================================== */

/* Fenstergroesse beim Start (kleines, zentriertes Fenster). */
window.onload = function () {
    try {
        window.resizeTo(620, 500);
        var l = Math.max(0, Math.floor((screen.availWidth  - 620) / 2));
        var t = Math.max(0, Math.floor((screen.availHeight - 500) / 2));
        window.moveTo(l, t);
    } catch (e) {}
};

/* Statusbereich in der HTA aktualisieren. kind: "info" | "success" | "error" */
function setStatus(text, kind) {
    var el = document.getElementById("status");
    el.className = "show " + kind;
    el.innerHTML = text;
}

/* Erstellen-Button aktivieren / deaktivieren. */
function setButtonEnabled(enabled) {
    var btn = document.getElementById("btnCreate");
    btn.disabled = !enabled;
    btn.innerHTML = enabled ? "Excel-Liste erstellen" : "Bitte warten &hellip;";
}

/* Liefert alle 193 aktuellen UN-Mitgliedstaaten als bereits alphabetisch
   sortiertes Array (offizielle deutsche Laendernamen, DIN 5007-1). */
function getUNMemberStates() {
    return [
            "Afghanistan",
            "Ägypten",
            "Albanien",
            "Algerien",
            "Andorra",
            "Angola",
            "Antigua und Barbuda",
            "Äquatorialguinea",
            "Argentinien",
            "Armenien",
            "Aserbaidschan",
            "Äthiopien",
            "Australien",
            "Bahamas",
            "Bahrain",
            "Bangladesch",
            "Barbados",
            "Belarus",
            "Belgien",
            "Belize",
            "Benin",
            "Bhutan",
            "Bolivien",
            "Bosnien und Herzegowina",
            "Botsuana",
            "Brasilien",
            "Brunei",
            "Bulgarien",
            "Burkina Faso",
            "Burundi",
            "Chile",
            "China",
            "Costa Rica",
            "Côte d'Ivoire",
            "Dänemark",
            "Deutschland",
            "Dominica",
            "Dominikanische Republik",
            "Dschibuti",
            "Ecuador",
            "El Salvador",
            "Eritrea",
            "Estland",
            "Eswatini",
            "Fidschi",
            "Finnland",
            "Frankreich",
            "Gabun",
            "Gambia",
            "Georgien",
            "Ghana",
            "Grenada",
            "Griechenland",
            "Guatemala",
            "Guinea",
            "Guinea-Bissau",
            "Guyana",
            "Haiti",
            "Honduras",
            "Indien",
            "Indonesien",
            "Irak",
            "Iran",
            "Irland",
            "Island",
            "Israel",
            "Italien",
            "Jamaika",
            "Japan",
            "Jemen",
            "Jordanien",
            "Kambodscha",
            "Kamerun",
            "Kanada",
            "Kap Verde",
            "Kasachstan",
            "Katar",
            "Kenia",
            "Kirgisistan",
            "Kiribati",
            "Kolumbien",
            "Komoren",
            "Kongo, Demokratische Republik",
            "Kongo, Republik",
            "Kroatien",
            "Kuba",
            "Kuwait",
            "Laos",
            "Lesotho",
            "Lettland",
            "Libanon",
            "Liberia",
            "Libyen",
            "Liechtenstein",
            "Litauen",
            "Luxemburg",
            "Madagaskar",
            "Malawi",
            "Malaysia",
            "Malediven",
            "Mali",
            "Malta",
            "Marokko",
            "Marshallinseln",
            "Mauretanien",
            "Mauritius",
            "Mexiko",
            "Mikronesien",
            "Moldau",
            "Monaco",
            "Mongolei",
            "Montenegro",
            "Mosambik",
            "Myanmar",
            "Namibia",
            "Nauru",
            "Nepal",
            "Neuseeland",
            "Nicaragua",
            "Niederlande",
            "Niger",
            "Nigeria",
            "Nordkorea",
            "Nordmazedonien",
            "Norwegen",
            "Oman",
            "Österreich",
            "Osttimor",
            "Pakistan",
            "Palau",
            "Panama",
            "Papua-Neuguinea",
            "Paraguay",
            "Peru",
            "Philippinen",
            "Polen",
            "Portugal",
            "Ruanda",
            "Rumänien",
            "Russland",
            "Salomonen",
            "Sambia",
            "Samoa",
            "San Marino",
            "São Tomé und Príncipe",
            "Saudi-Arabien",
            "Schweden",
            "Schweiz",
            "Senegal",
            "Serbien",
            "Seychellen",
            "Sierra Leone",
            "Simbabwe",
            "Singapur",
            "Slowakei",
            "Slowenien",
            "Somalia",
            "Spanien",
            "Sri Lanka",
            "St. Kitts und Nevis",
            "St. Lucia",
            "St. Vincent und die Grenadinen",
            "Südafrika",
            "Sudan",
            "Südkorea",
            "Südsudan",
            "Suriname",
            "Syrien",
            "Tadschikistan",
            "Tansania",
            "Thailand",
            "Togo",
            "Tonga",
            "Trinidad und Tobago",
            "Tschad",
            "Tschechien",
            "Tunesien",
            "Türkei",
            "Turkmenistan",
            "Tuvalu",
            "Uganda",
            "Ukraine",
            "Ungarn",
            "Uruguay",
            "Usbekistan",
            "Vanuatu",
            "Venezuela",
            "Vereinigte Arabische Emirate",
            "Vereinigte Staaten",
            "Vereinigtes Königreich",
            "Vietnam",
            "Zentralafrikanische Republik",
            "Zypern"
    ];
}

/* Kernlogik: Excel starten, Mappe aufbauen, Laender schreiben,
   formatieren und abschliessen. */
function createExcelList() {
    setButtonEnabled(false);
    setStatus("Excel wird ge&ouml;ffnet &hellip;", "info");

    var states = getUNMemberStates();
    var excel = null, wb = null, sheet = null;

    /* 1) Excel per COM starten (gezielte Fehlerbehandlung). */
    try {
        excel = new ActiveXObject("Excel.Application");
    } catch (e) {
        setStatus("<b>Microsoft Excel konnte nicht gestartet werden.</b><br>" +
                  "Bitte pr&uuml;fen, ob Excel installiert ist.<br>" +
                  "<span style='opacity:.7'>(" + e.message + ")</span>", "error");
        setButtonEnabled(true);
        return;
    }

    /* 2) Mappe aufbauen. */
    try {
        excel.Visible = true;             // Excel sichtbar machen
        excel.DisplayAlerts = false;

        wb = excel.Workbooks.Add();        // neue Arbeitsmappe + erstes Blatt
        sheet = wb.ActiveSheet;
        try { sheet.Name = "UN-Mitgliedstaaten"; } catch (eName) {}

        /* Ueberschrift in A1 + Formatierung. */
        sheet.Cells(1, 1).Value = "Mitgliedstaaten der Vereinten Nationen";
        try {
            var head = sheet.Cells(1, 1);
            head.Font.Bold = true;
            head.Font.Size = 14;
            head.Interior.Color = 0xDCDCDC;   // leicht grau (RGB 220,220,220)
        } catch (eHead) {}

        /* Staaten ab Zeile 2 (Liste ist bereits sortiert). */
        for (var i = 0; i < states.length; i++) {
            sheet.Cells(i + 2, 1).Value = states[i];
        }
        var lastRow = states.length + 1;

        /* Spaltenbreite automatisch anpassen. */
        try { sheet.Columns(1).AutoFit(); } catch (eFit) {}

        /* Autofilter ueber Kopfzeile + Datenbereich. */
        try {
            sheet.Range(sheet.Cells(1, 1), sheet.Cells(lastRow, 1)).AutoFilter();
        } catch (eFilter) {}

        /* Erste Zeile einfrieren (bewaehrtes Select+FreezePanes-Muster). */
        try {
            sheet.Range("A1").Select();
            excel.ActiveWindow.FreezePanes = false;
            sheet.Range("A2").Select();
            excel.ActiveWindow.FreezePanes = true;
        } catch (eFreeze) {}

        excel.DisplayAlerts = true;

        setStatus("<b>Fertig!</b><br>" + states.length + " UN-Mitgliedstaaten wurden " +
                  "nach Excel geschrieben. Die Arbeitsmappe ist ge&ouml;ffnet.", "success");
    } catch (e) {
        setStatus("<b>Beim Aufbau der Excel-Mappe ist ein Fehler aufgetreten.</b><br>" +
                  "<span style='opacity:.7'>(" + e.message + ")</span>", "error");
    } finally {
        /* COM-Referenzen freigeben. Excel bleibt fuer den Anwender sichtbar
           geoeffnet (kein Quit) -- nur unsere Referenzen werden aufgeloest. */
        sheet = null; wb = null; excel = null;
    }

    setButtonEnabled(true);
}
</script>
</body>
</html>
