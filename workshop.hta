<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <title>ERGO Workshop</title>
    <HTA:APPLICATION
        ID="ERGO_Vorgang_Analyse"
        APPLICATIONNAME="ERGO Workshop"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="yes"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="1.88"
        WINDOWSTATE="normal"
    />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 1rem 1.5rem;
        }
        .container { max-width: 1500px; margin: 0 auto; }
        .card {
            background: rgba(30, 41, 59, 0.85);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            margin-bottom: 1rem;
        }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
        .header-left { display: flex; align-items: center; gap: 0.75rem; }
        .logo { font-size: 32px; }
        h1 { font-size: 20px; }
        .subtitle { color: #94a3b8; font-size: 12px; margin-top: 2px; }
        .ver { color: #64748b; font-size: 11px; }

        label {
            display: block; margin-bottom: 0.3rem;
            color: #cbd5e1; font-size: 12px; font-weight: 500;
        }
        input[type="text"], input[type="number"], input[type="password"], textarea, select {
            width: 100%; padding: 8px 10px;
            border: 1px solid #475569; border-radius: 6px;
            background: #1e293b; color: #f1f5f9; font-size: 13px;
            font-family: inherit;
        }
        textarea { resize: vertical; font-family: 'Consolas', monospace; font-size: 11px; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: #ef4444; }

        .grid { display: grid; gap: 0.75rem; }
        .grid-2 { grid-template-columns: 1fr 1fr; }
        .grid-4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
        .grid-cookie { grid-template-columns: 1fr auto; align-items: end; }

        .btn {
            padding: 9px 16px; border: none; border-radius: 6px;
            cursor: pointer; font-size: 13px; font-weight: 500;
            transition: all 0.2s;
        }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-primary { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); color: white; }
        .btn-primary:hover:not(:disabled) { background: linear-gradient(135deg, #f87171 0%, #dc2626 100%); }
        .btn-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
        .btn-success:hover:not(:disabled) { background: linear-gradient(135deg, #34d399 0%, #10b981 100%); }
        .btn-warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
        .btn-warning:hover:not(:disabled) { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); }
        .btn-secondary { background: #475569; color: #f1f5f9; }
        .btn-secondary:hover:not(:disabled) { background: #64748b; }
        .btn-danger { background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); color: white; }
        .btn-danger:hover:not(:disabled) { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }

        .cookie-bar { display: flex; gap: 0.5rem; align-items: center; }
        .cookie-status { font-size: 11px; padding: 4px 8px; border-radius: 4px; }
        .cookie-status.ok { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; }
        .cookie-status.missing { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }

        .drop-area {
            border: 2px dashed #475569; border-radius: 10px;
            padding: 1.25rem; text-align: center; cursor: pointer;
            background: rgba(0,0,0,0.2); transition: all 0.2s;
            margin-bottom: 0.75rem;
        }
        .drop-area:hover, .drop-area.dragover {
            border-color: #ef4444; background: rgba(239, 68, 68, 0.05);
        }
        .drop-area .big { font-size: 28px; margin-bottom: 0.25rem; }
        .drop-area .hint { color: #94a3b8; font-size: 12px; margin-top: 0.25rem; }
        .folder-path { font-family: 'Consolas', monospace; font-size: 12px; color: #cbd5e1; margin-top: 0.5rem; word-break: break-all; }

        .stats { display: flex; gap: 1rem; flex-wrap: wrap; margin: 0.5rem 0 0.75rem; }
        .stat { background: rgba(0,0,0,0.25); padding: 6px 12px; border-radius: 6px; font-size: 12px; }
        .stat strong { color: #ef4444; }
        .stat.ok strong { color: #10b981; }
        .stat.err strong { color: #fca5a5; }

        .action-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

        .progress-container { display: none; margin: 0.75rem 0; }
        .progress-bar { height: 6px; background: #374151; border-radius: 3px; overflow: hidden; }
        .progress-fill {
            height: 100%; background: linear-gradient(90deg, #ef4444, #f97316);
            width: 0%; transition: width 0.3s;
        }
        .progress-text { font-size: 11px; color: #94a3b8; margin-top: 0.4rem; }
        .status { display: none; padding: 0.6rem 0.85rem; border-radius: 6px; margin: 0.5rem 0; font-size: 12px; }
        .status.success { background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; }
        .status.error { background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; }
        .status.info { background: rgba(59, 130, 246, 0.15); border: 1px solid #3b82f6; color: #93c5fd; }

        .results-table-wrap {
            display: none; max-height: 540px; overflow: auto;
            background: rgba(0,0,0,0.25); border-radius: 8px;
            border: 1px solid #334155; margin-top: 0.5rem;
        }
        table.results { width: 100%; border-collapse: collapse; font-size: 11px; }
        table.results th {
            position: sticky; top: 0; background: #0f172a; color: #cbd5e1;
            text-align: left; padding: 6px 8px; border-bottom: 1px solid #334155;
            font-weight: 600; font-size: 10px; text-transform: uppercase;
            white-space: nowrap;
        }
        table.results td {
            padding: 5px 8px; border-bottom: 1px solid #1e293b;
            color: #e2e8f0; vertical-align: top;
        }
        table.results tr:hover td { background: rgba(239, 68, 68, 0.08); cursor: pointer; }
        td.col-date { white-space: nowrap; color: #94a3b8; }
        td.col-betr { font-weight: 500; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        td.col-status { font-weight: 600; white-space: nowrap; }
        td.col-status.s-pending { color: #94a3b8; }
        td.col-status.s-running { color: #fbbf24; }
        td.col-status.s-ok { color: #10b981; }
        td.col-status.s-err { color: #ef4444; }
        td.col-status.s-cancel { color: #94a3b8; }
        td.col-status.s-cache { color: #60a5fa; }
        td.col-klass { font-weight: 500; }
        td.col-vt-makler { color: #6ee7b7; }
        td.col-vt-bounce { color: #94a3b8; }
        td.col-vt-other { color: #fbbf24; }

        .modal-backdrop {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.7); z-index: 100;
            align-items: center; justify-content: center; padding: 2rem;
        }
        .modal-backdrop.active { display: flex; }
        .modal {
            background: #1e293b; border-radius: 10px; padding: 1.25rem;
            max-width: 900px; width: 100%; max-height: 90vh; overflow: auto;
            border: 1px solid #475569;
        }
        .modal h3 { margin-bottom: 0.5rem; }
        .modal .kv { display: grid; grid-template-columns: 180px 1fr; gap: 4px 12px; font-size: 12px; margin-top: 0.75rem; }
        .modal .kv .k { color: #94a3b8; font-weight: 500; }
        .modal .kv .v { color: #e2e8f0; word-break: break-word; }
        .modal pre {
            background: #0f172a; padding: 0.75rem; border-radius: 6px;
            color: #e2e8f0; font-size: 11px; white-space: pre-wrap;
            word-wrap: break-word; max-height: 40vh; overflow: auto;
            font-family: 'Consolas', monospace; margin-top: 0.5rem;
        }

        .info-box {
            background: rgba(59, 130, 246, 0.08); border: 1px solid #1e40af;
            border-radius: 6px; padding: 0.5rem 0.75rem;
            font-size: 11px; color: #cbd5e1; margin-bottom: 0.5rem;
        }
        .compact { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
        .compact > * { margin: 0; }
        .checkbox-row { display: flex; align-items: center; gap: 0.4rem; font-size: 12px; color: #cbd5e1; cursor: pointer; }
        .checkbox-row input { width: auto; margin: 0; }

        details summary { cursor: pointer; padding: 6px 0; font-weight: 500; color: #cbd5e1; font-size: 13px; }
        details[open] summary { color: #f1f5f9; }
    </style>
</head>
<body>
<style id="ws-standalone">body > .container{display:none !important;} #wsClose{display:none !important;} #workshopOverlay{display:block !important;}</style>
<div class="container">

    <!-- UNC/MOTW-Banner sind ab v1.10 entfernt: der VBScript-Subprozess
         loest die Zone-Restriktion ohnehin, das HTA muss nicht mehr von
         C:\ aus laufen. Relocate/Unblock-Funktionen bleiben im Code fuer
         manuellen Aufruf via VBA-Editor-Konsole, falls jemand sie braucht. -->

    <div class="card">
        <div class="header">
            <div class="header-left">
                <div class="logo">&#129302;</div>
                <div>
                    <h1><span style="cursor:pointer; user-select:none;" onclick="openWorkshopMode()" title="Klick fuer Workshop-Modus (Demo mit 5 Mails)">ERGO</span> Vorgang-Analyse</h1>
                    <div class="subtitle">.msg-Mails &rarr; ErgoGPT Klassifikation &rarr; Excel-Export</div>
                </div>
            </div>
            <div class="ver">v1.88 - Kombi-PDF-Bau in Kleinst-Schritten (1 Kopf/1 PDF/1 Endmarke pro Tick) -> UI haengt nicht mehr, Progress+Log laufen sichtbar mit. Workshop-Log jetzt als schoenes HTML-Log (farbcodierte Zeilen + Zeitstempel) statt Klartext. Echte Umlaute (gebündelt, Anhänge, läuft, eingefügt). v1.87 - Experiment Kombi-PDF-Knopf</div>
        </div>

        <!-- Cookie -->
        <details open>
            <summary>1. Cookie fuer gpt.ergo.com</summary>
            <div style="margin-top: 0.5rem;">
                <div class="cookie-bar">
                    <input type="password" id="cookieInput" placeholder="Cookie hier einfuegen (langer String mit XSRF-TOKEN, ai_session, ...)">
                    <button class="btn btn-secondary" onclick="toggleCookieVis()" title="Sichtbarkeit umschalten">&#128065;</button>
                    <button class="btn btn-success" onclick="saveCookie()">Speichern</button>
                    <button class="btn btn-secondary" onclick="loadCookieFromFile()" title="Cookie.txt erneut von der Platte laden">&#128260; Neu laden</button>
                    <span id="cookieStatus" class="cookie-status missing">Cookie fehlt</span>
                </div>
                <div class="info-box" style="margin-top: 0.4rem;">
                    Cookie wird als <code>Cookie.txt</code> <strong>neben der HTA-Datei</strong> gespeichert: <code id="cookiePath">...</code>. Vorteil: gleicher Ordner = gleiche Security-Zone, keine Cross-Domain-Pruefung, funktioniert auch ohne "Zulassen"-Haekchen.
                </div>
            </div>
        </details>
    </div>

    <!-- Folder + Settings -->
    <div class="card">
        <details open>
            <summary>2. Ordner mit .msg-Dateien</summary>
            <div style="margin-top: 0.5rem;">
                <div class="drop-area" id="dropArea" onclick="pickFolder()">
                    <div class="big">&#128194;</div>
                    <div><strong>Ordner waehlen</strong> (oder Ordner hier hereinziehen)</div>
                    <div class="hint">Tool scannt rekursiv nach .msg-Dateien</div>
                </div>
                <div id="folderPath" class="folder-path"></div>
                <div id="folderStats" class="stats"></div>
                <div style="margin-top: 0.5rem;">
                    <button class="btn btn-secondary" id="btnRenameWithDate" onclick="renameMsgFilesWithDate()" disabled
                            style="padding: 6px 12px; font-size: 12px;"
                            title="Benennt alle .msg-Dateien im Ordner um zu YYYY-MM-DD_HHMM_<Originalname>.msg. Datum wird aus dem Mail-Header gelesen (kein Outlook noetig).">
                        &#128221; Datei-Datum als Praefix hinzufuegen (fuer Zeitraum-Filter)
                    </button>
                </div>
            </div>
        </details>

        <details>
            <summary>2b. Zeitraum-Filter (optional)</summary>
            <div style="margin-top: 0.5rem;">
                <div class="row">
                    <div>
                        <label>Von</label>
                        <input type="date" id="dateFrom" onchange="onDateChange()">
                    </div>
                    <div>
                        <label>Bis</label>
                        <input type="date" id="dateTo" onchange="onDateChange()">
                    </div>
                </div>
                <div class="compact" style="margin-top: 0.4rem;">
                    <button class="btn btn-secondary" style="padding:4px 10px;font-size:11px" onclick="setDateRangeQuick(7)">Letzte 7 Tage</button>
                    <button class="btn btn-secondary" style="padding:4px 10px;font-size:11px" onclick="setDateRangeQuick(14)">Letzte 14 Tage</button>
                    <button class="btn btn-secondary" style="padding:4px 10px;font-size:11px" onclick="setDateRangeQuick(30)">Letzte 30 Tage</button>
                    <button class="btn btn-secondary" style="padding:4px 10px;font-size:11px" onclick="setDateRangeQuick(90)">Letzte 90 Tage</button>
                    <button class="btn btn-secondary" style="padding:4px 10px;font-size:11px" onclick="resetDateRange()">Reset (alle)</button>
                </div>
                <div id="dateRangeStatus" style="font-size:11px; color: #94a3b8; margin-top:6px;">
                    Datum-Format: <code>TT.MM.JJJJ</code> (z.B. <code>15.05.2026</code>) oder <code>JJJJ-MM-TT</code> (z.B. <code>2026-05-15</code>). Filtert nach Datum im Dateinamen (Muster <code>YYYY-MM-DD_HHMM_...</code>). Mails ohne erkennbares Datum werden eingeschlossen.
                </div>
                <div style="margin-top: 0.6rem; padding-top: 0.5rem; border-top: 1px solid #334155;">
                    <button class="btn" id="btnCollectByDate" onclick="copyZeitraumToNewFolder()" disabled
                            style="background: linear-gradient(135deg, #0891b2, #155e75); color: white; font-size: 12px; padding: 8px 14px;"
                            title="Kopiert alle Mails im gewaehlten Zeitraum aus dem Ordner (rekursiv durch Unterordner) in einen neuen Ziel-Ordner. Der neue Ordner wird automatisch zum Analyse-Ordner.">
                        &#128193; Mails aus Zeitraum in neuen Ordner sammeln
                    </button>
                    <button class="btn" id="btnRandomSample" onclick="copyRandomSampleToNewFolder()" disabled
                            style="background: linear-gradient(135deg, #7c3aed, #5b21b6); color: white; font-size: 12px; padding: 8px 14px; margin-left: 6px;"
                            title="Zieht eine zufaellige Stichprobe (z.B. 1000 Mails) aus dem aktuellen Ordner / Filter und kopiert sie in einen neuen Ordner fuer's Sampling.">
                        &#127922; Zufallsstichprobe in neuen Ordner kopieren
                    </button>
                    <div style="font-size:11px; color: #94a3b8; margin-top:4px;">
                        <strong>Sammeln:</strong> alle Mails im Zeitraum (Filter wird angewendet).<br>
                        <strong>Zufalls-Stichprobe:</strong> N zufaellig gewaehlte Mails aus dem aktuellen Filter (z.B. 1000 von 5000 fuer Pool-Analyse).<br>
                        Beide kopieren FLACH (keine Unterordner), Originale bleiben erhalten.
                    </div>
                </div>
            </div>
        </details>

        <details>
            <summary>3. Einstellungen</summary>
            <div style="margin-top: 0.5rem;" class="grid grid-2">
                <div>
                    <label>Modell</label>
                    <input type="text" id="modelInput" value="gpt-51-chat">
                </div>
                <div>
                    <label>Parallel-Slots (1-50)</label>
                    <input type="number" id="parallelInput" value="3" min="1" max="50">
                </div>
            </div>
            <div style="margin-top: 0.5rem;" class="compact">
                <label class="checkbox-row">
                    <input type="checkbox" id="reanalyzeAll"> Alle Vorgaenge neu analysieren (Cache ignorieren)
                </label>
                <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 11px;" onclick="clearCache()">Cache fuer diesen Ordner loeschen</button>
            </div>
        </details>
    </div>

    <!-- Action -->
    <div class="card">
        <div class="action-bar">
            <button class="btn btn-primary" id="btnStart" onclick="startAnalysis()" disabled>
                &#9658; Analyse starten (mit KI)
            </button>
            <button class="btn" id="btnQuickPool" onclick="runQuickPoolOverview()" disabled
                    style="background: linear-gradient(135deg, #7c3aed, #5b21b6); color: white;"
                    title="Schnelle Pool-Uebersicht ohne KI - reine Heuristik aus Domain/Subject/Signatur (~1s/Mail, mit Outlook)">
                &#9889; Pool-Uebersicht (Outlook)
            </button>
            <button class="btn" id="btnQuickPoolXxl" onclick="runQuickPoolOverviewXxl()" disabled
                    style="background: linear-gradient(135deg, #0d9488, #064e3b); color: white;"
                    title="XXL: parsed .msg-Dateien direkt ohne Outlook, fuer grosse Sets (1000+ Mails). ~20-50x schneller.">
                &#128640; Pool-XXL (ohne Outlook)
            </button>
            <button class="btn" id="btnBulkTriage" onclick="runBulkTriage()" disabled
                    style="background: linear-gradient(135deg, #d97706, #92400e); color: white;"
                    title="Stufe 1: Bulk-KI-Triage. Sendet 30-40 Mails (Subject+Body) pro KI-Call. Kein PDF-Upload. Setzt Pool-XXL voraus.">
                &#129302; Bulk-Triage (Stufe 1, KI ohne PDF)
            </button>
            <button class="btn btn-warning" id="btnCancel" onclick="cancelAnalysis()" disabled
                    title="Pausiert die Analyse, schreibt den Cache und oeffnet Excel mit den bisherigen Ergebnissen. Beim naechsten Klick auf Start wird automatisch nahtlos weitergemacht - schon analysierte Mails werden uebersprungen.">
                &#9208; Pause (Excel + Resume)
            </button>
            <div style="flex:1;"></div>
            <button class="btn" id="btnRefreshLive" onclick="refreshLiveExcelDecor()" disabled
                    style="background: linear-gradient(135deg, #0d9488, #115e59); color: white;"
                    title="Wendet Farb-Highlights auf ALLE Zeilen im Live-Excel an und baut Auswertung-Sheet neu.">
                &#127912; Farben + Auswertung
            </button>
            <button class="btn" id="btnReReminders" onclick="reAnalyzeReminders()" disabled
                    style="background: linear-gradient(135deg, #b45309, #92400e); color: white;"
                    title="Analysiert NUR die als Reminder erkannten Vorgaenge nochmal - um die neue Spalte 'Reminder_Quelle' (Anhang-PDF / Anhang-Name / Betreff / Body) zu fuellen. Spart Tokens vs Komplett-Neulauf.">
                &#128260; Reminder-Quellen
            </button>
            <button class="btn" id="btnLoadExternalXlsx" onclick="openExternalXlsxPicker()"
                    style="background: linear-gradient(135deg, #6366f1, #4338ca); color: white;"
                    title="Laedt eine externe .xlsx (z.B. dein manuell gefiltertes Reminder-Subset) als Excel-Cache. .msg-Dateien werden im aktuell gewaehlten Ordner gematcht. Alle Eintraege werden zur Neuanalyse markiert.">
                &#128194; Externes Excel laden
            </button>
            <input type="file" id="externalXlsxFile" accept=".xlsx,.xlsm,.xls" style="display:none" onchange="onExternalXlsxPicked(this)">
            <button class="btn" id="btnLoadXlsxCache" onclick="loadXlsxCache()"
                    style="background: linear-gradient(135deg, #7c3aed, #5b21b6); color: white;"
                    title="Oeffnet die bestehende analyse.xlsx im _KI-Analyse-Ordner. Wurde frueher automatisch beim Folder-Select gemacht - jetzt nur auf Klick (dauert bei 5000 Vorgaengen ~30s).">
                &#128196; Cache laden
            </button>
            <button class="btn btn-success" id="btnExcel" onclick="exportToExcel()" disabled>
                &#128202; Excel-Export
            </button>
            <button class="btn btn-secondary" id="btnJson" onclick="exportToJson()" disabled>
                &#128190; JSON-Export
            </button>
        </div>

        <div class="progress-container" id="progressContainer">
            <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
            <div class="progress-text" id="progressText">Verarbeite...</div>
            <div id="slotStatus" style="display:flex; flex-direction: column; gap: 2px; margin-top: 6px; font-size: 11px; color: #cbd5e1; font-family: 'Consolas', monospace;"></div>
            <div style="margin-top: 8px; font-size: 11px; color: #94a3b8;">Live-Log (letzte 50 Mails):</div>
            <div id="aiLog" style="margin-top: 4px; max-height: 220px; overflow-y: auto; font-size: 11px; color: #e2e8f0; font-family: 'Consolas', monospace; background: rgba(15, 23, 42, 0.6); border: 1px solid #334155; border-radius: 4px; padding: 6px 8px; white-space: pre-wrap;"></div>
        </div>

        <div class="status success" id="successStatus"><span id="successMsg"></span></div>
        <div class="status error" id="errorStatus"><span id="errorMsg"></span></div>
        <div class="status info" id="infoStatus"><span id="infoMsg"></span></div>
    </div>

    <!-- Results -->
    <div class="card" style="padding: 0.75rem 1rem;">
        <div class="compact" style="margin-bottom: 0.5rem;">
            <strong style="font-size: 13px;">Ergebnisse</strong>
            <span id="resultsCount" style="color: #94a3b8; font-size: 12px;">0 Vorgaenge</span>
        </div>
        <div class="results-table-wrap" id="resultsTableWrap">
            <table class="results">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Status</th>
                        <th>Datei</th>
                        <th>Datum</th>
                        <th>Absender</th>
                        <th>Betreff</th>
                        <th>Triage</th>
                        <th>Klassifikation</th>
                        <th>Pool</th>
                        <th>Kunde</th>
                        <th>MV vollst.</th>
                        <th>Hinweis</th>
                    </tr>
                </thead>
                <tbody id="resultsBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal-backdrop" id="detailModal" onclick="closeDetail(event)">
        <div class="modal" onclick="event.stopPropagation()">
            <h3 id="detailTitle"></h3>
            <div id="detailKv" class="kv"></div>
            <pre id="detailRaw"></pre>
            <div style="margin-top: 0.75rem; text-align: right;">
                <button class="btn btn-secondary" onclick="closeDetail()">Schliessen</button>
            </div>
        </div>
    </div>

</div>

<!-- v1.5: VBScript-Helper komplett entfernt. Pure JS Multipart, da VBScript-
     Funktionen in HTAs aus UNC/Internet-Zone fuer JS nicht zugaenglich sind. -->


<script language="JavaScript">
'use strict';

// ============================================================================
// GLOBAL STATE
// ============================================================================
var outlookApp = null;
var outlookNS = null;
var COOKIE_PATH = "";  // computed at startup -> Cookie.txt next to this HTA
var ERGO_BASE = "https://gpt.ergo.com/api";
// Limits absichtlich SEHR hoch - die KI soll die volle Mail + alle Anhaenge sehen.
// MAX_PDFS war frueher 3 (Token-Sparen bei 5000er-Laeufen). Bei kleineren
// Stichproben gibt es keinen Grund Anhaenge zu droppen.
// MAX_PDF_MB schuetzt nur vor wirklich riesigen Files (z.B. 100MB-Scans).
// BODY_CAP wird in der Praxis fast nie erreicht - typische Mails sind <5000 Zeichen.
var MAX_PDFS = 50;        // praktisch unbegrenzt
var MAX_PDF_MB = 25;      // einzelne PDFs > 25 MB sind unrealistisch + ErgoGPT-Risiko
var BODY_CAP = 50000;     // ca. 12500 Tokens - normaler GPT-Kontext reicht easy
var DRAIN_TIMEOUT_MS = 240000;

var state = {
    cookie: "",
    folderPath: "",
    msgFiles: [],         // array of full paths
    results: [],          // array of result objects (cache-compatible)
    pendingMap: {},       // msgPath -> true if already in results
    running: false,
    cancelled: false,
    slots: {},            // active slot map
    slotCounter: 0,
    nextIdx: 0,
    parallelN: 3,
    txtFolderEnabled: false,
    dateFrom: null,       // Date object oder null
    dateTo: null,         // Date object oder null
    // Excel-Live-Cache (v1.54): waehrend Analyse wird jeder Vorgang sofort als
    // Zeile in eine .xlsx-Datei im _KI-Analyse-Ordner geschrieben. Excel ist
    // sichtbar, User sieht live wie's waechst. Wb.Save alle 10 Mails.
    excelApp: null,
    excelWb: null,
    excelSheet: null,
    excelXlsxPath: "",
    excelLiveRowCount: 0    // Anzahl Zeilen ab Zeile 2 die schon geschrieben sind
};

// ============================================================================
// INIT
// ============================================================================
window.onload = function() {
    try { window.resizeTo(1480, 920); } catch(e) {}

    // Outlook
    try {
        outlookApp = new ActiveXObject("Outlook.Application");
        outlookNS = outlookApp.GetNamespace("MAPI");
    } catch(e) {
        showError("Outlook konnte nicht verbunden werden. Bitte Outlook oeffnen und HTA neu starten. (" + e.message + ")");
    }

    // Cookie-Pfad: Cookie.txt neben der HTA-Datei (gleiche Security-Zone)
    COOKIE_PATH = getHtaDir() + "\\Cookie.txt";
    document.getElementById("cookiePath").innerText = COOKIE_PATH || "(HTA-Pfad nicht ermittelbar)";

    // Ab v1.10: keine UNC/MOTW-Banner mehr - der VBScript-Subprozess
    // umgeht die Zone-Restriktion ohnehin. HTA kann von UNC laufen.

    // Load cookie
    loadCookieFromFile();

    // Load saved settings from localStorage
    try {
        var saved = window.localStorage ? window.localStorage.getItem("ergo_va_settings") : null;
        if (saved) {
            var s = eval("(" + saved + ")");
            if (s.model) document.getElementById("modelInput").value = s.model;
            if (s.parallel) document.getElementById("parallelInput").value = s.parallel;
            if (s.lastFolder) {
                // Don't auto-load - require explicit user action - but pre-fill
                state.folderPath = s.lastFolder;
                document.getElementById("folderPath").innerText = "Zuletzt verwendet: " + s.lastFolder + " (Ordner waehlen zum Laden)";
            }
        }
    } catch(e) {}

    // Drag-drop
    setupDragDrop();
    try { setTimeout(function(){ openWorkshopMode(); }, 200); } catch(e) {}
};

function setupDragDrop() {
    var area = document.getElementById("dropArea");
    area.ondragenter = function(e) { e.preventDefault(); area.className = "drop-area dragover"; return false; };
    area.ondragover = function(e) { e.preventDefault(); area.className = "drop-area dragover"; return false; };
    area.ondragleave = function(e) { area.className = "drop-area"; };
    area.ondrop = function(e) {
        e.preventDefault();
        area.className = "drop-area";
        try {
            var dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                // HTA-Hack: in IE11 mode the File object often has .path
                var first = dt.files[0];
                var p = first.path;
                if (p) {
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    if (fso.FolderExists(p)) {
                        useFolder(p);
                        return false;
                    } else if (fso.FileExists(p)) {
                        // dropped a file - use its parent folder
                        var parent = fso.GetParentFolderName(p);
                        useFolder(parent);
                        return false;
                    }
                }
                showError("Pfad konnte nicht aus dem Drop-Event extrahiert werden. Bitte 'Ordner waehlen' nutzen.");
            }
        } catch(ex) {
            showError("Drop-Verarbeitung fehlgeschlagen: " + ex.message + " - bitte 'Ordner waehlen' nutzen.");
        }
        return false;
    };
}

// ============================================================================
// COOKIE
// ============================================================================
function loadCookieFromFile() {
    if (!COOKIE_PATH) {
        updateCookieStatus(false, "HTA-Pfad nicht ermittelbar");
        return;
    }
    var fso;
    try { fso = new ActiveXObject("Scripting.FileSystemObject"); }
    catch(e) { updateCookieStatus(false, "FSO nicht verfuegbar: " + e.message); return; }

    if (!fso.FileExists(COOKIE_PATH)) {
        updateCookieStatus(false, "Cookie.txt nicht gefunden");
        return;
    }

    // FSO.OpenTextFile statt ADODB.Stream - ADODB.Stream ist in IE-Internet-Zone
    // (UNC-Pfade!) als 'Datenquelle' gesperrt, FSO nicht.
    // Format: -2=System Default, -1=Unicode (UTF-16 LE), 0=ASCII
    var attempts = [
        { fmt: 0,  name: "ASCII" },
        { fmt: -1, name: "Unicode (UTF-16)" },
        { fmt: -2, name: "System-Default" }
    ];
    var best = "";
    var bestName = "";
    var lastErr = "";
    for (var i = 0; i < attempts.length; i++) {
        try {
            var ts = fso.OpenTextFile(COOKIE_PATH, 1, false, attempts[i].fmt);
            var raw = ts.ReadAll();
            ts.Close();
            raw = trim(String(raw));
            if (raw.charCodeAt(0) === 0xFEFF) raw = raw.substr(1);
            if (raw.length > best.length) { best = raw; bestName = attempts[i].name; }
            if (raw.length >= 50 && raw.indexOf("=") >= 0) {
                state.cookie = raw;
                document.getElementById("cookieInput").value = raw;
                updateCookieStatus(true, "Geladen via FSO/" + attempts[i].name + " (" + raw.length + " Zeichen)");
                return;
            }
        } catch(e) {
            lastErr = attempts[i].name + ": " + e.message;
        }
    }
    if (best.length > 0) {
        updateCookieStatus(false, "Datei nur " + best.length + " Zeichen / kein '=' (probiert: " + bestName + ")");
    } else {
        updateCookieStatus(false, "Datei unlesbar - " + (lastErr || "leere oder ungueltige Datei"));
    }
}

function saveCookie() {
    var raw = trim(document.getElementById("cookieInput").value);
    if (raw.length < 50) {
        showError("Cookie sieht zu kurz aus (min. 50 Zeichen). Bitte den vollen Cookie-String aus dem Browser einfuegen.");
        return;
    }
    if (!COOKIE_PATH) {
        showError("HTA-Pfad konnte nicht ermittelt werden - Cookie-Datei kann nicht gespeichert werden.");
        return;
    }
    try {
        // FSO.CreateTextFile statt ADODB.Stream - in UNC/Internet-Zone laeuft
        // ADODB.Stream nicht (gilt als 'Datenquelle'), FSO aber schon.
        // Cookie-String ist ASCII-safe (Base64, Hex etc.), Unicode nicht noetig.
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var ts = fso.CreateTextFile(COOKIE_PATH, true, false); // overwrite, ASCII
        ts.Write(raw);
        ts.Close();
        state.cookie = raw;
        updateCookieStatus(true, "Gespeichert via FSO (" + raw.length + " Zeichen)");
        showSuccess("Cookie gespeichert: " + COOKIE_PATH);
    } catch(e) {
        showError("Cookie konnte nicht gespeichert werden: " + e.message + " (Pfad: " + COOKIE_PATH + ")");
    }
}

function toggleCookieVis() {
    var i = document.getElementById("cookieInput");
    i.type = (i.type === "password") ? "text" : "password";
}

function updateCookieStatus(ok, detail) {
    var s = document.getElementById("cookieStatus");
    if (ok) {
        s.className = "cookie-status ok";
        s.innerText = "Cookie OK: " + (detail || ("Laenge " + state.cookie.length));
        s.title = "Cookie-Datei: " + COOKIE_PATH;
    } else {
        s.className = "cookie-status missing";
        s.innerText = "Cookie fehlt" + (detail ? " - " + detail : "");
        s.title = "Pfad geprueft: " + COOKIE_PATH;
    }
    refreshStartButton();
}

function extractCsrf(cookie) {
    if (!cookie) return "";
    var m = cookie.match(/(?:XSRF-TOKEN|CSRF-TOKEN|csrfToken|_csrf)=([^;]+)/i);
    if (!m) return "";
    try { return decodeURIComponent(m[1].replace(/\+/g, " ")); } catch(e) { return m[1]; }
}

// ============================================================================
// FOLDER
// ============================================================================
function pickFolder() {
    try {
        var shell = new ActiveXObject("Shell.Application");
        var f = shell.BrowseForFolder(0, "Ordner mit .msg-Dateien waehlen", 0);
        if (f && f.Self && f.Self.Path) {
            useFolder(f.Self.Path);
        }
    } catch(e) {
        var p = prompt("Ordner-Pfad eingeben:", state.folderPath || "C:\\");
        if (p) useFolder(p);
    }
}

function useFolder(path) {
    state.folderPath = path;
    document.getElementById("folderPath").innerText = path;
    saveSettings();
    scanFolder();
    refreshStartButton();
}

function scanFolder() {
    state.msgFiles = [];
    state.results = [];
    state.pendingMap = {};
    // Excel-Cache-State zuruecksetzen (wird ggf. spaeter per Klick geoeffnet)
    state.excelApp = null; state.excelWb = null; state.excelSheet = null;
    state.excelLiveRowCount = 0;
    hideStatus();
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if (!fso.FolderExists(state.folderPath)) {
            showError("Ordner nicht gefunden: " + state.folderPath);
            renderTable();
            return;
        }
        collectMsgFiles(fso, fso.GetFolder(state.folderPath));

        // KEIN Auto-Open der xlsx mehr (das dauert bei 5000 Zeilen 20-60s!).
        // Stattdessen: Info anzeigen, User entscheidet ob/wie Cache geladen werden soll.
        var xlsxPath = getXlsxCachePath();
        if (xlsxPath && fso.FileExists(xlsxPath)) {
            var sz = 0;
            try { sz = fso.GetFile(xlsxPath).Size; } catch(eS) {}
            var sizeStr = Math.round(sz / 1024) + " KB";
            showInfo("<strong>" + state.msgFiles.length + " .msg-Dateien</strong> gefunden. " +
                     "Bestehende Analyse: <code>analyse.xlsx</code> (" + sizeStr + "). Du hast drei Optionen:<br>" +
                     "&nbsp;&nbsp;1. <strong>'Cache laden'</strong> &rarr; oeffnet die volle xlsx (kann ~30s dauern)<br>" +
                     "&nbsp;&nbsp;2. <strong>'Externes Excel laden'</strong> &rarr; nur ein Subset (z.B. nur Reminder, schnell)<br>" +
                     "&nbsp;&nbsp;3. <strong>Start</strong> &rarr; ignoriert bestehende Analyse, faengt neu an");
        } else {
            // Legacy: cache.json laden falls vorhanden und keine xlsx da
            loadCache();
            if (state.msgFiles.length > 0 && state.results.length === 0) {
                showInfo(state.msgFiles.length + " .msg-Dateien gefunden. Keine bestehende Analyse - klick Start oder lade externes Excel.");
            }
        }

        renderTable();
        refreshFolderStats();
        refreshDateRangeStatus();
        if (state.msgFiles.length === 0) showInfo("Keine .msg-Dateien gefunden.");
    } catch(e) {
        showError("Ordner-Scan fehlgeschlagen: " + e.message);
    }
}

// Lazy: laed die analyse.xlsx erst auf User-Klick (war frueher Auto-Load in scanFolder).
function loadXlsxCache() {
    if (!state.folderPath) {
        showError("Erst Mail-Ordner waehlen.");
        return;
    }
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var p = getXlsxCachePath();
    if (!fso.FileExists(p)) {
        showError("Keine analyse.xlsx im _KI-Analyse-Ordner: " + p);
        return;
    }
    showInfo("Lade Excel-Cache... bei grossen Dateien ~10-60s.");
    try {
        if (ensureExcelCache()) {
            var n = readResultsFromExcelLive();
            renderTable();
            refreshFolderStats();
            refreshStartButton();
            showSuccess("Excel-Cache geladen: <strong>" + n + "</strong> Vorgaenge. Klick Start fuer weitere Analyse oder 'Externes Excel laden' fuer Subset-Workflow.");
        }
    } catch(e) {
        showError("Cache laden fehlgeschlagen: " + e.message);
    }
}

function collectMsgFiles(fso, folder) {
    try {
        var files = new Enumerator(folder.Files);
        for (; !files.atEnd(); files.moveNext()) {
            var f = files.item();
            if (String(f.Name).toLowerCase().substr(-4) === ".msg") {
                state.msgFiles.push(f.Path);
            }
        }
        var subs = new Enumerator(folder.SubFolders);
        for (; !subs.atEnd(); subs.moveNext()) {
            var sub = subs.item();
            // Don't recurse into _KI-Analyse cache folder
            if (String(sub.Name) !== "_KI-Analyse") {
                collectMsgFiles(fso, sub);
            }
        }
    } catch(e) {}
}

// ============================================================================
// CACHE
// ============================================================================
function cachePath() {
    if (!state.folderPath) return "";
    return state.folderPath + "\\_KI-Analyse\\cache.json";
}

function ensureCacheFolder() {
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var dir = state.folderPath + "\\_KI-Analyse";
        if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    } catch(e) {}
}

function loadCache() {
    var p = cachePath();
    if (!p) {
        showInfo("Cache: kein Pfad berechnet (folderPath leer?).");
        return;
    }
    // Volle Diagnose, damit der User sieht was passiert
    var fsoCk;
    try { fsoCk = new ActiveXObject("Scripting.FileSystemObject"); }
    catch(eF) { showError("Cache: FSO nicht verfuegbar - " + eF.message); return; }

    if (!fsoCk.FileExists(p)) {
        // Datei nicht da - zeige wo gesucht wurde + was im _KI-Analyse-Ordner liegt
        var cacheDir = state.folderPath + "\\_KI-Analyse";
        var diag = "Cache nicht gefunden bei: <code>" + p + "</code>. ";
        if (fsoCk.FolderExists(cacheDir)) {
            try {
                var folder = fsoCk.GetFolder(cacheDir);
                var en = new Enumerator(folder.Files);
                var names = [];
                for (; !en.atEnd(); en.moveNext()) names.push(String(en.item().Name));
                diag += "Inhalt von <code>" + cacheDir + "</code>: [" + (names.length > 0 ? names.join(", ") : "leer") + "]";
            } catch(eL) { diag += "Inhalt konnte nicht gelesen werden: " + eL.message; }
        } else {
            diag += "Unterordner <code>_KI-Analyse</code> existiert NICHT in <code>" + state.folderPath + "</code>.";
            // Vielleicht in einem direkten Unterordner? Suche eine Ebene tiefer
            try {
                var topFolder = fsoCk.GetFolder(state.folderPath);
                var subs = new Enumerator(topFolder.SubFolders);
                var hits = [];
                for (; !subs.atEnd(); subs.moveNext()) {
                    var sub = subs.item();
                    var subCache = String(sub.Path) + "\\_KI-Analyse\\cache.json";
                    if (fsoCk.FileExists(subCache)) hits.push(subCache);
                }
                if (hits.length > 0) diag += " Aber Cache existiert in Unter-Ordnern: " + hits.join(", ") + " - dort den Ordner auswaehlen!";
            } catch(eS) {}
        }
        showError(diag);
        return;
    }

    // Cache.json wird von saveCache() IMMER als UTF-16 LE geschrieben.
    // ADODB.Stream mit Charset="unicode" liest deterministisch die volle Datei -
    // FSO.OpenTextFile.ReadAll() hat bei >1 MB Dateien einen bekannten Bug, der
    // unterschiedlich viel zurueckliefert je nach Memory-State.
    var fileSize = 0;
    try {
        var f = fsoCk.GetFile(p);
        fileSize = f.Size;
    } catch(eFS) {}

    var raw = "";
    var readMethod = "";
    var readErr = "";
    // OFFIZIELLER deterministischer Read: VBScript-Helper macht ALLES intern:
    //   1. ADODB.Stream Type=1 + LoadFromFile (blockt synchron bis komplett im RAM)
    //   2. Stream.Size-Verify gegen fileSize
    //   3. stm.Read() liefert SafeArray of Bytes
    //   4. UTF-16-LE-Decode via MidB/AscB/ChrW direkt in VBScript
    //   5. Rueckgabe als String (BSTR) - marshalt 1:1 nach JScript
    // KEIN JScript-VBArray.toArray() - das hat bei grossen Arrays Partial-Returns.
    try {
        raw = String(ReadFileFullUtf16LE(p));
        readMethod = "VBScript binary->UTF16LE decode (" + raw.length + " chars)";
    } catch(eA) {
        readErr += "VBScript-Read: " + eA.message + ". ";
        // Fallback 1: FSO ReadAll
        try {
            var fRead = fsoCk.OpenTextFile(p, 1, false, -1);
            raw = String(fRead.ReadAll());
            fRead.Close();
            readMethod = "FSO Unicode (VBScript-Read scheiterte)";
        } catch(eU) {
            showError("Cache laden fehlgeschlagen. " + readErr + "FSO: " + eU.message + " (Pfad: " + p + ")");
            return;
        }
    }

    // CRC ueber gesamtes raw (nicht nur erste 100k!) - zeigt zuverlaessig ob
    // sich die Datei zwischen Loads veraendert
    var crc = 0;
    for (var ci = 0; ci < raw.length; ci++) {
        crc = ((crc << 5) - crc + raw.charCodeAt(ci)) | 0;
    }

    // BOM strippen (ADODB.unicode strippt BOM normalerweise selbst, aber sicher ist sicher)
    if (raw.length > 0 && raw.charCodeAt(0) === 0xFEFF) raw = raw.substr(1);

    // File-Modification-Time einlesen - User sieht ob sich Datei aendert zwischen Loads
    var lastMod = "";
    try { lastMod = String(fsoCk.GetFile(p).DateLastModified); } catch(eM) {}

    // Letzte 200 Zeichen des raw - zeigt ob JSON sauber mit '] }' endet
    var rawEnd = raw.length > 200 ? raw.substr(raw.length - 200) : raw;
    rawEnd = rawEnd.replace(/[\r\n]+/g, " ");

    // Sanity-Check: erwartete Char-Anzahl bei UTF-16 LE = (fileSize - 2 BOM) / 2
    var expectedChars = fileSize > 0 ? Math.floor((fileSize - 2) / 2) : 0;
    var readPctOk = expectedChars > 0 ? Math.round((raw.length / expectedChars) * 100) : 0;
    var sizeInfo = " [Datei: " + Math.round(fileSize / 1024) + " KB | mod: " + lastMod +
                   " | gelesen: " + Math.round(raw.length * 2 / 1024) + " KB via " + readMethod +
                   " | " + readPctOk + "% | CRC=" + (crc >>> 0).toString(16) +
                   " | Ende: '..." + rawEnd.substr(rawEnd.length - 80).replace(/'/g, "\"") + "']";

    if (!raw || raw.length < 10) {
        showError("Cache-Datei leer oder zu klein (" + raw.length + " Zeichen)." + sizeInfo);
        return;
    }

    // BEIDE Parser laufen lassen und das groessere Ergebnis nehmen.
    // Hintergrund: JSON.parse hat in IE11 bei sehr grossen Strings ggf. Quirks,
    // eval ist permissiver. Wenn JSON.parse z.B. 1061 Eintraege liefert, eval
    // aber 2000 - dann hatte JSON.parse partial-parse-Issue.
    var dataJson = null, dataEval = null;
    var parseErr = "";
    try {
        if (typeof JSON !== "undefined" && JSON.parse) dataJson = JSON.parse(raw);
    } catch(eJP) { parseErr += "JSON.parse: " + eJP.message + ". "; }
    try {
        dataEval = eval("(" + raw + ")");
    } catch(eEv) { parseErr += "eval: " + eEv.message + ". "; }

    // Welcher Parser hat mehr Eintraege?
    var jsonCount = (dataJson && dataJson.results && dataJson.results.length) || 0;
    var evalCount = (dataEval && dataEval.results && dataEval.results.length) || 0;
    var data = (evalCount > jsonCount) ? dataEval : dataJson;
    if (!data) data = dataEval || dataJson;
    var parserUsed = (evalCount > jsonCount) ? "eval(" + evalCount + ")" : "JSON.parse(" + jsonCount + ")";
    sizeInfo += " [Parser: " + parserUsed + ", JSON=" + jsonCount + " eval=" + evalCount + "]";
    if (!data) {
        var sample = "Anfang: '" + raw.substr(0, 200).replace(/[\r\n]+/g, " ") + "' | Ende: '" +
                     raw.substr(Math.max(0, raw.length - 200)).replace(/[\r\n]+/g, " ") + "'";
        showError("Cache laden fehlgeschlagen (Parsing). Dateigroesse: " +
                  Math.round(raw.length / 1024) + " KB. Fehler: " + parseErr + ". " + sample);
        return;
    }
    if (!data.results || data.results.length === 0) {
        showInfo("Cache-Datei vorhanden aber leer (data.results=" + (data.results ? data.results.length : "fehlt") + ")." + sizeInfo);
        return;
    }
    state.results = data.results;
    state.pendingMap = {};
    for (var i = 0; i < state.results.length; i++) {
        state.pendingMap[String(state.results[i].msgPath).toLowerCase()] = true;
    }
    // Letzten Eintrag anzeigen damit User sieht, was der "letzte" gecachte Vorgang war
    var lastEntry = state.results[state.results.length - 1];
    var lastInfo = lastEntry ? " Letzter Eintrag: " + (lastEntry.msgFile || lastEntry.msgPath || "?") + " (" + (lastEntry.analyzedAt || "?") + ")" : "";
    showInfo("Cache geladen: <strong>" + state.results.length + "</strong> Vorgaenge." + sizeInfo + lastInfo);
}

function saveCache() {
    var p = cachePath();
    if (!p || state.results.length === 0) return;
    try {
        ensureCacheFolder();
        var data = {
            version: 1,
            folder: state.folderPath,
            updatedAt: isoNow(),
            results: state.results
        };
        writeTextFile(p, jsonStringify(data));
    } catch(e) {
        // Don't crash on cache write fail
    }
}

// ============================================================================
// EXCEL-LIVE-CACHE (v1.54)
// xlsx-Datei im _KI-Analyse-Ordner ist die Wahrheitsquelle. Waehrend Analyse
// wird jeder fertige Vorgang sofort als Zeile geschrieben (eine Range.Value
// pro Cell = ~50ms pro Vorgang - vernachlaessigbar vs ErgoGPT ~3-5s).
// Wb.Save alle 10 Vorgaenge, sowie bei Pause/Finish.
// ============================================================================
function getXlsxCachePath() {
    if (!state.folderPath) return "";
    return state.folderPath + "\\_KI-Analyse\\analyse.xlsx";
}

var EXCEL_HEADERS = ["#","Datei","Datum","Auftrag_Datum","Absender Name","Absender Email","Empfaenger","Betreff","Anhaenge",
                     "Maklerpool","Makler_Nachname","Makler_Vorname","Maklernummer",
                     "Kunde_Nachname","Kunde_Vorname","Kundennummer","Versicherungsnummer",
                     "Vorgangstyp","Ist_Reminder","Klassifikation","Klassifikation_Grund",
                     "Geschaefts_Typ","Unterlagen_Angefragt","Unterlagen_Liste","Sonderfall","Sparte",
                     "Anhang_Typen","PDF_Qualitaet","MV_Enthalten","MV_Vollumfaenglich","MV_Einschraenkungen","MV_Status",
                     "Unterschrift_Kunde","Unterschrift_Makler","Auf_VN","Makler_Namentlich","Hinweis","Fehler","Reminder_Quelle",
                     "Mail_Zusammenfassung","Nicht_Neu_Grund"];

// Reminder-Indikatoren - Schluesselwoerter die in Betreff oder Anhang-Namen
// auf einen Reminder hindeuten. Match-case-insensitiv.
var REMINDER_RE = /\b(mahnung|reminder|erinnerung|wiedervorlage|\bWV\b|sachstandsanfrage|nachfass|2\.?\s*Mahnung)\b/i;

// Reminder-Quelle: bevorzugt KI-Antwort r.data.reminder_quelle (v1.59+).
// Fallback fuer alte Cache-Eintraege: Heuristik auf Anhang-Name + Betreff.
// Liefert komma-getrennte Liste falls mehrere Quellen zutreffen.
function detectReminderSource(r) {
    if (!r || !r.data) return "";
    if (sg(r.data, "ist_reminder") !== "ja") return "";
    // KI-Antwort (neue Analysen ab v1.59) - bevorzugt, kann schon Komma-Liste sein
    var kiQuelle = sg(r.data, "reminder_quelle");
    if (kiQuelle && kiQuelle.length > 0) return kiQuelle;
    // Fallback fuer alte Caches: Heuristik (kann Mail-Body / PDF-Inhalt nicht sehen)
    var parts = [];
    if (REMINDER_RE.test(String(r.anhangAlle || ""))) parts.push("Anhang-Dateiname");
    if (REMINDER_RE.test(String(r.betreff || ""))) parts.push("Mail-Betreff");
    if (parts.length === 0) return "Body/PDF (alt-Cache, Heuristik blind)";
    return parts.join(", ") + " (Heuristik)";
}

// Splittet eine Reminder-Quelle-Liste in atomare Quellen.
// Normalisiert "(Heuristik)"-Suffix weg, Whitespace, etc.
function splitReminderQuellen(s) {
    if (!s) return [];
    var clean = String(s).replace(/\s*\(Heuristik\)\s*/gi, "").replace(/\s*\(alt-Cache.*?\)\s*/gi, "");
    var parts = clean.split(",");
    var out = [];
    for (var i = 0; i < parts.length; i++) {
        var p = parts[i].replace(/^\s+|\s+$/g, "");
        if (p.length > 0) out.push(p);
    }
    return out;
}

// Stellt sicher dass state.excelApp / Wb / Sheet existieren und das xlsx
// im _KI-Analyse-Ordner geoeffnet/erstellt ist. Returns true bei Erfolg.
function ensureExcelCache() {
    if (state.excelSheet) {
        // Check ob die Reference noch lebt
        try { var test = state.excelSheet.Cells(1, 1).Value; return true; } catch(e) {
            state.excelApp = null; state.excelWb = null; state.excelSheet = null;
            state.excelLiveRowCount = 0;
        }
    }
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var dir = state.folderPath + "\\_KI-Analyse";
        if (!fso.FolderExists(dir)) {
            try { fso.CreateFolder(dir); } catch(eDir) {}
        }
        var xlsxPath = getXlsxCachePath();
        state.excelXlsxPath = xlsxPath;

        if (!state.excelApp) {
            state.excelApp = new ActiveXObject("Excel.Application");
            state.excelApp.Visible = true;
            state.excelApp.DisplayAlerts = false;
        }

        if (fso.FileExists(xlsxPath)) {
            state.excelWb = state.excelApp.Workbooks.Open(xlsxPath);
        } else {
            state.excelWb = state.excelApp.Workbooks.Add();
            try { state.excelWb.ActiveSheet.Name = "Analyse"; } catch(eN) {}
            state.excelWb.SaveAs(xlsxPath, 51);   // 51 = xlOpenXMLWorkbook (.xlsx)
        }
        try { state.excelSheet = state.excelWb.Sheets("Analyse"); } catch(eSht) {
            state.excelSheet = state.excelWb.ActiveSheet;
            try { state.excelSheet.Name = "Analyse"; } catch(eN2) {}
        }

        // Header schreiben wenn Zeile 1 noch leer
        var cellA1 = "";
        try { cellA1 = String(state.excelSheet.Cells(1, 1).Value || ""); } catch(eC) {}
        if (cellA1 === "" || cellA1 === "0") {
            writeExcelLiveHeaders(state.excelSheet);
            state.excelLiveRowCount = 0;
        } else {
            // Bestimme wie viele Datenzeilen schon drin sind
            var used = 0;
            try { used = state.excelSheet.UsedRange.Rows.Count; } catch(eU) {}
            state.excelLiveRowCount = Math.max(0, used - 1);
        }
        return true;
    } catch(e) {
        showError("Excel-Live-Cache konnte nicht initialisiert werden: " + e.message);
        return false;
    }
}

function writeExcelLiveHeaders(sheet) {
    try {
        for (var c = 0; c < EXCEL_HEADERS.length; c++) {
            sheet.Cells(1, c + 1).Value = EXCEL_HEADERS[c];
        }
        var hr = sheet.Range(sheet.Cells(1, 1), sheet.Cells(1, EXCEL_HEADERS.length));
        hr.Font.Bold = true;
        hr.Font.Color = rgb(255, 255, 255);
        hr.Interior.Color = rgb(30, 64, 175);
        hr.HorizontalAlignment = -4108;
        hr.WrapText = true;
        sheet.Rows(1).RowHeight = 28;
        // Freeze pane
        try {
            sheet.Range("A2").Select();
            state.excelApp.ActiveWindow.FreezePanes = true;
        } catch(eFr) {}
        // Spaltenbreiten grob
        try {
            sheet.Columns("A:A").ColumnWidth = 5;
            sheet.Columns("B:B").ColumnWidth = 40;
            sheet.Columns("C:I").ColumnWidth = 16;
        } catch(eCw) {}
    } catch(e) {}
}

// Schreibt eine Result-Zeile in das Excel-Live-Sheet. Verwendet r._excelRow
// wenn gesetzt (Update), sonst Append am Ende.
function writeResultRowToExcel(r) {
    if (!state.excelSheet) return;
    try {
        var rowIdx;
        if (r._excelRow && r._excelRow >= 2) {
            rowIdx = r._excelRow;
        } else {
            state.excelLiveRowCount++;
            rowIdx = state.excelLiveRowCount + 1;
            r._excelRow = rowIdx;
        }
        var d = r.data || {};
        var sht = state.excelSheet;
        sht.Cells(rowIdx, 1).Value = rowIdx - 1;
        sht.Cells(rowIdx, 2).Value = cellSafe(r.msgFile);
        sht.Cells(rowIdx, 3).Value = cellSafe(r.datum);
        sht.Cells(rowIdx, 4).Value = cellSafe(sg(d, "auftrag_datum"));
        sht.Cells(rowIdx, 5).Value = cellSafe(r.absName);
        sht.Cells(rowIdx, 6).Value = cellSafe(r.absMail);
        sht.Cells(rowIdx, 7).Value = cellSafe(r.empfaenger);
        sht.Cells(rowIdx, 8).Value = cellSafe(r.betreff);
        sht.Cells(rowIdx, 9).Value = cellSafe(r.anhangAlle);
        sht.Cells(rowIdx, 10).Value = cellSafe(sg(d, "maklerpool"));
        sht.Cells(rowIdx, 11).Value = cellSafe(sg(d, "makler_nachname"));
        sht.Cells(rowIdx, 12).Value = cellSafe(sg(d, "makler_vorname"));
        sht.Cells(rowIdx, 13).Value = cellSafe(sg(d, "makler_nummer"));
        sht.Cells(rowIdx, 14).Value = cellSafe(sg(d, "kunde_nachname"));
        sht.Cells(rowIdx, 15).Value = cellSafe(sg(d, "kunde_vorname"));
        sht.Cells(rowIdx, 16).Value = cellSafe(sg(d, "kunde_nummer"));
        sht.Cells(rowIdx, 17).Value = cellSafe(sg(d, "versicherungsnummer"));
        sht.Cells(rowIdx, 18).Value = cellSafe(sg(d, "vorgangstyp"));
        sht.Cells(rowIdx, 19).Value = cellSafe(sg(d, "ist_reminder"));
        sht.Cells(rowIdx, 20).Value = cellSafe(sg(d, "klassifikation"));
        sht.Cells(rowIdx, 21).Value = cellSafe(sg(d, "klassifikation_grund"));
        sht.Cells(rowIdx, 22).Value = cellSafe(sg(d, "geschaefts_typ"));
        sht.Cells(rowIdx, 23).Value = cellSafe(sg(d, "unterlagen_angefragt"));
        sht.Cells(rowIdx, 24).Value = cellSafe(sg(d, "unterlagen_liste"));
        sht.Cells(rowIdx, 25).Value = cellSafe(sg(d, "sonderfall"));
        sht.Cells(rowIdx, 26).Value = cellSafe(sg(d, "sparte"));
        sht.Cells(rowIdx, 27).Value = cellSafe(sg(d, "anhang_typen"));
        sht.Cells(rowIdx, 28).Value = cellSafe(sg(d, "pdf_qualitaet"));
        sht.Cells(rowIdx, 29).Value = cellSafe(sg(d, "enthaelt_maklervollmacht"));
        sht.Cells(rowIdx, 30).Value = cellSafe(sg(d, "mv_vollumfaenglich"));
        sht.Cells(rowIdx, 31).Value = cellSafe(sg(d, "mv_einschraenkungen"));
        sht.Cells(rowIdx, 32).Value = cellSafe(computeMvStatus(r));
        sht.Cells(rowIdx, 33).Value = cellSafe(sg(d, "unterschrift_kunde"));
        sht.Cells(rowIdx, 34).Value = cellSafe(sg(d, "unterschrift_makler"));
        sht.Cells(rowIdx, 35).Value = cellSafe(sg(d, "auf_vn_ausgestellt"));
        sht.Cells(rowIdx, 36).Value = cellSafe(sg(d, "makler_namentlich_genannt"));
        sht.Cells(rowIdx, 37).Value = cellSafe(sg(d, "hinweis"));
        sht.Cells(rowIdx, 38).Value = r.ok ? "" : cellSafe(r.errMsg);
        sht.Cells(rowIdx, 39).Value = cellSafe(detectReminderSource(r));
        sht.Cells(rowIdx, 40).Value = cellSafe(sg(d, "mail_zusammenfassung"));
        sht.Cells(rowIdx, 41).Value = cellSafe(sg(d, "nicht_neuer_vorgang_grund"));
        // Highlights live anwenden (~6-10 zusaetzliche COM-Calls, vernachlaessigbar
        // weil Mail-Analyse-Tempo ~3-5s pro Mail).
        applyHighlightsToLiveRow(rowIdx, r);
    } catch(e) {
        // Schreib-Fehler einer Zeile darf den Analyse-Lauf nicht killen
    }
}

function saveExcelLiveCache() {
    if (!state.excelWb) return;
    try { state.excelWb.Save(); } catch(e) {}
}

// Highlight-Farben (gleich wie in exportToExcel)
var H_LIVE_ROT    = function() { return rgb(252, 165, 165); };
var H_LIVE_GRUEN  = function() { return rgb(187, 247, 208); };
var H_LIVE_GELB   = function() { return rgb(254, 240, 138); };
var H_LIVE_ORANGE = function() { return rgb(254, 215, 170); };
var H_LIVE_BERN   = function() { return rgb(253, 230, 138); };
var H_LIVE_GRAU   = function() { return rgb(229, 231, 235); };

// Spalten-Indizes im Live-Excel (1-basiert) - muss zur EXCEL_HEADERS-Reihenfolge passen
var LIVE_COL_VORGANGSTYP = 18, LIVE_COL_REMINDER = 19, LIVE_COL_KLASSIFIK = 20;
var LIVE_COL_SONDERFALL = 25, LIVE_COL_PDF_QUAL = 28;
var LIVE_COL_VM_VOLLST = 30, LIVE_COL_MV_STATUS = 32;
var LIVE_COL_UNTERSCHR_K = 33, LIVE_COL_UNTERSCHR_M = 34;
var LIVE_COL_MAKLERPOOL = 10, LIVE_COL_HINWEIS = 37, LIVE_COL_FEHLER = 38, LIVE_COL_REMINDER_QUELLE = 39;

// Wendet Highlight-Farben auf EINE Zeile im Live-Excel an. Wird sowohl per-Zeile
// waehrend Analyse aufgerufen als auch im Bulk-Pass nach Migration.
function applyHighlightsToLiveRow(rowIdx, r) {
    if (!state.excelSheet) return;
    var d = r.data || {};
    try {
        if (!r.ok || r.errMsg) {
            state.excelSheet.Cells(rowIdx, LIVE_COL_FEHLER).Interior.Color = H_LIVE_ROT();
        }
        var vt = sg(d, "vorgangstyp");
        if (vt && vt !== "Makler-Vorgang" && vt !== "") {
            state.excelSheet.Range(state.excelSheet.Cells(rowIdx, LIVE_COL_MAKLERPOOL), state.excelSheet.Cells(rowIdx, LIVE_COL_HINWEIS)).Interior.Color = H_LIVE_GRAU();
            state.excelSheet.Cells(rowIdx, LIVE_COL_VORGANGSTYP).Interior.Color = H_LIVE_ORANGE();
        }
        if (sg(d, "ist_reminder") === "ja") state.excelSheet.Cells(rowIdx, LIVE_COL_REMINDER).Interior.Color = H_LIVE_ORANGE();
        // Reminder_Quelle (Spalte 39) - farblich markieren je nach Quelle
        var rq = detectReminderSource(r);
        if (rq.indexOf("Anhang") === 0) state.excelSheet.Cells(rowIdx, LIVE_COL_REMINDER_QUELLE).Interior.Color = rgb(167, 139, 250);   // Violett
        else if (rq.indexOf("Mail-Betreff") === 0 || rq.indexOf("Betreff") === 0) state.excelSheet.Cells(rowIdx, LIVE_COL_REMINDER_QUELLE).Interior.Color = H_LIVE_ORANGE();   // Orange
        else if (rq.length > 0) state.excelSheet.Cells(rowIdx, LIVE_COL_REMINDER_QUELLE).Interior.Color = H_LIVE_GELB();      // Gelb
        var sond = sg(d, "sonderfall");
        if (sond === "Flottengeschaeft" || sond === "Sondertarif") state.excelSheet.Cells(rowIdx, LIVE_COL_SONDERFALL).Interior.Color = H_LIVE_ROT();
        var kl = sg(d, "klassifikation");
        if (kl === "Nicht-Standard") state.excelSheet.Cells(rowIdx, LIVE_COL_KLASSIFIK).Interior.Color = H_LIVE_BERN();
        var pq = sg(d, "pdf_qualitaet");
        if (pq === "Scan") state.excelSheet.Cells(rowIdx, LIVE_COL_PDF_QUAL).Interior.Color = H_LIVE_BERN();
        else if (pq === "Mixed") state.excelSheet.Cells(rowIdx, LIVE_COL_PDF_QUAL).Interior.Color = H_LIVE_GELB();
        var mvv = sg(d, "mv_vollumfaenglich");
        if (mvv === "teilweise" || mvv === "nein") state.excelSheet.Cells(rowIdx, LIVE_COL_VM_VOLLST).Interior.Color = H_LIVE_ROT();
        else if (mvv === "ja") state.excelSheet.Cells(rowIdx, LIVE_COL_VM_VOLLST).Interior.Color = H_LIVE_GRUEN();
        var mvSt = computeMvStatus(r);
        if (mvSt === "OK") state.excelSheet.Cells(rowIdx, LIVE_COL_MV_STATUS).Interior.Color = H_LIVE_GRUEN();
        else if (mvSt === "MV unvollstaendig" || mvSt === "MV fehlt") state.excelSheet.Cells(rowIdx, LIVE_COL_MV_STATUS).Interior.Color = H_LIVE_ROT();
        else if (mvSt === "kein Anhang") state.excelSheet.Cells(rowIdx, LIVE_COL_MV_STATUS).Interior.Color = H_LIVE_GRAU();
        else if (mvSt === "nicht pruefbar") state.excelSheet.Cells(rowIdx, LIVE_COL_MV_STATUS).Interior.Color = H_LIVE_GELB();
        var uk = sg(d, "unterschrift_kunde");
        if (uk === "nein") state.excelSheet.Cells(rowIdx, LIVE_COL_UNTERSCHR_K).Interior.Color = H_LIVE_ROT();
        else if (uk === "ja") state.excelSheet.Cells(rowIdx, LIVE_COL_UNTERSCHR_K).Interior.Color = H_LIVE_GRUEN();
        var um = sg(d, "unterschrift_makler");
        if (um === "nein") state.excelSheet.Cells(rowIdx, LIVE_COL_UNTERSCHR_M).Interior.Color = H_LIVE_ROT();
        else if (um === "ja") state.excelSheet.Cells(rowIdx, LIVE_COL_UNTERSCHR_M).Interior.Color = H_LIVE_GRUEN();
    } catch(eHL) {}
}

// Wendet Highlights auf MEHRERE Zeilen an (Bulk nach Migration). Mit
// Excel-Speed-Flags damit das schnell geht.
function applyHighlightsToLiveRows(startRow, endRow, results) {
    if (!state.excelSheet) return;
    try { state.excelApp.ScreenUpdating = false; } catch(eF) {}
    try { state.excelApp.Calculation = -4135; } catch(eF) {}
    for (var i = 0; i < results.length; i++) {
        applyHighlightsToLiveRow(startRow + i, results[i]);
    }
    try { state.excelApp.ScreenUpdating = true; } catch(eF) {}
    try { state.excelApp.Calculation = -4105; } catch(eF) {}
}

// Baut die Auswertung-Sheet neu im Excel-Live-Workbook. Loescht ein
// existierendes Auswertung-Sheet und ruft die buildAuswertungSheet-Funktion
// aus exportToExcel auf - die kennt die Stats-Logik (Postfach-Drilldown, MV-Status etc).
// Oeffnet den File-Picker fuer das externe Excel. Triggert via Klick auf
// das versteckte <input type="file">. onChange ruft onExternalXlsxPicked.
function openExternalXlsxPicker() {
    if (!state.folderPath) {
        showError("Bitte zuerst den Mail-Ordner waehlen (Drop-Bereich oben). Dann externes Excel laden.");
        return;
    }
    var inp = document.getElementById("externalXlsxFile");
    if (!inp) { showError("File-Picker nicht initialisiert"); return; }
    // Reset value damit onChange auch bei gleicher Datei nochmal feuert
    try { inp.value = ""; } catch(e) {}
    inp.click();
}

// onChange-Handler vom File-Input. In HTA liefert input.value den vollen Pfad.
function onExternalXlsxPicked(input) {
    if (!input || !input.value) return;
    var path = String(input.value);
    if (path.length === 0) return;
    loadExternalXlsx(path);
}

// Externes Excel als Cache laden (z.B. manuell auf Reminder gefiltertes Subset).
// Vorteil: nur ~700 Reminder im Cache statt 5000 Komplett-Daten.
// Voraussetzung: Mail-Ordner ist schon gewaehlt (state.folderPath).
// path: optional - wenn nicht uebergeben, wird der File-Picker geoeffnet.
function loadExternalXlsx(path) {
    if (!state.folderPath) {
        showError("Bitte zuerst den Mail-Ordner waehlen (Drop-Bereich oben). Dann externes Excel laden.");
        return;
    }
    if (!path) {
        // Kein Pfad uebergeben - File-Picker oeffnen
        openExternalXlsxPicker();
        return;
    }
    path = String(path).replace(/^["']|["']$/g, "");   // Pfad-Anfuehrungszeichen weg
    var fso;
    try { fso = new ActiveXObject("Scripting.FileSystemObject"); } catch(eF) { showError("FSO nicht verfuegbar"); return; }
    if (!fso.FileExists(path)) {
        showError("Datei nicht gefunden: " + path);
        return;
    }
    try {
        // Existing Excel-Workbook schliessen falls offen
        if (state.excelWb) {
            try { state.excelWb.Close(false); } catch(eC) {}
            state.excelWb = null;
            state.excelSheet = null;
        }
        if (!state.excelApp) {
            state.excelApp = new ActiveXObject("Excel.Application");
            state.excelApp.DisplayAlerts = false;
        }
        state.excelApp.Visible = true;
        state.excelWb = state.excelApp.Workbooks.Open(path);
        state.excelXlsxPath = path;
        try { state.excelSheet = state.excelWb.Sheets("Analyse"); } catch(eS) {
            state.excelSheet = state.excelWb.ActiveSheet;
        }
        // Eintraege lesen + state.results befuellen
        var n = readResultsFromExcelLive();
        if (n === 0) {
            showError("Externes Excel geoeffnet, aber 0 lesbare Zeilen gefunden. Erwartetes Format: gleicher Header wie das Live-Excel (Spalte B = Datei).");
            return;
        }
        // Alle Eintraege zur Neuanalyse markieren (pendingMap leeren)
        for (var k in state.pendingMap) {
            if (state.pendingMap.hasOwnProperty(k)) delete state.pendingMap[k];
        }
        // KRITISCH: state.msgFiles auf NUR die gematchten Eintraege aus dem externen
        // Excel beschraenken. Sonst wuerde Start alle 5000 .msg-Dateien im Ordner
        // analysieren statt nur die ~700 Reminder.
        var matched = 0, missing = 0;
        var matchedPaths = [];
        var seenPath = {};
        var missingList = [];
        for (var i = 0; i < state.results.length; i++) {
            var p = state.results[i].msgPath || "";
            if (p && fso.FileExists(p) && !seenPath[p.toLowerCase()]) {
                matchedPaths.push(p);
                seenPath[p.toLowerCase()] = true;
                matched++;
            } else if (p && !fso.FileExists(p)) {
                missing++;
                if (missingList.length < 5) missingList.push(state.results[i].msgFile || p);
            }
        }
        state.msgFiles = matchedPaths;  // ueberschreibt die volle Liste mit dem Subset
        // Date-Range-Filter ausschalten, damit alle Reminder durchkommen
        state.dateFrom = null;
        state.dateTo = null;
        try {
            var df = document.getElementById("dateFrom"); if (df) df.value = "";
            var dt = document.getElementById("dateTo"); if (dt) dt.value = "";
        } catch(eD) {}
        renderTable();
        refreshFolderStats();
        refreshDateRangeStatus();
        refreshStartButton();
        var msg = "Externes Excel geladen: <strong>" + n + "</strong> Eintraege. " +
                  "<strong>" + matched + "</strong> .msg-Dateien im Ordner gefunden und ausgewaehlt. ";
        if (missing > 0) msg += "<strong>" + missing + " fehlen</strong> im Ordner";
        if (missingList.length > 0) msg += " (z.B.: " + missingList.join(", ") + "). ";
        else msg += ". ";
        msg += "Work-Queue ist auf diese " + matched + " Vorgaenge beschraenkt. " +
               "<strong>Klick Start</strong> &rarr; nur diese werden (re-)analysiert.";
        showSuccess(msg);
    } catch(e) {
        showError("Externes Excel laden fehlgeschlagen: " + (e.message || "unbekannt"));
    }
}

// User-Trigger: Analysiert NUR die als Reminder erkannten Vorgaenge neu,
// um die reminder_quelle (PDF-Inhalt / Dateiname / Betreff / Body) nachzutragen.
// Markiert sie als nicht-cached, dann normaler Start-Analyse-Lauf.
function reAnalyzeReminders() {
    if (state.results.length === 0) {
        showError("Keine Daten - erst Ordner waehlen.");
        return;
    }
    if (state.cookie.length < 50) {
        showError("Cookie fehlt - kann nicht neu analysieren.");
        return;
    }
    // Zaehle wieviele Reminders es gibt
    var reminders = [];
    for (var i = 0; i < state.results.length; i++) {
        var r = state.results[i];
        if (r && r.data && sg(r.data, "ist_reminder") === "ja") reminders.push(r);
    }
    if (reminders.length === 0) {
        showInfo("Keine Reminder-Vorgaenge gefunden - nichts zu tun.");
        return;
    }
    // Bestaetigung
    var sure = confirm("Es werden " + reminders.length + " Reminder-Vorgaenge neu analysiert " +
                       "(volle KI-Analyse pro Mail, ~" + Math.round(reminders.length * 0.05) +
                       " Cent geschaetzt). Die reminder_quelle-Spalte wird danach befuellt.\n\n" +
                       "Fortfahren?");
    if (!sure) return;
    // Aus pendingMap entfernen damit sie als nicht-cached gelten
    for (var k = 0; k < reminders.length; k++) {
        var rk = reminders[k];
        delete state.pendingMap[String(rk.msgPath).toLowerCase()];
    }
    appendAiLog("OK", "", "Reminder-Re-Analyse: " + reminders.length + " Vorgaenge zur Neuanalyse markiert");
    // Normaler Start-Lauf - der filtert ueber pendingMap und nimmt nur die Reminders
    startAnalysis();
}

// User-Trigger: wendet Farb-Highlights auf ALLE Zeilen im Live-Excel an und
// baut die Auswertung neu. Hilfreich nach bereits gelaufener Migration ohne
// Highlights, oder um Stats nach manuellen Aenderungen zu aktualisieren.
function refreshLiveExcelDecor() {
    if (!state.excelSheet || state.results.length === 0) {
        showError("Kein Excel-Live-Cache offen oder keine Daten. Erst Ordner waehlen und Analyse-Start druecken.");
        return;
    }
    hideStatus();
    showInfo("Wende Farben auf " + state.results.length + " Zeilen an + baue Auswertung neu...");
    try { state.excelApp.ScreenUpdating = false; } catch(eF) {}
    try { state.excelApp.Calculation = -4135; } catch(eF) {}
    var done = 0;
    for (var i = 0; i < state.results.length; i++) {
        var r = state.results[i];
        var rowIdx = r._excelRow || (i + 2);
        // Reminder_Quelle-Spalte (39) jetzt auch befuellen - wichtig fuer
        // alte Migrationen ohne diese Spalte
        try { state.excelSheet.Cells(rowIdx, 39).Value = cellSafe(detectReminderSource(r)); } catch(eRq) {}
        applyHighlightsToLiveRow(rowIdx, r);
        done++;
    }
    try { state.excelApp.ScreenUpdating = true; } catch(eF) {}
    try { state.excelApp.Calculation = -4105; } catch(eF) {}
    try { rebuildLiveAuswertungSheet(); } catch(eA) {}
    try { saveExcelLiveCache(); } catch(eS) {}
    showSuccess("Farben + Auswertung aktualisiert (" + done + " Zeilen). Excel ist auf neuestem Stand.");
}

function rebuildLiveAuswertungSheet() {
    if (!state.excelWb || !state.excelApp) return;
    try {
        // Existing loeschen
        try {
            state.excelApp.DisplayAlerts = false;
            var existing = state.excelWb.Sheets("Auswertung");
            existing.Delete();
        } catch(eD) {}
        try { state.excelApp.DisplayAlerts = true; } catch(eDA) {}
        // Neu bauen via existierender Funktion
        buildAuswertungSheet(state.excelWb, state.excelApp);
        // Zurueck zum Analyse-Sheet
        try { state.excelWb.Sheets("Analyse").Activate(); } catch(eA) {}
    } catch(e) {}
}

// Bulk-Write MEHRERE Results in EINEM Rutsch via VBScript-FillRangeFromTsv.
// Verwendet fuer die initiale Migration (1100+ Vorgaenge aus cache.json -> xlsx),
// damit nicht 1100 x 38 = 41800 sync COM-Calls den Long-Running-Script-Dialog
// triggern und Excel ueberlasten. Returns true bei Erfolg, false bei Fehler.
function bulkWriteResultsToExcel(results) {
    if (!state.excelSheet || results.length === 0) return false;
    var startRow = state.excelLiveRowCount + 2;
    var nRows = results.length;
    var nCols = EXCEL_HEADERS.length;

    // TSV bauen: cellSafeTsv strippt Tabs/Newlines aus Werten
    var rowsTsv = [];
    for (var i = 0; i < nRows; i++) {
        var r = results[i];
        var d = r.data || {};
        var rowNum = state.excelLiveRowCount + i + 1;
        rowsTsv.push(
            String(rowNum) + "\t" +
            cellSafeTsv(r.msgFile) + "\t" +
            cellSafeTsv(r.datum) + "\t" +
            cellSafeTsv(sg(d, "auftrag_datum")) + "\t" +
            cellSafeTsv(r.absName) + "\t" +
            cellSafeTsv(r.absMail) + "\t" +
            cellSafeTsv(r.empfaenger) + "\t" +
            cellSafeTsv(r.betreff) + "\t" +
            cellSafeTsv(r.anhangAlle) + "\t" +
            cellSafeTsv(sg(d, "maklerpool")) + "\t" +
            cellSafeTsv(sg(d, "makler_nachname")) + "\t" +
            cellSafeTsv(sg(d, "makler_vorname")) + "\t" +
            cellSafeTsv(sg(d, "makler_nummer")) + "\t" +
            cellSafeTsv(sg(d, "kunde_nachname")) + "\t" +
            cellSafeTsv(sg(d, "kunde_vorname")) + "\t" +
            cellSafeTsv(sg(d, "kunde_nummer")) + "\t" +
            cellSafeTsv(sg(d, "versicherungsnummer")) + "\t" +
            cellSafeTsv(sg(d, "vorgangstyp")) + "\t" +
            cellSafeTsv(sg(d, "ist_reminder")) + "\t" +
            cellSafeTsv(sg(d, "klassifikation")) + "\t" +
            cellSafeTsv(sg(d, "klassifikation_grund")) + "\t" +
            cellSafeTsv(sg(d, "geschaefts_typ")) + "\t" +
            cellSafeTsv(sg(d, "unterlagen_angefragt")) + "\t" +
            cellSafeTsv(sg(d, "unterlagen_liste")) + "\t" +
            cellSafeTsv(sg(d, "sonderfall")) + "\t" +
            cellSafeTsv(sg(d, "sparte")) + "\t" +
            cellSafeTsv(sg(d, "anhang_typen")) + "\t" +
            cellSafeTsv(sg(d, "pdf_qualitaet")) + "\t" +
            cellSafeTsv(sg(d, "enthaelt_maklervollmacht")) + "\t" +
            cellSafeTsv(sg(d, "mv_vollumfaenglich")) + "\t" +
            cellSafeTsv(sg(d, "mv_einschraenkungen")) + "\t" +
            cellSafeTsv(computeMvStatus(r)) + "\t" +
            cellSafeTsv(sg(d, "unterschrift_kunde")) + "\t" +
            cellSafeTsv(sg(d, "unterschrift_makler")) + "\t" +
            cellSafeTsv(sg(d, "auf_vn_ausgestellt")) + "\t" +
            cellSafeTsv(sg(d, "makler_namentlich_genannt")) + "\t" +
            cellSafeTsv(sg(d, "hinweis")) + "\t" +
            (r.ok ? "" : cellSafeTsv(r.errMsg)) + "\t" +
            cellSafeTsv(detectReminderSource(r)) + "\t" +
            cellSafeTsv(sg(d, "mail_zusammenfassung")) + "\t" +
            cellSafeTsv(sg(d, "nicht_neuer_vorgang_grund"))
        );
        r._excelRow = startRow + i;
    }
    var bigTsv = rowsTsv.join("\n");

    // Excel-Speed-Flags waehrend Bulk-Write
    try { state.excelApp.ScreenUpdating = false; } catch(eF) {}
    try { state.excelApp.Calculation = -4135; } catch(eF) {}
    try { state.excelApp.EnableEvents = false; } catch(eF) {}

    var ok = false;
    var method = "";
    try {
        var rng = state.excelSheet.Range(
            state.excelSheet.Cells(startRow, 1),
            state.excelSheet.Cells(startRow + nRows - 1, nCols)
        );
        FillRangeFromTsv(rng, bigTsv, "\n", "\t", nRows, nCols);
        // Sanity-Check: 3 Stichproben
        var s1 = String(state.excelSheet.Cells(startRow, 2).Value || "");
        var midR = startRow + Math.floor(nRows / 2);
        var sM = String(state.excelSheet.Cells(midR, 2).Value || "");
        var sE = String(state.excelSheet.Cells(startRow + nRows - 1, 2).Value || "");
        if (s1.length > 0 && sM.length > 0 && sE.length > 0) {
            state.excelLiveRowCount += nRows;
            ok = true;
            method = "FillRangeFromTsv";
        }
    } catch(eB) {}

    if (!ok) {
        // Methode 2: Clipboard-Paste. Bewaehrte Excel-Bulk-Methode.
        // Tab-Newline-TSV in Clipboard, Cell selektieren, Paste.
        try {
            // Cleanup falls erster Versuch teilweise gefuellt hat
            try {
                state.excelSheet.Range(
                    state.excelSheet.Cells(startRow, 1),
                    state.excelSheet.Cells(startRow + nRows - 1, nCols)
                ).ClearContents();
            } catch(eClr) {}
            window.clipboardData.clearData();
            window.clipboardData.setData("Text", bigTsv);
            state.excelSheet.Range(state.excelSheet.Cells(startRow, 1), state.excelSheet.Cells(startRow, 1)).Select();
            state.excelSheet.Paste();
            // Sanity
            var c1 = String(state.excelSheet.Cells(startRow, 2).Value || "");
            var cM = String(state.excelSheet.Cells(startRow + Math.floor(nRows / 2), 2).Value || "");
            var cE = String(state.excelSheet.Cells(startRow + nRows - 1, 2).Value || "");
            if (c1.length > 0 && cM.length > 0 && cE.length > 0) {
                state.excelLiveRowCount += nRows;
                ok = true;
                method = "Clipboard-Paste";
            }
            try { window.clipboardData.clearData(); } catch(eCC) {}
        } catch(eCp) {}
    }

    // Flags zurueck
    try { state.excelApp.ScreenUpdating = true; } catch(eF) {}
    try { state.excelApp.Calculation = -4105; } catch(eF) {}
    try { state.excelApp.EnableEvents = true; } catch(eF) {}

    if (ok) {
        appendAiLog("OK", "", "Bulk-Write erfolgreich via " + method + " (" + nRows + " Zeilen)");
        // Highlights bulk-applizieren auf alle frisch geschriebenen Zeilen
        appendAiLog("OK", "", "Wende Farb-Highlights an (" + nRows + " Zeilen)...");
        applyHighlightsToLiveRows(startRow, startRow + nRows - 1, results);
        appendAiLog("OK", "", "Highlights fertig. Baue Auswertung-Sheet...");
        rebuildLiveAuswertungSheet();
        appendAiLog("OK", "", "Auswertung-Sheet fertig.");
    } else {
        // Cleanup partial write + reset _excelRow markers
        try {
            state.excelSheet.Range(
                state.excelSheet.Cells(startRow, 1),
                state.excelSheet.Cells(startRow + nRows - 1, nCols)
            ).ClearContents();
        } catch(eC) {}
        for (var j = 0; j < nRows; j++) results[j]._excelRow = 0;
    }
    return ok;
}

// Liest die Daten aus einem existierenden xlsx (vor Analyse-Start)
// und befuellt state.results + state.pendingMap. Returns Anzahl gelesener Zeilen.
function readResultsFromExcelLive() {
    if (!state.excelSheet) return 0;
    var lastRow = 1;
    try { lastRow = state.excelSheet.UsedRange.Rows.Count; } catch(e) {}
    if (lastRow < 2) return 0;
    // Build msgFile -> msgPath map aus state.msgFiles
    var fileToPath = {};
    for (var fi = 0; fi < state.msgFiles.length; fi++) {
        var fp = state.msgFiles[fi];
        var fn = fp.substr(fp.lastIndexOf("\\") + 1);
        fileToPath[fn.toLowerCase()] = fp;
    }
    state.results = [];
    state.pendingMap = {};
    for (var r = 2; r <= lastRow; r++) {
        try {
            var msgFile = String(state.excelSheet.Cells(r, 2).Value || "");
            if (!msgFile) continue;
            var msgPath = fileToPath[msgFile.toLowerCase()] || msgFile;  // fallback: nur filename
            var errMsgStr = String(state.excelSheet.Cells(r, 38).Value || "");
            var entry = {
                msgPath: msgPath,
                msgFile: msgFile,
                datum: String(state.excelSheet.Cells(r, 3).Value || ""),
                absName: String(state.excelSheet.Cells(r, 5).Value || ""),
                absMail: String(state.excelSheet.Cells(r, 6).Value || ""),
                empfaenger: String(state.excelSheet.Cells(r, 7).Value || ""),
                betreff: String(state.excelSheet.Cells(r, 8).Value || ""),
                anhangAlle: String(state.excelSheet.Cells(r, 9).Value || ""),
                ok: !errMsgStr,
                errMsg: errMsgStr,
                _excelRow: r,
                data: {
                    auftrag_datum: String(state.excelSheet.Cells(r, 4).Value || ""),
                    maklerpool: String(state.excelSheet.Cells(r, 10).Value || ""),
                    makler_nachname: String(state.excelSheet.Cells(r, 11).Value || ""),
                    makler_vorname: String(state.excelSheet.Cells(r, 12).Value || ""),
                    makler_nummer: String(state.excelSheet.Cells(r, 13).Value || ""),
                    kunde_nachname: String(state.excelSheet.Cells(r, 14).Value || ""),
                    kunde_vorname: String(state.excelSheet.Cells(r, 15).Value || ""),
                    kunde_nummer: String(state.excelSheet.Cells(r, 16).Value || ""),
                    versicherungsnummer: String(state.excelSheet.Cells(r, 17).Value || ""),
                    vorgangstyp: String(state.excelSheet.Cells(r, 18).Value || ""),
                    ist_reminder: String(state.excelSheet.Cells(r, 19).Value || ""),
                    klassifikation: String(state.excelSheet.Cells(r, 20).Value || ""),
                    klassifikation_grund: String(state.excelSheet.Cells(r, 21).Value || ""),
                    geschaefts_typ: String(state.excelSheet.Cells(r, 22).Value || ""),
                    unterlagen_angefragt: String(state.excelSheet.Cells(r, 23).Value || ""),
                    unterlagen_liste: String(state.excelSheet.Cells(r, 24).Value || ""),
                    sonderfall: String(state.excelSheet.Cells(r, 25).Value || ""),
                    sparte: String(state.excelSheet.Cells(r, 26).Value || ""),
                    anhang_typen: String(state.excelSheet.Cells(r, 27).Value || ""),
                    pdf_qualitaet: String(state.excelSheet.Cells(r, 28).Value || ""),
                    enthaelt_maklervollmacht: String(state.excelSheet.Cells(r, 29).Value || ""),
                    mv_vollumfaenglich: String(state.excelSheet.Cells(r, 30).Value || ""),
                    mv_einschraenkungen: String(state.excelSheet.Cells(r, 31).Value || ""),
                    unterschrift_kunde: String(state.excelSheet.Cells(r, 33).Value || ""),
                    unterschrift_makler: String(state.excelSheet.Cells(r, 34).Value || ""),
                    auf_vn_ausgestellt: String(state.excelSheet.Cells(r, 35).Value || ""),
                    makler_namentlich_genannt: String(state.excelSheet.Cells(r, 36).Value || ""),
                    hinweis: String(state.excelSheet.Cells(r, 37).Value || ""),
                    reminder_quelle: String(state.excelSheet.Cells(r, 39).Value || ""),
                    mail_zusammenfassung: String(state.excelSheet.Cells(r, 40).Value || ""),
                    nicht_neuer_vorgang_grund: String(state.excelSheet.Cells(r, 41).Value || "")
                }
            };
            state.results.push(entry);
            state.pendingMap[msgPath.toLowerCase()] = true;
        } catch(eR) {}
    }
    state.excelLiveRowCount = state.results.length;
    return state.results.length;
}

// FSO-first, ADODB.Stream-Fallback Pattern (von BGAV-HTA abgeleitet).
// Notwendig fuer UNC/Internet-Zone: ADODB.Stream blockiert mit
// "Datenquelle in anderer Domaene", FSO nicht.
function writeTextFile(path, content) {
    var fsoErr = "", adbErr = "";
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var f = fso.CreateTextFile(path, true, true); // overwrite=true, unicode=true (UTF-16 LE)
        f.Write(content);
        f.Close();
        return;
    } catch(e) { fsoErr = e.message; }
    try {
        var stm = new ActiveXObject("ADODB.Stream");
        stm.Type = 2; stm.Charset = "utf-8"; stm.Open();
        stm.WriteText(content);
        stm.SaveToFile(path, 2);
        stm.Close();
        return;
    } catch(e) { adbErr = e.message; }
    throw new Error("Schreiben fehlgeschlagen (FSO: " + fsoErr + " / ADODB: " + adbErr + ")");
}

function readTextFile(path) {
    var fso;
    try { fso = new ActiveXObject("Scripting.FileSystemObject"); }
    catch(e) { throw new Error("FSO nicht verfuegbar: " + e.message); }
    if (!fso.FileExists(path)) return "";

    // FSO mit Format-Fallback (Unicode -> SystemDefault -> ASCII).
    // Wir nehmen die laengste plausible Variante.
    var fmts = [-1, -2, 0];
    var best = "";
    for (var i = 0; i < fmts.length; i++) {
        try {
            var f = fso.OpenTextFile(path, 1, false, fmts[i]);
            var t = String(f.ReadAll());
            f.Close();
            if (t.length > best.length) best = t;
        } catch(e) {}
    }
    if (best.charCodeAt(0) === 0xFEFF) best = best.substr(1);
    if (best.length > 0) return best;

    // Letzter Versuch: ADODB.Stream UTF-8 (geht in lokaler Zone)
    try {
        var stm = new ActiveXObject("ADODB.Stream");
        stm.Type = 2; stm.Charset = "utf-8"; stm.Open();
        stm.LoadFromFile(path);
        var t2 = stm.ReadText();
        stm.Close();
        return String(t2 || "");
    } catch(e) {
        throw new Error("Lesen fehlgeschlagen: " + e.message);
    }
}

function clearCache() {
    if (!state.folderPath) { showError("Erst Ordner waehlen."); return; }
    if (!confirm("Cache fuer\n" + state.folderPath + "\nwirklich loeschen?\n(Die .msg-Dateien selbst bleiben unangetastet)")) return;
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var p = cachePath();
        if (fso.FileExists(p)) fso.DeleteFile(p, true);
        state.results = [];
        state.pendingMap = {};
        renderTable();
        scanFolder();
        showSuccess("Cache geloescht.");
    } catch(e) {
        showError("Cache konnte nicht geloescht werden: " + e.message);
    }
}

// ============================================================================
// ANALYSIS - MAIN
// ============================================================================
function refreshStartButton() {
    var canStart = !state.running &&
                   state.cookie.length > 50 &&
                   state.folderPath.length > 0 &&
                   state.msgFiles.length > 0 &&
                   outlookApp !== null;
    var canQuick = !state.running &&
                   state.folderPath.length > 0 &&
                   state.msgFiles.length > 0 &&
                   outlookApp !== null;
    // XXL braucht KEIN Outlook, nur Ordner + Mails
    var canXxl = !state.running &&
                 state.folderPath.length > 0 &&
                 state.msgFiles.length > 0;
    // Bulk-Triage: braucht Cookie + Folder + Mails (Outlook nicht zwingend)
    var canBulk = !state.running &&
                  state.cookie.length > 50 &&
                  state.folderPath.length > 0 &&
                  state.msgFiles.length > 0;
    document.getElementById("btnStart").disabled = !canStart;
    document.getElementById("btnQuickPool").disabled = !canQuick;
    document.getElementById("btnQuickPoolXxl").disabled = !canXxl;
    document.getElementById("btnBulkTriage").disabled = !canBulk;
    document.getElementById("btnCancel").disabled = !state.running;
    document.getElementById("btnExcel").disabled = state.results.length === 0;
    var btnRf = document.getElementById("btnRefreshLive");
    if (btnRf) btnRf.disabled = !state.excelSheet || state.results.length === 0;
    var btnRR = document.getElementById("btnReReminders");
    if (btnRR) btnRR.disabled = state.running || state.results.length === 0 || state.cookie.length < 50;
    document.getElementById("btnJson").disabled = state.results.length === 0;
    // Rename-Button: braucht nur Ordner + Mails
    var btnRn = document.getElementById("btnRenameWithDate");
    if (btnRn) btnRn.disabled = state.running || state.folderPath.length === 0 || state.msgFiles.length === 0;
    // Collect-Button: braucht Ordner + Mails + min. 1 Datum
    var btnCl = document.getElementById("btnCollectByDate");
    if (btnCl) btnCl.disabled = state.running || state.folderPath.length === 0 || state.msgFiles.length === 0 || (!state.dateFrom && !state.dateTo);
    // Random-Sample-Button: braucht nur Ordner + Mails (Datum optional)
    var btnRs = document.getElementById("btnRandomSample");
    if (btnRs) btnRs.disabled = state.running || state.folderPath.length === 0 || state.msgFiles.length === 0;
}

function startAnalysis() {
    if (state.running) return;
    if (!outlookApp) { showError("Outlook nicht verbunden."); return; }
    if (state.cookie.length < 50) { showError("Cookie fehlt oder ungueltig."); return; }

    saveSettings();
    hideStatus();

    state.parallelN = parseInt(document.getElementById("parallelInput").value) || 3;
    if (state.parallelN < 1) state.parallelN = 1;
    if (state.parallelN > 50) state.parallelN = 50;

    var reanalyze = document.getElementById("reanalyzeAll").checked;
    if (reanalyze) {
        state.results = [];
        state.pendingMap = {};
        // Excel-Cache neu beginnen
        state.excelApp = null; state.excelWb = null; state.excelSheet = null;
        state.excelLiveRowCount = 0;
    }

    // EXCEL-LIVE-CACHE initialisieren. Sichtbares Excel-Fenster, persistentes xlsx.
    if (!ensureExcelCache()) {
        showError("Excel-Live-Cache konnte nicht initialisiert werden. Analyse wird nicht gestartet.");
        return;
    }
    // Falls state.results bereits Daten aus cache.json hat, aber Excel noch leer ist,
    // alle bisherigen Eintraege ins Excel migrieren - VIA BULK-WRITE, NICHT zellweise!
    // Bei 1100+ Vorgaengen wuerde zellweise 41800 sync COM-Calls bedeuten -> Long-Running-
    // Script-Dialog + Excel-Hang. Bulk-Write via VBScript FillRangeFromTsv = 1 Call.
    if (state.results.length > 0 && state.excelLiveRowCount === 0) {
        appendAiLog("OK", "", "Excel-Migration (Bulk): " + state.results.length + " Vorgaenge aus cache.json -> xlsx");
        showInfo("Migriere " + state.results.length + " Vorgaenge in Excel (Bulk-Write)...");
        if (bulkWriteResultsToExcel(state.results)) {
            appendAiLog("OK", "", "Migration erfolgreich. xlsx hat jetzt " + state.excelLiveRowCount + " Zeilen.");
        } else {
            appendAiLog("FEHLER", "", "Bulk-Migration scheiterte - faelle auf zellweisen Write zurueck");
            // Fallback: zellweise (kann Dialog triggern bei vielen Eintraegen)
            for (var mi = 0; mi < state.results.length; mi++) {
                writeResultRowToExcel(state.results[mi]);
            }
        }
        saveExcelLiveCache();
        hideStatus();
    }

    // Determine work list: nur Mails im Zeitraum, minus already-cached
    var filtered = getFilteredMsgFiles();
    var work = [];
    for (var i = 0; i < filtered.length; i++) {
        var p = filtered[i];
        if (!state.pendingMap[p.toLowerCase()]) {
            work.push(p);
        }
    }

    if (work.length === 0) {
        showInfo("Alle " + filtered.length + " Vorgaenge im Zeitraum sind bereits im Cache. (Haken setzen bei 'Alle neu analysieren' um zu erzwingen.)");
        return;
    }

    state.running = true;
    state.cancelled = false;
    state.slots = {};
    state.slotCounter = 0;
    state.nextIdx = 0;
    state.workQueue = work;
    state.workTotal = work.length;
    state.processed = 0;
    state.errors = 0;
    state.abortReason = "";

    document.getElementById("progressContainer").style.display = "block";
    clearAiLog();
    appendAiLog("OK", "", "Start: " + work.length + " Mails, " + state.parallelN + " parallele Slots");
    refreshStartButton();
    renderTable();

    // Kick off main loop
    setTimeout(workerTick, 10);
}

function cancelAnalysis() {
    if (!state.running) return;
    state.cancelled = true;
    showInfo("Pause angefordert - laufende Calls werden zu Ende gefuehrt, dann Cache + Excel...");
    // Mark all slots cancelled; workerTick wird sie in Stage-abhaengig sauber entfernen.
    // RUNNING-Slots: http.Abort() ruft Send-WaitForResponse ab.
    // UPLOADING-Slots: VBS laeuft im OS weiter, wir ignorieren das Result.
    for (var k in state.slots) {
        if (!state.slots.hasOwnProperty(k)) continue;
        var sl = state.slots[k];
        sl.cancelled = true;
        if (sl.stage === "RUNNING" && sl.http) {
            try { sl.http.Abort(); } catch(e) {}
        }
    }
}

function workerTick() {
    if (!state.running) return;

    try {
        // A) Fill ONE free slot per tick (sequential prep). prepareSlot ist synchron
        // (Outlook-COM + sync-HTTP + PDF-Upload via VBS, ~1-3s pro Mail). Wuerde man
        // 10 Slots in EINEM Tick prepa-ren, blockiert man 20-30s und Windows zeigt
        // den Long-Running-Script-Dialog. Stattdessen: pro Tick ein Slot, naechster
        // Tick laeuft nach 30ms - Ramp-up auf 10 Slots dauert ~300ms, dann steady-state.
        if (countSlots() < state.parallelN && state.nextIdx < state.workQueue.length && !state.cancelled && !state.abortReason) {
            var msgPath = state.workQueue[state.nextIdx];
            state.nextIdx++;

            var slot = {
                id: ++state.slotCounter,
                msgPath: msgPath,
                cancelled: false,
                phase: "prep"
            };
            updateProgressText("Vorbereiten: " + getFileName(msgPath));

            // Synchronous prep: open MSG, props, PDFs upload, conv create, async start
            var prepOk = prepareSlot(slot);
            if (prepOk) {
                state.slots["s" + slot.id] = slot;
                appendAiLog("OK", slot.msgPath, "Slot " + slot.id + " gestartet (PDFs=" + (slot.pdfListe ? slot.pdfListe.split(";").length : 0) + ")");
            } else {
                // Prep error - write result, continue
                var r = makeResult(slot, false, slot.errMsg || "Vorbereitung fehlgeschlagen");
                addResult(r);
                state.errors++;
                appendAiLog("FEHLER", slot.msgPath, "Prep: " + (slot.errMsg || "Vorbereitung fehlgeschlagen").substr(0, 80));
                if (isAuthError(r.errMsg)) state.abortReason = "AUTH";
                if (isModelError(r.errMsg)) state.abortReason = "MODELL";
            }
        }

        // B) Poll all slots - State Machine: UPLOADING -> READY -> RUNNING -> DONE
        var toRemove = [];
        var UPLOAD_TIMEOUT_MS = 5 * 60 * 1000;  // 5 Min hartes Upload-Timeout
        for (var key in state.slots) {
            if (!state.slots.hasOwnProperty(key)) continue;
            var s = state.slots[key];

            // --- Cancelled: stille Entfernung (alle Stages) ---
            if (s.cancelled) {
                if (s.stage === "CREATING_CONV" && s.convHttp) { try { s.convHttp.Abort(); } catch(eA) {} }
                if (s.stage === "RUNNING" && s.http) { try { s.http.Abort(); } catch(eA) {} }
                if (s.stage === "UPLOADING" || s.stage === "CREATING_CONV") cleanupSlotTempFiles(s);
                if (s.convId) fireDelete(s.convId);
                toRemove.push(key);
                continue;
            }

            // --- CREATING_CONV: async conversation_id holen, dann uploads feuern ---
            if (s.stage === "CREATING_CONV") {
                var convElapsed = new Date().getTime() - (s.convStartedAt || 0);
                if (convElapsed > UPLOAD_TIMEOUT_MS) {
                    var rCT = makeResult(s, false, "[Conv-Timeout] >5min ohne conversation_id");
                    addResult(rCT);
                    state.errors++;
                    appendAiLog("FEHLER", s.msgPath, "Conv-Timeout >5min");
                    cleanupSlotTempFiles(s);
                    toRemove.push(key);
                    continue;
                }
                var convDone = false; var convWinErr = null;
                try { convDone = s.convHttp.WaitForResponse(0); } catch(e) { convWinErr = e; }
                if (convWinErr) {
                    var cMsg = (convWinErr.message || "").toString();
                    var cIsSendRace = cMsg.indexOf("Send") >= 0 || cMsg.indexOf("send") >= 0;
                    if (!s.convRetries) s.convRetries = 0;
                    if (cIsSendRace && s.convRetries < 8) {
                        s.convRetries++;
                        setSlotPhase(s, "Conv-Wait retry " + s.convRetries + "/8");
                    } else {
                        var rCE = makeResult(s, false, "[CONV-ASYNC] " + cMsg);
                        addResult(rCE);
                        state.errors++;
                        appendAiLog("FEHLER", s.msgPath, "[CONV-ASYNC] " + cMsg.substr(0, 80));
                        cleanupSlotTempFiles(s);
                        toRemove.push(key);
                    }
                    continue;
                }
                if (!convDone) {
                    setSlotPhase(s, "Conv-Wait (" + Math.round(convElapsed/1000) + "s)");
                    continue;
                }
                // convHttp ist fertig - convId extrahieren
                try {
                    var convStatus = 0;
                    try { convStatus = s.convHttp.Status; } catch(eS) {}
                    var convResp = "";
                    try { convResp = s.convHttp.ResponseText; } catch(eR) {}
                    if (convStatus !== 200) throw new Error("HTTP " + convStatus + " - " + convResp.substr(0, 200));
                    s.convId = parseJsonStr(convResp, "id");
                    if (!s.convId) throw new Error("Keine conversation_id in: " + convResp.substr(0, 200));
                } catch(eC) {
                    var rCE2 = makeResult(s, false, "[CONV] " + eC.message);
                    addResult(rCE2);
                    state.errors++;
                    appendAiLog("FEHLER", s.msgPath, "[CONV] " + eC.message.substr(0, 80));
                    cleanupSlotTempFiles(s);
                    toRemove.push(key);
                    continue;
                }
                // PDF-Uploads feuern oder direkt READY
                if (s.tempPdfPaths && s.tempPdfPaths.length > 0) {
                    s.uploadHandles = [];
                    try {
                        var fsoU = new ActiveXObject("Scripting.FileSystemObject");
                        for (var piX = 0; piX < s.tempPdfPaths.length; piX++) {
                            var pdfX = s.tempPdfPaths[piX];
                            var fnX = fsoU.GetFileName(pdfX);
                            s.uploadHandles.push(uploadPdfStartAsync(s.convId, pdfX, fnX));
                        }
                        s.uploadStartedAt = new Date().getTime();
                        s.stage = "UPLOADING";
                        setSlotPhase(s, "Upload 0/" + s.uploadHandles.length + " (async)");
                    } catch(eU) {
                        var rUEf = makeResult(s, false, "[Upload-Start] " + eU.message);
                        addResult(rUEf);
                        state.errors++;
                        appendAiLog("FEHLER", s.msgPath, "[Upload-Start] " + eU.message.substr(0, 80));
                        cleanupSlotTempFiles(s);
                        if (s.convId) fireDelete(s.convId);
                        toRemove.push(key);
                        continue;
                    }
                } else {
                    s.docIdsJson = "[]";
                    s.stage = "READY";
                    cleanupSlotTempFiles(s);
                }
                // Drop-through zu UPLOADING/READY in diesem Tick
            }

            // --- UPLOADING: Async PDF-Uploads warten, dann finalize -> READY ---
            if (s.stage === "UPLOADING") {
                var elapsed = new Date().getTime() - (s.uploadStartedAt || 0);
                if (elapsed > UPLOAD_TIMEOUT_MS) {
                    var rU = makeResult(s, false, "[Upload-Timeout] >5min ohne Result");
                    addResult(rU);
                    state.errors++;
                    appendAiLog("FEHLER", s.msgPath, "Upload-Timeout >5min");
                    cleanupSlotTempFiles(s);
                    if (s.convId) fireDelete(s.convId);
                    toRemove.push(key);
                    continue;
                }
                if (pollSlotUploads(s)) {
                    if (finalizeSlotUploads(s)) {
                        // Stage jetzt READY - in diesem Tick gleich startAnswer probieren (drop through)
                    } else {
                        var rUE = makeResult(s, false, s.errMsg || "Upload fehlgeschlagen");
                        addResult(rUE);
                        state.errors++;
                        appendAiLog("FEHLER", s.msgPath, s.errMsg || "Upload");
                        if (s.convId) fireDelete(s.convId);
                        toRemove.push(key);
                        continue;
                    }
                } else {
                    // Noch nicht alle Uploads fertig, naechster Tick erneut
                    continue;
                }
            }

            // --- READY: startAnswerAsync feuern -> RUNNING ---
            if (s.stage === "READY") {
                if (slotStartAnswer(s)) {
                    // Stage jetzt RUNNING, drop through zu Polling
                } else {
                    var rRE = makeResult(s, false, s.errMsg || "Start-Fehler");
                    addResult(rRE);
                    state.errors++;
                    appendAiLog("FEHLER", s.msgPath, s.errMsg || "Start");
                    if (s.convId) fireDelete(s.convId);
                    toRemove.push(key);
                    continue;
                }
            }

            // --- RUNNING: WaitForResponse(0) pollen ---
            if (s.stage === "RUNNING") {
                var done = false;
                var winErr = null;
                try {
                    done = s.http.WaitForResponse(0);
                } catch(e) {
                    winErr = e;
                }

                if (winErr) {
                    var msg = (winErr.message || "").toString();
                    var isSendRace = msg.indexOf("Send") >= 0 || msg.indexOf("send") >= 0;
                    if (!s.waitRetries) s.waitRetries = 0;
                    if (isSendRace && s.waitRetries < 8) {
                        s.waitRetries++;
                        setSlotPhase(s, "warte (retry " + s.waitRetries + "/8)");
                        // bleibt im Slot, naechster Tick erneut
                    } else {
                        var r2 = makeResult(s, false, "[ASYNC] " + msg);
                        addResult(r2);
                        state.errors++;
                        appendAiLog("FEHLER", s.msgPath, "[ASYNC] " + msg.substr(0, 80));
                        fireDelete(s.convId);
                        toRemove.push(key);
                    }
                } else if (done) {
                    var r3 = finalizeSlot(s);
                    addResult(r3);
                    if (r3.ok) state.processed++; else state.errors++;
                    if (isAuthError(r3.errMsg)) state.abortReason = "AUTH";
                    if (isModelError(r3.errMsg)) state.abortReason = "MODELL";
                    var d3 = r3.data || {};
                    appendAiLog(r3.ok ? "OK" : "FEHLER", s.msgPath,
                        r3.ok ? ((d3.klassifikation || "?") + " | " + (d3.maklerpool || "")) : (r3.errMsg || "")
                    );
                    fireDelete(s.convId);
                    toRemove.push(key);
                }
            }
        }
        for (var i = 0; i < toRemove.length; i++) {
            delete state.slots[toRemove[i]];
        }

        // C) Status update - Progressbar + Slot-Liste
        var inflight = countSlots();
        var done2 = state.processed + state.errors;
        updateProgress(done2, state.workTotal,
            inflight + " parallel | " +
            state.processed + " ok | " +
            state.errors + " fehler | " +
            (state.workTotal - state.nextIdx) + " warten");
        renderSlotStatus();

        // D) Save cache every batch finished. cache.json bleibt als Backup,
        // aber das xlsx ist die neue Wahrheitsquelle. wb.Save alle ~10 neue
        // Vorgaenge - sonst wird's bei 5000 Speicher-Aufrufen langsam.
        if (toRemove.length > 0) {
            saveCache();
            renderTable();
            if (!state._excelSaveCounter) state._excelSaveCounter = 0;
            state._excelSaveCounter += toRemove.length;
            if (state._excelSaveCounter >= 10) {
                saveExcelLiveCache();
                state._excelSaveCounter = 0;
            }
        }

        // E) Continue or finish?
        if (state.cancelled) {
            // Wait for inflight to abort (which should be quick), then finish
            if (countSlots() === 0) {
                finishAnalysis("Abgebrochen");
                return;
            }
        } else if (state.abortReason) {
            // Abort - cancel inflight
            for (var k2 in state.slots) {
                if (state.slots.hasOwnProperty(k2)) {
                    try { state.slots[k2].http.Abort(); } catch(e) {}
                }
            }
            if (countSlots() === 0) {
                finishAnalysis(state.abortReason);
                return;
            }
        } else if (state.nextIdx >= state.workQueue.length && countSlots() === 0) {
            finishAnalysis("OK");
            return;
        }
    } catch(e) {
        showError("Pipeline-Fehler: " + e.message);
        finishAnalysis("ERROR");
        return;
    }

    // Schedule next tick:
    // - 0ms wenn freie Slots da sind UND noch Mails zu prepa-ren - so fuellen wir
    //   sofort nach Completion einen neuen Slot nach (Rolling-Replacement).
    // - 200ms wenn alle Slots voll (nur polling, kein CPU-Burner).
    // - 200ms wenn keine Mails mehr - workerTick wartet auf die letzten Inflights.
    var hasFreeSlot = countSlots() < state.parallelN;
    var hasMoreWork = state.nextIdx < state.workQueue.length;
    var delay = (hasFreeSlot && hasMoreWork) ? 0 : 200;
    setTimeout(workerTick, delay);
}

function countSlots() {
    var n = 0;
    for (var k in state.slots) if (state.slots.hasOwnProperty(k)) n++;
    return n;
}

function finishAnalysis(reason) {
    state.running = false;
    saveCache();
    saveExcelLiveCache();   // finaler Save des xlsx
    // Auswertung-Sheet im Live-xlsx neu bauen (mit allen aktuellen Daten)
    try { rebuildLiveAuswertungSheet(); } catch(eA) {}
    try { saveExcelLiveCache(); } catch(eS) {}
    renderTable();
    document.getElementById("progressContainer").style.display = "none";
    document.getElementById("slotStatus").innerText = "";
    refreshStartButton();

    var msg = "";
    switch (reason) {
        case "OK":
            msg = "Analyse fertig: " + state.processed + " erfolgreich, " + state.errors + " Fehler.";
            showSuccess(msg);
            break;
        case "Abgebrochen":
            msg = "Pausiert. Bisher: " + state.processed + " ok, " + state.errors + " fehler. Cache geschrieben - klicke 'Start', um nahtlos weiterzumachen (analysierte Mails werden uebersprungen). Excel wird jetzt geoeffnet...";
            showInfo(msg);
            // Auto-Excel-Export mit aktuellen Ergebnissen (inkl. Stats)
            try {
                if (state.results && state.results.length > 0) {
                    exportToExcel();
                }
            } catch(eExp) {
                showError("Pause-Excel-Export fehlgeschlagen: " + eExp.message + " - Daten sind aber im Cache, manueller Excel-Export per Button moeglich.");
            }
            break;
        case "AUTH":
            showError("Cookie abgelaufen (HTTP 403). Bitte oben neuen Cookie einfuegen + speichern, dann erneut starten. Bisher: " + state.processed + " ok, " + state.errors + " fehler.");
            break;
        case "MODELL":
            showError("Modell wird nicht unterstuetzt. Anderen Modell-Namen in Einstellungen probieren (z.B. gpt-51-chat). Bisher: " + state.processed + " ok, " + state.errors + " fehler.");
            break;
        default:
            showError("Pipeline-Fehler. Bisher: " + state.processed + " ok, " + state.errors + " fehler.");
    }
}

// ============================================================================
// SLOT LIFECYCLE
// ============================================================================
function prepareSlot(slot) {
    var step = "init";
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        step = "MSG oeffnen";
        setSlotPhase(slot, "MSG oeffnen");
        var it = outlookApp.Session.OpenSharedItem(slot.msgPath);

        step = "Properties lesen";
        setSlotPhase(slot, "Properties lesen");
        slot.datum = "";
        slot.absName = "";
        slot.absMail = "";
        slot.empfaenger = "";
        slot.betreff = "";
        slot.body = "";
        try {
            var d = new Date(it.ReceivedTime);
            slot.datum = pad(d.getDate()) + "." + pad(d.getMonth()+1) + "." + d.getFullYear() + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
            slot.dateIso = d.getFullYear() + "-" + pad(d.getMonth()+1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":00";
        } catch(e) {}
        try { slot.absName = String(it.SenderName || ""); } catch(e) {}
        try { slot.absMail = getSenderEmail(it); } catch(e) {}
        try { slot.empfaenger = String(it.To || ""); } catch(e) {}
        try { slot.betreff = String(it.Subject || ""); } catch(e) {}
        try { slot.body = String(it.Body || ""); } catch(e) {}

        step = "Anhaenge extrahieren";
        setSlotPhase(slot, "Anhaenge extrahieren");
        slot.anhangAlle = "";
        slot.pdfListe = "";
        var pdfPaths = [];
        var tempDir = getEnv("TEMP") + "\\ergo_va_hta_" + slot.id;
        try { if (!fso.FolderExists(tempDir)) fso.CreateFolder(tempDir); } catch(e) {}

        var attCount = 0;
        try { attCount = it.Attachments.Count; } catch(e) {}
        for (var a = 1; a <= attCount; a++) {
            try {
                var att = it.Attachments.Item(a);
                var fname = String(att.FileName || "");
                if (fname.length > 0) {
                    if (slot.anhangAlle) slot.anhangAlle += "; ";
                    slot.anhangAlle += fname;
                    if (fname.toLowerCase().substr(-4) === ".pdf") {
                        if (pdfPaths.length >= MAX_PDFS) {
                            // Sehr selten - nur warnen
                            if (slot.pdfListe) slot.pdfListe += "; ";
                            slot.pdfListe += "[uebersprungen: " + fname + "]";
                        } else {
                            var safe = sanitizeFilename(fname);
                            var outPath = tempDir + "\\" + safe;
                            att.SaveAsFile(outPath);
                            if (fso.FileExists(outPath)) {
                                var sizeMb = fso.GetFile(outPath).Size / 1048576;
                                if (sizeMb <= MAX_PDF_MB) {
                                    pdfPaths.push(outPath);
                                    if (slot.pdfListe) slot.pdfListe += "; ";
                                    slot.pdfListe += fname;
                                } else {
                                    // Datei zu gross - vermerken aber nicht hochladen
                                    if (slot.pdfListe) slot.pdfListe += "; ";
                                    slot.pdfListe += "[zu-gross-" + Math.round(sizeMb) + "MB: " + fname + "]";
                                    try { fso.DeleteFile(outPath, true); } catch(e) {}
                                }
                            }
                        }
                    }
                }
            } catch(e) {}
        }

        step = "MSG schliessen";
        try { it.Close(1); } catch(e) {}

        step = "Prompt bauen";
        setSlotPhase(slot, "Prompt bauen");
        var bodyShort = slot.body;
        if (bodyShort.length > BODY_CAP) bodyShort = bodyShort.substr(0, BODY_CAP) + " [...gekuerzt]";
        slot.prompt = buildVorgangPrompt(slot.datum, slot.absName, slot.absMail, slot.betreff, bodyShort, slot.anhangAlle, slot.pdfListe);

        step = "Conversation anlegen (async)";
        setSlotPhase(slot, "Conversation anlegen (async)");
        slot.convHttp = createConversationAsyncFire(slot.prompt);
        slot.convStartedAt = new Date().getTime();
        slot.tempPdfPaths = pdfPaths;     // Cleanup nach Upload-Finalize
        slot.tempDir = tempDir;
        slot.stage = "CREATING_CONV";
        // Achtung: convId und uploadHandles werden im naechsten Tick gesetzt,
        // sobald die async PUT /conversation antwortet. Das macht 15-50 Slots
        // wirklich gleichzeitig startbar.
        return true;
    } catch(e) {
        slot.errMsg = "[" + step + "] " + e.message;
        return false;
    }
}

// Polling der async-Uploads. Setzt slot.phase fuer Live-Anzeige und liefert true,
// wenn ALLE Handles fertig sind (Result-Datei existiert).
function pollSlotUploads(slot) {
    if (!slot.uploadHandles || slot.uploadHandles.length === 0) return true;
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var doneCount = 0;
    for (var i = 0; i < slot.uploadHandles.length; i++) {
        var h = slot.uploadHandles[i];
        if (h.done) { doneCount++; continue; }
        if (fso.FileExists(h.resultPath)) {
            // Datei da, aber lesen tut finalize - hier nur "vorhanden" markieren.
            doneCount++;
        }
    }
    // Live-Anzeige
    setSlotPhase(slot, "Upload " + doneCount + "/" + slot.uploadHandles.length + " (async)");
    return doneCount === slot.uploadHandles.length;
}

// Liest alle Result-Dateien ein, baut docIdsJson, cleanup temp-PDFs. Setzt
// slot.stage="READY" oder bei Fehler slot.errMsg + return false.
function finalizeSlotUploads(slot) {
    var ids = [];
    for (var i = 0; i < slot.uploadHandles.length; i++) {
        var h = slot.uploadHandles[i];
        if (!h.done) uploadPdfReadResult(h);
        if (h.errMsg) {
            slot.errMsg = "[Upload " + h.fileName + "] " + h.errMsg;
            // Restliche Handles trotzdem cleanen
            for (var j = i; j < slot.uploadHandles.length; j++) {
                if (!slot.uploadHandles[j].done) uploadPdfReadResult(slot.uploadHandles[j]);
            }
            cleanupSlotTempFiles(slot);
            return false;
        }
        if (h.docId) ids.push(h.docId);
    }
    slot.docIdsJson = ids.length === 0 ? "[]" : ('["' + ids.join('","') + '"]');
    cleanupSlotTempFiles(slot);
    slot.stage = "READY";
    return true;
}

function cleanupSlotTempFiles(slot) {
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if (slot.tempPdfPaths) {
            for (var i = 0; i < slot.tempPdfPaths.length; i++) {
                try { fso.DeleteFile(slot.tempPdfPaths[i], true); } catch(e) {}
            }
        }
        if (slot.tempDir && fso.FolderExists(slot.tempDir)) {
            try { fso.DeleteFolder(slot.tempDir, true); } catch(e) {}
        }
    } catch(e) {}
}

// Feuert den Async-Antwort-Call. Setzt slot.http und stage="RUNNING".
function slotStartAnswer(slot) {
    setSlotPhase(slot, "warte auf GPT-Antwort...");
    try {
        slot.http = startAnswerAsync(slot.convId, slot.prompt, slot.docIdsJson);
        slot.stage = "RUNNING";
        return true;
    } catch(e) {
        slot.errMsg = "[Async Antwort-Call] " + e.message;
        return false;
    }
}

function finalizeSlot(slot) {
    try {
        var status = 0;
        try { status = slot.http.Status; } catch(e) {}
        var resp = "";
        try { resp = slot.http.ResponseText; } catch(e) {}

        if (slot.cancelled) {
            return makeResult(slot, false, "[ABGEBROCHEN]");
        }

        var answer = extractAssistantFromNdjson(resp);
        if (!answer || answer.length === 0) {
            var hint = extractServerHint(resp);
            var msg = (status !== 200) ? ("HTTP " + status + ". " + hint) : ("Keine Assistant-Nachricht. " + hint);
            return makeResult(slot, false, "[ANTWORT] " + msg);
        }

        var antwort = jsonUnescape(answer).replace(/\\n/g, "\n");
        var dict = parseGptJson(antwort);
        if (!dict) {
            return makeResult(slot, false, "[PARSE] JSON-Antwort nicht lesbar: " + antwort.substr(0, 200));
        }

        var r = makeResult(slot, true, "");
        r.data = dict;
        return r;
    } catch(e) {
        return makeResult(slot, false, "[FINAL] " + e.message);
    }
}

function makeResult(slot, ok, errMsg) {
    return {
        msgPath: slot.msgPath,
        msgFile: getFileName(slot.msgPath),
        datum: slot.datum || "",
        dateIso: slot.dateIso || "",
        absName: slot.absName || "",
        absMail: slot.absMail || "",
        empfaenger: slot.empfaenger || "",
        betreff: slot.betreff || "",
        anhangAlle: slot.anhangAlle || "",
        pdfListe: slot.pdfListe || "",
        ok: ok,
        errMsg: errMsg || "",
        data: null,
        analyzedAt: isoNow()
    };
}

function addResult(r) {
    // Replace existing entry for same path, or append
    var key = String(r.msgPath).toLowerCase();
    for (var i = 0; i < state.results.length; i++) {
        if (String(state.results[i].msgPath).toLowerCase() === key) {
            // Update: behalte existing _excelRow falls vorhanden
            if (state.results[i]._excelRow && !r._excelRow) r._excelRow = state.results[i]._excelRow;
            state.results[i] = r;
            state.pendingMap[key] = true;
            // Excel-Live-Write (Update vorhandener Zeile)
            writeResultRowToExcel(r);
            return;
        }
    }
    state.results.push(r);
    state.pendingMap[key] = true;
    // Excel-Live-Write (Append neue Zeile)
    writeResultRowToExcel(r);
}

// ============================================================================
// ERGO GPT API
// ============================================================================
function createConversationSync(prompt) {
    // WinHttp statt MSXML2 fuer konsistenteres UTF-8-Verhalten
    var http = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    http.Open("PUT", ERGO_BASE + "/conversation", false);
    try { http.SetProxy(0); } catch(e) {}
    setWinHttpHeaders(http);
    http.SetRequestHeader("Content-Type", "application/json;charset=UTF-8");
    var payload = buildPayload(cleanForJson(prompt), "[]");
    // Als UTF-8-Bytes senden -> Umlaute landen korrekt auf der Leitung
    var bodyBytes = stringToUtf8Bytes(payload);
    if (bodyBytes) http.Send(bodyBytes); else http.Send(payload);
    if (http.Status !== 200) {
        throw new Error("Create failed: " + http.Status + " - " + (http.ResponseText || "").substr(0, 200));
    }
    return parseJsonStr(http.ResponseText, "id");
}

// Async-Variante: feuert PUT /conversation mit async=true Open. Send kehrt
// sofort zurueck, der Server-Request laeuft im Hintergrund. workerTick
// polled spaeter via WaitForResponse(0) und liest die conversation_id ein.
// Das ist der entscheidende Trick um 15-50 Slots WIRKLICH gleichzeitig zu
// starten - createConversationSync hat vorher pro Slot 200-500ms blockiert.
function createConversationAsyncFire(prompt) {
    var http = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { http.SetTimeouts(30000, 30000, 60000, 180000); } catch(e) {}
    http.Open("PUT", ERGO_BASE + "/conversation", true);   // async = true
    try { http.SetProxy(0); } catch(e) {}
    setWinHttpHeaders(http);
    http.SetRequestHeader("Content-Type", "application/json;charset=UTF-8");
    var payload = buildPayload(cleanForJson(prompt), "[]");
    var bodyBytes = stringToUtf8Bytes(payload);
    if (bodyBytes) http.Send(bodyBytes); else http.Send(payload);
    return http;
}

function startAnswerAsync(convId, prompt, docIdsJson, recvMs) {
    var http = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    var payload = buildPayload(cleanForJson(prompt), docIdsJson);
    // recvMs: Receive-Timeout. Batch (5 Mails in 1 Prompt) braucht deutlich
    // laenger als ein Einzel-Call -> Default 180s, Batch uebergibt mehr.
    try { http.SetTimeouts(30000, 30000, 60000, recvMs || 180000); } catch(e) {}
    http.Open("PUT", ERGO_BASE + "/conversation/" + convId, true);
    try { http.SetProxy(0); } catch(e) {}
    setWinHttpHeaders(http);
    http.SetRequestHeader("Content-Type", "application/json;charset=UTF-8");
    http.SetRequestHeader("Accept", "*/*");
    // UTF-8-Bytes statt String -> Umlaute korrekt
    var bodyBytes = stringToUtf8Bytes(payload);
    if (bodyBytes) http.Send(bodyBytes); else http.Send(payload);
    return http;
}

function fireDelete(convId) {
    if (!convId) return;
    try {
        var http = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
        http.Open("DELETE", ERGO_BASE + "/conversation", true);
        try { http.SetProxy(0); } catch(e) {}
        setWinHttpHeaders(http);
        http.SetRequestHeader("Content-Type", "application/json;charset=UTF-8");
        http.SetRequestHeader("Accept", "*/*");
        http.Send('{"conversation_ids":["' + convId + '"]}');
        // fire and forget
    } catch(e) {}
}

// Pure-JS Multipart-Builder (Ersatz fuer den ehemaligen VBScript-Helper,
// der in HTAs aus UNC/Internet-Zone fuer JS unzugaenglich war).
// Setzt voraus, dass ADODB.Stream Binary-I/O auf %TEMP%-Pfade darf -
// das geht auch in Internet-Zone, weil die Source-Datei lokal ist.
function buildMultipartBody(pre, filePath, post) {
    var stm = new ActiveXObject("ADODB.Stream");
    stm.Type = 1; // binary
    stm.Open();

    // Pre (UTF-8 ohne BOM)
    var preBytes = stringToUtf8Bytes(pre);
    if (preBytes) stm.Write(preBytes);

    // File
    var fileStm = new ActiveXObject("ADODB.Stream");
    fileStm.Type = 1;
    fileStm.Open();
    fileStm.LoadFromFile(filePath);
    stm.Write(fileStm.Read());
    fileStm.Close();

    // Post (UTF-8 ohne BOM)
    var postBytes = stringToUtf8Bytes(post);
    if (postBytes) stm.Write(postBytes);

    stm.Position = 0;
    var bytes = stm.Read();
    stm.Close();
    return bytes;
}

function stringToUtf8Bytes(s) {
    if (!s || s.length === 0) return null;
    var stm = new ActiveXObject("ADODB.Stream");
    stm.Type = 2; stm.Charset = "utf-8"; stm.Open();
    stm.WriteText(s);
    stm.Position = 0;
    stm.Type = 1;
    if (stm.Size >= 3) stm.Read(3); // skip BOM
    var b = stm.Read();
    stm.Close();
    return b;
}

// Feuert einen VBS-Upload-Subprozess fire-and-forget (Shell.Run mit
// bWaitOnReturn=false). Liefert sofort einen Handle zurueck. Der eigentliche
// Upload laeuft asynchron in einem separaten Prozess. Polling per FileExists
// auf handle.resultPath - sobald die Datei existiert, ist der Upload fertig.
// So koennen 15-50 Uploads PARALLEL laufen (jeder in eigenem OS-Prozess),
// statt nacheinander mit ~1-3s blocking pro PDF.
function uploadPdfStartAsync(convId, pdfPath, fileName) {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var tempDir = shell.ExpandEnvironmentStrings("%TEMP%");
    var stamp = String(new Date().getTime()) + "_" + Math.floor(Math.random() * 1000000) + "_" + Math.floor(Math.random() * 1000000);
    var vbsPath = tempDir + "\\ergo_upload_" + stamp + ".vbs";
    var resultPath = tempDir + "\\ergo_result_" + stamp + ".txt";
    var cookiePath = tempDir + "\\ergo_cookie_" + stamp + ".txt";

    // Falls stale Result-Datei existiert: weg, sonst koennten wir sie als "fertig" misinterpretieren
    try { fso.DeleteFile(resultPath, true); } catch(e) {}

    // Cookie + VBS schreiben
    var cookieFile = fso.CreateTextFile(cookiePath, true, false);
    cookieFile.Write(state.cookie);
    cookieFile.Close();
    var vbsFile = fso.CreateTextFile(vbsPath, true, false);
    vbsFile.Write(buildUploadVbs());
    vbsFile.Close();

    var fnArg = fileName.replace(/"/g, '""');
    var pdfArg = pdfPath.replace(/"/g, '""');

    var cmd = 'wscript.exe //NoLogo //B "' + vbsPath + '" ' +
              '"' + cookiePath + '" ' +
              '"' + convId + '" ' +
              '"' + pdfArg + '" ' +
              '"' + fnArg + '" ' +
              '"' + resultPath + '"';

    // FIRE-AND-FORGET: bWaitOnReturn=false. Run gibt sofort zurueck (oder wirft, falls Process nicht startbar).
    shell.Run(cmd, 0, false);

    return {
        vbsPath: vbsPath,
        resultPath: resultPath,
        cookiePath: cookiePath,
        fileName: fileName,
        pdfPath: pdfPath,
        startedAt: new Date().getTime(),
        done: false,
        docId: null,
        errMsg: null
    };
}

// Liest die Result-Datei eines fertigen Uploads, extrahiert document_id oder
// setzt errMsg. Cleanup der temp-Dateien danach. Setzt handle.done=true.
function uploadPdfReadResult(handle) {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    try {
        if (!fso.FileExists(handle.resultPath)) {
            handle.errMsg = "Result-Datei fehlt (Timeout? VBS crashed?)";
            handle.done = true;
            return;
        }
        var rf = fso.OpenTextFile(handle.resultPath, 1, false, -2);
        var content = rf.ReadAll();
        rf.Close();
        var data = null;
        try { data = eval("(" + content + ")"); } catch(eP) {
            handle.errMsg = "Result nicht parsebar: " + content.substr(0, 200);
            handle.done = true;
            return;
        }
        if (!data || data.status === undefined) {
            handle.errMsg = "Result ohne status: " + content.substr(0, 200);
            handle.done = true;
            return;
        }
        if (data.status !== 200) {
            handle.errMsg = "HTTP " + data.status + ": " + (data.body || "").substr(0, 200);
            handle.done = true;
            return;
        }
        var did = parseJsonStr(data.body || "", "document_id");
        if (!did) {
            handle.errMsg = "Keine document_id in: " + (data.body || "").substr(0, 200);
            handle.done = true;
            return;
        }
        handle.docId = did;
        handle.done = true;
    } finally {
        try { fso.DeleteFile(handle.vbsPath, true); } catch(e) {}
        try { fso.DeleteFile(handle.resultPath, true); } catch(e) {}
        try { fso.DeleteFile(handle.cookiePath, true); } catch(e) {}
    }
}

// VBScript-Uploader: liest Cookie aus Datei, PDF als Binary via
// ADODB.Stream, baut Multipart-Body, sendet via WinHttp.WinHttpRequest,
// schreibt {status, body} als JSON in resultPath. Laeuft in wscript.exe
// ohne IE-Zone-Restriktionen.
function buildUploadVbs() {
    var v = [];
    v.push("Option Explicit");
    v.push("Dim cookieFile, convId, pdfPath, fileName, resultPath");
    v.push("cookieFile = WScript.Arguments(0)");
    v.push("convId = WScript.Arguments(1)");
    v.push("pdfPath = WScript.Arguments(2)");
    v.push("fileName = WScript.Arguments(3)");
    v.push("resultPath = WScript.Arguments(4)");
    v.push("");
    v.push("Sub WriteResult(status, body)");
    v.push("    Dim esc, json, fso, f");
    v.push("    esc = body");
    v.push("    esc = Replace(esc, \"\\\", \"\\\\\")");
    v.push("    esc = Replace(esc, \"\"\"\", \"\\\"\"\")");
    v.push("    esc = Replace(esc, vbCrLf, \"\\n\")");
    v.push("    esc = Replace(esc, vbCr, \"\\n\")");
    v.push("    esc = Replace(esc, vbLf, \"\\n\")");
    v.push("    esc = Replace(esc, vbTab, \" \")");
    v.push("    json = \"{\"\"status\"\":\" & status & \",\"\"body\"\":\"\"\" & esc & \"\"\"}\"");
    v.push("    Set fso = CreateObject(\"Scripting.FileSystemObject\")");
    v.push("    Set f = fso.CreateTextFile(resultPath, True, False)");
    v.push("    f.Write json");
    v.push("    f.Close");
    v.push("End Sub");
    v.push("");
    // KEIN "Started"-Placeholder mehr: das JS polled per FileExists auf resultPath.
    // Existiert die Datei, ist der Upload fertig (egal ob OK oder Error - in beiden
    // Faellen schreibt das VBS-Skript ein Result-Objekt). Errors im VBS schreiben
    // status=0 ueber WriteResult (siehe PDF-read- und HTTP-Error-Handler unten).
    v.push("On Error Resume Next");
    v.push("Err.Clear");
    v.push("");
    v.push("Dim fsoMain, ts, cookie");
    v.push("Set fsoMain = CreateObject(\"Scripting.FileSystemObject\")");
    v.push("Set ts = fsoMain.OpenTextFile(cookieFile, 1, False, 0)");
    v.push("cookie = ts.ReadAll");
    v.push("ts.Close");
    v.push("cookie = Trim(cookie)");
    v.push("");
    v.push("Dim re, xsrf");
    v.push("xsrf = \"\"");
    v.push("Set re = CreateObject(\"VBScript.RegExp\")");
    v.push("re.Pattern = \"(?:XSRF-TOKEN|CSRF-TOKEN|csrfToken|_csrf)=([^;]+)\"");
    v.push("re.IgnoreCase = True");
    v.push("If re.Test(cookie) Then xsrf = re.Execute(cookie)(0).SubMatches(0)");
    v.push("");
    v.push("Dim stmFile, fileBytes");
    v.push("Set stmFile = CreateObject(\"ADODB.Stream\")");
    v.push("stmFile.Type = 1");
    v.push("stmFile.Open");
    v.push("stmFile.LoadFromFile pdfPath");
    v.push("fileBytes = stmFile.Read");
    v.push("stmFile.Close");
    v.push("If Err.Number <> 0 Then");
    v.push("    WriteResult 0, \"PDF read error: \" & Err.Description");
    v.push("    WScript.Quit 0");
    v.push("End If");
    v.push("");
    v.push("Dim guid, boundary");
    v.push("guid = CreateObject(\"Scriptlet.TypeLib\").Guid");
    v.push("guid = Replace(Replace(Replace(guid, \"{\", \"\"), \"}\", \"\"), \"-\", \"\")");
    v.push("boundary = \"----WebKitFormBoundary\" & Left(guid, 16)");
    v.push("");
    v.push("Dim pre, post");
    v.push("pre = \"--\" & boundary & vbCrLf");
    v.push("pre = pre & \"Content-Disposition: form-data; name=\"\"file_content\"\"; filename=\"\"\" & fileName & \"\"\"\" & vbCrLf");
    v.push("pre = pre & \"Content-Type: application/pdf\" & vbCrLf & vbCrLf");
    v.push("post = vbCrLf & \"--\" & boundary & vbCrLf");
    v.push("post = post & \"Content-Disposition: form-data; name=\"\"filename\"\"\" & vbCrLf & vbCrLf");
    v.push("post = post & fileName & vbCrLf");
    v.push("post = post & \"--\" & boundary & vbCrLf");
    v.push("post = post & \"Content-Disposition: form-data; name=\"\"conversation_id\"\"\" & vbCrLf & vbCrLf");
    v.push("post = post & convId & vbCrLf");
    v.push("post = post & \"--\" & boundary & \"--\" & vbCrLf");
    v.push("");
    v.push("Function Utf8Bytes(s)");
    v.push("    Dim st");
    v.push("    Set st = CreateObject(\"ADODB.Stream\")");
    v.push("    st.Type = 2 : st.Charset = \"utf-8\" : st.Open");
    v.push("    st.WriteText s");
    v.push("    st.Position = 0");
    v.push("    st.Type = 1");
    v.push("    If st.Size >= 3 Then st.Read 3");
    v.push("    Utf8Bytes = st.Read");
    v.push("    st.Close");
    v.push("End Function");
    v.push("");
    v.push("Dim stmBody, body");
    v.push("Set stmBody = CreateObject(\"ADODB.Stream\")");
    v.push("stmBody.Type = 1");
    v.push("stmBody.Open");
    v.push("stmBody.Write Utf8Bytes(pre)");
    v.push("stmBody.Write fileBytes");
    v.push("stmBody.Write Utf8Bytes(post)");
    v.push("stmBody.Position = 0");
    v.push("body = stmBody.Read");
    v.push("stmBody.Close");
    v.push("");
    v.push("Dim http");
    v.push("Set http = CreateObject(\"WinHttp.WinHttpRequest.5.1\")");
    v.push("http.SetTimeouts 30000, 30000, 60000, 180000");
    v.push("http.Open \"POST\", \"https://gpt.ergo.com/api/document\", False");
    v.push("http.SetProxy 0");
    v.push("http.SetRequestHeader \"User-Agent\", \"Mozilla/5.0\"");
    v.push("http.SetRequestHeader \"Accept\", \"*/*\"");
    v.push("http.SetRequestHeader \"Cookie\", cookie");
    v.push("If Len(xsrf) > 0 Then");
    v.push("    http.SetRequestHeader \"X-XSRF-TOKEN\", xsrf");
    v.push("    http.SetRequestHeader \"X-CSRF-TOKEN\", xsrf");
    v.push("End If");
    v.push("http.SetRequestHeader \"Origin\", \"https://gpt.ergo.com\"");
    v.push("http.SetRequestHeader \"Referer\", \"https://gpt.ergo.com/\"");
    v.push("http.SetRequestHeader \"X-Requested-With\", \"XMLHttpRequest\"");
    v.push("http.SetRequestHeader \"Content-Type\", \"multipart/form-data; boundary=\" & boundary");
    v.push("http.Send body");
    v.push("");
    v.push("Dim status, respBody");
    v.push("status = http.Status");
    v.push("respBody = http.ResponseText");
    v.push("If Err.Number <> 0 Then");
    v.push("    WriteResult 0, \"HTTP error: \" & Err.Description");
    v.push("    WScript.Quit 0");
    v.push("End If");
    v.push("");
    v.push("WriteResult status, respBody");
    v.push("WScript.Quit 0");
    return v.join("\r\n");
}

// Alte PowerShell-Variante - bleibt im Code als historische Referenz,
// wird aber nicht mehr aufgerufen (in v1.10 durch buildUploadVbs ersetzt).
function buildUploadPs1() {
    var ps = [];
    ps.push("param(");
    ps.push("    [string]$CookieFile,");
    ps.push("    [string]$ConvId,");
    ps.push("    [string]$PdfPath,");
    ps.push("    [string]$FileName,");
    ps.push("    [string]$ResultPath");
    ps.push(")");
    ps.push("");
    ps.push("$ErrorActionPreference = 'Stop'");
    ps.push("");
    ps.push("function Write-Result($status, $body) {");
    ps.push("    $bodyEsc = ($body -replace '\\\\','\\\\\\\\' -replace '\"','\\\"' -replace \"`r\",'\\r' -replace \"`n\",'\\n' -replace \"`t\",'\\t')");
    ps.push("    $json = '{\"status\":' + $status + ',\"body\":\"' + $bodyEsc + '\"}'");
    ps.push("    [System.IO.File]::WriteAllText($ResultPath, $json, [System.Text.Encoding]::UTF8)");
    ps.push("}");
    ps.push("");
    ps.push("try {");
    ps.push("    $cookie = [System.IO.File]::ReadAllText($CookieFile)");
    ps.push("    $cookie = $cookie.Trim()");
    ps.push("    $xsrf = ''");
    ps.push("    if ($cookie -match '(?i)(?:XSRF-TOKEN|CSRF-TOKEN|csrfToken|_csrf)=([^;]+)') {");
    ps.push("        $xsrf = [System.Uri]::UnescapeDataString($matches[1])");
    ps.push("    }");
    ps.push("");
    ps.push("    $fileBytes = [System.IO.File]::ReadAllBytes($PdfPath)");
    ps.push("");
    ps.push("    $boundary = '----WebKitFormBoundary' + ([guid]::NewGuid().ToString('N').Substring(0,16))");
    ps.push("    $enc = [System.Text.Encoding]::UTF8");
    ps.push("");
    ps.push("    $pre = \"--$boundary`r`nContent-Disposition: form-data; name=`\"file_content`\"; filename=`\"$FileName`\"`r`nContent-Type: application/pdf`r`n`r`n\"");
    ps.push("    $post = \"`r`n--$boundary`r`nContent-Disposition: form-data; name=`\"filename`\"`r`n`r`n$FileName`r`n--$boundary`r`nContent-Disposition: form-data; name=`\"conversation_id`\"`r`n`r`n$ConvId`r`n--$boundary--`r`n\"");
    ps.push("");
    ps.push("    $preBytes = $enc.GetBytes($pre)");
    ps.push("    $postBytes = $enc.GetBytes($post)");
    ps.push("");
    ps.push("    $ms = New-Object System.IO.MemoryStream");
    ps.push("    $ms.Write($preBytes, 0, $preBytes.Length)");
    ps.push("    $ms.Write($fileBytes, 0, $fileBytes.Length)");
    ps.push("    $ms.Write($postBytes, 0, $postBytes.Length)");
    ps.push("    $body = $ms.ToArray()");
    ps.push("    $ms.Close()");
    ps.push("");
    ps.push("    $headers = @{");
    ps.push("        'Cookie' = $cookie");
    ps.push("        'User-Agent' = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'");
    ps.push("        'Accept' = '*/*'");
    ps.push("        'Accept-Language' = 'de-DE,de;q=0.9,en;q=0.8'");
    ps.push("        'Origin' = 'https://gpt.ergo.com'");
    ps.push("        'Referer' = 'https://gpt.ergo.com/'");
    ps.push("        'X-Requested-With' = 'XMLHttpRequest'");
    ps.push("    }");
    ps.push("    if ($xsrf) {");
    ps.push("        $headers['X-XSRF-TOKEN'] = $xsrf");
    ps.push("        $headers['X-CSRF-TOKEN'] = $xsrf");
    ps.push("    }");
    ps.push("");
    ps.push("    # TLS 1.2 + ignore proxy detection for speed");
    ps.push("    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.SecurityProtocolType]::Tls12");
    ps.push("");
    ps.push("    try {");
    ps.push("        $resp = Invoke-WebRequest -Uri 'https://gpt.ergo.com/api/document' -Method Post -Body $body -ContentType (\"multipart/form-data; boundary=$boundary\") -Headers $headers -UseBasicParsing -TimeoutSec 180");
    ps.push("        Write-Result $resp.StatusCode $resp.Content");
    ps.push("    } catch [System.Net.WebException] {");
    ps.push("        $status = 0; $body = $_.Exception.Message");
    ps.push("        if ($_.Exception.Response) {");
    ps.push("            $status = [int]$_.Exception.Response.StatusCode");
    ps.push("            try {");
    ps.push("                $sr = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())");
    ps.push("                $body = $sr.ReadToEnd(); $sr.Close()");
    ps.push("            } catch {}");
    ps.push("        }");
    ps.push("        Write-Result $status $body");
    ps.push("    } catch {");
    ps.push("        Write-Result 0 $_.Exception.Message");
    ps.push("    }");
    ps.push("} catch {");
    ps.push("    Write-Result 0 ('SCRIPT-ERROR: ' + $_.Exception.Message)");
    ps.push("}");
    return ps.join("\r\n");
}

function setCommonHeaders(http) {
    http.setRequestHeader("Cookie", state.cookie);
    var xsrf = extractCsrf(state.cookie);
    if (xsrf) {
        http.setRequestHeader("X-XSRF-TOKEN", xsrf);
        http.setRequestHeader("X-CSRF-TOKEN", xsrf);
    }
    http.setRequestHeader("User-Agent", "Mozilla/5.0");
    http.setRequestHeader("Accept-Language", "de-DE,de;q=0.9,en;q=0.8");
    http.setRequestHeader("Origin", "https://gpt.ergo.com");
    http.setRequestHeader("Referer", "https://gpt.ergo.com/");
    http.setRequestHeader("X-Requested-With", "XMLHttpRequest");
}

function setWinHttpHeaders(http) {
    http.SetRequestHeader("Cookie", state.cookie);
    var xsrf = extractCsrf(state.cookie);
    if (xsrf) {
        http.SetRequestHeader("X-XSRF-TOKEN", xsrf);
        http.SetRequestHeader("X-CSRF-TOKEN", xsrf);
    }
    http.SetRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/129 Safari/537.36");
    http.SetRequestHeader("Accept-Language", "de-DE,de;q=0.9,en;q=0.8");
    http.SetRequestHeader("Origin", "https://gpt.ergo.com");
    http.SetRequestHeader("Referer", "https://gpt.ergo.com/");
    http.SetRequestHeader("X-Requested-With", "XMLHttpRequest");
}

function buildPayload(promptEsc, docIdsJson) {
    var model = trim(document.getElementById("modelInput").value) || "gpt-51-chat";
    // Temperature und Tone hardgecodet (Default: deterministisch, sachlich) -
    // diese Felder gibt es in der UI nicht mehr.
    return '{"conversation_title":"New conversation","messages":[{' +
           '"id":"' + uuid4() + '","role":"user","content":"' + promptEsc +
           '","date":"' + isoNow() + '"}],' +
           '"model":"' + model + '","temperature":0' +
           ',"pinned":false,"tone":"Sachlich","document_ids":' + docIdsJson + '}';
}

// ============================================================================
// NDJSON / RESPONSE PARSING
// ============================================================================
function extractAssistantFromNdjson(raw) {
    if (!raw) return "";
    raw = raw.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
    var lines = raw.split("\n");
    var last = "";
    for (var i = 0; i < lines.length; i++) {
        var ln = trim(lines[i]);
        if (!ln) continue;
        if (ln.toLowerCase().substr(0, 5) === "data:") ln = trim(ln.substr(5));
        if (ln.charAt(0) === "{" && ln.charAt(ln.length - 1) === "}") {
            var t = extractAssistantFromChunk(ln);
            if (t) last = t;
        }
    }
    return last;
}

function extractAssistantFromChunk(json) {
    var re = /"choices"\s*:\s*\[\s*\{[\s\S]*?"messages"\s*:\s*\[\s*\{[\s\S]*?"role"\s*:\s*"assistant"[\s\S]*?"content"\s*:\s*"((?:\\.|[^"])*)"/;
    var m = json.match(re);
    if (m) return m[1];
    var re2 = /"choices"\s*:\s*\[[\s\S]*?"delta"[\s\S]*?"content"\s*:\s*"((?:\\.|[^"])*)"/;
    var m2 = json.match(re2);
    if (m2) return m2[1];
    return "";
}

function extractServerHint(raw) {
    if (!raw) return "(leere Antwort)";
    var keys = ["message", "error", "detail", "error_description"];
    for (var i = 0; i < keys.length; i++) {
        var re = new RegExp('"' + keys[i] + '"\\s*:\\s*"((?:\\\\.|[^"]){0,500})"', "i");
        var m = raw.match(re);
        if (m && m[1]) return "Server: " + m[1].substr(0, 240);
    }
    var lc = raw.toLowerCase();
    if (lc.indexOf("nicht mehr unterst") >= 0 || lc.indexOf("not supported") >= 0 ||
        lc.indexOf("deprecated") >= 0 || lc.indexOf("unknown model") >= 0) {
        return "Modell nicht (mehr) unterstuetzt - Modell-Name in Einstellungen anpassen.";
    }
    var plain = raw.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ");
    return "Antwort: " + plain.substr(0, 200);
}

function parseGptJson(answer) {
    var t = trim(answer);
    // Strip code fences
    if (t.substr(0, 7) === "```json") t = t.substr(7);
    if (t.substr(0, 3) === "```") t = t.substr(3);
    if (t.substr(t.length - 3) === "```") t = t.substr(0, t.length - 3);
    t = trim(t);
    // Find {...}
    var s = t.indexOf("{");
    var e = t.lastIndexOf("}");
    if (s < 0 || e <= s) return null;
    t = t.substr(s, e - s + 1);
    try {
        // IE11 has JSON.parse but be defensive
        if (typeof JSON !== "undefined" && JSON.parse) return JSON.parse(t);
        return eval("(" + t + ")");
    } catch(ex) {
        // Try line by line key extraction as fallback
        return extractKeysHeuristic(t);
    }
}

function extractKeysHeuristic(t) {
    var keys = ["vorgangstyp","auftrag_datum","maklerpool","makler_nachname","makler_vorname",
                "makler_nummer","kunde_nachname","kunde_vorname","kunde_nummer","versicherungsnummer",
                "klassifikation","klassifikation_grund","geschaefts_typ","unterlagen_angefragt",
                "unterlagen_liste","sonderfall","sparte","anhang_typen","pdf_qualitaet",
                "enthaelt_maklervollmacht","mv_vollumfaenglich","mv_einschraenkungen",
                "unterschrift_kunde","unterschrift_makler","auf_vn_ausgestellt",
                "makler_namentlich_genannt","ist_reminder","hinweis"];
    var d = {};
    var found = 0;
    for (var i = 0; i < keys.length; i++) {
        var re = new RegExp('"' + keys[i] + '"\\s*:\\s*"((?:\\\\.|[^"]){0,500})"');
        var m = t.match(re);
        if (m) { d[keys[i]] = m[1]; found++; }
    }
    return (found >= 3) ? d : null;
}

function parseJsonStr(json, key) {
    if (!json) return "";
    var re = new RegExp('"' + key + '"\\s*:\\s*"([^"]*)"', "i");
    var m = json.match(re);
    return m ? m[1] : "";
}

function isAuthError(desc) {
    if (!desc) return false;
    var s = desc.toLowerCase();
    return (s.indexOf("403") >= 0 && (s.indexOf("forbidden") >= 0 || s.indexOf("create failed") >= 0)) ||
           s.indexOf("azure-application-gateway") >= 0 ||
           (s.indexOf("401") >= 0 && s.indexOf("unauthor") >= 0);
}

function isModelError(desc) {
    if (!desc) return false;
    var s = desc.toLowerCase();
    return s.indexOf("nicht mehr unterst") >= 0 ||
           (s.indexOf("modell") >= 0 && s.indexOf("unterstuetzt") >= 0) ||
           s.indexOf("unknown model") >= 0 ||
           s.indexOf("not supported") >= 0;
}

// ============================================================================
// PROMPT BUILDER (ported from VBA BuildVorgangPrompt)
// ============================================================================
function buildVorgangPrompt(datum, absName, absMail, betreff, text, anhangAlle, anhangPdfsHochgeladen) {
    var p = "";
    p += "Du bist ein erfahrener Sachbearbeiter im Innendienst eines deutschen\n";
    p += "Komposit-Versicherers (SHUK: Sach/Haftpflicht/Unfall/Kfz).\n";
    p += "Du analysierst eingehende Makler-Emails inklusive Anhaengen.\n\n";
    p += "===== EMAIL =====\n";
    p += "Datum: " + datum + "\n";
    p += "Absender: " + absName + " <" + absMail + ">\n";
    p += "Betreff: " + betreff + "\n";
    p += "Anhaenge (alle): " + (anhangAlle ? anhangAlle : "(keine)") + "\n";
    p += "Anhaenge HOCHGELADEN als PDF: " + (anhangPdfsHochgeladen ? anhangPdfsHochgeladen : "(keine)") + "\n\n";
    p += "Body:\n<<<\n" + text + "\n>>>\n===== ENDE EMAIL =====\n\n";

    p += "AUFGABE: Klassifiziere die Mail strikt anhand der unten definierten Felder und Wertelisten.\n\n";
    p += "WICHTIG - SCHRITT 0 (Triage): Pruefe ZUERST das Feld 'vorgangstyp'. Wenn die Mail KEIN echter eingehender Makler-Vorgang ist (Bounce-NDR, von ergo selbst rausgegangen, automatische System-Mail, Werbung), dann setze ALLE anderen Felder auf '' (leerer String) - nur 'vorgangstyp' und 'hinweis' werden befuellt. NICHT raten.\n\n";
    p += "Nur wenn vorgangstyp == 'Makler-Vorgang': die uebrigen Felder befuellen. Nutze die HOCHGELADENEN PDFs (falls vorhanden) als zusaetzliche Quelle - insbesondere fuer die Maklervollmacht-Pruefung.\n\n";

    p += "REGELN:\n";
    p += "- Nutze Email-Signatur, From-Domain, Body und PDF-Inhalte als Quellen.\n";
    p += "- Wenn Information nicht eindeutig: leerer String oder 'nicht_pruefbar'. Rate NIE.\n";
    p += "- Antworte AUSSCHLIESSLICH mit einem einzeiligen JSON-Objekt mit GENAU 28 Schluesseln (alle Werte als String). Kein Markdown, keine Code-Fences.\n\n";

    p += "FELDER:\n\n";
    p += "0) vorgangstyp (TRIAGE - immer ausfuellen)\n";
    p += "   'Makler-Vorgang' / 'Bounce-NDR' / 'Ergo-Outbound' / 'System-Mail' / 'Werbung-Spam' / 'Unklar'\n";
    p += "   Bounce-Indizien: 'postmaster','mailer-daemon','noreply','Mail Delivery Failure','5.7.1','Relay access denied'.\n";
    p += "   Ergo-Outbound: Absender @ergo.de / @itergo.com / @ergo.com.\n\n";

    p += "1) maklerpool - extrahiert UND konsolidiert. Verwende die EINHEITLICHEN Schreibweisen aus der folgenden Liste, NICHT die Roh-Variante aus der Mail:\n";
    p += "    KONSOLIDIERUNGS-MAP (linke Seite: gefundene Variante -> rechts: einheitlicher Name)\n";
    p += "    - 'Jung, DMS', 'Jung DMS', 'JDC', 'Jung,DMS & Cie. Pool GmbH', 'jungdms', 'jdcgroup' -> 'JDC / Jung, DMS & Cie.'\n";
    p += "    - 'Fonds Finanz', 'fondsfinanz', 'ff-makler', 'Fonds-Finanz' -> 'Fonds Finanz Maklerservice GmbH'\n";
    p += "    - 'blau direkt', 'blau-direkt', 'blaudirekt' -> 'blau direkt GmbH'\n";
    p += "    - 'DEMA', 'DEMMAK', 'Deutsche Versicherungsmakler' -> 'DEMA Deutsche Versicherungsmakler AG'\n";
    p += "    - 'BCA AG', 'bca-ag' -> 'BCA AG'\n";
    p += "    - 'Apella' -> 'Apella AG'\n";
    p += "    - 'CHECK24', 'Check24' -> 'CHECK24 Vergleichsportal'\n";
    p += "    - 'Maxpool' -> 'Maxpool Maklerkooperation GmbH'\n";
    p += "    - 'Hypoport' -> 'Hypoport AG'\n";
    p += "    - 'Verifox' -> 'Verifox GmbH'\n";
    p += "    - 'Impuls Finanzmanagement', 'Impuls-FM' -> 'Impuls Finanzmanagement AG'\n";
    p += "    - 'Securess' -> 'Securess Versicherungsmakler GmbH'\n";
    p += "    - 'tecis' -> 'tecis Finanzdienstleistungen AG'\n";
    p += "    - 'Qualitypool' -> 'Qualitypool GmbH'\n";
    p += "    - 'Swiss Life Select', 'SwissLife' -> 'Swiss Life Select Deutschland GmbH'\n";
    p += "    - 'MLP' -> 'MLP Finanzberatung SE'\n";
    p += "    - 'FORMAXX' -> 'FORMAXX AG'\n";
    p += "    - 'tauRes', 'TauRes' -> 'TauRes Gesellschaft fuer Investmentberatung mbH'\n";
    p += "    - '[pma:]', 'pma:' -> '[pma:] Finanz- und Versicherungsmakler GmbH'\n";
    p += "    - 'FG FINANZ', 'FGFinanz' -> 'FG FINANZ-SERVICE Aktiengesellschaft'\n";
    p += "    - 'Fuhrmann' -> 'Fuhrmann Versicherungsmakler GmbH'\n";
    p += "    - 'Finanzguru' -> 'Finanzguru Versicherungsservice GmbH'\n";
    p += "    - '1:1 Assekuranz', '2:2 Assekuranz' -> exakt so beibehalten\n";
    p += "    - 'Concordia Service' -> 'Concordia Service GmbH'\n";
    p += "    - 'WIFO' -> 'WIFO Wirtschafts- und Finanzkontor'\n";
    p += "    - 'aruna' -> 'aruna GmbH'\n";
    p += "    - 'ROLAND' -> 'ROLAND Versicherungsmakler'\n";
    p += "    - 'Invers' -> 'Invers GmbH'\n";
    p += "    - 'BEST GRUPPE', 'BESTGRUPPE' -> 'BEST GRUPPE'\n";
    p += "    - 'LEIMEISTER' -> 'LEIMEISTER Versicherungsmakler GmbH'\n";
    p += "    - 'INCON' -> 'INCON GmbH & Co. Assekuranz KG'\n";
    p += "    - 'DEUTUNA' -> 'DEUTUNA Finanzplanung GmbH'\n";
    p += "    - 'DASG' -> 'DASG Deutsche Assekuranzservice GmbH'\n";
    p += "    - 'vfm Service' -> 'vfm Service GmbH'\n";
    p += "    - 'FondsKonzept' -> 'FondsKonzept Assekuranzmakler AG'\n";
    p += "    - 'CLARUS AG' -> 'CLARUS AG'\n";
    p += "    Wenn keine Konsolidierungs-Regel passt: Roh-Variante mit korrekter Rechtsform-Endung (GmbH/AG/etc).\n\n";
    p += "1z) auftrag_datum - Datum aus Maklerauftrag / Pool-Anschreiben (z.B. 'Grossaitingen, 28.11.2025'). NICHT das Mail-Eingangsdatum.\n\n";
    p += "2) makler_nachname / 3) makler_vorname - HANDELNDE Person beim Makler, NICHT der Kunde.\n";
    p += "   Wenn KEINE Einzelperson, sondern eine Makler-FIRMA handelt, gehoert der Firmenname in makler_nachname.\n";
    p += "   WICHTIG Pool vs. zugrundeliegender Makler: Wenn der Maklervertrag / die Maklervollmacht auf eine\n";
    p += "   Makler-Firma laeuft, die nur ueber einen Pool abwickelt (z.B. Finanzguru, abgewickelt ueber Jung DMS),\n";
    p += "   dann bleibt maklerpool = 'JDC / Jung, DMS & Cie.' ABER makler_nachname = der eigentliche Makler\n";
    p += "   (also z.B. 'Finanzguru'). Pool und tatsaechlicher Makler sind getrennt zu fuehren.\n\n";
    p += "3a) makler_nummer - Identifikator BEIM VERSICHERER. STRENGE Priorisierung:\n";
    p += "    1. 'Agentur-Nr.' / 'Vermittler-Nr.' im Briefkopf-Block (das ist die Wunsch-Nummer).\n";
    p += "    2. 'BD-Nummer' / 'Bestandsnummer' / 'Beraterzeichen'.\n";
    p += "    3. NUR Fallback: Pool-IDs wie 'MAKID','DEMMAK','BCA-ID' (sind pool-intern, NICHT beim Versicherer).\n\n";
    p += "3b) kunde_nachname / 3c) kunde_vorname - VN / Vollmachtgeber. Quellen: MV-PDF -> Body -> Betreff.\n\n";
    p += "3d) kunde_nummer - Person-Nr / Partnernummer (NICHT Versicherungs- oder Maklernummer).\n";
    p += "3e) versicherungsnummer - VNR / Vertragsnummer (z.B. 'LF060237653').\n\n";

    p += "4) klassifikation - GENAU EINER von:\n";
    p += "   - 'BUe-Vorgang' (Bestandsuebertragung)\n";
    p += "   - 'Schadenmeldung'\n";
    p += "   - 'Antrag-Aenderung' (Neuantrag, Tarifwechsel, Adresswechsel, Bankverbindung)\n";
    p += "   - 'Anfrage-Ruecksprache'\n";
    p += "   - 'Nicht-Standard' (echte Eskalation: Beschwerde, Klage, BaFin, Vorstand, Konsortium)\n";
    p += "   - 'Kein-Makler-Vorgang' (nur wenn vorgangstyp != 'Makler-Vorgang')\n";
    p += "   WICHTIG: Mahnungen / Reminder / Wiedervorlagen sind KEINE eigene Klassifikation. Wenn eine\n";
    p += "   Mail ein Reminder ist, klassifiziere sie nach dem zugrunde liegenden Vorgang (meist 'BUe-Vorgang',\n";
    p += "   selten 'Anfrage-Ruecksprache' oder 'Antrag-Aenderung') und setze ist_reminder = 'ja' (Feld 17).\n";
    p += "4a) klassifikation_grund - kurze Begruendung (max 200 Z.), konkrete Indizien nennen.\n\n";

    p += "5) geschaefts_typ - GENAU einer von 'BUe einfacher Vertrag' / 'BUe Kundenverbindung' / 'Keine BUe'\n";
    p += "   STRENGE Definition - Defaultwert 'BUe einfacher Vertrag' nur bei eindeutigem Einzelvertrags-Bezug:\n";
    p += "   - 'BUe einfacher Vertrag': Mail/MV/Anschreiben benennt GENAU EINE Versicherungsnummer\n";
    p += "     oder GENAU EINEN spezifischen Vertrag. KEINE Hinweise auf 'auch die anderen' / 'alle Vertraege'.\n";
    p += "   - 'BUe Kundenverbindung' (= ganze Verbindung): TRIGGER (irgendwann zutreffend):\n";
    p += "     (a) Im Anschreiben / MV-PDF werden MEHRERE konkrete Versicherungsnummern aufgefuehrt\n";
    p += "         (egal ob ERGO oder fremd) ODER\n";
    p += "     (b) Formulierungen wie 'gesamte Kundenverbindung','alle Vertraege','Kunde komplett',\n";
    p += "         'alle bei Ihnen bestehenden Vertraege','samtliche Vertraege des VN' ODER\n";
    p += "     (c) Anschreiben ist generisches Pool-Standardanschreiben ohne Vertragsnummer-Einschraenkung\n";
    p += "         + MV ist umfassend ('alle Vertraege' / 'jeweilige Vertraege').\n";
    p += "   - 'Keine BUe': nur wenn es technisch GAR KEINE Bestandsuebertragung ist (z.B. nur Anschriftsaenderung).\n";
    p += "   WICHTIG: PDF-Anhaenge auswerten! Wenn das Anschreiben mehrere Vertraege auflistet, ist es\n";
    p += "   Kundenverbindung, auch wenn die Mail-Subject nur EINE Nummer nennt.\n\n";
    p += "6) unterlagen_angefragt - 'ja' wenn Unterlagen fehlen / nachreichen / unvollstaendig. Sonst 'nein'.\n";
    p += "6a) unterlagen_liste - kommagetrennte Liste der fehlenden Unterlagen.\n\n";
    p += "7) sonderfall - 'Flottengeschaeft' / 'Sondertarif' / 'Kein Sonderfall'.\n";
    p += "8) sparte - 'Komposit' (SHUK) / 'Leben' / 'KV' / 'Mehrere' / 'Unbekannt'.\n\n";
    p += "9) anhang_typen - kommagetrennt: 'Maklervollmacht','Police','Antrag','Schadenmeldung','Beitragsrechnung','Anschreiben','Kuendigung','Datenblatt','Sonstiges'.\n";
    p += "9a) pdf_qualitaet - 'Text-PDF' / 'Scan' / 'Mixed' / 'Keine_PDFs' / 'nicht_pruefbar'.\n\n";

    p += "10) enthaelt_maklervollmacht - 'ja' / 'nein'.\n\n";
    p += "11) mv_vollumfaenglich - Schlagwort-basiert:\n";
    p += "    (a) 'abschliessen, aendern und kuendigen'\n";
    p += "    (b) 'Willenserklaerungen abgeben und entgegen[nehmen]' / 'aktiv und passiv vertreten'\n";
    p += "    (c) 'bevollmaechtigt zu vertreten' (uneingeschraenkt)\n";
    p += "    (d) 'Abgabe und Entgegennahme von Willenserklaerungen' + Aenderung/Kuendigung/Abschluss\n";
    p += "    (e) 'uneingeschraenkte aktive und passive Vertretung' (Minimalstandard PVC2D)\n";
    p += "    Werte: 'ja' (Schlagwort erkennbar) / 'teilweise' (Schlagwort ABER Einschraenkung) / 'nein' / 'nicht_pruefbar' (keine MV oder PDF nicht ausgewertet).\n";
    p += "    WICHTIG: 'vollumfaenglich' meint INHALT der Bevollmaechtigung, nicht Form.\n\n";
    p += "12) mv_einschraenkungen - Klartext: 'KV ausgeschlossen','schriftliche Zustimmung VN','kein Schlagwort gefunden' etc. Leer wenn 'ja' oder nicht pruefbar.\n\n";

    p += "13) unterschrift_kunde - 'ja' / 'nein' / 'nicht_pruefbar' (Unterschrift VN sichtbar?).\n";
    p += "14) unterschrift_makler - 'ja' / 'nein' / 'nicht_pruefbar' (Makler-Unterschrift, optional).\n";
    p += "15) auf_vn_ausgestellt - 'ja' / 'nein' / 'nicht_pruefbar'.\n";
    p += "16) makler_namentlich_genannt - 'ja' / 'nein' / 'nicht_pruefbar'.\n\n";

    p += "17) ist_reminder - 'ja' / 'nein' / 'nicht_pruefbar' (CROSS-CUTTING - orthogonal zur Klassifikation).\n";
    p += "    Indikatoren (case-insensitiv): Betreff 'Erinnerung','Reminder','WV','Mahnung','2. Mahnung','Sachstandsanfrage'; Body 'wir warten noch','haben wir noch nichts erhalten','bitten um Rueckmeldung'; Anhang-Dateinamen mit 'Mahnung','Reminder','Erinnerung'.\n";
    p += "    Ein Reminder bekommt die normale klassifikation (z.B. 'BUe-Vorgang'), nicht 'Mahnung-Reminder'.\n\n";

    p += "17a) reminder_quelle - WO ueberall hast du den Reminder-Hinweis erkannt?\n";
    p += "     Liste ALLER zutreffenden Quellen, komma-getrennt (Pipe nicht erlaubt). Atomare Werte:\n";
    p += "     - 'Anhang-PDF-Inhalt'  : Mahnungs-/Erinnerungs-Text steht IM PDF-Body\n";
    p += "     - 'Anhang-Dateiname'   : PDF heisst z.B. 'Mahnung_*.pdf' / 'Reminder_*.pdf'\n";
    p += "     - 'Mail-Betreff'       : Betreff enthaelt 'Erinnerung','Reminder','Mahnung','WV','2. Mahnung'\n";
    p += "     - 'Mail-Body'          : Mailtext enthaelt 'wir warten noch','noch nichts erhalten','bitten um Rueckmeldung'\n";
    p += "     Bei mehreren Quellen: komma-getrennt mit Leerzeichen, z.B. 'Mail-Betreff, Anhang-PDF-Inhalt'.\n";
    p += "     Leer wenn ist_reminder != 'ja'.\n";
    p += "     WICHTIG: Sei genau - das ist die Grundlage fuer die Reminder-Validierungs-Statistik im Excel.\n\n";

    p += "18a) mail_zusammenfassung - 1-2 Saetze NEUTRAL was die Mail inhaltlich macht.\n";
    p += "     Format: 'Makler X bittet um Bestandsuebertragung fuer Vertrag Y (Sparte Z). MV liegt bei.'\n";
    p += "     Max 250 Zeichen. NICHT mit Bewertung mischen - rein deskriptiv.\n\n";

    p += "18b) nicht_neuer_vorgang_grund - leer wenn es ein neuer Erstvorgang ist. SONST EXPLIZIT erklaeren\n";
    p += "     warum es KEIN neuer Erstvorgang ist (1 Satz, max 200 Z.). Beispiele:\n";
    p += "     - 'Reminder zu BUe-Anfrage vom <Datum>, ursprgl. Anschreiben vom Pool als Anhang.'\n";
    p += "     - '2. Mahnung zu noch offener BUe-Anfrage - Sachstandsanfrage.'\n";
    p += "     - 'Wiedervorlage - Pool wartet auf Antwort zur ersten Anfrage.'\n";
    p += "     - 'Nachreichung von Unterlagen zu bereits angefragter BUe.'\n";
    p += "     - 'Mail bezieht sich auf laufenden Vorgang von <Datum> - keine neue Anfrage.'\n";
    p += "     Bei ist_reminder=ja MUSS dieses Feld eine Begruendung enthalten. Quelle: Anhang-PDF-Inhalt,\n";
    p += "     Mail-Body ('Erinnerung an unsere Anfrage vom...'), Mail-Betreff ('2. Mahnung','Sachstand').\n\n";

    p += "19) hinweis - EIN kurzer Satz (max 200 Z.) was an dem Vorgang auffaellig ist.\n";
    p += "    BOILERPLATE NICHT erwaehnen: Folgende Formulierungen sind Standard-Textbausteine in Pool-BUe-Mails und gehoeren NICHT in den Hinweis:\n";
    p += "    - 'Sonderkonditionsvorbehalt' / 'Sonderkonditionen duerfen nicht verloren gehen' / 'falls Sonderkonditionen bestehen, bitten wir um Rueckmeldung'\n";
    p += "    - 'Wir bitten um Bestaetigung' / 'Vorlage der Maklervollmacht' (Standardtext)\n";
    p += "    - Kuendigung der bisherigen Betreuung (Standardklausel im Maklerwechsel)\n";
    p += "    Erwaehne den Hinweis nur, wenn der Vorgang AUSSERGEWOEHNLICH ist (z.B. echte Sondertarife im Vertrag genannt, ungewoehnliche Anhaenge, Eskalations-Indikatoren, unklare MV, mehrere Vertraege).\n";
    p += "    Wenn nichts auffaellig: leerer String ''.\n\n";

    p += "AUSGABE-FORMAT (eine Zeile, gueltiges JSON, alle 31 Schluessel):\n";
    p += '{"vorgangstyp":"...","auftrag_datum":"...",';
    p += '"maklerpool":"...","makler_nachname":"...","makler_vorname":"...","makler_nummer":"...",';
    p += '"kunde_nachname":"...","kunde_vorname":"...","kunde_nummer":"...","versicherungsnummer":"...",';
    p += '"klassifikation":"...","klassifikation_grund":"...","geschaefts_typ":"...","unterlagen_angefragt":"...",';
    p += '"unterlagen_liste":"...","sonderfall":"...","sparte":"...","anhang_typen":"...","pdf_qualitaet":"...",';
    p += '"enthaelt_maklervollmacht":"...","mv_vollumfaenglich":"...","mv_einschraenkungen":"...",';
    p += '"unterschrift_kunde":"...","unterschrift_makler":"...","auf_vn_ausgestellt":"...","makler_namentlich_genannt":"...",';
    p += '"ist_reminder":"...","reminder_quelle":"...","mail_zusammenfassung":"...","nicht_neuer_vorgang_grund":"...","hinweis":"..."}\n\n';
    p += "Antworte JETZT, nur das JSON-Objekt:\n";

    return p;
}

// ============================================================================
// EXPORT
// ============================================================================
// Excel.Interior.Color erwartet BGR-codierte Long. Wir bauen den Wert wie
// VBAs RGB(r,g,b) = r + g*256 + b*65536. So funktionieren die VBA-Farben.
function rgb(r, g, b) { return r + g * 256 + b * 65536; }

function exportToExcel() {
    if (state.results.length === 0) { showError("Keine Ergebnisse zum Exportieren."); return; }
    hideStatus();
    try {
        var excel = new ActiveXObject("Excel.Application");
        // WICHTIG: Excel VERSTECKT lassen waehrend Bulk-Write. Sichtbares Fenster
        // wird vom DWM/Window-Manager als "Not Responding" markiert wenn die
        // COM-Schleife laenger als ~5s blockiert (Recherche: hidden Window
        // unterliegt diesem Check nicht). Am Ende wieder einblenden.
        excel.Visible = false;
        excel.DisplayAlerts = false;
        try { excel.ScreenUpdating = false; } catch(eS) {}
        try { excel.Calculation = -4135; /* xlCalculationManual */ } catch(eS) {}
        try { excel.EnableEvents = false; } catch(eS) {}
        try { excel.DisplayStatusBar = false; } catch(eS) {}
        var wb = excel.Workbooks.Add();
        var sheet = wb.ActiveSheet;
        try { sheet.DisplayPageBreaks = false; } catch(eS) {}
        try { sheet.Name = "Analyse"; } catch(e) {}

        var headers = ["#","Datei","Datum","Auftrag_Datum","Absender Name","Absender Email","Empfaenger","Betreff","Anhaenge",
                       "Maklerpool","Makler_Nachname","Makler_Vorname","Maklernummer",
                       "Kunde_Nachname","Kunde_Vorname","Kundennummer","Versicherungsnummer",
                       "Vorgangstyp","Ist_Reminder","Klassifikation","Klassifikation_Grund",
                       "Geschaefts_Typ","Unterlagen_Angefragt","Unterlagen_Liste","Sonderfall","Sparte",
                       "Anhang_Typen","PDF_Qualitaet","MV_Enthalten","MV_Vollumfaenglich","MV_Einschraenkungen","MV_Status",
                       "Unterschrift_Kunde","Unterschrift_Makler","Auf_VN","Makler_Namentlich","Hinweis","Fehler","Reminder_Quelle",
                       "Mail_Zusammenfassung","Nicht_Neu_Grund"];
        // Spalten-Konstanten (1-basiert) - nach MV_Status alles ab Spalte 33 +1 verschoben
        var COL_DATEI = 2, COL_HINWEIS = 37, COL_FEHLER = 38;
        var COL_MAKLERPOOL = 10, COL_MAKLER_NR = 13;
        var COL_KUNDE_NACH = 14, COL_VERS_NR = 17;
        var COL_VORGANGSTYP = 18, COL_REMINDER = 19;
        var COL_KLASSIFIK = 20, COL_GESCHTYP = 22, COL_UNTERLAGEN = 23, COL_SONDERFALL = 25, COL_SPARTE = 26;
        var COL_ANH_TYPEN = 27, COL_PDF_QUAL = 28;
        var COL_VM_VORHAND = 29, COL_VM_VOLLST = 30, COL_VM_FEHLT = 31, COL_MV_STATUS = 32, COL_UNTERSCHR_K = 33, COL_UNTERSCHR_M = 34, COL_AUF_VN = 35, COL_MAKL_NAM = 36;

        for (var c = 0; c < headers.length; c++) {
            sheet.Cells(1, c+1).Value = headers[c];
        }

        // Farb-Schema fuer Header-Gruppen (VBA-Original)
        var F_STAMM  = rgb(30,  64, 175); // Indigo  - Mail-Stammdaten
        var F_MAKLER = rgb(22, 101,  52); // Gruen   - Makler
        var F_KUNDE  = rgb(14, 116, 144); // Petrol  - Kunde
        var F_TRIAGE = rgb(76,  29, 149); // Lila    - Triage / Reminder / Hinweis
        var F_KLASS  = rgb(15, 118, 110); // Teal    - Klassifikation
        var F_ANHANG = rgb(154, 52,  18); // Bronze  - Anhang
        var F_MV     = rgb(159, 18,  57); // Bordeaux- Maklervollmacht
        var WHITE    = rgb(255, 255, 255);

        try {
            var hr = sheet.Range(sheet.Cells(1,1), sheet.Cells(1, headers.length));
            hr.Font.Bold = true;
            hr.Font.Color = WHITE;
            hr.HorizontalAlignment = -4108; // xlCenter
            hr.WrapText = true;
            sheet.Rows(1).RowHeight = 30;
            // Pro Gruppe einfaerben
            sheet.Range(sheet.Cells(1,1), sheet.Cells(1, 9)).Interior.Color = F_STAMM;
            sheet.Range(sheet.Cells(1, COL_MAKLERPOOL), sheet.Cells(1, COL_MAKLER_NR)).Interior.Color = F_MAKLER;
            sheet.Range(sheet.Cells(1, COL_KUNDE_NACH), sheet.Cells(1, COL_VERS_NR)).Interior.Color = F_KUNDE;
            sheet.Range(sheet.Cells(1, COL_VORGANGSTYP), sheet.Cells(1, COL_REMINDER)).Interior.Color = F_TRIAGE;
            sheet.Range(sheet.Cells(1, COL_KLASSIFIK), sheet.Cells(1, COL_SPARTE)).Interior.Color = F_KLASS;
            sheet.Range(sheet.Cells(1, COL_ANH_TYPEN), sheet.Cells(1, COL_PDF_QUAL)).Interior.Color = F_ANHANG;
            sheet.Range(sheet.Cells(1, COL_VM_VORHAND), sheet.Cells(1, COL_MAKL_NAM)).Interior.Color = F_MV;
            sheet.Cells(1, COL_HINWEIS).Interior.Color = F_TRIAGE;
            sheet.Cells(1, COL_FEHLER).Interior.Color = rgb(127, 29, 29); // dunkles Rot
        } catch(e) {}

        // Highlight-Farben fuer Daten-Zeilen
        var H_ROT   = rgb(252, 165, 165); // Fehler/Achtung
        var H_GRUEN = rgb(187, 247, 208); // OK/positiv
        var H_GELB  = rgb(254, 240, 138); // Achtung
        var H_ORANGE= rgb(254, 215, 170); // Reminder/Warnung
        var H_BERN  = rgb(253, 230, 138); // Klassifikation auffaellig
        var H_GRAU  = rgb(229, 231, 235); // Kein-Makler-Vorgang

        // PHASE 1: BULK-WRITE via VBScript-Sub FillRangeFromTsv. Das Range-Assignment
        // passiert INNERHALB VBScript (siehe Eric-Lippert-Recherche) - so umgeht man
        // den JScript-SafeArray-Round-Trip-Bug, der bisher leere Zellen produzierte.
        // Per-Cell-Fallback falls FillRangeFromTsv die Sanity-Check nicht besteht.
        var bulkErrors = [];
        var exportTotal = state.results.length;
        var pgEl = document.getElementById("progressContainer");
        var statusEl = document.getElementById("slotStatus");
        if (pgEl) pgEl.style.display = "block";
        if (statusEl) statusEl.innerText = "Excel-Export: TSV bauen fuer " + exportTotal + " Zeilen...";
        forceRepaint();

        // TSV-Riesen-String bauen (cellSafeTsv strippt Tabs/Newlines - sonst kaputter Split)
        var rowsTsv = [];
        for (var i = 0; i < state.results.length; i++) {
            var r = state.results[i];
            var d = r.data || {};
            rowsTsv.push(
                String(i + 1) + "\t" +
                cellSafeTsv(r.msgFile) + "\t" +
                cellSafeTsv(r.datum) + "\t" +
                cellSafeTsv(sg(d, "auftrag_datum")) + "\t" +
                cellSafeTsv(r.absName) + "\t" +
                cellSafeTsv(r.absMail) + "\t" +
                cellSafeTsv(r.empfaenger) + "\t" +
                cellSafeTsv(r.betreff) + "\t" +
                cellSafeTsv(r.anhangAlle) + "\t" +
                cellSafeTsv(sg(d, "maklerpool")) + "\t" +
                cellSafeTsv(sg(d, "makler_nachname")) + "\t" +
                cellSafeTsv(sg(d, "makler_vorname")) + "\t" +
                cellSafeTsv(sg(d, "makler_nummer")) + "\t" +
                cellSafeTsv(sg(d, "kunde_nachname")) + "\t" +
                cellSafeTsv(sg(d, "kunde_vorname")) + "\t" +
                cellSafeTsv(sg(d, "kunde_nummer")) + "\t" +
                cellSafeTsv(sg(d, "versicherungsnummer")) + "\t" +
                cellSafeTsv(sg(d, "vorgangstyp")) + "\t" +
                cellSafeTsv(sg(d, "ist_reminder")) + "\t" +
                cellSafeTsv(sg(d, "klassifikation")) + "\t" +
                cellSafeTsv(sg(d, "klassifikation_grund")) + "\t" +
                cellSafeTsv(sg(d, "geschaefts_typ")) + "\t" +
                cellSafeTsv(sg(d, "unterlagen_angefragt")) + "\t" +
                cellSafeTsv(sg(d, "unterlagen_liste")) + "\t" +
                cellSafeTsv(sg(d, "sonderfall")) + "\t" +
                cellSafeTsv(sg(d, "sparte")) + "\t" +
                cellSafeTsv(sg(d, "anhang_typen")) + "\t" +
                cellSafeTsv(sg(d, "pdf_qualitaet")) + "\t" +
                cellSafeTsv(sg(d, "enthaelt_maklervollmacht")) + "\t" +
                cellSafeTsv(sg(d, "mv_vollumfaenglich")) + "\t" +
                cellSafeTsv(sg(d, "mv_einschraenkungen")) + "\t" +
                cellSafeTsv(computeMvStatus(r)) + "\t" +
                cellSafeTsv(sg(d, "unterschrift_kunde")) + "\t" +
                cellSafeTsv(sg(d, "unterschrift_makler")) + "\t" +
                cellSafeTsv(sg(d, "auf_vn_ausgestellt")) + "\t" +
                cellSafeTsv(sg(d, "makler_namentlich_genannt")) + "\t" +
                cellSafeTsv(sg(d, "hinweis")) + "\t" +
                (r.ok ? "" : cellSafeTsv(r.errMsg)) + "\t" +
                cellSafeTsv(detectReminderSource(r)) + "\t" +
                cellSafeTsv(sg(d, "mail_zusammenfassung")) + "\t" +
                cellSafeTsv(sg(d, "nicht_neuer_vorgang_grund"))
            );
        }
        var bigTsv = rowsTsv.join("\n");
        if (statusEl) statusEl.innerText = "Excel-Export: VBScript-Bulk-Write (" + Math.round(bigTsv.length / 1024) + " KB)...";
        forceRepaint();

        var bulkOk = false;
        try {
            var rng = sheet.Range(sheet.Cells(2, 1), sheet.Cells(state.results.length + 1, headers.length));
            FillRangeFromTsv(rng, bigTsv, "\n", "\t", state.results.length, headers.length);
            // Sanity-Check: DREI Stichproben (Anfang, Mitte, Ende). FillRangeFromTsv kann
            // bei grossen Arrays Memory-Probleme bekommen und partial schreiben.
            var midRow = Math.floor((state.results.length + 1) / 2) + 1;
            var s1 = String(sheet.Cells(2, 2).Value || "");
            var sM = String(sheet.Cells(midRow, 2).Value || "");
            var s2 = String(sheet.Cells(state.results.length + 1, 2).Value || "");
            if (s1.length > 0 && sM.length > 0 && s2.length > 0) {
                bulkOk = true;
            } else {
                throw new Error("FillRangeFromTsv: Stichproben leer (anfang='" + s1.substr(0,30) +
                                "', mitte='" + sM.substr(0,30) + "', ende='" + s2.substr(0,30) + "')");
            }
        } catch(eBulk) {
            bulkErrors.push("VBScript-Bulk fehlgeschlagen: " + (eBulk.message || "?") + " - Per-Cell-Fallback laeuft");
        }

        // -----------------------------------------------------------------------
        // ASYNC CHUNKED PIPELINE - zerlegt synchrone Loops in setTimeout-Chunks.
        // Jeder Chunk ist eine eigene JS-Task. Windows-Script-Statement-Counter
        // resettet sich zwischen Tasks - kein "Script-Ausfuehrung dauert lange"-
        // Dialog mehr. Ablauf:
        //   bulkOk=true  -> startColorsChunked -> finalizeExport
        //   bulkOk=false -> writePerCellChunk(0) -> startColorsChunked -> finalizeExport
        // -----------------------------------------------------------------------

        // Nested function: chunked per-cell-write (Fallback wenn FillRangeFromTsv versagt)
        function writePerCellChunk(startIdx) {
            try {
                var CHUNK_ROWS = 50;
                var endIdx = Math.min(startIdx + CHUNK_ROWS, state.results.length);
                for (var ii2 = startIdx; ii2 < endIdx; ii2++) {
                    var r2 = state.results[ii2];
                    var d2 = r2.data || {};
                    var row2 = ii2 + 2;
                    try {
                        sheet.Cells(row2, 1).Value = ii2 + 1;
                        sheet.Cells(row2, 2).Value = cellSafe(r2.msgFile);
                        sheet.Cells(row2, 3).Value = cellSafe(r2.datum);
                        sheet.Cells(row2, 4).Value = cellSafe(sg(d2, "auftrag_datum"));
                        sheet.Cells(row2, 5).Value = cellSafe(r2.absName);
                        sheet.Cells(row2, 6).Value = cellSafe(r2.absMail);
                        sheet.Cells(row2, 7).Value = cellSafe(r2.empfaenger);
                        sheet.Cells(row2, 8).Value = cellSafe(r2.betreff);
                        sheet.Cells(row2, 9).Value = cellSafe(r2.anhangAlle);
                        sheet.Cells(row2, 10).Value = cellSafe(sg(d2, "maklerpool"));
                        sheet.Cells(row2, 11).Value = cellSafe(sg(d2, "makler_nachname"));
                        sheet.Cells(row2, 12).Value = cellSafe(sg(d2, "makler_vorname"));
                        sheet.Cells(row2, 13).Value = cellSafe(sg(d2, "makler_nummer"));
                        sheet.Cells(row2, 14).Value = cellSafe(sg(d2, "kunde_nachname"));
                        sheet.Cells(row2, 15).Value = cellSafe(sg(d2, "kunde_vorname"));
                        sheet.Cells(row2, 16).Value = cellSafe(sg(d2, "kunde_nummer"));
                        sheet.Cells(row2, 17).Value = cellSafe(sg(d2, "versicherungsnummer"));
                        sheet.Cells(row2, 18).Value = cellSafe(sg(d2, "vorgangstyp"));
                        sheet.Cells(row2, 19).Value = cellSafe(sg(d2, "ist_reminder"));
                        sheet.Cells(row2, 20).Value = cellSafe(sg(d2, "klassifikation"));
                        sheet.Cells(row2, 21).Value = cellSafe(sg(d2, "klassifikation_grund"));
                        sheet.Cells(row2, 22).Value = cellSafe(sg(d2, "geschaefts_typ"));
                        sheet.Cells(row2, 23).Value = cellSafe(sg(d2, "unterlagen_angefragt"));
                        sheet.Cells(row2, 24).Value = cellSafe(sg(d2, "unterlagen_liste"));
                        sheet.Cells(row2, 25).Value = cellSafe(sg(d2, "sonderfall"));
                        sheet.Cells(row2, 26).Value = cellSafe(sg(d2, "sparte"));
                        sheet.Cells(row2, 27).Value = cellSafe(sg(d2, "anhang_typen"));
                        sheet.Cells(row2, 28).Value = cellSafe(sg(d2, "pdf_qualitaet"));
                        sheet.Cells(row2, 29).Value = cellSafe(sg(d2, "enthaelt_maklervollmacht"));
                        sheet.Cells(row2, 30).Value = cellSafe(sg(d2, "mv_vollumfaenglich"));
                        sheet.Cells(row2, 31).Value = cellSafe(sg(d2, "mv_einschraenkungen"));
                        sheet.Cells(row2, 32).Value = cellSafe(computeMvStatus(r2));
                        sheet.Cells(row2, 33).Value = cellSafe(sg(d2, "unterschrift_kunde"));
                        sheet.Cells(row2, 34).Value = cellSafe(sg(d2, "unterschrift_makler"));
                        sheet.Cells(row2, 35).Value = cellSafe(sg(d2, "auf_vn_ausgestellt"));
                        sheet.Cells(row2, 36).Value = cellSafe(sg(d2, "makler_namentlich_genannt"));
                        sheet.Cells(row2, 37).Value = cellSafe(sg(d2, "hinweis"));
                        sheet.Cells(row2, 38).Value = r2.ok ? "" : cellSafe(r2.errMsg);
                        sheet.Cells(row2, 39).Value = cellSafe(detectReminderSource(r2));
                        sheet.Cells(row2, 40).Value = cellSafe(sg(d2, "mail_zusammenfassung"));
                        sheet.Cells(row2, 41).Value = cellSafe(sg(d2, "nicht_neuer_vorgang_grund"));
                    } catch(eR2) {
                        bulkErrors.push("Zeile " + row2 + ": " + (eR2.message || "?"));
                    }
                }
                if (statusEl) statusEl.innerText = "Excel-Export: Per-Cell " + endIdx + " / " + exportTotal;
                forceRepaint();
                if (endIdx % 500 === 0) {
                    try { excel.ScreenUpdating = true; excel.ScreenUpdating = false; } catch(eFlush) {}
                }
                if (endIdx < state.results.length) {
                    setTimeout(function() { writePerCellChunk(endIdx); }, 0);
                } else {
                    startColorsChunked();
                }
            } catch(eChunk) {
                failExport("Per-Cell-Chunk-Fehler bei Zeile " + (startIdx + 1) + ": " + eChunk.message);
            }
        }

        function startColorsChunked() {
            if (statusEl) statusEl.innerText = "Excel-Export: " + exportTotal + " / " + exportTotal + " (Farben starten)";
            forceRepaint();
            colorsChunk(0);
        }

        function colorsChunk(startIdx) {
            try {
                var CHUNK_ROWS = 200;
                var endIdx = Math.min(startIdx + CHUNK_ROWS, state.results.length);
                for (var ii = startIdx; ii < endIdx; ii++) {
                    var rr = state.results[ii];
                    var dd = rr.data || {};
                    var row = ii + 2;
                    try {
                        if (!rr.ok || rr.errMsg) {
                            sheet.Cells(row, COL_FEHLER).Interior.Color = H_ROT;
                        }
                        var vt = sg(dd, "vorgangstyp");
                        if (vt && vt !== "Makler-Vorgang" && vt !== "") {
                            sheet.Range(sheet.Cells(row, COL_MAKLERPOOL), sheet.Cells(row, COL_HINWEIS)).Interior.Color = H_GRAU;
                            sheet.Cells(row, COL_VORGANGSTYP).Interior.Color = H_ORANGE;
                        }
                        if (sg(dd, "ist_reminder") === "ja") sheet.Cells(row, COL_REMINDER).Interior.Color = H_ORANGE;
                        var sond = sg(dd, "sonderfall");
                        if (sond === "Flottengeschaeft" || sond === "Sondertarif") sheet.Cells(row, COL_SONDERFALL).Interior.Color = H_ROT;
                        var kl = sg(dd, "klassifikation");
                        if (kl === "Nicht-Standard") sheet.Cells(row, COL_KLASSIFIK).Interior.Color = H_BERN;
                        var pq = sg(dd, "pdf_qualitaet");
                        if (pq === "Scan") sheet.Cells(row, COL_PDF_QUAL).Interior.Color = H_BERN;
                        else if (pq === "Mixed") sheet.Cells(row, COL_PDF_QUAL).Interior.Color = H_GELB;
                        var mvv = sg(dd, "mv_vollumfaenglich");
                        if (mvv === "teilweise" || mvv === "nein") sheet.Cells(row, COL_VM_VOLLST).Interior.Color = H_ROT;
                        else if (mvv === "ja") sheet.Cells(row, COL_VM_VOLLST).Interior.Color = H_GRUEN;
                        var mvSt = computeMvStatus(rr);
                        if (mvSt === "OK") sheet.Cells(row, COL_MV_STATUS).Interior.Color = H_GRUEN;
                        else if (mvSt === "MV unvollstaendig" || mvSt === "MV fehlt") sheet.Cells(row, COL_MV_STATUS).Interior.Color = H_ROT;
                        else if (mvSt === "kein Anhang") sheet.Cells(row, COL_MV_STATUS).Interior.Color = H_GRAU;
                        else if (mvSt === "nicht pruefbar") sheet.Cells(row, COL_MV_STATUS).Interior.Color = H_GELB;
                        var uk = sg(dd, "unterschrift_kunde");
                        if (uk === "nein") sheet.Cells(row, COL_UNTERSCHR_K).Interior.Color = H_ROT;
                        else if (uk === "ja") sheet.Cells(row, COL_UNTERSCHR_K).Interior.Color = H_GRUEN;
                        var um = sg(dd, "unterschrift_makler");
                        if (um === "nein") sheet.Cells(row, COL_UNTERSCHR_M).Interior.Color = H_ROT;
                        else if (um === "ja") sheet.Cells(row, COL_UNTERSCHR_M).Interior.Color = H_GRUEN;
                    } catch(eHL) {
                        bulkErrors.push("Highlight Zeile " + row + ": " + (eHL.message || "?"));
                    }
                }
                if (statusEl) statusEl.innerText = "Excel-Export: Farben " + endIdx + " / " + exportTotal;
                forceRepaint();
                if (endIdx % 1000 === 0) {
                    try { excel.ScreenUpdating = true; excel.ScreenUpdating = false; } catch(eFlush) {}
                }
                if (endIdx < state.results.length) {
                    setTimeout(function() { colorsChunk(endIdx); }, 0);
                } else {
                    finalizeExport();
                }
            } catch(eC) {
                failExport("Color-Chunk-Fehler bei Zeile " + (startIdx + 1) + ": " + eC.message);
            }
        }

        function finalizeExport() {
            try {
                if (statusEl) statusEl.innerText = "Excel-Export: Auswertung + Formatierung...";
                forceRepaint();

                try {
                    sheet.Columns("A:A").ColumnWidth = 5;
                    sheet.Columns("B:B").ColumnWidth = 40;
                    sheet.Columns("C:H").ColumnWidth = 18;
                    sheet.Cells.Font.Name = "Open Sans";
                    sheet.Cells.WrapText = false;
                    sheet.Range(sheet.Cells(1,1), sheet.Cells(state.results.length + 1, headers.length)).AutoFilter();
                    sheet.Range("A2").Select();
                    excel.ActiveWindow.FreezePanes = true;
                } catch(eFmt) {}

                var auswErr = "";
                try { buildAuswertungSheet(wb, excel); } catch(eAusw) {
                    auswErr = eAusw.message || "unbekannter Fehler";
                }

                try { excel.ScreenUpdating = true; } catch(eS) {}
                try { excel.Calculation = -4105; } catch(eS) {}
                try { excel.EnableEvents = true; } catch(eS) {}
                try { excel.DisplayStatusBar = true; } catch(eS) {}
                excel.DisplayAlerts = true;
                try { excel.Visible = true; } catch(eS) {}

                var okMsg = "Excel mit " + state.results.length + " Vorgaengen + Auswertung-Sheet geoeffnet.";
                if (bulkErrors.length > 0) {
                    okMsg += " <strong>" + bulkErrors.length + " Zeilen mit Schreibfehlern</strong>: " +
                             bulkErrors.slice(0, 3).join(" | ") + (bulkErrors.length > 3 ? " ..." : "");
                }
                if (auswErr) okMsg += " <strong>Auswertung-Sheet fehlgeschlagen:</strong> " + auswErr;
                okMsg += " Bitte manuell speichern.";
                if (statusEl) statusEl.innerText = "";
                if (pgEl && !state.running) pgEl.style.display = "none";
                showSuccess(okMsg);
            } catch(eF) {
                failExport("Finalize-Fehler: " + eF.message);
            }
        }

        function failExport(msg) {
            try { if (typeof excel !== "undefined") {
                excel.ScreenUpdating = true;
                excel.Calculation = -4105;
                excel.EnableEvents = true;
                excel.DisplayAlerts = true;
                excel.DisplayStatusBar = true;
                excel.Visible = true;
            }} catch(eR) {}
            if (statusEl) statusEl.innerText = "";
            if (pgEl && !state.running) pgEl.style.display = "none";
            showError("Excel-Export fehlgeschlagen: " + msg);
        }

        // KICKOFF: erster Chunk je nach bulkOk-Status
        if (!bulkOk) {
            try { sheet.Range(sheet.Cells(2, 1), sheet.Cells(state.results.length + 1, headers.length)).ClearContents(); } catch(eClr) {}
            setTimeout(function() { writePerCellChunk(0); }, 0);
        } else {
            setTimeout(startColorsChunked, 0);
        }
    } catch(e) {
        // Settings auch im Fehlerfall zuruecksetzen (sonst bleibt Excel ggf.
        // unsichtbar/frozen falls Crash zwischen Visible=false und Visible=true)
        try { if (typeof excel !== "undefined") {
            excel.ScreenUpdating = true;
            excel.Calculation = -4105;
            excel.EnableEvents = true;
            excel.DisplayAlerts = true;
            excel.DisplayStatusBar = true;
            excel.Visible = true;
        }} catch(eR) {}
        showError("Excel-Export fehlgeschlagen: " + (e.message || "unbekannter Laufzeitfehler") +
                  (e.number !== undefined ? " (Code " + e.number + ")" : "") +
                  (e.description ? " - " + e.description : ""));
    }
}

// Extrahiert die reine E-Mail-Adresse aus einem To-String wie
// "Bestandsuebertragungen <bestandsuebertragungen@ergo.de>" oder "foo@bar.de".
// Lowercased fuer konsistentes Gruppieren.
function extractRecipientEmail(s) {
    if (!s) return "";
    var str = String(s);
    // Erst: Inhalt zwischen < und >
    var m = str.match(/<([^>]+@[^>]+)>/);
    if (m) return m[1].toLowerCase();
    // Sonst: erste Email-Adresse im String
    var m2 = str.match(/([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,})/);
    if (m2) return m2[1].toLowerCase();
    return str.toLowerCase();
}

// Berechnet Statistik fuer ein Subset von Ergebnissen. Liefert ein Objekt
// mit allen Zwischenwerten, die buildAuswertungSheet zum Rendern braucht.
function computeAuswertungStats(results) {
    var st = {
        totalMaklerVorgang: 0,
        classifCounts: {},
        bueResults: [],
        poolCountsBue: {},
        reminderInBue: 0,
        reminderSrcAnhang: 0,
        reminderSrcBetreff: 0,
        reminderSrcBodyKi: 0,
        // Atomare Quellen-Counts (jeder Reminder kann zu mehreren beitragen)
        rqAnhangPdf: 0,
        rqAnhangDateiname: 0,
        rqMailBetreff: 0,
        rqMailBody: 0,
        rqHeuristikBlind: 0,        // alt-Cache, keine Quelle erkennbar
        rqMultiple: 0,              // Anzahl Reminders mit >1 Quelle
        einfacherVertragBue: 0,
        kundenverbindungBue: 0,
        bueTypUnklar: 0,
        mvStatusBue: { "OK": 0, "MV unvollstaendig": 0, "MV fehlt": 0, "kein Anhang": 0, "nicht pruefbar": 0 },
        // PDF-Qualitaet in BU-Vorgaengen (Text-PDF = einfach, Scan = OCR noetig)
        pdfQualitaetBue: { "Text-PDF": 0, "Scan": 0, "Mixed": 0, "Keine_PDFs": 0, "nicht_pruefbar": 0, "(sonstige)": 0 }
    };
    for (var i = 0; i < results.length; i++) {
        var r = results[i];
        if (!r.ok || !r.data) continue;
        var vt = sg(r.data, "vorgangstyp");
        if (vt !== "Makler-Vorgang") continue;
        st.totalMaklerVorgang++;
        var klass = sg(r.data, "klassifikation") || "(leer)";
        st.classifCounts[klass] = (st.classifCounts[klass] || 0) + 1;
        if (klass === "BUe-Vorgang") {
            st.bueResults.push(r);
            var pool = sg(r.data, "maklerpool") || "(kein Pool angegeben)";
            st.poolCountsBue[pool] = (st.poolCountsBue[pool] || 0) + 1;
            if (sg(r.data, "ist_reminder") === "ja") {
                st.reminderInBue++;
                var rqSrc = detectReminderSource(r);
                // Drei-Bucket-Variante fuer Backward-Compat
                if (rqSrc.indexOf("Anhang") === 0) st.reminderSrcAnhang++;
                else if (rqSrc.indexOf("Mail-Betreff") === 0 || rqSrc.indexOf("Betreff") === 0) st.reminderSrcBetreff++;
                else st.reminderSrcBodyKi++;
                // Atomare Quellen-Counts (jede Quelle zaehlt einzeln)
                var atoms = splitReminderQuellen(rqSrc);
                var hasReal = false;
                for (var ai = 0; ai < atoms.length; ai++) {
                    var atom = atoms[ai];
                    if (atom === "Anhang-PDF-Inhalt") { st.rqAnhangPdf++; hasReal = true; }
                    else if (atom === "Anhang-Dateiname") { st.rqAnhangDateiname++; hasReal = true; }
                    else if (atom === "Mail-Betreff") { st.rqMailBetreff++; hasReal = true; }
                    else if (atom === "Mail-Body") { st.rqMailBody++; hasReal = true; }
                }
                if (atoms.length > 1) st.rqMultiple++;
                if (!hasReal) st.rqHeuristikBlind++;
            }
            var gt = sg(r.data, "geschaefts_typ") || "";
            if (gt.indexOf("einfacher") >= 0 || gt.indexOf("einzeln") >= 0) st.einfacherVertragBue++;
            else if (gt.indexOf("Kundenverbindung") >= 0 || gt.indexOf("kundenverbindung") >= 0) st.kundenverbindungBue++;
            else st.bueTypUnklar++;
            var mvs = computeMvStatus(r);
            if (mvs in st.mvStatusBue) st.mvStatusBue[mvs]++;
            else st.mvStatusBue[mvs] = (st.mvStatusBue[mvs] || 0) + 1;
            // PDF-Qualitaet
            var pq = sg(r.data, "pdf_qualitaet") || "(sonstige)";
            if (pq in st.pdfQualitaetBue) st.pdfQualitaetBue[pq]++;
            else st.pdfQualitaetBue["(sonstige)"]++;
        }
    }
    return st;
}

// Zweites Excel-Sheet "Auswertung": Maklerpool-Statistik + BU-Detail-Stats.
// Zaehlt nur echte Makler-Vorgaenge (vorgangstyp=Makler-Vorgang).
// Hat 3 Sektionen: GESAMT (alle Postfaecher), dann pro Postfach ein Drill-Down.
// Konsolidierte MV-Status-Spalte. Reduziert die drei MV-Felder + Anhang-Info
// auf einen Single-Glance-Wert. Reihenfolge zaehlt: zuerst "kein Anhang"
// pruefen, dann "MV fehlt" (Anhang da, aber MV-Flag nein), dann Vollumfang.
function computeMvStatus(r) {
    if (!r || !r.data) return "";
    var d = r.data;
    var anhang = String(r.anhangAlle || "").replace(/^\s+|\s+$/g, "");
    if (!anhang) return "kein Anhang";
    var enth = (sg(d, "enthaelt_maklervollmacht") || "").toLowerCase();
    var voll = (sg(d, "mv_vollumfaenglich") || "").toLowerCase();
    if (enth === "nein") return "MV fehlt";
    if (voll === "ja") return "OK";
    if (voll === "teilweise") return "MV unvollstaendig";
    if (voll === "nein") return "MV unvollstaendig";
    return "nicht pruefbar";
}

function buildAuswertungSheet(wb, excel) {
    // GESAMT-Stats
    var gesamt = computeAuswertungStats(state.results);

    // Per-Postfach gruppieren
    var byPostfach = {};
    for (var i0 = 0; i0 < state.results.length; i0++) {
        var r0 = state.results[i0];
        var pf = extractRecipientEmail(r0.empfaenger) || "(kein Empfaenger)";
        if (!byPostfach[pf]) byPostfach[pf] = [];
        byPostfach[pf].push(r0);
    }
    // Postfaecher sortiert nach Anzahl Mails (egal welcher Klassifikation), absteigend
    var postfaecher = [];
    for (var k0 in byPostfach) if (byPostfach.hasOwnProperty(k0)) postfaecher.push({ email: k0, count: byPostfach[k0].length });
    postfaecher.sort(function(a, b) { return b.count - a.count; });

    // Neues Sheet hinten anhaengen
    var aus = wb.Worksheets.Add();
    try {
        aus.Move(null, wb.Sheets(wb.Sheets.Count));
        aus.Name = "Auswertung";
    } catch(e) {}

    var row = 1;
    function pct(part, total) {
        if (!total || total === 0) return "-";
        return (Math.round((part / total) * 1000) / 10) + "%";
    }
    function header(text, bgColor) {
        aus.Cells(row, 1).Value = text;
        var rng = aus.Range(aus.Cells(row, 1), aus.Cells(row, 3));
        try { rng.Merge(); } catch(e) {}
        rng.Font.Bold = true;
        rng.Font.Size = 13;
        rng.Font.Color = rgb(255, 255, 255);
        rng.Interior.Color = bgColor || rgb(30, 64, 175);
        rng.HorizontalAlignment = -4131; // xlLeft
        aus.Rows(row).RowHeight = 22;
        row++;
    }
    function dataRow(label, value, share, indent, bold) {
        aus.Cells(row, 1).Value = (indent ? "    " : "") + label;
        aus.Cells(row, 2).Value = value;
        aus.Cells(row, 3).Value = share || "";
        if (bold) {
            aus.Range(aus.Cells(row,1), aus.Cells(row,3)).Font.Bold = true;
        }
        row++;
    }

    // Rendert einen Statistik-Block (Uebersicht + BU-Detail + Maklerpools) fuer
    // einen gegebenen Stats-Container. Verwendet die obigen Closures aus
    // buildAuswertungSheet (aus, row, header, dataRow, pct).
    function renderBlock(titlePrefix, st, baseColor) {
        // Uebersicht
        header(titlePrefix + " (echte Makler-Vorgaenge)", baseColor || rgb(30, 64, 175));
        dataRow("Vorgaenge gesamt", st.totalMaklerVorgang, "100%", false, true);
        row++;
        var classifOrder = ["BUe-Vorgang", "Schadenmeldung", "Antrag-Aenderung", "Anfrage-Ruecksprache", "Nicht-Standard"];
        for (var k = 0; k < classifOrder.length; k++) {
            var c = st.classifCounts[classifOrder[k]] || 0;
            dataRow(classifOrder[k], c, pct(c, st.totalMaklerVorgang), true);
        }
        for (var ck in st.classifCounts) {
            if (!st.classifCounts.hasOwnProperty(ck)) continue;
            var inList = false;
            for (var j = 0; j < classifOrder.length; j++) if (classifOrder[j] === ck) { inList = true; break; }
            if (inList) continue;
            // Mahnung-Reminder aus alten Cache-Eintraegen: einklappen unter Klassifikation, ignorieren - cross-cutting via ist_reminder
            if (ck === "Mahnung-Reminder") {
                dataRow(ck + " (alt-Cache, neu: BUe + Reminder)", st.classifCounts[ck], pct(st.classifCounts[ck], st.totalMaklerVorgang), true);
                continue;
            }
            dataRow(ck, st.classifCounts[ck], pct(st.classifCounts[ck], st.totalMaklerVorgang), true);
        }
        row++;

        // BU-Detail
        if (st.bueResults.length > 0) {
            header("BU-VORGAENGE im Detail (n=" + st.bueResults.length + ")", rgb(22, 101, 52));
            dataRow("BUs gesamt", st.bueResults.length, "100%", false, true);
            row++;
            var erst = st.bueResults.length - st.reminderInBue;
            dataRow("Erstvorgang", erst, pct(erst, st.bueResults.length), true);
            dataRow("Reminder / Wiedervorlage", st.reminderInBue, pct(st.reminderInBue, st.bueResults.length), true);
            row++;
            dataRow("einfacher Vertrag", st.einfacherVertragBue, pct(st.einfacherVertragBue, st.bueResults.length), true);
            dataRow("ganze Kundenverbindung", st.kundenverbindungBue, pct(st.kundenverbindungBue, st.bueResults.length), true);
            if (st.bueTypUnklar > 0) dataRow("BU-Typ unklar", st.bueTypUnklar, pct(st.bueTypUnklar, st.bueResults.length), true);
            row++;

            // REMINDER-QUELLEN-Block (eigene Statistik wo der Reminder erkannt wurde)
            if (st.reminderInBue > 0) {
                header("REMINDER-QUELLEN (n=" + st.reminderInBue + " Reminder-BUs)", rgb(180, 83, 9));
                dataRow("Anhang-PDF-Inhalt", st.rqAnhangPdf, pct(st.rqAnhangPdf, st.reminderInBue), true);
                dataRow("Anhang-Dateiname", st.rqAnhangDateiname, pct(st.rqAnhangDateiname, st.reminderInBue), true);
                dataRow("Mail-Betreff", st.rqMailBetreff, pct(st.rqMailBetreff, st.reminderInBue), true);
                dataRow("Mail-Body", st.rqMailBody, pct(st.rqMailBody, st.reminderInBue), true);
                if (st.rqMultiple > 0) dataRow("davon Mehrfach-Quelle (kombiniert)", st.rqMultiple, pct(st.rqMultiple, st.reminderInBue), true);
                if (st.rqHeuristikBlind > 0) dataRow("Quelle nicht erfasst (alt-Cache)", st.rqHeuristikBlind, pct(st.rqHeuristikBlind, st.reminderInBue), true);
                row++;
            }

            // MV-Status-Block (konsolidierter Blick)
            header("MV-STATUS (nur BU-Vorgaenge)", rgb(159, 18, 57));
            var mvOrder = ["OK", "MV unvollstaendig", "MV fehlt", "kein Anhang", "nicht pruefbar"];
            for (var mi = 0; mi < mvOrder.length; mi++) {
                var mk = mvOrder[mi];
                var mv = st.mvStatusBue[mk] || 0;
                dataRow(mk, mv, pct(mv, st.bueResults.length), true);
            }
            // Zusaetzliche unerwartete Werte (sollte nie passieren)
            for (var emk in st.mvStatusBue) {
                if (!st.mvStatusBue.hasOwnProperty(emk)) continue;
                var inOrder = false;
                for (var oi = 0; oi < mvOrder.length; oi++) if (mvOrder[oi] === emk) { inOrder = true; break; }
                if (!inOrder && st.mvStatusBue[emk] > 0) dataRow(emk, st.mvStatusBue[emk], pct(st.mvStatusBue[emk], st.bueResults.length), true);
            }
            row++;

            // PDF-Qualitaet-Block (Text-PDF = automatisierungstauglich, Scan = OCR-Pflichtfall)
            header("PDF-QUALITAET (nur BU-Vorgaenge)", rgb(180, 83, 9));
            var pqOrder = ["Text-PDF", "Mixed", "Scan", "Keine_PDFs", "nicht_pruefbar"];
            var pqLabels = {
                "Text-PDF":     "Text-PDF (auto-tauglich)",
                "Mixed":        "Mixed (teilweise OCR)",
                "Scan":         "Scan (OCR/manuell)",
                "Keine_PDFs":   "Keine PDFs vorhanden",
                "nicht_pruefbar":"nicht pruefbar"
            };
            for (var qi = 0; qi < pqOrder.length; qi++) {
                var qk = pqOrder[qi];
                var qv = st.pdfQualitaetBue[qk] || 0;
                dataRow(pqLabels[qk] || qk, qv, pct(qv, st.bueResults.length), true);
            }
            // Sonstige
            if (st.pdfQualitaetBue["(sonstige)"] > 0) {
                dataRow("(sonstige Werte)", st.pdfQualitaetBue["(sonstige)"], pct(st.pdfQualitaetBue["(sonstige)"], st.bueResults.length), true);
            }
            row++;

            // Maklerpool-Aufstellung
            header("MAKLERPOOLS (nur BU-Vorgaenge, sortiert nach Haeufigkeit)", rgb(14, 116, 144));
            var pools = [];
            for (var p in st.poolCountsBue) if (st.poolCountsBue.hasOwnProperty(p)) pools.push({ name: p, count: st.poolCountsBue[p] });
            pools.sort(function(a, b) { return b.count - a.count; });

            var grossThreshold = 5;
            var sigThreshold = 2;
            if (st.bueResults.length < 10) { grossThreshold = 2; sigThreshold = 2; }

            var einzelfallSum = 0;
            var einzelfallNames = [];
            for (var pi = 0; pi < pools.length; pi++) {
                var pp = pools[pi];
                if (pp.count >= grossThreshold) {
                    dataRow(pp.name, pp.count, pct(pp.count, st.bueResults.length));
                } else if (pp.count >= sigThreshold) {
                    dataRow(pp.name, pp.count, pct(pp.count, st.bueResults.length));
                } else {
                    einzelfallSum++;
                    einzelfallNames.push(pp.name);
                }
            }
            if (einzelfallSum > 0) {
                dataRow("Sonstige (je 1 Vorgang)", einzelfallSum, pct(einzelfallSum, st.bueResults.length), false, true);
                for (var ni = 0; ni < einzelfallNames.length; ni++) {
                    aus.Cells(row, 1).Value = "      - " + einzelfallNames[ni];
                    row++;
                }
            }
        } else if (st.totalMaklerVorgang > 0) {
            header("BU-VORGAENGE im Detail", rgb(22, 101, 52));
            dataRow("Keine BU-Vorgaenge gefunden", 0, "");
        }
        row += 2; // zwei Leerzeilen vor naechstem Block
    }

    // GESAMT-Block
    renderBlock("UEBERSICHT GESAMT (alle Postfaecher)", gesamt, rgb(30, 64, 175));

    // Per-Postfach Drilldown
    if (postfaecher.length > 1) {
        for (var pfi = 0; pfi < postfaecher.length; pfi++) {
            var pfEmail = postfaecher[pfi].email;
            var pfResults = byPostfach[pfEmail];
            var pfStats = computeAuswertungStats(pfResults);
            // Nur Postfaecher mit min. 1 echtem Makler-Vorgang anzeigen
            if (pfStats.totalMaklerVorgang === 0) continue;
            renderBlock("POSTFACH: " + pfEmail + " (n=" + pfResults.length + ")", pfStats, rgb(76, 29, 149));
        }
    }

    // Format
    try {
        aus.Columns("A:A").ColumnWidth = 42;
        aus.Columns("B:B").ColumnWidth = 12;
        aus.Columns("C:C").ColumnWidth = 12;
        aus.Cells.Font.Name = "Open Sans";
        aus.Range("B:B").HorizontalAlignment = -4108; // xlCenter
        aus.Range("C:C").HorizontalAlignment = -4108;
    } catch(e) {}

    // Analyse-Sheet als aktives Tab lassen
    try { wb.Sheets("Analyse").Activate(); } catch(e) {}
}

function exportToJson() {
    if (state.results.length === 0) { showError("Keine Ergebnisse zum Exportieren."); return; }
    hideStatus();
    try {
        var shell = new ActiveXObject("WScript.Shell");
        var shellApp = new ActiveXObject("Shell.Application");
        var dl;
        try { dl = shellApp.NameSpace("shell:Downloads").Self.Path; }
        catch(e) { dl = shell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\Downloads"; }
        var now = new Date();
        var ts = now.getFullYear() + "-" + pad(now.getMonth()+1) + "-" + pad(now.getDate()) + "_" + pad(now.getHours()) + "-" + pad(now.getMinutes());
        var path = dl + "\\ergo_vorgang_analyse_" + ts + ".json";
        var json = jsonStringify({ folder: state.folderPath, exportedAt: isoNow(), results: state.results });
        writeTextFile(path, json);
        showSuccess("JSON gespeichert: " + path);
    } catch(e) {
        showError("JSON-Export fehlgeschlagen: " + e.message);
    }
}

function sg(d, k) {
    if (!d) return "";
    var v = d[k];
    if (v === undefined || v === null) return "";
    return String(v);
}

// Excel interpretiert Strings, die mit = + - @ anfangen, als Formel - und
// wirft "';' erwartet" wenn die Syntax kaputt ist (z.B. bei MIME-encoded
// Subjects wie =?utf-8?Q?...?=). Wir prefixen mit Apostroph -> Force-Text.
function cellSafe(v) {
    if (v == null) return "";
    var s = String(v);
    if (s.length === 0) return "";
    var c0 = s.charAt(0);
    if (c0 === "=" || c0 === "+" || c0 === "-" || c0 === "@") {
        return "'" + s;
    }
    return s;
}

// Wie cellSafe, aber strippt zusaetzlich Tab/Newline/CR. Wird beim Bulk-Write
// per VBScript-TSV-Split gebraucht, damit der \t-Separator nicht in einem
// Zell-Wert versehentlich auftaucht.
function cellSafeTsv(v) {
    var s = cellSafe(v);
    if (!s) return "";
    return s.replace(/[\r\n\t]+/g, " ");
}

// ============================================================================
// RENDER TABLE
// ============================================================================
function renderTable() {
    var tbody = document.getElementById("resultsBody");
    var html = "";
    for (var i = 0; i < state.results.length; i++) {
        var r = state.results[i];
        var d = r.data || {};
        var vt = sg(d, "vorgangstyp");
        var vtCls = "col-vt-other";
        if (vt === "Makler-Vorgang") vtCls = "col-vt-makler";
        else if (vt === "Bounce-NDR" || vt === "Ergo-Outbound" || vt === "System-Mail") vtCls = "col-vt-bounce";

        var sCls = "s-ok";
        var sTxt = "OK";
        if (!r.ok) {
            if (r.errMsg && r.errMsg.indexOf("ABGEBROCHEN") >= 0) { sCls = "s-cancel"; sTxt = "Abbruch"; }
            else { sCls = "s-err"; sTxt = "Fehler"; }
        }

        html += '<tr onclick="showDetail(' + i + ')">';
        html += '<td>' + (i+1) + '</td>';
        html += '<td class="col-status ' + sCls + '">' + sTxt + '</td>';
        html += '<td>' + esc(r.msgFile) + '</td>';
        html += '<td class="col-date">' + esc(r.datum) + '</td>';
        html += '<td>' + esc(r.absName || r.absMail) + '</td>';
        html += '<td class="col-betr">' + esc(r.betreff) + '</td>';
        html += '<td class="' + vtCls + '">' + esc(vt) + '</td>';
        html += '<td class="col-klass">' + esc(sg(d, "klassifikation")) + '</td>';
        html += '<td>' + esc(sg(d, "maklerpool")) + '</td>';
        html += '<td>' + esc(((sg(d,"kunde_nachname")||"") + " " + (sg(d,"kunde_vorname")||"")).replace(/^\s+|\s+$/g,"")) + '</td>';
        html += '<td>' + esc(sg(d, "mv_vollumfaenglich")) + '</td>';
        html += '<td>' + esc(r.ok ? sg(d, "hinweis") : r.errMsg) + '</td>';
        html += '</tr>';
    }

    // Plus inflight slots as "running" rows
    for (var k in state.slots) {
        if (!state.slots.hasOwnProperty(k)) continue;
        var s = state.slots[k];
        html += '<tr>';
        html += '<td>...</td>';
        html += '<td class="col-status s-running">laeuft</td>';
        html += '<td>' + esc(getFileName(s.msgPath)) + '</td>';
        html += '<td class="col-date">' + esc(s.datum || "") + '</td>';
        html += '<td>' + esc(s.absName || "") + '</td>';
        html += '<td class="col-betr">' + esc(s.betreff || "") + '</td>';
        html += '<td colspan="6"><em>warte auf ErgoGPT...</em></td>';
        html += '</tr>';
    }

    tbody.innerHTML = html;
    document.getElementById("resultsCount").innerText = state.results.length + " Vorgaenge" + (countSlots() > 0 ? " (+" + countSlots() + " laufen)" : "");
    document.getElementById("resultsTableWrap").style.display = (state.results.length + countSlots() > 0) ? "block" : "none";
    refreshStartButton();
}

function showDetail(idx) {
    var r = state.results[idx];
    if (!r) return;
    document.getElementById("detailTitle").innerText = (r.betreff || "(kein Betreff)");
    var kv = "";
    kv += '<div class="k">Datei</div><div class="v">' + esc(r.msgPath) + '</div>';
    kv += '<div class="k">Datum</div><div class="v">' + esc(r.datum) + '</div>';
    kv += '<div class="k">Absender</div><div class="v">' + esc(r.absName) + " &lt;" + esc(r.absMail) + "&gt;</div>";
    kv += '<div class="k">Anhaenge</div><div class="v">' + esc(r.anhangAlle || "(keine)") + '</div>';
    kv += '<div class="k">PDFs hochgeladen</div><div class="v">' + esc(r.pdfListe || "(keine)") + '</div>';
    kv += '<div class="k">Status</div><div class="v">' + (r.ok ? '<span style="color:#10b981">OK</span>' : '<span style="color:#ef4444">' + esc(r.errMsg) + '</span>') + '</div>';
    if (r.data) {
        var keys = ["vorgangstyp","ist_reminder","klassifikation","klassifikation_grund","maklerpool","makler_nachname","makler_vorname","makler_nummer","kunde_nachname","kunde_vorname","kunde_nummer","versicherungsnummer","geschaefts_typ","unterlagen_angefragt","unterlagen_liste","sonderfall","sparte","anhang_typen","pdf_qualitaet","enthaelt_maklervollmacht","mv_vollumfaenglich","mv_einschraenkungen","unterschrift_kunde","unterschrift_makler","auf_vn_ausgestellt","makler_namentlich_genannt","auftrag_datum","hinweis"];
        for (var i = 0; i < keys.length; i++) {
            var v = r.data[keys[i]];
            if (v) kv += '<div class="k">' + keys[i] + '</div><div class="v">' + esc(v) + '</div>';
        }
    }
    document.getElementById("detailKv").innerHTML = kv;
    document.getElementById("detailRaw").innerText = r.ok ? "" : (r.errMsg || "");
    document.getElementById("detailModal").className = "modal-backdrop active";
}

function closeDetail(ev) {
    if (ev && ev.target && String(ev.target.className).indexOf("modal-backdrop") === -1) return;
    document.getElementById("detailModal").className = "modal-backdrop";
}

// ============================================================================
// HELPERS
// ============================================================================
function saveSettings() {
    try {
        if (!window.localStorage) return;
        var s = {
            model: document.getElementById("modelInput").value,
            parallel: document.getElementById("parallelInput").value,
            lastFolder: state.folderPath
        };
        window.localStorage.setItem("ergo_va_settings", jsonStringify(s));
    } catch(e) {}
}

function getSenderEmail(mailItem) {
    try {
        var typ = mailItem.SenderEmailType;
        if (typ === "EX") {
            try {
                var s = mailItem.Sender;
                if (s) {
                    var eu = s.GetExchangeUser();
                    if (eu && eu.PrimarySmtpAddress) return eu.PrimarySmtpAddress;
                }
            } catch(e) {}
        }
        return mailItem.SenderEmailAddress || "";
    } catch(e) { return ""; }
}

// Sammelt alle To-Empfaenger (olTo=1). Bei Exchange-Empfaengern wird die
// Primary SMTP Address ueber AddressEntry.GetExchangeUser geholt, sonst
// fallback auf Display-Name. DN-Pfade (/o=...) werden weggefiltert.
function getRecipientsTo(mailItem) {
    var out = [];
    try {
        var rc = mailItem.Recipients.Count;
        for (var i = 1; i <= rc; i++) {
            try {
                var rcp = mailItem.Recipients.Item(i);
                if (rcp.Type !== 1) continue; // olTo only
                var name = "";
                var smtp = "";
                try { name = String(rcp.Name || ""); } catch(e) {}
                try {
                    var ae = rcp.AddressEntry;
                    if (ae) {
                        var eu = ae.GetExchangeUser();
                        if (eu && eu.PrimarySmtpAddress) smtp = eu.PrimarySmtpAddress;
                    }
                } catch(e) {}
                if (!smtp) {
                    try { smtp = String(rcp.Address || ""); } catch(e) {}
                    // DN-String unterdruecken
                    if (smtp.charAt(0) === "/") smtp = "";
                }
                var entry = name;
                if (smtp && smtp !== name && smtp.indexOf("@") > 0) {
                    entry = name ? (name + " <" + smtp + ">") : smtp;
                }
                if (entry) out.push(entry);
            } catch(e) {}
        }
    } catch(e) {}
    return out.join("; ");
}

function getEnv(name) {
    try {
        var shell = new ActiveXObject("WScript.Shell");
        return shell.ExpandEnvironmentStrings("%" + name + "%");
    } catch(e) { return ""; }
}

// Vollstaendiger Pfad zur HTA-Datei (inkl. Dateiname)
function getHtaPath() {
    var dir = getHtaDir();
    var name = getHtaFileName();
    if (!dir || !name) return "";
    return dir + "\\" + name;
}

function getHtaFileName() {
    try {
        var href = decodeURIComponent(String(location.href));
        if (href.toLowerCase().substr(0, 5) === "file:") href = href.substr(5);
        href = href.replace(/^\/+/, "").replace(/\//g, "\\");
        var qPos = href.indexOf("?"); if (qPos >= 0) href = href.substr(0, qPos);
        var slash = href.lastIndexOf("\\");
        return slash >= 0 ? href.substr(slash + 1) : href;
    } catch(e) { return ""; }
}

// True, wenn das HTA von einem UNC-Pfad (\\server\share\...) laeuft.
// IE klassifiziert das als Internet-Zone -> ADODB.Stream wird gesperrt.
function isRunningFromUnc() {
    var dir = getHtaDir();
    return dir && dir.substr(0, 2) === "\\\\";
}

// Kopiert HTA + Cookie.txt nach %LOCALAPPDATA%\ergo-vorgang-analyse\,
// ENTFERNT Mark-of-the-Web (sonst bleibt die Kopie weiter in Internet-
// Zone), startet die neue Instanz, schliesst die aktuelle.
function relocateToLocal() {
    var htaDir = getHtaDir();
    var htaPath = getHtaPath();
    if (!htaDir || !htaPath) {
        showError("HTA-Pfad konnte nicht ermittelt werden.");
        return;
    }
    try {
        var shell = new ActiveXObject("WScript.Shell");
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var localBase = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\ergo-vorgang-analyse";
        if (!fso.FolderExists(localBase)) fso.CreateFolder(localBase);

        // Ziel-Dateinamen
        var htaName = getHtaFileName() || "ergo-vorgang-analyse.hta";
        var dstHta = localBase + "\\" + htaName;
        fso.CopyFile(htaPath, dstHta, true);
        unblockFile(dstHta);

        // Cookie.txt mitkopieren + entsperren falls vorhanden
        var srcCookie = htaDir + "\\Cookie.txt";
        var dstCookie = localBase + "\\Cookie.txt";
        if (fso.FileExists(srcCookie)) {
            try { fso.CopyFile(srcCookie, dstCookie, true); } catch(e) {}
            unblockFile(dstCookie);
        }

        // Neue Instanz starten + diese schliessen
        shell.Run('mshta "' + dstHta + '"', 1, false);
        window.setTimeout(function() {
            try { window.close(); } catch(e) {}
        }, 300);
    } catch(e) {
        showError("Verschieben fehlgeschlagen: " + e.message + "\n\nManueller Workaround:\n1. HTA + Cookie.txt nach C:\\ kopieren\n2. Rechtsklick auf die kopierte HTA -> Eigenschaften -> Zulassen-Haken setzen\n3. HTA doppelklicken");
    }
}

// Entfernt MOTW von der laufenden HTA + Cookie.txt + startet neu.
// Fuer den Fall, dass das HTA lokal liegt, aber den Mark-of-the-Web noch
// vom urspruenglichen Download mitschleppt.
function unblockSelfAndRestart() {
    var htaPath = getHtaPath();
    if (!htaPath) { showError("HTA-Pfad nicht ermittelbar."); return; }
    try {
        unblockFile(htaPath);
        if (COOKIE_PATH) unblockFile(COOKIE_PATH);
        var shell = new ActiveXObject("WScript.Shell");
        shell.Run('mshta "' + htaPath + '"', 1, false);
        window.setTimeout(function() { try { window.close(); } catch(e) {} }, 300);
    } catch(e) {
        showError("Entsperren fehlgeschlagen: " + e.message + "\n\nManueller Workaround:\nRechtsklick auf die HTA -> Eigenschaften -> ganz unten 'Zulassen' anklicken -> OK -> HTA neu starten.");
    }
}

// Entfernt das Mark-of-the-Web ('Zone.Identifier'-ADS) von einer Datei.
// Ohne diesen Schritt bleibt eine kopierte/heruntergeladene Datei in der
// Internet-Zone, auch wenn sie auf C:\ liegt - und ADODB.Stream wird
// weiter gesperrt.
function unblockFile(path) {
    if (!path) return;
    // Variante 1: ADS direkt loeschen via FSO (geht bei manchen Rechtekonfigs)
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        fso.DeleteFile(path + ":Zone.Identifier", true);
        return;
    } catch(e1) {}
    // Variante 2: PowerShell Unblock-File (Standard-Weg)
    try {
        var shell = new ActiveXObject("WScript.Shell");
        var ps = 'powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command "Unblock-File -LiteralPath \'' + path + '\'"';
        shell.Run(ps, 0, true); // hidden window, wait for exit
        return;
    } catch(e2) {}
    // Variante 3: cmd-DEL der ADS (legacy)
    try {
        var shell2 = new ActiveXObject("WScript.Shell");
        shell2.Run('cmd.exe /c del "' + path + ':Zone.Identifier" 2>nul', 0, true);
    } catch(e3) {}
}

// Verzeichnis, in dem die HTA-Datei liegt - via location.href parsen.
// Behandelt sowohl lokale Pfade (file:///C:/...) als auch UNC-Pfade
// (file:////server/share/... oder file://server/share/...).
function getHtaDir() {
    try {
        var href = decodeURIComponent(String(location.href));
        if (href.toLowerCase().substr(0, 5) === "file:") {
            href = href.substr(5);
        }
        // Anzahl fuehrender Slashes zaehlen
        var leadSlashes = 0;
        while (leadSlashes < href.length && href.charAt(leadSlashes) === "/") {
            leadSlashes++;
        }
        href = href.substr(leadSlashes);
        // Backslashes statt Slashes
        href = href.replace(/\//g, "\\");
        // Querystring/Hash abschneiden
        var qPos = href.indexOf("?"); if (qPos >= 0) href = href.substr(0, qPos);
        var hPos = href.indexOf("#"); if (hPos >= 0) href = href.substr(0, hPos);
        // UNC-Erkennung:
        //   - 4+ Slashes nach 'file:' (leeres authority, z.B. file:////server/share)
        //   - oder erstes Segment ist kein Laufwerksbuchstabe (X:)
        var firstSeg = href.split("\\")[0];
        var isDriveLetter = /^[a-zA-Z]:$/.test(firstSeg);
        if (leadSlashes >= 4 || !isDriveLetter) {
            href = "\\\\" + href;
        }
        var slash = href.lastIndexOf("\\");
        if (slash < 0) return "";
        return href.substr(0, slash);
    } catch(e) {
        return "";
    }
}

function getFileName(path) {
    if (!path) return "";
    var i = String(path).lastIndexOf("\\");
    return i >= 0 ? path.substr(i+1) : path;
}

// ============================================================================
// DATE RANGE FILTER (v1.21)
// ============================================================================
// Liest Datum aus Dateinamen-Praefix (Muster YYYY-MM-DD oder YYYY-MM-DD_HHMM).
// Wenn kein Datum im Namen erkennbar: Mail wird eingeschlossen (Default-Strict).
function isInDateRange(filePath) {
    if (!state.dateFrom && !state.dateTo) return true;
    var fname = getFileName(filePath);
    var m = fname.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!m) return true; // kein Datum im Namen -> default einschliessen
    var y = parseInt(m[1], 10);
    var mo = parseInt(m[2], 10) - 1;
    var d = parseInt(m[3], 10);
    if (isNaN(y) || isNaN(mo) || isNaN(d)) return true;
    var fileDate = new Date(y, mo, d);
    if (state.dateFrom && fileDate < state.dateFrom) return false;
    if (state.dateTo) {
        // dateTo gilt als end-of-day
        var endOfDay = new Date(state.dateTo.getFullYear(), state.dateTo.getMonth(), state.dateTo.getDate(), 23, 59, 59);
        if (fileDate > endOfDay) return false;
    }
    return true;
}

// Liefert die durch Datum gefilterten msgFiles. Default: state.msgFiles
// (unfiltriert), wenn beide Datum-Felder leer.
function getFilteredMsgFiles() {
    if (!state.dateFrom && !state.dateTo) return state.msgFiles;
    var out = [];
    for (var i = 0; i < state.msgFiles.length; i++) {
        if (isInDateRange(state.msgFiles[i])) out.push(state.msgFiles[i]);
    }
    return out;
}

function setDateRangeQuick(days) {
    var now = new Date();
    var to = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var from = new Date(to.getFullYear(), to.getMonth(), to.getDate() - days + 1);
    document.getElementById("dateFrom").value = isoDateInput(from);
    document.getElementById("dateTo").value = isoDateInput(to);
    onDateChange();
}

function resetDateRange() {
    document.getElementById("dateFrom").value = "";
    document.getElementById("dateTo").value = "";
    onDateChange();
}

function isoDateInput(d) {
    var pad2 = function(n) { return n < 10 ? "0" + n : "" + n; };
    return d.getFullYear() + "-" + pad2(d.getMonth() + 1) + "-" + pad2(d.getDate());
}

// Kurzformat YYMMDD fuer Ordnernamen (spart 4 Zeichen vs ISO YYYY-MM-DD).
// Bei langen UNC-Pfaden + Windows-260-Limit zaehlt jedes Zeichen.
function shortDateForFolder(d) {
    var pad2 = function(n) { return n < 10 ? "0" + n : "" + n; };
    return String(d.getFullYear()).substr(2) + pad2(d.getMonth() + 1) + pad2(d.getDate());
}

// Akzeptiert TT.MM.JJJJ (Deutsch), TT/MM/JJJJ und JJJJ-MM-TT (ISO).
// IE11/HTA-Mode rendert <input type="date"> als normales Textfeld -> User
// kann jedes Format tippen.
function parseDateInput(s) {
    if (!s) return null;
    s = String(s).replace(/^\s+|\s+$/g, "");
    if (!s) return null;
    var m;
    // ISO: 2026-05-15
    m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) {
        var d1 = new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10));
        if (!isNaN(d1.getTime())) return d1;
    }
    // Deutsch: 15.05.2026 oder 1.5.26
    m = s.match(/^(\d{1,2})\.(\d{1,2})\.(\d{2,4})$/);
    if (m) {
        var y = parseInt(m[3], 10);
        if (y < 100) y += 2000;
        var d2 = new Date(y, parseInt(m[2], 10) - 1, parseInt(m[1], 10));
        if (!isNaN(d2.getTime())) return d2;
    }
    // Slash: 15/05/2026
    m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
    if (m) {
        var y2 = parseInt(m[3], 10);
        if (y2 < 100) y2 += 2000;
        var d3 = new Date(y2, parseInt(m[2], 10) - 1, parseInt(m[1], 10));
        if (!isNaN(d3.getTime())) return d3;
    }
    return null;
}

function onDateChange() {
    var fromStr = document.getElementById("dateFrom").value;
    var toStr = document.getElementById("dateTo").value;
    state.dateFrom = parseDateInput(fromStr);
    state.dateTo = parseDateInput(toStr);
    refreshFolderStats();
    refreshDateRangeStatus();
    refreshStartButton();
    saveSettings();
}

function refreshDateRangeStatus() {
    var el = document.getElementById("dateRangeStatus");
    if (!el) return;
    if (!state.dateFrom && !state.dateTo) {
        el.innerText = "Filtert nach Datum im Dateinamen (Muster YYYY-MM-DD_HHMM_...). Aktuell: kein Filter aktiv - alle Mails werden analysiert.";
        return;
    }
    var fStr = state.dateFrom ? isoDateInput(state.dateFrom) : "(offen)";
    var tStr = state.dateTo ? isoDateInput(state.dateTo) : "(offen)";
    var inRange = 0, noDate = 0;
    for (var i = 0; i < state.msgFiles.length; i++) {
        if (isInDateRange(state.msgFiles[i])) inRange++;
        var fn = getFileName(state.msgFiles[i]);
        if (!fn.match(/^(\d{4})-(\d{2})-(\d{2})/)) noDate++;
    }
    var msg = "Zeitraum: " + fStr + " bis " + tStr + " - " + inRange + " von " + state.msgFiles.length + " Mails im Filter.";
    if (noDate > 0) {
        msg += " (" + noDate + " ohne Datum im Dateinamen werden eingeschlossen.)";
    }
    el.innerText = msg;
}

function refreshFolderStats() {
    var el = document.getElementById("folderStats");
    if (!el) return;
    var total = state.msgFiles.length;
    if (total === 0) { el.innerHTML = ""; return; }
    var inRange = (state.dateFrom || state.dateTo) ? getFilteredMsgFiles().length : total;
    var cached = state.results.length;
    var html = '<div class="stat">.msg-Dateien gefunden: <strong>' + total + '</strong></div>';
    if (state.dateFrom || state.dateTo) {
        html += '<div class="stat">Im Zeitraum: <strong>' + inRange + '</strong></div>';
    }
    if (cached > 0) {
        html += '<div class="stat ok">Aus Cache geladen: <strong>' + cached + '</strong></div>';
        var todo = Math.max(0, inRange - cached);
        html += '<div class="stat">Noch zu analysieren: <strong>' + todo + '</strong></div>';
    }
    el.innerHTML = html;
}

function sanitizeFilename(s) {
    if (!s) return "anhang";
    return String(s).replace(/[\\\/:*?"<>|\r\n\t]/g, "_").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, "");
}

function pad(n) { return n < 10 ? "0" + n : "" + n; }
function trim(s) { return s == null ? "" : String(s).replace(/^\s+|\s+$/g, ""); }
function esc(s) {
    if (s == null) return "";
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function jsonEscape(s) {
    return String(s == null ? "" : s)
        .replace(/\\/g, "\\\\")
        .replace(/"/g, '\\"')
        .replace(/\r\n/g, "\\n").replace(/\r/g, "\\n").replace(/\n/g, "\\n")
        .replace(/\t/g, " ");
}

function cleanForJson(s) {
    return jsonEscape(String(s == null ? "" : s));
}

function jsonUnescape(s) {
    // Reverse what extractAssistantFromChunk regex left in - it's still JSON-encoded
    if (!s) return "";
    var r = s;
    r = r.replace(/\\u([0-9a-fA-F]{4})/g, function(_, h) { return String.fromCharCode(parseInt(h, 16)); });
    r = r.replace(/\\"/g, '"');
    r = r.replace(/\\\//g, "/");
    r = r.replace(/\\\\/g, "\\");
    r = r.replace(/\\r/g, "");
    r = r.replace(/\\t/g, "\t");
    return r;
}

function jsonStringify(obj) {
    if (typeof JSON !== "undefined" && JSON.stringify) {
        try { return JSON.stringify(obj, null, 2); } catch(e) {}
    }
    return jsonStringifyFallback(obj);
}

function jsonStringifyFallback(obj) {
    var t = typeof obj;
    if (obj === null) return "null";
    if (t === "string") return '"' + obj.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n").replace(/\r/g, "\\r").replace(/\t/g, "\\t") + '"';
    if (t === "number" || t === "boolean") return String(obj);
    if (t === "undefined") return "null";
    if (Object.prototype.toString.call(obj) === "[object Array]") {
        var parts = [];
        for (var i = 0; i < obj.length; i++) parts.push(jsonStringifyFallback(obj[i]));
        return "[" + parts.join(",") + "]";
    }
    if (t === "object") {
        var parts2 = [];
        for (var k in obj) {
            if (obj.hasOwnProperty(k)) parts2.push('"' + k + '":' + jsonStringifyFallback(obj[k]));
        }
        return "{" + parts2.join(",") + "}";
    }
    return "null";
}

function isoNow() {
    var n = new Date();
    return n.getFullYear() + "-" + pad(n.getMonth()+1) + "-" + pad(n.getDate()) +
           "T" + pad(n.getHours()) + ":" + pad(n.getMinutes()) + ":" + pad(n.getSeconds());
}

function uuid4() {
    var s = "";
    var parts = [8, 4, 4, 4, 12];
    for (var i = 0; i < parts.length; i++) {
        for (var j = 0; j < parts[i]; j++) {
            s += Math.floor(Math.random() * 16).toString(16);
        }
        if (i < parts.length - 1) s += "-";
    }
    return s;
}

// ============================================================================
// STATUS
// ============================================================================
function updateProgress(cur, total, label) {
    var pct = total > 0 ? Math.round((cur / total) * 100) : 0;
    document.getElementById("progressFill").style.width = pct + "%";
    document.getElementById("progressText").innerText =
        pct + "%  -  " + cur + "/" + total + " erledigt" + (label ? "  -  " + label : "");
    forceRepaint();
}

function updateProgressText(t) {
    document.getElementById("progressText").innerText = t;
    forceRepaint();
}

// In HTAs blockiert ein synchroner Aufruf (z.B. WScript.Shell.Run mit
// wait=true fuer PowerShell-Upload) den UI-Thread. Diese Funktion erzwingt
// einen Layout+Paint-Tick, damit zwischendurch der aktuelle Status sichtbar
// wird, bevor der naechste Sync-Call die UI wieder einfriert.
function forceRepaint() {
    try {
        // Layout-Reflow erzwingen
        var dummy = document.body.offsetHeight;
        // window.refresh ist IE-spezifisch, ignorieren wenn nicht da
        if (window.refresh) window.refresh();
    } catch(e) {}
}

// Setzt die aktuelle Phase fuer einen Slot und aktualisiert die Live-Anzeige.
function setSlotPhase(slot, phase) {
    if (!slot) return;
    slot.phase = phase;
    slot.phaseAt = new Date().getTime();
    renderSlotStatus();
}

// Live-Log: Eine Zeile pro abgeschlossener Mail. Haelt nur die letzten 50.
var _aiLogLines = [];
function appendAiLog(kind, msgPath, detail) {
    var name = msgPath ? msgPath.substr(msgPath.lastIndexOf("\\")+1) : "?";
    if (name.length > 70) name = name.substr(0, 67) + "...";
    var now = new Date();
    var hh = pad(now.getHours()), mm = pad(now.getMinutes()), ss = pad(now.getSeconds());
    var marker = (kind === "OK") ? "[OK]   " : "[FEHLER]";
    var line = hh + ":" + mm + ":" + ss + " " + marker + " " + name + (detail ? " - " + detail : "");
    _aiLogLines.push(line);
    if (_aiLogLines.length > 50) _aiLogLines.splice(0, _aiLogLines.length - 50);
    var el = document.getElementById("aiLog");
    if (el) {
        el.innerText = _aiLogLines.join("\n");
        try { el.scrollTop = el.scrollHeight; } catch(eS) {}
    }
}

function clearAiLog() {
    _aiLogLines = [];
    var el = document.getElementById("aiLog");
    if (el) el.innerText = "";
}

function renderSlotStatus() {
    var lines = [];
    var slotIds = [];
    for (var k in state.slots) if (state.slots.hasOwnProperty(k)) slotIds.push(k);
    // Numerisch sortieren (s1, s2, ..., s9, s10 statt lexikal s1, s10, s11, s2)
    slotIds.sort(function(a, b) {
        var na = parseInt(String(a).replace(/^s/, ""), 10) || 0;
        var nb = parseInt(String(b).replace(/^s/, ""), 10) || 0;
        return na - nb;
    });
    for (var i = 0; i < slotIds.length; i++) {
        var s = state.slots[slotIds[i]];
        var age = "";
        if (s.phaseAt) {
            var secs = Math.max(0, Math.round((new Date().getTime() - s.phaseAt) / 1000));
            age = " (" + secs + "s)";
        }
        var fileName = s.msgPath ? s.msgPath.substr(s.msgPath.lastIndexOf("\\")+1) : "";
        // Kappung lange Dateinamen
        if (fileName.length > 60) fileName = fileName.substr(0, 57) + "...";
        lines.push("[" + s.id + "] " + (s.phase || "init") + age + " - " + fileName);
    }
    var el = document.getElementById("slotStatus");
    if (el) el.innerText = lines.join("\n");
    forceRepaint();
}

function showSuccess(m) {
    var e = document.getElementById("successStatus");
    e.style.display = "block";
    document.getElementById("successMsg").innerHTML = m;
    document.getElementById("errorStatus").style.display = "none";
    document.getElementById("infoStatus").style.display = "none";
}
function showError(m) {
    document.getElementById("errorStatus").style.display = "block";
    document.getElementById("errorMsg").innerHTML = m;
    document.getElementById("successStatus").style.display = "none";
    document.getElementById("infoStatus").style.display = "none";
}
function showInfo(m) {
    document.getElementById("infoStatus").style.display = "block";
    document.getElementById("infoMsg").innerHTML = m;
    document.getElementById("successStatus").style.display = "none";
    document.getElementById("errorStatus").style.display = "none";
}
function hideStatus() {
    document.getElementById("successStatus").style.display = "none";
    document.getElementById("errorStatus").style.display = "none";
    document.getElementById("infoStatus").style.display = "none";
}

