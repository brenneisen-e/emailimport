<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="x-ua-compatible" content="ie=edge"/>
    <meta charset="utf-8"/>
    <title>BGAV Extraktion</title>

    <HTA:APPLICATION
        ID="BGAV_Extraktion"
        APPLICATIONNAME="BGAV Extraktion"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="7.0"
        WINDOWSTATE="normal"
    />

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 20px;
            color: #1e293b;
        }
        .container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 760px;
            padding: 32px;
            margin-top: 10px;
        }
        .header {
            text-align: center;
            margin-bottom: 24px;
        }
        .header h1 {
            font-size: 22px;
            color: #1e293b;
            font-weight: 700;
        }
        .header .subtitle {
            color: #64748b;
            font-size: 13px;
            margin-top: 4px;
        }
        .badge {
            display: inline-block;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            margin-top: 6px;
        }

        /* Steps */
        .steps {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 10px;
        }
        .step {
            flex: 1;
            text-align: center;
            padding: 8px 4px;
            border-radius: 8px;
            font-size: 11px;
            color: #94a3b8;
            background: white;
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }
        .step.active {
            color: #f59e0b;
            border-color: #f59e0b;
            background: #fffbeb;
            font-weight: 600;
        }
        .step.completed {
            color: #10b981;
            border-color: #10b981;
            background: #ecfdf5;
        }
        .step-num {
            font-weight: 700;
            font-size: 14px;
            display: block;
        }

        /* Form elements */
        .form-group {
            margin-bottom: 16px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: #374151;
            margin-bottom: 6px;
        }
        select, input[type=text], input[type=number] {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            font-family: inherit;
            transition: border-color 0.2s;
            background: white;
        }
        select:focus, input:focus {
            outline: none;
            border-color: #f59e0b;
        }
        select:disabled, input:disabled {
            background: #f1f5f9;
            color: #94a3b8;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }
        .btn-primary:hover { opacity: 0.9; }
        .btn-primary:disabled {
            background: #cbd5e1;
            cursor: not-allowed;
        }
        .btn-secondary {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }
        .btn-secondary:hover { background: #e2e8f0; }

        /* Progress */
        .progress-container {
            display: none;
            margin: 16px 0;
        }
        .progress-bar {
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #f59e0b, #d97706);
            border-radius: 3px;
            width: 0%;
            transition: width 0.3s;
        }
        .progress-text {
            font-size: 12px;
            color: #64748b;
            margin-top: 6px;
            text-align: center;
        }

        /* Log */
        .log-container {
            background: #1e293b;
            border-radius: 10px;
            padding: 12px 16px;
            margin: 16px 0;
            max-height: 220px;
            overflow-y: auto;
            display: none;
        }
        .log-entry {
            font-family: 'Cascadia Code', 'Consolas', monospace;
            font-size: 11px;
            line-height: 1.6;
            color: #94a3b8;
        }
        .log-entry.info { color: #38bdf8; }
        .log-entry.success { color: #4ade80; }
        .log-entry.warn { color: #fbbf24; }
        .log-entry.error { color: #f87171; }

        /* Status messages */
        .status-box {
            padding: 14px 16px;
            border-radius: 10px;
            margin: 12px 0;
            font-size: 13px;
            display: none;
        }
        .status-success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
        }
        .status-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }
        .status-info {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
        }

        /* Results table */
        .results-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            margin-top: 12px;
        }
        .results-table th {
            background: #f8fafc;
            padding: 8px 10px;
            text-align: left;
            font-weight: 600;
            color: #374151;
            border-bottom: 2px solid #e2e8f0;
        }
        .results-table td {
            padding: 6px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
        }
        .results-table tr:hover td { background: #f8fafc; }

        .file-path {
            font-family: 'Consolas', monospace;
            font-size: 11px;
            color: #64748b;
            word-break: break-all;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
            margin: 20px 0 10px 0;
            padding-bottom: 6px;
            border-bottom: 2px solid #f59e0b;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>BGAV Extraktion</h1>
            <div class="subtitle">EML-Dateien verarbeiten: BD-Zuordnung, Umbenennung + PDF-Erstellung</div>
            <div class="badge">EML-Verarbeitung | Excel-Zuordnung | PDF-Export</div>
        </div>

        <!-- Steps -->
        <div class="steps">
            <div class="step active" id="step1">
                <span class="step-num">1</span>
                Einstellungen
            </div>
            <div class="step" id="step2">
                <span class="step-num">2</span>
                Excel
            </div>
            <div class="step" id="step3">
                <span class="step-num">3</span>
                Verarbeitung
            </div>
            <div class="step" id="step4">
                <span class="step-num">4</span>
                Ergebnis
            </div>
        </div>

        <!-- Step 1: Einstellungen -->
        <div id="panelStep1">
            <div class="section-title">1. Ordner und Dateien</div>

            <div class="form-group">
                <label>Mail-Ordner (Quell-Ordner mit .msg oder .eml Dateien)</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="emlFolderPath" placeholder="Ordner mit Mail-Dateien (.msg/.eml)..." style="flex:1;"/>
                    <button class="btn btn-secondary" onclick="browseFolder('emlFolderPath')">Durchsuchen...</button>
                </div>
            </div>

            <div class="form-group">
                <label>Excel-Datei (Mappe1.xlsx)</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="excelPath" placeholder="Pfad zur Excel-Datei..." style="flex:1;"/>
                    <button class="btn btn-secondary" onclick="browseExcel()">Durchsuchen...</button>
                </div>
            </div>

            <div class="form-group">
                <label>Ausgabe-Ordner (fuer umbenannte EML + PDF)</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="outputPath" placeholder="Ausgabe-Ordner..." style="flex:1;"/>
                    <button class="btn btn-secondary" onclick="browseFolder('outputPath')">Durchsuchen...</button>
                </div>
            </div>

            <div style="margin-top: 16px; text-align: center;">
                <button class="btn btn-primary" id="btnStart" onclick="startProcessing()">
                    &#9654; Verarbeitung starten
                </button>
            </div>
        </div>

        <!-- Progress -->
        <div class="progress-container" id="progressContainer">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <div class="progress-text" id="progressText"></div>
        </div>

        <!-- Log -->
        <div class="log-container" id="logContainer"></div>

        <!-- Status Messages -->
        <div class="status-box status-error" id="errorStatus"></div>
        <div class="status-box status-success" id="successStatus"></div>
        <div class="status-box status-info" id="infoStatus"></div>

        <!-- Results (Step 4) -->
        <div id="panelResults" style="display:none;">
            <div class="section-title">Ergebnis - Zugeordnete Dateien</div>
            <div id="resultsSummary"></div>
            <table class="results-table" id="resultsTable">
                <thead>
                    <tr>
                        <th>Nr</th>
                        <th>Empfaenger</th>
                        <th>BD-Nummer</th>
                        <th>Neuer Dateiname</th>
                    </tr>
                </thead>
                <tbody id="resultsBody"></tbody>
            </table>

            <div id="unmappedSection" style="display:none; margin-top:20px;">
                <div class="section-title" style="border-color:#f87171;">Nicht zugeordnete Dateien (bleiben im Quell-Ordner)</div>
                <table class="results-table" id="unmappedTable">
                    <thead>
                        <tr>
                            <th>Dateiname</th>
                            <th>Empfaenger (aus Mail)</th>
                            <th>Grund</th>
                        </tr>
                    </thead>
                    <tbody id="unmappedBody"></tbody>
                </table>
            </div>

            <div style="margin-top: 16px; text-align: center;">
                <button class="btn btn-secondary" onclick="openFolder(document.getElementById('outputPath').value)">&#128193; Ausgabe-Ordner oeffnen</button>
                <button class="btn btn-secondary" onclick="openFolder(document.getElementById('emlFolderPath').value)">&#128193; Quell-Ordner oeffnen</button>
                <button class="btn btn-secondary" onclick="resetTool()">&#8635; Neuer Durchlauf</button>
            </div>
        </div>
    </div>

    <script type="text/javascript">
    // ══════════════════════════════════════════════════════════════
    // Globale Variablen
    // ══════════════════════════════════════════════════════════════
    var excelLookup = {};
    var processedFiles = [];  // erfolgreich zugeordnete Dateien
    var unmappedFiles = [];   // nicht zugeordnete Dateien
    var outlookApp = null;    // Outlook-Instanz (fuer .msg Dateien)

    // Word/Outlook-Konstanten
    var wdFormatPDF = 17;
    var olMHTML = 10;
    var olHTML = 5;

    // ══════════════════════════════════════════════════════════════
    // Initialisierung
    // ══════════════════════════════════════════════════════════════
    window.onload = function () {
        try {
            window.resizeTo(800, 820);
        } catch (e) {}

        setDefaultPaths();
    };

    function setDefaultPaths() {
        document.getElementById('outputPath').value = "\\\\cifs\\shellfolder\\243898\\Desktop_2016\\Neuer Ordner (5)";
        document.getElementById('emlFolderPath').value = "\\\\cifs\\shellfolder\\243898\\Desktop_2016\\Neuer Ordner (5)\\Neuer Ordner";

        // Versuche Excel-Datei automatisch zu finden
        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var htaDir = getScriptDir();

            var excelNames = [
                "Mappe1.xlsx",
                "Mappe1.xls",
                "\u00DCbersicht_Titel\u00E4nderung.xlsx",
                "Uebersicht_Titelaenderung.xlsx"
            ];

            var found = false;
            for (var ei = 0; ei < excelNames.length; ei++) {
                var excelCandidate = htaDir + excelNames[ei];
                if (fso.FileExists(excelCandidate)) {
                    document.getElementById('excelPath').value = excelCandidate;
                    found = true;
                    break;
                }
            }

            if (!found && fso.FolderExists(htaDir)) {
                var htaFolder = fso.GetFolder(htaDir);
                var htaFiles = new Enumerator(htaFolder.Files);
                for (; !htaFiles.atEnd(); htaFiles.moveNext()) {
                    var htaFile = htaFiles.item();
                    if (htaFile.Name.match(/mappe/i) && htaFile.Name.match(/\.xlsx?$/i)) {
                        document.getElementById('excelPath').value = htaFile.Path;
                        break;
                    }
                }
            }
        } catch (e) {}
    }

    function getScriptDir() {
        try {
            var path = document.location.pathname;
            path = unescape(path);
            if (path.charAt(0) === '/') path = path.substring(1);
            path = path.replace(/\//g, '\\');
            var lastSlash = path.lastIndexOf('\\');
            if (lastSlash > -1) return path.substring(0, lastSlash + 1);
            return '';
        } catch (e) { return ''; }
    }

    // ══════════════════════════════════════════════════════════════
    // Datei-Dialoge
    // ══════════════════════════════════════════════════════════════
    function browseFolder(inputId) {
        try {
            var shellApp = new ActiveXObject("Shell.Application");
            var folder = shellApp.BrowseForFolder(0, "Ordner waehlen", 0x0040, 17);
            if (folder) {
                document.getElementById(inputId).value = folder.Self.Path;
            }
        } catch (e) {
            logWarn("Dialog-Fehler: " + e.message);
        }
    }

    function browseExcel() {
        try {
            var shellApp = new ActiveXObject("Shell.Application");
            var file = shellApp.BrowseForFolder(0,
                "Excel-Datei auswaehlen (Ordner der Datei waehlen)", 0x0040, 17);
            if (file) {
                var folderPath = file.Self.Path;
                var fso = new ActiveXObject("Scripting.FileSystemObject");

                var folder = fso.GetFolder(folderPath);
                var files = folder.Files;
                var enumFiles = new Enumerator(files);
                for (; !enumFiles.atEnd(); enumFiles.moveNext()) {
                    var f = enumFiles.item();
                    if (f.Name.toLowerCase().indexOf('mappe') > -1 ||
                        f.Name.toLowerCase().indexOf('mappe1') > -1) {
                        document.getElementById('excelPath').value = f.Path;
                        logInfo("Excel-Datei gefunden: " + f.Name);
                        return;
                    }
                }
                enumFiles = new Enumerator(files);
                for (; !enumFiles.atEnd(); enumFiles.moveNext()) {
                    var f2 = enumFiles.item();
                    if (f2.Name.match(/\.xlsx?$/i)) {
                        document.getElementById('excelPath').value = f2.Path;
                        logInfo("Excel-Datei: " + f2.Name);
                        return;
                    }
                }
                document.getElementById('excelPath').value = folderPath;
            }
        } catch (e) {
            logWarn("Dialog-Fehler: " + e.message);
        }
    }

    function openFolder(path) {
        try {
            var shell = new ActiveXObject("WScript.Shell");
            shell.Run('explorer.exe "' + path + '"');
        } catch (e) {}
    }

    // ══════════════════════════════════════════════════════════════
    // Mail-Datei lesen (.msg via Outlook, .eml via Header-Parsing)
    // ══════════════════════════════════════════════════════════════

    // Outlook-Instanz initialisieren (nur einmal, fuer .msg Dateien)
    function ensureOutlook() {
        if (!outlookApp) {
            outlookApp = new ActiveXObject("Outlook.Application");
        }
        return outlookApp;
    }

    // MSG-Datei via Outlook oeffnen und Infos extrahieren
    function readMsgFile(msgPath) {
        var result = { toEmails: [], subject: '', date: '', conversationId: '' };
        try {
            var app = ensureOutlook();
            var mailItem = app.Session.OpenSharedItem(msgPath);

            result.subject = mailItem.Subject || '';

            // Empfaenger-Adressen extrahieren
            try {
                var recipients = mailItem.Recipients;
                for (var r = 1; r <= recipients.Count; r++) {
                    try {
                        var rcpt = recipients.Item(r);
                        if (rcpt.Type === 1) { // olTo
                            var addr = '';
                            // Versuche SMTP-Adresse zu bekommen
                            try {
                                addr = rcpt.Address || '';
                                if (addr.indexOf('@') === -1) {
                                    // Exchange-Adresse -> SMTP auflösen
                                    try {
                                        var addrEntry = rcpt.AddressEntry;
                                        if (addrEntry) {
                                            try {
                                                var exchUser = addrEntry.GetExchangeUser();
                                                if (exchUser && exchUser.PrimarySmtpAddress) {
                                                    addr = exchUser.PrimarySmtpAddress;
                                                }
                                            } catch (e1) {}
                                            if (addr.indexOf('@') === -1) {
                                                try {
                                                    var PR_SMTP = "http://schemas.microsoft.com/mapi/proptag/0x39FE001E";
                                                    var smtpAddr = addrEntry.PropertyAccessor.GetProperty(PR_SMTP);
                                                    if (smtpAddr) addr = smtpAddr;
                                                } catch (e2) {}
                                            }
                                        }
                                    } catch (e3) {}
                                }
                            } catch (e4) {
                                addr = rcpt.Name || '';
                            }
                            if (addr) result.toEmails.push(addr.toLowerCase());
                        }
                    } catch (rcptErr) {}
                }
            } catch (rcptsErr) {}

            try { result.date = mailItem.SentOn || ''; } catch (de) {}

            // ConversationIndex extrahieren (erste 44 Hex-Zeichen = Conversation Header)
            try {
                var convIdx = mailItem.ConversationIndex || '';
                if (convIdx.length >= 44) {
                    result.conversationId = convIdx.substring(0, 44);
                } else if (convIdx.length > 0) {
                    result.conversationId = convIdx;
                }
            } catch (convErr) {}
            // Fallback: ConversationTopic + Empfaenger als ID
            if (!result.conversationId) {
                try {
                    var topic = mailItem.ConversationTopic || mailItem.Subject || '';
                    result.conversationId = 'topic:' + topic + '|' + (result.toEmails.length > 0 ? result.toEmails[0] : '');
                } catch (topicErr) {}
            }

            mailItem.Close(0); // olDiscard
        } catch (e) {
            logWarn("MSG nicht lesbar: " + msgPath.replace(/.*\\/, '') + " (" + e.message + ")");
        }
        return result;
    }

    // EML-Datei: Header parsen (Textformat)
    function readEmlFile(emlPath) {
        var result = { toEmails: [], subject: '', date: '', conversationId: '' };
        var headers = {};
        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var file = fso.OpenTextFile(emlPath, 1, false, 0);
            var currentKey = '';
            var currentVal = '';
            var lineCount = 0;

            while (!file.AtEndOfStream && lineCount < 200) {
                var line = file.ReadLine();
                lineCount++;

                if (line.replace(/\s/g, '') === '') break;

                if (/^\s/.test(line)) {
                    currentVal += ' ' + line.replace(/^\s+/, '');
                } else {
                    if (currentKey) headers[currentKey] = currentVal;
                    var colonPos = line.indexOf(':');
                    if (colonPos > 0) {
                        currentKey = line.substring(0, colonPos).toLowerCase();
                        currentVal = line.substring(colonPos + 1).replace(/^\s+/, '');
                    }
                }
            }
            if (currentKey) headers[currentKey] = currentVal;
            file.Close();
        } catch (e) {}

        result.toEmails = extractEmailAddresses(headers['to'] || '');
        result.subject = headers['subject'] || '';
        result.date = headers['date'] || '';
        // EML: Thread-Index Header oder Fallback
        if (headers['thread-index']) {
            var ti = headers['thread-index'].replace(/\s/g, '');
            result.conversationId = ti.length >= 44 ? ti.substring(0, 44) : ti;
        } else {
            // Fallback: Subject ohne AW/WG/RE/FW + Empfaenger
            var cleanSubj = (headers['subject'] || '').replace(/^(AW|WG|RE|FW|Fwd):\s*/gi, '');
            result.conversationId = 'topic:' + cleanSubj + '|' + (result.toEmails.length > 0 ? result.toEmails[0] : '');
        }
        return result;
    }

    // Mail-Datei lesen (automatisch MSG oder EML)
    function readMailFile(filePath) {
        if (filePath.match(/\.msg$/i)) {
            return readMsgFile(filePath);
        } else {
            return readEmlFile(filePath);
        }
    }

    function extractEmailAddresses(headerValue) {
        var emails = [];
        if (!headerValue) return emails;

        var re = /[\w.\-+]+@[\w.\-]+\.\w+/gi;
        var match;
        while ((match = re.exec(headerValue)) !== null) {
            emails.push(match[0].toLowerCase());
        }
        return emails;
    }

    // ══════════════════════════════════════════════════════════════
    // Async-Helfer
    // ══════════════════════════════════════════════════════════════
    function asyncStep(fn, nextFn) {
        try {
            fn();
        } catch (ex) {
            showError("Unerwarteter Fehler: " + ex.message);
            logError("FEHLER: " + ex.message);
            resetButtons();
            return;
        }
        if (nextFn) {
            setTimeout(nextFn, 50);
        }
    }

    function asyncLoop(params) {
        var i = params.start;
        var step = params.step || 1;
        var chunkSize = params.chunkSize || 10;

        function doChunk() {
            try {
                var count = 0;
                while (i <= params.end && count < chunkSize) {
                    params.body(i);
                    i += step;
                    count++;
                }
                if (i <= params.end) {
                    setTimeout(doChunk, 30);
                } else {
                    if (params.onDone) params.onDone();
                }
            } catch (ex) {
                showError("Unerwarteter Fehler: " + ex.message);
                logError("FEHLER: " + ex.message);
                resetButtons();
            }
        }

        doChunk();
    }

    // ══════════════════════════════════════════════════════════════
    // Haupt-Verarbeitung
    // ══════════════════════════════════════════════════════════════
    function startProcessing() {
        var emlFolder = document.getElementById('emlFolderPath').value;
        var outputBase = document.getElementById('outputPath').value;

        if (!emlFolder) {
            showError("Bitte EML-Ordner angeben!");
            return;
        }
        if (!outputBase) {
            showError("Bitte Ausgabe-Ordner angeben!");
            return;
        }

        hideAllStatus();
        document.getElementById('panelResults').style.display = 'none';
        document.getElementById('progressContainer').style.display = 'block';
        document.getElementById('logContainer').style.display = 'block';
        document.getElementById('btnStart').disabled = true;

        processedFiles = [];
        unmappedFiles = [];

        setStepActive('step1');
        setTimeout(function() { doExtraction(); }, 100);
    }

    function doExtraction() {
        var ctx = {
            emlFolder: document.getElementById('emlFolderPath').value,
            excelPath: document.getElementById('excelPath').value,
            outputBase: document.getElementById('outputPath').value,
            fso: null,
            emlDir: '',
            pdfDir: '',
            mailFiles: [],  // Array von {path, name, type:'msg'|'eml'}
            startNr: 0,
            wordApp: null,
            wordAvailable: false,
            csvRows: 0
        };

        // ── Schritt 1: Ordner pruefen/erstellen ──
        asyncStep(function() {
            setProgress(5, 'Pruefe Ordner...');
            ctx.fso = new ActiveXObject("Scripting.FileSystemObject");

            if (!ctx.fso.FolderExists(ctx.emlFolder)) {
                throw new Error("EML-Ordner nicht gefunden: " + ctx.emlFolder);
            }

            ctx.emlDir = ctx.outputBase + "\\eml";
            ctx.pdfDir = ctx.outputBase + "\\pdf";

            if (!ctx.fso.FolderExists(ctx.outputBase)) ctx.fso.CreateFolder(ctx.outputBase);
            if (!ctx.fso.FolderExists(ctx.emlDir)) ctx.fso.CreateFolder(ctx.emlDir);
            if (!ctx.fso.FolderExists(ctx.pdfDir)) ctx.fso.CreateFolder(ctx.pdfDir);

            logInfo("EML-Ordner: " + ctx.emlFolder);
            logInfo("Ausgabe-Ordner: " + ctx.outputBase);
            setStepCompleted('step1');
        }, function() {

        // ── Schritt 2: Excel laden ──
        asyncStep(function() {
            setStepActive('step2');
            setProgress(10, 'Lade Excel-Metadaten...');
            excelLookup = {};

            if (ctx.excelPath && ctx.fso.FileExists(ctx.excelPath)) {
                excelLookup = loadExcelMetadata(ctx.excelPath);
                logSuccess(countKeys(excelLookup) + " Eintraege aus Excel geladen");
            } else {
                logWarn("Keine Excel-Datei angegeben oder nicht gefunden. Zuordnung nicht moeglich.");
            }
            setStepCompleted('step2');
        }, function() {

        // ── Schritt 3: EML-Dateien scannen ──
        asyncStep(function() {
            setStepActive('step3');
            setProgress(15, 'Scanne Mail-Ordner...');

            var folder = ctx.fso.GetFolder(ctx.emlFolder);
            var files = new Enumerator(folder.Files);
            var msgCount = 0;
            var emlCount = 0;
            for (; !files.atEnd(); files.moveNext()) {
                var f = files.item();
                if (f.Name.match(/\.msg$/i)) {
                    ctx.mailFiles.push({ path: f.Path, name: f.Name, type: 'msg' });
                    msgCount++;
                } else if (f.Name.match(/\.eml$/i)) {
                    ctx.mailFiles.push({ path: f.Path, name: f.Name, type: 'eml' });
                    emlCount++;
                }
            }

            if (ctx.mailFiles.length === 0) {
                throw new Error("Keine .msg oder .eml Dateien im Ordner gefunden: " + ctx.emlFolder);
            }

            var typeInfo = [];
            if (msgCount > 0) typeInfo.push(msgCount + " MSG");
            if (emlCount > 0) typeInfo.push(emlCount + " EML");
            logInfo(ctx.mailFiles.length + " Mail-Dateien gefunden (" + typeInfo.join(", ") + ")");

            if (msgCount > 0) {
                logInfo("MSG-Dateien erkannt - initialisiere Outlook zum Lesen...");
                try {
                    ensureOutlook();
                    logSuccess("Outlook verbunden");
                } catch (olErr) {
                    throw new Error("Outlook wird zum Lesen von MSG-Dateien benoetigt, konnte aber nicht gestartet werden: " + olErr.message);
                }
            }

            // Hoechste bestehende Nummer in Ausgabe ermitteln (fuer Fortsetzung)
            if (ctx.fso.FolderExists(ctx.emlDir)) {
                var existing = new Enumerator(ctx.fso.GetFolder(ctx.emlDir).Files);
                for (; !existing.atEnd(); existing.moveNext()) {
                    var exName = existing.item().Name;
                    var exMatch = exName.match(/_(\d+)\.(eml|msg)$/i);
                    if (exMatch) {
                        var n = parseInt(exMatch[1]);
                        if (n > ctx.startNr) ctx.startNr = n;
                    }
                }
                if (ctx.startNr > 0) {
                    logInfo("Fortsetze ab Nr. " + (ctx.startNr + 1) + " (bestehende Dateien im Ausgabe-Ordner)");
                }
            }

            setProgress(20, 'Verarbeite ' + ctx.mailFiles.length + ' Mail-Dateien...');
        }, function() {

        // ── Schritt 3a: Mails scannen und BD-Zuordnung erstellen ──
        var scanResults = [];   // {index, mailFile, bdNr, matchedEmail, subject, date, toEmails, conversationId}
        var convGroups = {};    // conversationId -> [scanResult, ...]
        var duplicateCount = 0;

        asyncLoop({
            start: 0,
            end: ctx.mailFiles.length - 1,
            step: 1,
            chunkSize: 5,
            body: function(i) {
              try {
                var mailFile = ctx.mailFiles[i];
                var mailInfo = readMailFile(mailFile.path);
                var toEmails = mailInfo.toEmails;
                var subject = mailInfo.subject;
                var date = mailInfo.date || '';

                // BD-Nummer suchen
                var bdNr = '';
                var matchedEmail = '';
                for (var e = 0; e < toEmails.length; e++) {
                    var meta = excelLookup[toEmails[e]];
                    if (meta && meta.bd_nummer) {
                        bdNr = meta.bd_nummer;
                        matchedEmail = toEmails[e];
                        break;
                    }
                }

                if (bdNr) {
                    var convId = mailInfo.conversationId || ('noconv:' + mailFile.name);
                    var entry = {
                        index: i,
                        mailFile: mailFile,
                        bdNr: bdNr,
                        matchedEmail: matchedEmail,
                        subject: subject,
                        date: date,
                        toEmails: toEmails,
                        conversationId: convId
                    };
                    scanResults.push(entry);

                    if (!convGroups[convId]) {
                        convGroups[convId] = [];
                    }
                    convGroups[convId].push(entry);
                } else {
                    var reason = '';
                    if (toEmails.length === 0) {
                        reason = 'Kein Empfaenger in Mail gefunden';
                    } else if (countKeys(excelLookup) === 0) {
                        reason = 'Keine Excel-Datei geladen';
                    } else {
                        reason = 'Empfaenger nicht in Excel gefunden';
                    }

                    unmappedFiles.push({
                        name: mailFile.name,
                        path: mailFile.path,
                        toEmails: toEmails,
                        reason: reason
                    });

                    logWarn("[---] " + mailFile.name + " -> NICHT ZUGEORDNET (" + reason +
                        (toEmails.length > 0 ? ", An: " + toEmails.join(", ") : "") + ")");
                }
              } catch (fileErr) {
                logError("Scan-Fehler bei " + (ctx.mailFiles[i] ? ctx.mailFiles[i].name : "Datei " + i) + ": " + fileErr.message);
                unmappedFiles.push({
                    name: ctx.mailFiles[i] ? ctx.mailFiles[i].name : "Datei " + i,
                    path: ctx.mailFiles[i] ? ctx.mailFiles[i].path : '',
                    toEmails: [],
                    reason: 'Fehler: ' + fileErr.message
                });
              }

                var pct = 20 + Math.round(((i + 1) / ctx.mailFiles.length) * 15);
                setProgress(pct, 'Scanne ' + (i + 1) + ' von ' + ctx.mailFiles.length + ' Mail-Dateien...');
            },
            onDone: function() {

            // ── Schritt 3b: Duplikate filtern - pro ConversationIndex nur neueste Mail behalten ──
            var filesToProcess = [];
            var convKeys = [];
            for (var k in convGroups) {
                if (convGroups.hasOwnProperty(k)) convKeys.push(k);
            }

            for (var c = 0; c < convKeys.length; c++) {
                var group = convGroups[convKeys[c]];
                if (group.length === 1) {
                    filesToProcess.push(group[0]);
                } else {
                    // Mehrere Mails im selben Thread: neueste behalten, BD von erster nehmen
                    // Sortiere nach Datum (aufsteigend) - aelteste zuerst
                    group.sort(function(a, b) {
                        var dateA = a.date ? new Date(a.date).getTime() : 0;
                        var dateB = b.date ? new Date(b.date).getTime() : 0;
                        if (isNaN(dateA)) dateA = 0;
                        if (isNaN(dateB)) dateB = 0;
                        return dateA - dateB;
                    });

                    // BD-Mapping von der aeltesten (ersten) Mail im Thread nehmen
                    var firstEntry = group[0];
                    var bdFromFirst = firstEntry.bdNr;
                    var emailFromFirst = firstEntry.matchedEmail;

                    // Neueste Mail (letzte im sortierten Array) behalten
                    var newest = group[group.length - 1];
                    // BD-Mapping von erster Mail uebernehmen
                    newest.bdNr = bdFromFirst;
                    newest.matchedEmail = emailFromFirst;
                    filesToProcess.push(newest);

                    // Rest als Duplikat loggen
                    for (var d = 0; d < group.length; d++) {
                        if (d === group.length - 1) continue; // neueste ueberspringen
                        duplicateCount++;
                        unmappedFiles.push({
                            name: group[d].mailFile.name,
                            path: group[d].mailFile.path,
                            toEmails: group[d].toEmails,
                            reason: 'Duplikat (Thread, BD ' + bdFromFirst + ', behalte neuere: ' + newest.mailFile.name + ')'
                        });
                        logWarn("[DUP] " + group[d].mailFile.name + " -> DUPLIKAT im Thread (BD " + bdFromFirst + ", behalte neuere: " + newest.mailFile.name + ")");
                    }
                }
            }

            logInfo("--- Scan abgeschlossen: " + scanResults.length + " zugeordnet, davon " + duplicateCount + " Duplikate entfernt -> " + filesToProcess.length + " eindeutige Threads ---");

        // ── Schritt 3c: Eindeutige Dateien kopieren/verschieben ──
        asyncLoop({
            start: 0,
            end: filesToProcess.length - 1,
            step: 1,
            chunkSize: 5,
            body: function(i) {
              try {
                var entry = filesToProcess[i];
                var mailFile = entry.mailFile;
                var bdNr = entry.bdNr;
                var matchedEmail = entry.matchedEmail;
                var subject = entry.subject;

                var fileNr = ctx.startNr + processedFiles.length + 1;
                var nr = padNumber(fileNr, 3);
                var newName = bdNr + "_BGAV_Titelbezeichnung_" + nr;
                var newMsgPath = ctx.emlDir + "\\" + newName + ".msg";
                var newEmlPath = ctx.emlDir + "\\" + newName + ".eml";

                var destPath;
                var ext = mailFile.type === 'msg' ? '.msg' : '.eml';
                var targetPath = (mailFile.type === 'msg') ? newMsgPath : newEmlPath;

                try {
                    ctx.fso.MoveFile(mailFile.path, targetPath);
                } catch (moveErr) {
                    try {
                        ctx.fso.CopyFile(mailFile.path, targetPath, true);
                        try { ctx.fso.DeleteFile(mailFile.path, true); } catch (delErr) {
                            logWarn("[" + nr + "] Quelle konnte nicht geloescht werden: " + mailFile.name);
                        }
                    } catch (copyErr) {
                        logError("[" + nr + "] Datei konnte nicht verschoben werden: " + mailFile.name + " (" + copyErr.message + ")");
                        unmappedFiles.push({
                            name: mailFile.name,
                            path: mailFile.path,
                            toEmails: entry.toEmails,
                            reason: 'Dateizugriff verweigert: ' + copyErr.message
                        });
                        return;
                    }
                }
                destPath = targetPath;

                processedFiles.push({
                    fileNr: fileNr,
                    nr: nr,
                    baseName: newName,
                    bdNummer: bdNr,
                    email: matchedEmail,
                    filePath: destPath,
                    fileType: mailFile.type,
                    pdfPath: ctx.pdfDir + "\\" + newName + ".pdf",
                    originalName: mailFile.name,
                    subject: subject
                });

                logSuccess("[" + nr + "] " + mailFile.name + " -> " + newName + ext + " (BD: " + bdNr + ", An: " + matchedEmail + ")");
              } catch (fileErr) {
                logError("Fehler bei " + (filesToProcess[i] ? filesToProcess[i].mailFile.name : "Datei " + i) + ": " + fileErr.message);
              }

                var pct = 35 + Math.round(((i + 1) / filesToProcess.length) * 15);
                setProgress(pct, 'Kopiere ' + (i + 1) + ' von ' + filesToProcess.length + ' Dateien...');
            },
            onDone: function() {

            logInfo("--- Ergebnis: " + processedFiles.length + " zugeordnet, " + unmappedFiles.length + " nicht zugeordnet (davon " + duplicateCount + " Duplikate) ---");

            // Nicht zugeordnete Dateien + Duplikate in separate Ordner kopieren
            var unmappedDir = ctx.outputBase + "\\nicht_zugeordnet";
            var duplicateDir = ctx.outputBase + "\\duplikate_old";
            var unmappedCopied = 0;
            var dupCopied = 0;

            for (var u = 0; u < unmappedFiles.length; u++) {
                var uf = unmappedFiles[u];
                if (!uf.path || !ctx.fso.FileExists(uf.path)) continue;

                var isDuplicate = (uf.reason && uf.reason.indexOf('Duplikat') === 0);
                var targetDir = isDuplicate ? duplicateDir : unmappedDir;

                if (!ctx.fso.FolderExists(targetDir)) ctx.fso.CreateFolder(targetDir);

                try {
                    ctx.fso.CopyFile(uf.path, targetDir + "\\" + uf.name, false);
                    if (isDuplicate) { dupCopied++; } else { unmappedCopied++; }
                } catch (ucErr) {}
            }

            if (unmappedCopied > 0) {
                logInfo(unmappedCopied + " nicht zugeordnete Dateien -> " + unmappedDir);
            }
            if (dupCopied > 0) {
                logInfo(dupCopied + " Duplikate (aeltere Thread-Mails) -> " + duplicateDir);
            }

            if (processedFiles.length === 0) {
                showError("Keine EML-Dateien konnten zugeordnet werden. " +
                    unmappedFiles.length + " Dateien bleiben im Quell-Ordner.");
                showResults();
                saveLogToFile(ctx.outputBase);
                resetButtons();
                return;
            }

        // ── Schritt 4: PDF erstellen ──
        asyncStep(function() {
            setProgress(55, 'Erstelle PDF-Dateien...');
            logInfo("--- PDF Export ---");

            try {
                ctx.wordApp = new ActiveXObject("Word.Application");
                ctx.wordApp.Visible = false;
                ctx.wordAvailable = true;
                logInfo("Word gefunden - erstelle PDF via Word");
            } catch (wordInitErr) {
                logWarn("Word nicht verfuegbar (" + wordInitErr.message + "). PDF-Erstellung uebersprungen.");
            }
        }, function() {

        if (!ctx.wordAvailable) {
            // Kein Word -> PDFs ueberspringen
            logWarn("PDF-Erstellung uebersprungen (Word nicht verfuegbar)");

        // ── Schritt 5: CSV erzeugen (ohne PDF) ──
        asyncStep(function() {
            finishExtraction(ctx);
        }, function() {}); // Ende
            return;
        }

        asyncLoop({
            start: 0,
            end: processedFiles.length - 1,
            step: 1,
            chunkSize: 3,
            body: function(p) {
                try {
                    var pf = processedFiles[p];
                    if (pf.fileType === 'msg') {
                        createPdfFromMsg(pf.filePath, pf.pdfPath, ctx.wordApp);
                    } else {
                        createPdfFromEml(pf.filePath, pf.pdfPath, ctx.wordApp);
                    }
                    logSuccess("  PDF: " + pf.baseName + ".pdf");
                } catch (pdfErr) {
                    logError("  PDF-Fehler " + processedFiles[p].nr + ": " + pdfErr.message);
                }

                setProgress(55 + Math.round(((p + 1) / processedFiles.length) * 30),
                    'PDF ' + (p + 1) + '/' + processedFiles.length);
            },
            onDone: function() {

            // Word schliessen
            if (ctx.wordApp) {
                try { ctx.wordApp.Quit(0); } catch (qe) {}
                ctx.wordApp = null;
            }

        // ── Schritt 5: CSV + Ergebnis ──
        asyncStep(function() {
            finishExtraction(ctx);
        }, function() {}); // Ende

        }}); // Ende asyncLoop PDF
        }); // Ende asyncStep Word-Init
        }}); // Ende asyncLoop Dateien-Kopieren (3c)
        }}); // Ende asyncLoop Scan (3a)
        }); // Ende asyncStep EML-Scan
        }); // Ende asyncStep Excel
        }); // Ende asyncStep Ordner
    }

    function finishExtraction(ctx) {
        setProgress(90, 'Erzeuge Metadaten-CSV...');
        logInfo("--- CSV Export ---");

        var csvPath = ctx.outputBase + "\\bgav_metadaten.csv";
        ctx.csvRows = generateMetadataCsv(csvPath);
        logSuccess("CSV gespeichert: bgav_metadaten.csv (" + ctx.csvRows + " Eintraege)");

        setStepCompleted('step3');
        setStepCompleted('step4');
        setProgress(100, 'Fertig!');

        showResults();

        var msg = "<strong>Verarbeitung abgeschlossen!</strong><br>" +
            processedFiles.length + " Dateien zugeordnet + umbenannt";
        if (unmappedFiles.length > 0) {
            msg += "<br><span style='color:#d97706;'>" + unmappedFiles.length +
                " Dateien NICHT zugeordnet (bleiben im Quell-Ordner)</span>";
        }
        msg += "<br><span class='file-path'>" + ctx.outputBase + "</span>";
        showSuccess(msg);

        saveLogToFile(ctx.outputBase);
        resetButtons();
    }

    // ══════════════════════════════════════════════════════════════
    // PDF-Erstellung via Word
    // ══════════════════════════════════════════════════════════════

    // MSG-Datei: via Outlook als MHTML speichern, dann Word->PDF
    function createPdfFromMsg(msgPath, pdfPath, wordApp) {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var tempDir = fso.GetSpecialFolder(2).Path;
        var tempBase = tempDir + "\\bgav_temp_" + (new Date()).getTime();
        var tempMht = tempBase + ".mht";

        // MSG via Outlook als MHTML speichern
        var app = ensureOutlook();
        var mailItem = app.Session.OpenSharedItem(msgPath);
        mailItem.SaveAs(tempMht, olMHTML);
        mailItem.Close(0);

        var doc = wordApp.Documents.Open(tempMht, false, true, false);

        try {
            doc.ExportAsFixedFormat(pdfPath, 17, false, 0, 0);
        } catch (exportErr) {
            doc.SaveAs2(pdfPath, wdFormatPDF);
        }

        doc.Close(0);

        // Temp aufraumen
        try { if (fso.FileExists(tempMht)) fso.DeleteFile(tempMht, true); } catch (de) {}
        try {
            var filesDir = tempBase + "_files";
            if (fso.FolderExists(filesDir)) fso.DeleteFolder(filesDir, true);
        } catch (de2) {}
    }

    // EML-Datei: als MHTML-Copy oeffnen, dann Word->PDF
    function createPdfFromEml(emlPath, pdfPath, wordApp) {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var tempDir = fso.GetSpecialFolder(2).Path;
        var tempBase = tempDir + "\\bgav_temp_" + (new Date()).getTime();
        var tempMht = tempBase + ".mht";

        // EML nach .mht kopieren (Word oeffnet MHTML zuverlaessiger mit .mht Extension)
        fso.CopyFile(emlPath, tempMht);

        var doc = null;
        try {
            doc = wordApp.Documents.Open(tempMht, false, true, false);
        } catch (openErr) {
            // Fallback: direkt als EML oeffnen
            doc = wordApp.Documents.Open(emlPath, false, true, false);
        }

        try {
            doc.ExportAsFixedFormat(
                pdfPath, 17, false, 0, 0
            );
        } catch (exportErr) {
            doc.SaveAs2(pdfPath, wdFormatPDF);
        }

        doc.Close(0);

        // Temp aufraumen
        try { if (fso.FileExists(tempMht)) fso.DeleteFile(tempMht, true); } catch (de) {}
        try {
            var filesDir = tempBase + "_files";
            if (fso.FolderExists(filesDir)) fso.DeleteFolder(filesDir, true);
        } catch (de2) {}
    }

    // ══════════════════════════════════════════════════════════════
    // Excel-Metadaten laden
    // ══════════════════════════════════════════════════════════════
    function loadExcelMetadata(excelPath) {
        var lookup = {};
        var excelApp = null;
        var workbook = null;

        try {
            excelApp = new ActiveXObject("Excel.Application");
            excelApp.Visible = false;
            excelApp.DisplayAlerts = false;

            workbook = excelApp.Workbooks.Open(excelPath, 0, true);
            var ws = workbook.Sheets.Item(1);

            var maxRow = ws.UsedRange.Rows.Count;
            logInfo("Excel geladen: " + maxRow + " Zeilen");

            // Spalte B=2 (Email), C=3 (BD-Nummer/Match)
            for (var row = 2; row <= maxRow + 1; row++) {
                try {
                    var emailVal = ws.Cells(row, 2).Value;
                    if (!emailVal) continue;

                    var emailKey = String(emailVal).replace(/^\s+|\s+$/g, '').toLowerCase();
                    if (!emailKey || emailKey.indexOf('@') === -1) continue;

                    var bdNummer = ws.Cells(row, 3).Value;

                    lookup[emailKey] = {
                        bd_nummer: bdNummer ? String(bdNummer).replace(/^\s+|\s+$/g, '') : '',
                        vorname: '',
                        nachname: '',
                        email: String(emailVal).replace(/^\s+|\s+$/g, '')
                    };
                } catch (rowErr) {}
            }

        } catch (excelErr) {
            logError("Excel-Fehler: " + excelErr.message);
        } finally {
            try { if (workbook) workbook.Close(false); } catch (e) {}
            try { if (excelApp) excelApp.Quit(); } catch (e) {}
        }

        return lookup;
    }

    // ══════════════════════════════════════════════════════════════
    // CSV-Erzeugung
    // ══════════════════════════════════════════════════════════════
    function generateMetadataCsv(csvPath) {
        var header = "Nr;Dateiname_EML;Dateiname_PDF;Empfaenger_Email;BD_Nummer;Klammerbegriff;Original_Dateiname";
        var klammerbegriff = "ADM Vertrag";

        // Bestehende CSV einlesen (fuer Wiederholungslauf)
        var existingLines = [];
        var startNr = 0;
        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (fso.FileExists(csvPath)) {
                var file = fso.OpenTextFile(csvPath, 1, false, -1);
                var content = file.ReadAll();
                file.Close();

                var allLines = content.split(/\r?\n/);
                for (var el = 1; el < allLines.length; el++) {
                    var line = allLines[el].replace(/^\s+|\s+$/g, '');
                    if (line) {
                        existingLines.push(line);
                        var lineNr = parseInt(line.split(';')[0]);
                        if (!isNaN(lineNr) && lineNr > startNr) startNr = lineNr;
                    }
                }
                if (existingLines.length > 0) {
                    logInfo("Bestehende CSV: " + existingLines.length + " Eintraege beibehalten (letzte Nr: " + startNr + ")");
                }
            }
        } catch (e) {}

        var lines = [];
        lines.push(header);
        for (var ex = 0; ex < existingLines.length; ex++) {
            lines.push(existingLines[ex]);
        }

        var nr = startNr;
        for (var i = 0; i < processedFiles.length; i++) {
            nr++;
            var pf = processedFiles[i];
            var meta = excelLookup[pf.email] || {};

            lines.push(
                nr + ';' +
                csvEscape(pf.baseName + (pf.fileType === 'msg' ? '.msg' : '.eml')) + ';' +
                csvEscape(pf.baseName + ".pdf") + ';' +
                csvEscape(pf.email) + ';' +
                csvEscape(pf.bdNummer) + ';' +
                csvEscape(klammerbegriff) + ';' +
                csvEscape(pf.originalName)
            );
        }

        var csvContent = lines.join('\r\n') + '\r\n';
        writeUtf8File(csvPath, csvContent);

        return nr;
    }

    function csvEscape(val) {
        if (!val) return '';
        var s = String(val);
        if (s.indexOf(';') > -1 || s.indexOf('"') > -1 || s.indexOf('\n') > -1) {
            return '"' + s.replace(/"/g, '""') + '"';
        }
        return s;
    }

    // ══════════════════════════════════════════════════════════════
    // Datei-Operationen
    // ══════════════════════════════════════════════════════════════
    function writeUtf8File(filepath, content) {
        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var file = fso.CreateTextFile(filepath, true, true);
            file.Write(content);
            file.Close();
            return;
        } catch (fsoErr) {}

        try {
            var stream = new ActiveXObject("ADODB.Stream");
            stream.Type = 2;
            stream.Charset = "UTF-8";
            stream.Open();
            stream.WriteText(content);
            stream.SaveToFile(filepath, 2);
            stream.Close();
        } catch (streamErr) {
            throw new Error("Datei konnte nicht geschrieben werden: " + filepath + " - " + streamErr.message);
        }
    }

    // ══════════════════════════════════════════════════════════════
    // Ergebnis-Anzeige
    // ══════════════════════════════════════════════════════════════
    function showResults() {
        document.getElementById('panelResults').style.display = 'block';

        document.getElementById('resultsSummary').innerHTML =
            '<p style="margin-bottom:8px;">' +
            '<strong>' + processedFiles.length + '</strong> zugeordnet | ' +
            '<strong style="color:#d97706;">' + unmappedFiles.length + '</strong> nicht zugeordnet</p>';

        // Zugeordnete Dateien
        var tbody = document.getElementById('resultsBody');
        tbody.innerHTML = '';

        for (var i = 0; i < processedFiles.length; i++) {
            var pf = processedFiles[i];
            var meta = excelLookup[pf.email] || {};
            var name = pf.email;

            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td>' + pf.nr + '</td>' +
                '<td>' + escapeHtml(name) + '<br><small style="color:#94a3b8;">' + escapeHtml(pf.email) + '</small></td>' +
                '<td>' + escapeHtml(pf.bdNummer) + '</td>' +
                '<td style="color:#10b981;">&#10003; ' + escapeHtml(pf.baseName) + '</td>';
            tbody.appendChild(tr);
        }

        // Nicht zugeordnete Dateien
        if (unmappedFiles.length > 0) {
            document.getElementById('unmappedSection').style.display = 'block';
            var ubody = document.getElementById('unmappedBody');
            ubody.innerHTML = '';

            for (var u = 0; u < unmappedFiles.length; u++) {
                var uf = unmappedFiles[u];
                var tr2 = document.createElement('tr');
                tr2.innerHTML =
                    '<td>' + escapeHtml(uf.name) + '</td>' +
                    '<td>' + (uf.toEmails.length > 0 ? escapeHtml(uf.toEmails.join(', ')) : '<em>nicht erkannt</em>') + '</td>' +
                    '<td style="color:#f87171;">' + escapeHtml(uf.reason) + '</td>';
                ubody.appendChild(tr2);
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    // UI-Hilfsfunktionen
    // ══════════════════════════════════════════════════════════════
    function setProgress(pct, text) {
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('progressText').innerText = text;
    }

    function setStepActive(stepId) {
        document.getElementById(stepId).className = 'step active';
    }

    function setStepCompleted(stepId) {
        document.getElementById(stepId).className = 'step completed';
    }

    function showError(msg) {
        var el = document.getElementById('errorStatus');
        el.innerHTML = msg;
        el.style.display = 'block';
    }

    function showSuccess(msg) {
        var el = document.getElementById('successStatus');
        el.innerHTML = msg;
        el.style.display = 'block';
    }

    function hideAllStatus() {
        document.getElementById('errorStatus').style.display = 'none';
        document.getElementById('successStatus').style.display = 'none';
        document.getElementById('infoStatus').style.display = 'none';
    }

    function logEntry(msg, cls) {
        var container = document.getElementById('logContainer');
        container.style.display = 'block';
        var div = document.createElement('div');
        div.className = 'log-entry ' + (cls || '');
        div.innerText = msg;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }

    function logInfo(msg)    { logEntry(msg, 'info'); }
    function logSuccess(msg) { logEntry(msg, 'success'); }
    function logWarn(msg)    { logEntry(msg, 'warn'); }
    function logError(msg)   { logEntry(msg, 'error'); }

    function saveLogToFile(outputBase) {
        try {
            var container = document.getElementById('logContainer');
            var entries = container.getElementsByTagName('div');
            var logLines = [];
            var now = new Date();
            logLines.push("BGAV Extraktion - Log vom " + formatDateLong(now));
            logLines.push("============================================================");
            logLines.push("");

            for (var li = 0; li < entries.length; li++) {
                var entry = entries[li];
                var prefix = "";
                if (entry.className.indexOf('error') > -1) prefix = "[FEHLER] ";
                else if (entry.className.indexOf('warn') > -1) prefix = "[WARNUNG] ";
                else if (entry.className.indexOf('success') > -1) prefix = "[OK] ";
                else if (entry.className.indexOf('info') > -1) prefix = "[INFO] ";
                logLines.push(prefix + (entry.innerText || ''));
            }

            var logContent = logLines.join('\r\n') + '\r\n';
            var timestamp = padNumber(now.getFullYear(), 4) +
                padNumber(now.getMonth() + 1, 2) +
                padNumber(now.getDate(), 2) + "_" +
                padNumber(now.getHours(), 2) +
                padNumber(now.getMinutes(), 2) +
                padNumber(now.getSeconds(), 2);
            var logPath = outputBase + "\\bgav_log_" + timestamp + ".txt";

            writeUtf8File(logPath, logContent);
            logSuccess("Log gespeichert: bgav_log_" + timestamp + ".txt");
        } catch (logErr) {
            logWarn("Log-Datei konnte nicht gespeichert werden: " + logErr.message);
        }
    }

    function resetButtons() {
        document.getElementById('btnStart').disabled = false;
    }

    function resetTool() {
        document.getElementById('panelResults').style.display = 'none';
        document.getElementById('progressContainer').style.display = 'none';
        document.getElementById('logContainer').innerHTML = '';
        document.getElementById('logContainer').style.display = 'none';
        document.getElementById('unmappedSection').style.display = 'none';
        hideAllStatus();
        processedFiles = [];
        unmappedFiles = [];

        document.getElementById('step1').className = 'step active';
        document.getElementById('step2').className = 'step';
        document.getElementById('step3').className = 'step';
        document.getElementById('step4').className = 'step';
    }

    // ══════════════════════════════════════════════════════════════
    // Hilfsfunktionen
    // ══════════════════════════════════════════════════════════════
    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function padNumber(num, len) {
        var s = String(num);
        while (s.length < len) s = '0' + s;
        return s;
    }

    function countKeys(obj) {
        var count = 0;
        for (var k in obj) {
            if (obj.hasOwnProperty(k)) count++;
        }
        return count;
    }

    function formatDateLong(d) {
        try {
            var dt = new Date(d);
            return padNumber(dt.getDate(), 2) + '.' +
                padNumber(dt.getMonth() + 1, 2) + '.' +
                dt.getFullYear() + ' ' +
                padNumber(dt.getHours(), 2) + ':' +
                padNumber(dt.getMinutes(), 2) + ':' +
                padNumber(dt.getSeconds(), 2);
        } catch (e) { return ''; }
    }
    </script>
</body>
</html>
