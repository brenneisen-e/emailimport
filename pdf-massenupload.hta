<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="x-ua-compatible" content="ie=edge"/>
    <meta charset="utf-8"/>
    <title>PDF Massenupload</title>

    <HTA:APPLICATION
        ID="PDF_Massenupload"
        APPLICATIONNAME="PDF Massenupload"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="1.0"
        WINDOWSTATE="normal"
    />

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 20px;
            color: #1e293b;
        }
        .container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 760px;
            padding: 32px;
            margin-top: 10px;
        }
        .header {
            text-align: center;
            margin-bottom: 24px;
        }
        .header h1 {
            font-size: 22px;
            color: #1e293b;
            font-weight: 700;
        }
        .header .subtitle {
            color: #64748b;
            font-size: 13px;
            margin-top: 4px;
        }
        .badge {
            display: inline-block;
            background: #e0e7ff;
            color: #4338ca;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 12px;
            margin-top: 8px;
            font-weight: 600;
        }

        /* Steps */
        .steps {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 24px;
        }
        .step {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #94a3b8;
        }
        .step .num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 11px;
        }
        .step.active .num {
            background: #4f46e5;
            color: white;
        }
        .step.completed .num {
            background: #22c55e;
            color: white;
        }
        .step-arrow {
            color: #cbd5e1;
            font-size: 14px;
        }

        /* Sections */
        .section {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
        }
        .section h3 {
            font-size: 14px;
            color: #475569;
            margin-bottom: 12px;
            font-weight: 600;
        }

        /* Buttons */
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn:hover { transform: translateY(-1px); }
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        .btn-primary {
            background: #4f46e5;
            color: white;
        }
        .btn-primary:hover:not(:disabled) {
            background: #4338ca;
        }
        .btn-success {
            background: #22c55e;
            color: white;
        }
        .btn-success:hover:not(:disabled) {
            background: #16a34a;
        }
        .btn-secondary {
            background: #e2e8f0;
            color: #475569;
        }
        .btn-secondary:hover:not(:disabled) {
            background: #cbd5e1;
        }
        .btn-row {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        /* Input */
        .input-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .input-row input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 13px;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        .input-row input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
        }

        /* Table */
        .result-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            margin-top: 8px;
        }
        .result-table th {
            background: #e2e8f0;
            padding: 8px 10px;
            text-align: left;
            font-weight: 600;
            color: #475569;
        }
        .result-table td {
            padding: 6px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
        }
        .result-table tr:hover td {
            background: #f1f5f9;
        }
        .scroll-container {
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        /* Log */
        .log-area {
            background: #1e293b;
            color: #94a3b8;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 11px;
            padding: 12px;
            border-radius: 8px;
            max-height: 200px;
            overflow-y: auto;
            margin-top: 12px;
        }
        .log-area .log-success { color: #4ade80; }
        .log-area .log-warn { color: #fbbf24; }
        .log-area .log-error { color: #f87171; }
        .log-area .log-info { color: #60a5fa; }

        /* Progress */
        .progress-bar {
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            margin-top: 12px;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            border-radius: 3px;
            width: 0%;
            transition: width 0.3s;
        }

        /* Status */
        .status-msg {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 12px;
            margin-top: 12px;
            display: none;
        }
        .status-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }
        .status-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .file-path {
            font-family: 'Consolas', monospace;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 11px;
        }

        .hidden { display: none; }

        .stat-box {
            display: inline-block;
            background: #e0e7ff;
            padding: 6px 14px;
            border-radius: 8px;
            margin: 4px;
            font-size: 13px;
            font-weight: 600;
            color: #4338ca;
        }
        .stat-box.green {
            background: #dcfce7;
            color: #166534;
        }
        .stat-box.red {
            background: #fef2f2;
            color: #991b1b;
        }
    </style>

    <script language="javascript">
    // ══════════════════════════════════════════════════════════════
    // Globale Variablen
    // ══════════════════════════════════════════════════════════════
    var foundFiles = [];   // [{filename, bdNummer, datum}]
    var selectedFolder = '';

    // ══════════════════════════════════════════════════════════════
    // Hilfsfunktionen
    // ══════════════════════════════════════════════════════════════

    function getScriptDir() {
        var path = unescape(document.location.pathname);
        if (path.charAt(0) === '/' || path.charAt(0) === '\\') {
            path = path.substring(1);
        }
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        return fso.GetParentFolderName(path);
    }

    function log(msg, cls) {
        var el = document.getElementById('logArea');
        if (!el) return;
        var span = document.createElement('div');
        if (cls) span.className = cls;
        span.innerText = msg;
        el.appendChild(span);
        el.scrollTop = el.scrollHeight;
    }

    function logInfo(msg)    { log(msg, 'log-info'); }
    function logSuccess(msg) { log(msg, 'log-success'); }
    function logWarn(msg)    { log(msg, 'log-warn'); }
    function logError(msg)   { log(msg, 'log-error'); }

    function setProgress(pct) {
        var fill = document.getElementById('progressFill');
        if (fill) fill.style.width = pct + '%';
    }

    function setStepActive(id) {
        var el = document.getElementById(id);
        if (el) el.className = 'step active';
    }

    function setStepCompleted(id) {
        var el = document.getElementById(id);
        if (el) el.className = 'step completed';
    }

    function showMsg(type, html) {
        var el = document.getElementById('statusMsg');
        el.className = 'status-msg status-' + type;
        el.innerHTML = html;
        el.style.display = 'block';
    }

    // ══════════════════════════════════════════════════════════════
    // Ordner auswaehlen
    // ══════════════════════════════════════════════════════════════

    // Shell-Namespace-Pfade (z.B. \shellfolder\...) in echte Dateisystem-Pfade aufloesen
    // Noetig fuer Citrix/Terminal-Server-Umgebungen
    function resolveShellFolder(folderObj) {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var path = folderObj.Self.Path;

        // Wenn der Pfad direkt existiert, ist alles ok
        if (fso.FolderExists(path)) return path;

        // Methode 1: Ueber ein Kind-Element den echten Elternpfad ermitteln
        try {
            var items = folderObj.Items();
            if (items && items.Count > 0) {
                var childPath = items.Item(0).Path;
                if (childPath && fso.FileExists(childPath)) {
                    var resolved = fso.GetParentFolderName(childPath);
                    if (fso.FolderExists(resolved)) {
                        logInfo("Shell-Pfad aufgeloest: " + path + " -> " + resolved);
                        return resolved;
                    }
                }
                // Kind-Element ist selbst ein Ordner
                if (childPath && fso.FolderExists(childPath)) {
                    var resolved = fso.GetParentFolderName(childPath);
                    if (fso.FolderExists(resolved)) {
                        logInfo("Shell-Pfad aufgeloest: " + path + " -> " + resolved);
                        return resolved;
                    }
                }
            }
        } catch(e) {
            logError("Resolve Methode 1 fehlgeschlagen: " + e.message);
        }

        // Methode 2: Ueber Shell NameSpace erneut aufloesen
        try {
            var shell = new ActiveXObject("Shell.Application");
            var ns = shell.NameSpace(path);
            if (ns && ns.Self) {
                var nsPath = ns.Self.Path;
                if (nsPath !== path && fso.FolderExists(nsPath)) {
                    logInfo("Shell-Pfad aufgeloest via NameSpace: " + path + " -> " + nsPath);
                    return nsPath;
                }
            }
        } catch(e) {
            logError("Resolve Methode 2 fehlgeschlagen: " + e.message);
        }

        // Nicht aufloesbar - Original zurueckgeben
        return path;
    }

    function browseFolder() {
        try {
            var shell = new ActiveXObject("Shell.Application");
            var folder = shell.BrowseForFolder(0, "Ordner mit PDF-Dateien auswaehlen:", 0x0051, "");
            if (folder && folder.Self) {
                selectedFolder = resolveShellFolder(folder);
                document.getElementById('folderPath').value = selectedFolder;
                logInfo("Ordner ausgewaehlt: " + selectedFolder);
            }
        } catch(e) {
            logError("Fehler beim Ordner auswaehlen: " + e.message);
        }
    }

    function useCurrentFolder() {
        selectedFolder = getScriptDir();
        document.getElementById('folderPath').value = selectedFolder;
        logInfo("Verwende aktuellen Ordner: " + selectedFolder);
    }

    // ══════════════════════════════════════════════════════════════
    // PDFs scannen
    // ══════════════════════════════════════════════════════════════

    function scanFolder() {
        var folder = document.getElementById('folderPath').value;
        if (!folder) {
            showMsg('error', 'Bitte zuerst einen Ordner auswaehlen.');
            return;
        }

        selectedFolder = folder;
        foundFiles = [];
        document.getElementById('panelResults').style.display = 'none';
        document.getElementById('statusMsg').style.display = 'none';
        setStepActive('step1');
        setProgress(10);

        logInfo("Scanne Ordner: " + folder);

        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (!fso.FolderExists(folder)) {
                // Bei Shell-Namespace-Pfaden (\shellfolder\...) bessere Fehlermeldung
                if (folder.indexOf("\\shellfolder\\") >= 0 || folder.indexOf("::") >= 0) {
                    showMsg('error', 'Shell-Namespace-Pfad kann nicht aufgeloest werden: ' + folder + '<br><br>Bitte den Ordnerpfad manuell eingeben (z.B. C:\\Users\\...\\Desktop\\Ordner) oder ueber ein zugeordnetes Laufwerk navigieren.');
                    logError("Shell-Namespace-Pfad nicht aufloesbar: " + folder);
                } else {
                    showMsg('error', 'Ordner existiert nicht: ' + folder);
                    logError("Ordner nicht gefunden: " + folder);
                }
                return;
            }

            var folderObj = fso.GetFolder(folder);
            var files = new Enumerator(folderObj.Files);
            var total = 0;
            var matched = 0;
            var skipped = 0;

            // Pattern: Dashboard_XXXXXXXX_DDMMYYYY.pdf
            // BD-Nummer = 8 Ziffern an Position 2 (nach "Dashboard_")
            var pattern = /^Dashboard_(\d{8})_(\d{8})\.pdf$/i;

            setProgress(30);

            while (!files.atEnd()) {
                var file = files.item();
                var name = file.Name;
                total++;

                var match = name.match(pattern);
                if (match) {
                    matched++;
                    var bdNummer = match[1];
                    var datumRaw = match[2]; // DDMMYYYY
                    var datum = datumRaw.substring(0, 2) + '.' +
                                datumRaw.substring(2, 4) + '.' +
                                datumRaw.substring(4, 8);

                    foundFiles.push({
                        filename: name,
                        bdNummer: bdNummer,
                        datum: datum
                    });
                } else if (name.toLowerCase().indexOf('.pdf') > -1) {
                    skipped++;
                    logWarn("Uebersprungen (kein Dashboard-Pattern): " + name);
                }

                files.moveNext();
            }

            setProgress(70);
            setStepCompleted('step1');

            logSuccess(matched + " Dashboard-PDFs gefunden (von " + total + " Dateien)");
            if (skipped > 0) {
                logWarn(skipped + " andere PDF-Dateien uebersprungen");
            }

            if (foundFiles.length === 0) {
                showMsg('error', 'Keine passenden PDF-Dateien gefunden.<br>' +
                    'Erwartet: <span class="file-path">Dashboard_XXXXXXXX_DDMMYYYY.pdf</span>');
                setProgress(0);
                return;
            }

            // Sortierung nach BD-Nummer
            foundFiles.sort(function(a, b) {
                if (a.bdNummer < b.bdNummer) return -1;
                if (a.bdNummer > b.bdNummer) return 1;
                return 0;
            });

            // Tabelle anzeigen
            showResultsTable();
            setStepActive('step2');
            setProgress(80);

            document.getElementById('btnExportCsv').disabled = false;

        } catch(e) {
            logError("Fehler beim Scannen: " + e.message);
            showMsg('error', 'Fehler: ' + e.message);
        }
    }

    function showResultsTable() {
        var tbody = document.getElementById('resultsBody');
        tbody.innerHTML = '';

        for (var i = 0; i < foundFiles.length; i++) {
            var f = foundFiles[i];
            var tr = document.createElement('tr');

            var td1 = document.createElement('td');
            td1.innerText = (i + 1);
            tr.appendChild(td1);

            var td2 = document.createElement('td');
            td2.innerText = f.filename;
            td2.style.fontFamily = "'Consolas', monospace";
            td2.style.fontSize = "11px";
            tr.appendChild(td2);

            var td3 = document.createElement('td');
            td3.innerText = f.bdNummer;
            td3.style.fontWeight = "600";
            tr.appendChild(td3);

            var td4 = document.createElement('td');
            td4.innerText = f.datum;
            tr.appendChild(td4);

            tbody.appendChild(tr);
        }

        document.getElementById('panelResults').style.display = 'block';
        document.getElementById('resultCount').innerText = foundFiles.length + ' PDFs gefunden';
    }

    // ══════════════════════════════════════════════════════════════
    // CSV Export
    // ══════════════════════════════════════════════════════════════

    function exportCsv() {
        if (foundFiles.length === 0) {
            showMsg('error', 'Keine Dateien zum Exportieren.');
            return;
        }

        setStepActive('step2');
        setProgress(85);
        logInfo("--- CSV Export ---");

        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var klammer = "ADM Vertrag";
            var csvPath = selectedFolder + "\\pdf_upload_metadaten.csv";

            var lines = [];
            var header = "Nr;Dateiname_PDF;BD_Nummer;Klammerbegriff";
            lines.push(header);

            for (var i = 0; i < foundFiles.length; i++) {
                var f = foundFiles[i];
                var nr = i + 1;
                lines.push(nr + ';' +
                    csvEscape(f.filename) + ';' +
                    csvEscape(f.bdNummer) + ';' +
                    csvEscape(klammer));
            }

            var csvContent = lines.join('\r\n') + '\r\n';
            writeUtf8File(csvPath, csvContent);

            setStepCompleted('step2');
            setProgress(100);

            logSuccess("CSV gespeichert: pdf_upload_metadaten.csv (" + foundFiles.length + " Eintraege)");

            showMsg('success',
                '<strong>CSV erfolgreich erstellt!</strong><br>' +
                foundFiles.length + ' Eintraege in <span class="file-path">pdf_upload_metadaten.csv</span><br>' +
                '<span class="file-path">' + csvPath + '</span>');

            // Ordner oeffnen
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run('explorer.exe /select,"' + csvPath + '"');
            } catch(e2) { /* ignore */ }

        } catch(e) {
            logError("Fehler beim CSV-Export: " + e.message);
            showMsg('error', 'Fehler beim Speichern: ' + e.message);
        }
    }

    function csvEscape(val) {
        if (!val) return '';
        var s = String(val);
        if (s.indexOf(';') > -1 || s.indexOf('"') > -1 || s.indexOf('\n') > -1) {
            return '"' + s.replace(/"/g, '""') + '"';
        }
        return s;
    }

    function writeUtf8File(filepath, content) {
        try {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            // unicode=true -> UTF-16LE mit BOM (Windows-kompatibel)
            var file = fso.CreateTextFile(filepath, true, true);
            file.Write(content);
            file.Close();
        } catch(e) {
            // Fallback: ADODB.Stream fuer echtes UTF-8
            var stream = new ActiveXObject("ADODB.Stream");
            stream.Type = 2; // adTypeText
            stream.Charset = "utf-8";
            stream.Open();
            stream.WriteText(content);
            stream.SaveToFile(filepath, 2);
            stream.Close();
        }
    }

    // ══════════════════════════════════════════════════════════════
    // Init
    // ══════════════════════════════════════════════════════════════

    function initApp() {
        // HTA-Fenster zentrieren und Groesse setzen
        try {
            window.resizeTo(800, 700);
            var screenW = screen.availWidth;
            var screenH = screen.availHeight;
            window.moveTo((screenW - 800) / 2, (screenH - 700) / 2);
        } catch(e) { /* ignore */ }

        // Aktuellen Ordner vorbelegen
        useCurrentFolder();
    }
    </script>
</head>
<body onload="initApp()">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>PDF Massenupload</h1>
            <div class="subtitle">Dashboard-PDFs scannen und Upload-CSV erzeugen</div>
            <div class="badge">BD-Nummer aus Dateiname | Klammerbegriff: ADM Vertrag</div>
        </div>

        <!-- Steps -->
        <div class="steps">
            <div class="step" id="step1">
                <div class="num">1</div>
                <span>PDFs scannen</span>
            </div>
            <span class="step-arrow">&#9654;</span>
            <div class="step" id="step2">
                <div class="num">2</div>
                <span>CSV erzeugen</span>
            </div>
        </div>

        <!-- Ordner-Auswahl -->
        <div class="section">
            <h3>Ordner mit PDF-Dateien</h3>
            <div class="input-row">
                <input type="text" id="folderPath" placeholder="Pfad zum Ordner..." />
                <button class="btn btn-secondary" onclick="browseFolder()">Durchsuchen...</button>
                <button class="btn btn-secondary" onclick="useCurrentFolder()">HTA-Ordner</button>
            </div>
            <div class="btn-row">
                <button class="btn btn-primary" onclick="scanFolder()">PDFs scannen</button>
            </div>
            <p style="margin-top:8px;font-size:11px;color:#94a3b8;">
                Erwartet: <span class="file-path">Dashboard_XXXXXXXX_DDMMYYYY.pdf</span>
                (z.B. Dashboard_00630595_29102025.pdf)
            </p>
        </div>

        <!-- Ergebnis-Tabelle -->
        <div class="section hidden" id="panelResults">
            <h3>Gefundene PDFs <span id="resultCount" style="font-weight:400;color:#64748b;font-size:12px;"></span></h3>
            <div class="scroll-container">
                <table class="result-table">
                    <thead>
                        <tr>
                            <th style="width:40px">Nr</th>
                            <th>Dateiname</th>
                            <th style="width:100px">BD-Nummer</th>
                            <th style="width:100px">Datum</th>
                        </tr>
                    </thead>
                    <tbody id="resultsBody"></tbody>
                </table>
            </div>
            <div class="btn-row">
                <button class="btn btn-success" id="btnExportCsv" onclick="exportCsv()" disabled>CSV erzeugen</button>
            </div>
        </div>

        <!-- Status -->
        <div class="status-msg" id="statusMsg"></div>

        <!-- Progress -->
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>

        <!-- Log -->
        <div class="log-area" id="logArea"></div>
    </div>
</body>
</html>
